<?xml version="1.0" encoding="utf-8"?>
<call name="shore bombardment" key="artillery2.call"
	initiation_comment1="Requesting Fire Support"
	initiation_comment2="Field Guns, Saturation Bombardment"
	acknowledge_comment="Roger, wait three."
	acknowledge_time="3.0"
	launch_comment="Barrage under way."
        notify_metagame="1">

    <!-- Volley 1: 3 groups x 2 shells; corresponding groups repeat every 3 seconds. -->

    <round
	instances="2"
	instance_class="grenade"
	instance_key="artillery_shell.projectile" 
	instance_spread="10 15 10" 
	common_spread="20 0 20" 
	launch_time="6.0"
	spawn_time="10.0">
	<sound class="launch" fileref="light_gun_barrage_distant.wav" volume="2.3" /> 
	<sound class="spawn" fileref="shell_whistle_02.wav" volume="0.95" />
	</round>

    <round
	instances="2"
	instance_class="grenade"
	instance_key="artillery_shell.projectile" 
	instance_spread="10 15 10" 
	common_spread="20 0 20" 
	launch_time="6.5"
	spawn_time="10.5">   
	<sound class="spawn" fileref="shell_whistle_02.wav" volume="0.95" />
	</round>

