<?xml version="1.0" encoding="utf-8"?>
<calls>
	<call 
	key="usf_vehicle.call" 
	radio_view_text="Reinforcements - .50 Cal Jeep" 
	initiation_comment="Requesting reinforcements, jeep!" 
	acknowledge_comment="Copy, loud and clear" 
	notify_metagame="1" consume_rp="0" show_target_marker="0">
	
		<tag name="reinforcements" />
		<hud_icon filename="hud_willys_mg.png" />
		<capacity value="0" source="rank" source_value="0.0" />
		<capacity value="100" source="rank" source_value="0.1" />
		<inventory encumbrance="0.0" price="200.0" />
		
	</call>
  
	<call key="usf_vehicle_spawn.call" acknowledge_time="0.0" launch_comment=".50 cal jeep deployed">
		<round 
		instances="1" 
		instance_class="vehicle" 
		instance_key="willys_mb.vehicle" 
		instance_spread="3 0 3" 
		common_spread="0 0 0" 
		launch_time="2.5" 
		spawn_time="5.0" 
		horizontal_offset_at_spawn="0.0" 
		vertical_offset_at_spawn="0.0" 
		initial_speed_to_target="0.0">
		</round>
		
		<inventory encumbrance="0.0" price="200.0" />
		
	</call>
	
</calls>
