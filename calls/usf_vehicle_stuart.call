<?xml version="1.0" encoding="utf-8"?>
<calls>
	<call 
	key="usf_vehicle_stuart.call" 
	radio_view_text="Reinforcements - M5A1 Stuart Light Tank" 
	initiation_comment="Requesting reinforcements, M5A1 Stuart!" 
	acknowledge_comment="Copy, loud and clear" 
	notify_metagame="1" consume_rp="0" show_target_marker="0">
	
		<tag name="reinforcements" />
		<hud_icon filename="hud_tank_m5a1_stuart.png" />
		<capacity value="0" source="rank" source_value="0.0" />
		<capacity value="100" source="rank" source_value="0.1" />
		<inventory encumbrance="0.0" price="800.0" /> 
		
	</call>
  
	<call key="usf_vehicle_stuart_spawn.call" acknowledge_time="0.0" launch_comment="M5A1 Stuart deployed">
		<round 
		instances="1" 
		instance_class="vehicle" 
		instance_key="m5a1_stuart.vehicle" 
		instance_spread="3 0 3" 
		common_spread="0 0 0" 
		launch_time="2.5" 
		spawn_time="5.0" 
		horizontal_offset_at_spawn="0.0" 
		vertical_offset_at_spawn="0.0" 
		initial_speed_to_target="0.0">
		</round>
		
		<inventory encumbrance="0.0" price="800.0" />
		
	</call>
	
</calls>
