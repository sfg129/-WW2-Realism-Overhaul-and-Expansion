<?xml version="1.0" encoding="utf-8"?>
<call name="airdropped armoury" key="ww2_undead_usf_para_armoury.call"
           initiation_comment1="Airdropped Armory"
           acknowledge_comment="Confirmed, supply is in the air."
           launch_comment="Airdropping supplies now."
           	  notify_metagame="1">

    <round instances="1"
           instance_class="vehicle"
           instance_key="usf_armoury_parachute.vehicle" 
           instance_spread="0 0 0" 
           common_spread="0 0 0" 
           launch_time="6.0"
           spawn_time="10.0"
           horizontal_offset_at_spawn="0.0"
           vertical_offset_at_spawn="50.0"
           initial_speed_to_target="0.0">
        <effect class="launch" ref="ShadowC47Flyby" shadow="1" />
        <sound class="launch" fileref="plane_flyby.wav" />
    </round>

    <hud_icon filename="hud_para_armory.png" />
    <capacity value="100" source="rank" source_value="0.0" />
    <inventory encumbrance="0.0" price="175.0" />

</call>
