			spawn_time="7.5" 
			horizontal_offset_at_spawn="0.0" 
			vertical_offset_at_spawn="0.0" 
			initial_speed_to_target="0.0">
	<sound class="launch" fileref="mus_cue_call_in_ija_infantry.wav" pitch_variety="0.0"/>       
		</round>
		
		<inventory encumbrance="0.0" price="350.0" />
		
	</call>
	
