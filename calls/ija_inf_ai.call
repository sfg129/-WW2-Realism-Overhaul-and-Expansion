		<capacity value="100" source="rank" source_value="0.15" />
		<inventory encumbrance="0.0" price="350.0" />
		
	</call>
  
	<call key="ija_inf_spawn_ai.call" acknowledge_time="0.0" launch_comment="Banzai charge deployed">
		<round 
			instances="8" 
			instance_class="soldier" 
			instance_key="banzai" 
			instance_spread="2 0 2" 
			common_spread="0 0 0" 
