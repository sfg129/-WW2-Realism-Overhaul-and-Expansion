			horizontal_offset_at_spawn="0.0" 
			vertical_offset_at_spawn="0.0" 
			initial_speed_to_target="0.0">
		</round>
		
		<round 
			instances="3" 
			instance_class="soldier" 
			instance_key="banzai_2" 
			instance_spread="2 0 2" 
			common_spread="0 0 0" 
			launch_time="5.0" 
			spawn_time="7.5" 
			horizontal_offset_at_spawn="0.0" 
			vertical_offset_at_spawn="0.0" 
			initial_speed_to_target="0.0">
		</round>
		
		<round 
			instances="1" 
			instance_class="soldier" 
			instance_key="banzai_leader" 
			instance_spread="0 0 0" 
			common_spread="0 0 0" 
