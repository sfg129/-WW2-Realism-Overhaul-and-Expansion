<?xml version="1.0" encoding="utf-8"?>
<calls>
	<call 	name="Reinforcements - Grounded Paratroopers" key="ukf_para_no_parachuting.call"
	radio_view_text="Reinforcements - Grounded Paratrooper Squad" 
	initiation_comment="Requesting reinforcements, paratroopers from nearby areas"
	acknowledge_comment="Roger"
	launch_comment="nearby paratroopers deploying"
  	notify_metagame="1" consume_rp="0" show_target_marker="0">

    <hud_icon filename="hud_paratroopers2.png" />
    <capacity value="0" source="rank" source_value="0.0" />
    <capacity value="100" source="rank" source_value="0.15" />
    <inventory encumbrance="0.0" price="250.0" />
	</call>


	<call key="ukf_para_no_parachuting_spawn.call" acknowledge_time="0.0" launch_comment="Paratroopers deployed">
		<round 
			instances="7" 
			instance_class="soldier" 
			instance_key="regular" 
			instance_spread="3 0 3" 
			common_spread="0 0 0" 
			launch_time="5.0" 
			spawn_time="7.5" 
			horizontal_offset_at_spawn="0.0" 
			vertical_offset_at_spawn="0.0" 
			initial_speed_to_target="0.0">
		</round>
		<round 
			instances="1" 
			instance_class="soldier" 
			instance_key="veteran_callin" 
			instance_spread="3 0 3" 
			common_spread="0 0 0" 
			launch_time="5.0" 
			spawn_time="7.5" 
			horizontal_offset_at_spawn="0.0" 
			vertical_offset_at_spawn="0.0" 
			initial_speed_to_target="0.0">
		</round>
		<round 
			instances="2" 
			instance_class="soldier" 
			instance_key="assault_callin" 
			instance_spread="3 0 3" 
			common_spread="0 0 0" 
			launch_time="5.0" 
			spawn_time="7.5" 
			horizontal_offset_at_spawn="0.0" 
			vertical_offset_at_spawn="0.0" 
			initial_speed_to_target="0.0">
	<sound class="launch" fileref="mus_cue_call_in_usf_paratrooper.wav" pitch_variety="0.0" />     
		</round>

		<inventory encumbrance="0.0" price="250.0" />
		
	</call>
	
</calls>