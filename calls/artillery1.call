<?xml version="1.0" encoding="utf-8"?>
<call name="naval gunfire support" key="artillery1.call"
	initiation_comment1="Requesting Fire Support"
	initiation_comment2="Heavy Naval Guns"
	acknowledge_comment="Roger, guns rotating to target."
	acknowledge_time="5.0"
	launch_comment="Shots out."
        notify_metagame="1">
    
	<!-- bombardment of 3 guns x2 barrels each -->

	<round 
	instances="2"
	instance_class="grenade"
	instance_key="naval_artillery_shell.projectile" 
	instance_spread="20 20 20" 
	common_spread="0 0 0" 
	launch_time="8.0"
	spawn_time="14.5">
	<sound class="launch" fileref="naval_barrage_distant.wav" volume="7.0" />   
	<sound class="spawn" fileref="naval_shell_whistle.wav" volume="1.4" />
	</round>

	<round 
	instances="2"
	instance_class="grenade"
	instance_key="naval_artillery_shell.projectile" 
	instance_spread="20 20 20" 
	common_spread="0 0 0" 
	launch_time="11.0"
	spawn_time="17.0">
	<sound class="spawn" fileref="naval_shell_whistle.wav" volume="1.4" />
	</round>

	<round 
	instances="2"
	instance_class="grenade"
	instance_key="naval_artillery_shell.projectile" 
	instance_spread="20 20 20" 
	common_spread="0 0 0" 
	launch_time="14.0"
	spawn_time="20.0">
	<sound class="spawn" fileref="naval_shell_whistle.wav" volume="1.4" />
	</round>
	
	<hud_icon filename="hud_artillery1.png" />
	<capacity value="0" source="rank" source_value="0.0" />
	<capacity value="100" source="rank" source_value="0.8" />
	<inventory encumbrance="0.0" price="700" />
	
</call>
