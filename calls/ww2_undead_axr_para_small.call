<?xml version="1.0" encoding="utf-8"?>
<call 	name="Reinforcements - Paratroopers" key="ww2_undead_axr_para_small.call"
	radio_view_text="Reinforcements - Paratrooper Squad" 
	initiation_comment="Requesting reinforcements, paratroopers"
	acknowledge_comment="Roger"
	launch_comment=""
  notify_metagame="1"  >

    <round instances="6"
           instance_class="soldier"
	   instance_key="nachtjaeger_fsj"
           instance_spread="10 15 10" 
           common_spread="0 0 0" 
           launch_time="5.0"
           spawn_time="11.0">

        <effect class="launch" ref="ShadowC47Flyby" shadow="1" />
        <sound class="launch" fileref="plane_flyby.wav" />

    </round>

	<!-- used to use this to play a bit of music but decided to cut from WW2 Undead -->
