	// --------------------------------------------
	void update(float time) {
		m_timer -= time;
			
		if (m_timer < 0.0) {
			end();
		}
	    if (m_timer < 80.0 && m_ch == 0){
			m_ch++;    
    		//m_metagame.getComms().send("<command class='create_instance' faction_id='0' position='591 50 365' instance_class='vehicle' instance_key='supply_box.vehicle'/>");
	    }    
		if (m_timer < 60.0 && m_ch==1){
			m_ch++;
			m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem intro, part 1"));
		}
		if (m_timer < 55.0 && m_ch==2){
			m_ch++;
			m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem intro, part 2"));
		}
		if (m_timer < 50.0 && m_ch==3){
			m_ch++;
			m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem intro, part 3"));
		}
		if (m_timer < 45.0 and m_ch==4){
			m_ch++;
			m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem intro, part 4"));
		}
		if (m_timer < 40.0 and m_ch==5){
			m_ch++;
			m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem intro, part 5"));
		}
		if (m_timer < 35.0 and m_ch==6){
			m_ch++;
			m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem intro, part 6"));
			m_metagame.getComms().send("<command class='create_call' key='wh_vehicle_sdkfz251_hidden.call' position='520 10 869' faction_id='1' />");		
			m_metagame.getComms().send("<command class='create_call' key='wh_vehicle_stug_hidden.call' position='507 10 877' faction_id='1' />");		
			m_metagame.getComms().send("<command class='create_call' key='wh_vehicle_stug_hidden.call' position='507 10 877' faction_id='1' />");
			spawn_crewSOUTH();
		}
		if (m_timer < 7.0 and m_ch==7){
			m_ch++;
			m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem intro, part 7"));
		}
	}

	// --------------------------------------------
	void end() {
		DefPhaseArnhem::end();
		//clearVisualTimer(m_metagame);
	}

	// --------------------------------------------
	void save(XmlElement@ root) {
		DefPhaseArnhem::save(root);
		
		root.setIntAttribute("ch", m_ch);
		root.setFloatAttribute("timer", m_timer);
	}

	// --------------------------------------------
	void load(const XmlElement@ root) {
		DefPhaseArnhem::load(root);

		m_ch = root.getIntAttribute("ch");
		m_timer = root.getFloatAttribute("timer");
	}
};

// -------------------------------------------- this is the first attack post - commander chat
//artillery strike positions, west bridge: (513 9 505) (529 12 620)
//artillery strike positions, east bridge: (629 6 501)
//vehicles south of bridge: (507 10 877) (520 10 869)
// for Arnhem this will serve as a preliminary attack with mild armour, a "probe"
class DefPhase1Arnhem : DefPhaseArnhem {
	protected float m_timer = 0.0;
	protected int m_ch = 0;

	// --------------------------------------------
	DefPhase1Arnhem(GameModeInvasion@ metagame, PhaseController@ controller, float enemySpawnCompensationFactor) {
		super(metagame, controller, enemySpawnCompensationFactor);
	}

	// --------------------------------------------
	void start() {
		DefPhaseArnhem::start();
		_log("Phase1 starting");
		
		// set enemy soldier ai modifications
		/*
		// NOTE, this changed default soldier group as it is, and default soldier group is player-only, so it doesn't do anything
		m_metagame.getComms().send(
			"<command class='soldier_ai' faction='1'>\n" + 
			"  <parameter class='willingness_to_charge' value='0.35' />\n" +
			"</command>");
			*/

		if (m_loadingFromSave) {
			// trust that nothing needs to be re-set when loading from save
			return;
		}
		
		m_timer = 4.0 * 60.0;
		setVisualTimer(m_metagame, m_timer);
		
		m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem stage 1"));
		
		m_metagame.getComms().send("<command class='create_call' key='artillery2.call' position='513 9 505' faction_id='1' />");
		m_metagame.getComms().send("<command class='create_call' key='artillery2.call' position='529 12 620' faction_id='1' />");
		m_metagame.getComms().send("<command class='create_call' key='artillery2.call' position='629 6 501' faction_id='1' />");
		
		// set enemy commander ai
		m_metagame.getComms().send("<command class='commander_ai' faction='1' base_defense='0.17' border_defense='0.12' attack_start_spread='0' attack_target_spread='0' attack_target_base_key='bridge_north' />");

		/////////////////
		// EAST SPAWNS //
		/////////////////
		//m_metagame.getComms().send("<command class='create_instance' faction_id='1' position='460 6 185' instance_class='vehicle' instance_tag='jeep'/>");
	}
	
	protected void handleBaseOwnerChangeEvent(const XmlElement@ event) {
			// base_id
			// owner_id (faction)
			
		int owner = event.getIntAttribute("owner_id");		
		string baseKey = event.getStringAttribute("base_key");
		_log("base name is " + baseKey + " owned by " + owner);
		if (baseKey == "bridge_north") {
			// if this base changes owner, change things
			if (owner == 0) {
					//if Allies own Bridge North, Axis attack with a lot of force
						m_metagame.getComms().send("<command class='commander_ai' faction='1' base_defense='0.17' border_defense='0.12' attack_start_spread='0' attack_target_spread='0' attack_target_base_key='bridge_north' />");
			} else if (owner == 1) {
					//if Axis own Bridge North, Axis continue to attack but with less force
				// NOTE, clear attack request with attack_target_base_key='' to let commander control again
				m_metagame.getComms().send("<command class='commander_ai' faction='1' base_defense='0.4' border_defense='0.3' attack_start_spread='6' attack_target_spread='6' attack_target_base_key='' />");
				}
			}
	}

	// --------------------------------------------
	void update(float time) {
		m_timer -= time;
		if (m_timer < 0.0) {
			// done
			end();
		}
		
		if (m_timer < 240.0 and m_ch==0){
			m_ch++;
			spawn_probeSOUTH();
			spawn_crewSOUTH();
			spawn_crewSOUTH();
			/////////////////
			// EAST SPAWNS //
			/////////////////

			/////////////////
			// WEST SPAWNS //
			/////////////////
		}
		if (m_timer < 110.0 and m_ch==1){
			m_ch++;
			spawn_crewSOUTH();
			//spawn_crewSOUTH();
		}
	}

	// --------------------------------------------
	void end() {
		DefPhaseArnhem::end();
		clearVisualTimer(m_metagame);
	}

	// --------------------------------------------
	void save(XmlElement@ root) {
		DefPhaseArnhem::save(root);
		root.setIntAttribute("ch", m_ch);
		root.setFloatAttribute("timer", m_timer);
	}

	// --------------------------------------------
	void load(const XmlElement@ root) {
		DefPhaseArnhem::load(root);
		m_ch = root.getIntAttribute("ch");
		m_timer = root.getFloatAttribute("timer");
	}
};

// -------------------------------------------- second attack
// for arnhem this is a massive, full-on assault with preliminary bombardment and lots of Armour
//artillery strike positions, west bridge: (513 9 505) (529 12 620)
//artillery strike positions, east bridge: (629 6 501)
//vehicles south of bridge: (507 10 877) (520 10 869)
class DefPhase2Arnhem : DefPhaseArnhem {
	protected float m_timer = 0.0;
	protected int m_ch=0;

	// --------------------------------------------
	DefPhase2Arnhem(GameModeInvasion@ metagame, PhaseController@ controller, float enemySpawnCompensationFactor) {
		super(metagame, controller, enemySpawnCompensationFactor);
	}

	// --------------------------------------------
	void start() {
		DefPhaseArnhem::start();
		_log("Phase2 starting");
		
		// set enemy soldier ai modifications
		/*
		// NOTE, this changed default soldier group as it is, and default soldier group is player-only, so it doesn't do anything
		m_metagame.getComms().send(
			"<command class='soldier_ai' faction='1'>\n" + 
			"  <parameter class='willingness_to_charge' value='1.0' />\n" +
			"</command>");
			*/

		if (m_loadingFromSave) {
			// trust that nothing needs to be re-set when loading from save
			return;
		}

		m_timer = 8.0 * 60.0;
		setVisualTimer(m_metagame, m_timer);

		m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem stage 2"));
		
		m_metagame.getComms().send("<command class='create_call' key='artillery2.call' position='513 9 505' faction_id='1' />");
		m_metagame.getComms().send("<command class='create_call' key='artillery2.call' position='529 12 620' faction_id='1' />");
		m_metagame.getComms().send("<command class='create_call' key='artillery2.call' position='629 6 501' faction_id='1' />");

		/////////////////
		// SPAWNS //
		/////////////////
		m_metagame.getComms().send("<command class='create_call' key='wh_vehicle_sdkfz251_hidden.call' position='507 10 877' faction_id='1' />");		
		m_metagame.getComms().send("<command class='create_call' key='wh_vehicle_panzer_hidden.call' position='520 10 869' faction_id='1' />");		
		
		spawn_crewSOUTH();
		spawn_crewSOUTH();
		
		//m_metagame.getComms().send("<command class='update_base' base_key='eastern_redoubt' capturable='1' />");
		
		m_metagame.getComms().send("<command class='commander_ai' faction='1' base_defense='0.15' border_defense='0.1' attack_start_spread='0' attack_target_spread='0' attack_target_base_key='' />");
		
		m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem stage attacks increase 1"));
		m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem stage attacks increase 2"));
		m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem stage attacks increase 3"));
	}
	
	protected void handleBaseOwnerChangeEvent(const XmlElement@ event) {
			// base_id
			// owner_id (faction)
			
		int owner = event.getIntAttribute("owner_id");		
		string baseKey = event.getStringAttribute("base_key");
		_log("base name is " + baseKey + " owned by " + owner);
		if (baseKey == "bridge_north") {
			// if this base changes owner, change things
			if (owner == 0) {
					//if Allies own Bridge North, Axis attack with a lot of force
						m_metagame.getComms().send("<command class='commander_ai' faction='1' base_defense='0.17' border_defense='0.12' attack_start_spread='0' attack_target_spread='0' attack_target_base_key='bridge_north' />");
			} else if (owner == 1) {
					//if Axis own Bridge North, Axis continue to attack but with less force
				// NOTE, clear attack request with attack_target_base_key='' to let commander control again
				m_metagame.getComms().send("<command class='commander_ai' faction='1' base_defense='0.4' border_defense='0.3' attack_start_spread='6' attack_target_spread='6' attack_target_base_key='' />");
				}
			}
	}

	// --------------------------------------------
	void update(float time) {
		m_timer -= time;
		if (m_timer < 0.0) {
			// done
			end();
		}
		
		if (m_timer < 480.0 and m_ch==0){
			m_ch++;
			//spawn_CORE_Arnhem();
			spawn_crewSOUTH();
			spawn_crewSOUTH();
		}
		if (m_timer < 420.0 and m_ch==1){
			m_ch++;
			spawn_CORE_Arnhem();
		}
		if (m_timer <360 and m_ch==2) {
			m_ch++;
			//spawn_probeKGHQ();	//Germans shift away from Bridge and more to attack other zones
			m_metagame.getComms().send("<command class='commander_ai' faction='1' base_defense='0.15' border_defense='0.1' attack_start_spread='1' attack_target_spread='1' />");
			//m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem test info 3"));	//just to log when this happens
			//m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem test info 3"));	//just to log when this happens
			//m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem test info 3"));	//just to log when this happens
		}
		if (m_timer < 210.0 and m_ch==3){
			m_ch++;

						
			//m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem test info 1"));	//just to log when this happens
			//m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem test info 1"));	//just to log when this happens
			//m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem test info 1"));	//just to log when this happens
			{
				XmlElement command("command");
				command.setStringAttribute("class", "change_game_settings");
				
				command.setStringAttribute("soldier_capacity_model", "constant");

				// temporarily the Allies get a large boost to defenders; they will then be set to more normal values during counter-attack phase
				XmlElement f1("faction");
				f1.setFloatAttribute("capacity_multiplier", 1.5);	//was 1.5
				//f1.setFloatAttribute("ai_accuracy", 0.95);
				//f1.setIntAttribute("lose_without_bases", 1);
				command.appendChild(f1);

				XmlElement f2("faction");
				f2.setFloatAttribute("capacity_multiplier", 0.95);	//was 0.8
				//f2.setFloatAttribute("ai_accuracy", 0.85);
				//f2.setIntAttribute("lose_without_bases", 1);
				command.appendChild(f2);

				m_metagame.getComms().send(command);
			}
		}
		if (m_timer < 90.0 and m_ch==4){
			m_ch++;
			//spawn_probeKGHQ();
		}
	}

	// --------------------------------------------
	void end() {
		DefPhaseArnhem::end();
		clearVisualTimer(m_metagame);
	}

	// --------------------------------------------
	void save(XmlElement@ root) {
		DefPhaseArnhem::save(root);
		root.setIntAttribute("ch", m_ch);
		root.setFloatAttribute("timer", m_timer);
	}

	// --------------------------------------------
	void load(const XmlElement@ root) {
		DefPhaseArnhem::load(root);
		m_ch = root.getIntAttribute("ch");
		m_timer = root.getFloatAttribute("timer");
	}
};

// -- counterattack phase for Allies to take Arnhem
// --------------------------------------------
class DefPhase7Arnhem : DefPhaseArnhem {
	protected float m_timer = 0.0;
	// --------------------------------------------
	DefPhase7Arnhem(GameModeInvasion@ metagame, PhaseController@ controller, float enemySpawnCompensationFactor) {
		super(metagame, controller, enemySpawnCompensationFactor);
	}
	// --------------------------------------------
	void start() {
		DefPhaseArnhem::start();
		_log("Phase7 starting");
		
		// set enemy soldier ai modifications
		/*
		// NOTE, this changed default soldier group as it is, and default soldier group is player-only, so it doesn't do anything
		m_metagame.getComms().send(
			"<command class='soldier_ai' faction='1'>\n" + 
			"  <parameter class='willingness_to_charge' value='0.0' />\n" +
			"</command>");
			*/

		if (m_loadingFromSave) {
			// trust that nothing needs to be re-set when loading from save
			return;
		}

		m_timer = 2.0 * 60.0;
		//setVisualTimer(m_metagame, m_timer);
		
		array<Resource@> resources = { 
			Resource("artillery2.call", "call"),
			Resource("artillery3.call", "call") 
		};
		resetFactionCallResources(m_metagame, 0, resources, true, getCallSorting());
		
		m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem stage 7"));
		m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem stage 8"));
		
		// set enemy commander ai
		m_metagame.getComms().send("<command class='commander_ai' faction='1' base_defense='0.76' border_defense='0.21' attack_start_spread='4' attack_target_spread='4'/>");    // was 0.74 0.2

		// set enemy home base to capturable
		m_metagame.getComms().send("<command class='update_base' base_key='kampfgruppe_hq' capturable='1' />");
		m_metagame.getComms().send("<command class='update_base' base_key='bloody_block' capturable='1' />");
		m_metagame.getComms().send("<command class='update_base' base_key='residence_north' capturable='1' />");
		m_metagame.getComms().send("<command class='update_base' base_key='residence_east' capturable='1' />");
		m_metagame.getComms().send("<command class='update_base' base_key='residence_south' capturable='1' />");
		m_metagame.getComms().send("<command class='update_base' base_key='residence_west' capturable='1' />");
		m_metagame.getComms().send("<command class='update_base' base_key='industrial_park' capturable='1' />");
		
		//spawn a group to defend the Industrial Park as it's kinda important to have a fight here
		spawn_defenders_INDUSTRIAL();

		// set friendly commander ai
		m_metagame.getComms().send("<command class='commander_ai' faction='0' base_defense='0.35' border_defense='0.2' attack_start_spread='4' attack_target_spread='4'/>");   // was .25 .15
		
		
		m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem stage counterattack 1"));
		m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem stage counterattack 2"));
		m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem stage counterattack 3"));
		
		
		//m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem test info 2"));	//just to log when this happens
		//m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem test info 2"));	//just to log when this happens
		//m_metagame.getTaskSequencer().add(AnnounceTask(m_metagame, 5.0, 0, "arnhem test info 2"));	//just to log when this happens
		{
				XmlElement command("command");
				command.setStringAttribute("class", "change_game_settings");
				
				command.setStringAttribute("soldier_capacity_model", "constant");

				
				// a bit more for Player faction, but enemy Faction gets a lot more resources, since they are no longer reinforced with waves.
				XmlElement f1("faction");
				f1.setFloatAttribute("capacity_multiplier", 0.9);	// was 0.7
				//f1.setFloatAttribute("ai_accuracy", 0.95);
				//f1.setIntAttribute("lose_without_bases", 1);
				command.appendChild(f1);

				XmlElement f2("faction");
				f2.setFloatAttribute("capacity_multiplier", 1.25);	//was 1.55
				//f2.setFloatAttribute("ai_accuracy", 0.85);
				//f2.setIntAttribute("lose_without_bases", 1);
				command.appendChild(f2);

				m_metagame.getComms().send(command);
		}
	}

	// --------------------------------------------
	void update(float time) {
		m_timer -= time;
		if (m_timer < 0.0) {
			// done
			//end();	
		}
	}
	
	// --------------------------------------------
	void end() {
		DefPhaseArnhem::end();
		//clearVisualTimer(m_metagame);
	}

	protected void handleBaseOwnerChangeEvent(const XmlElement@ event) {
        // response to base owner change event in DefPhase7 checking when enemy has only one base left, and end DefPhase7
        if (getBasesForFaction(m_metagame, 1) == 1) {
           end();
		   //completeMatch();	//win
        }
    }

	// --------------------------------------------
	void save(XmlElement@ root) {
		DefPhaseArnhem::save(root);
		root.setFloatAttribute("timer", m_timer);
	}

	// --------------------------------------------
	void load(const XmlElement@ root) {
		DefPhaseArnhem::load(root);
		m_timer = root.getFloatAttribute("timer");
	}
};

// --------------------------------------------
class PhaseControllerArnhem : PhaseControllerBase {
	// --------------------------------------------
	PhaseControllerArnhem(GameModeInvasion@ metagame, float enemySpawnCompensationFactor) {
		super(metagame, "arnhem", enemySpawnCompensationFactor);
	}

	// --------------------------------------------
	void reset() {
		PhaseControllerBase::reset();
		
		m_phases.insertLast(DefPhase0Arnhem(m_metagame, this, m_enemySpawnCompensationFactor));	//commander chat & setup
		m_phases.insertLast(DefPhase1Arnhem(m_metagame, this, m_enemySpawnCompensationFactor));	//initial probing attack
		m_phases.insertLast(DefPhase2Arnhem(m_metagame, this, m_enemySpawnCompensationFactor));	//full on assault
		m_phases.insertLast(DefPhase7Arnhem(m_metagame, this, m_enemySpawnCompensationFactor));	//counter-attack
	}
}
