// --------------------------------------------
const Vector3 SOUTH_POSITION_1 = Vector3(479, 9, 893);
const Vector3 SOUTH_POSITION_2 = Vector3(498, 9, 904);
const Vector3 KG_HQ_POSITION = Vector3(267, 6, 177);
const Vector3 INDUSTRIAL_POSITION = Vector3(775, 8, 670);

//for Arnhem
//artillery strike positions, west bridge: (513 9 505) (529 12 620)
//artillery strike positions, east bridge: (629 6 501)
//vehicles south of bridge: (507 10 877) (520 10 869)
//infantry south of bridge: (479 9 893) (498 9 904)
//infantry KG HQ: (267 6 177)

// --------------------------------------------
class DefPhaseArnhem : DefPhaseBase {
	// --------------------------------------------
	DefPhaseArnhem(GameModeInvasion@ metagame, PhaseController@ controller, float enemySpawnCompensationFactor) {
		super(metagame, controller, enemySpawnCompensationFactor);
	}

	////////////
	// TIER 1 //
	////////////

	protected void spawn_probeSOUTH() {
		//replace spawn_less_compensation with just spawn if you need more compensated soldiers during a wave. the compensation VALUE is QUARTERED when _less is used.
		spawn(5, 1, SOUTH_POSITION_1, "regular"); //this group uses normal compensation for the time being, as an example
		spawn_less_compensation(1, 1, SOUTH_POSITION_1, "nco");
	}

	protected void spawn_probeKGHQ() {
		spawn(6, 1, KG_HQ_POSITION, "regular");
		spawn_less_compensation(1, 1, KG_HQ_POSITION, "nco");		
	}
	
	protected void spawn_crewSOUTH() {
		spawn_less_compensation(3, 1, SOUTH_POSITION_1, "regular");
		spawn_less_compensation(1, 1, SOUTH_POSITION_1, "nco");		
	}
	
	protected void spawn_crewKGHQ() {
		spawn_less_compensation(3, 1, KG_HQ_POSITION, "regular");
		spawn_less_compensation(1, 1, KG_HQ_POSITION, "nco");		
	}
	
	protected void spawn_defenders_INDUSTRIAL() {
		spawn(9, 1, INDUSTRIAL_POSITION, "regular");				
		spawn_less_compensation(1, 1, INDUSTRIAL_POSITION, "nco");		
	}
	
	////////////
	// TIER 2 //
	////////////
	
	protected void spawn_CORE_Arnhem() {
		spawn(4, 1, SOUTH_POSITION_2, KG_HQ_POSITION, "regular");
		spawn_less_compensation(1, 1, SOUTH_POSITION_2, KG_HQ_POSITION, "nco");
		spawn_less_compensation(1, 1, SOUTH_POSITION_2, KG_HQ_POSITION, "veteran");
	}
};


