	<dialogue key="wander dialogue 2 men">
		<comment text="Regarde cet endroit" />
		<comment text="C'est si calme" />
		<comment text="Je pourrais presque vivre ici" />
	</dialogue>

	<dialogue key="wander dialogue 2 men">
		<comment text="J'crois que je suis déjà venu par ici" />
	</dialogue>
  
	<dialogue key="wander dialogue 2 men">
		<comment text="On a besoin d'un peu d'action par ici" />
	</dialogue>  

	<dialogue key="wander dialogue 2 men">
		<comment text="Je me sens invincible aujourd'hui" />
	</dialogue>
  
	<dialogue key="wander dialogue 2 men">
		<comment text="Rejoignez l'armée qu'ils disaient, ça sera amusant qu'ils disaient..." />
	</dialogue>  
  
	<dialogue key="wander dialogue 2 men">
		<comment text="Si j'avais su combien on marcherait, j'aurais rejoins l'armée de l'air" />
	</dialogue>    

	<dialogue key="defense dialogue 2 men">
		<comment text="Tu vas obtenir une promotion bientôt ?" />
		<comment text="J'pense pas" />
	</dialogue>
  
  <dialogue key="wander dialogue 2 men">
      <comment text="Tu veux voir quelque chose de cool ?" />
      <comment text="Erf, j'vais pas tomber de nouveau dans le panneau ..." />
   </dialogue> 

	<dialogue key="defense dialogue 2 men">
		<comment text="Tu sais, on était derrière les lignes ennemies, le Sergent et moi" />
		<comment text="Donc, tu as rejoint une escouade furtive ?" />
		<comment text="Ouais, on a localisé un camion de transport aussi" />
		<comment text="Wouah, c'est génial mec" />
		<comment text="Faire du repérage sur le territoire ennemi vaut mieux que de perdre du temps ici" />
		<comment text="Au moins on vit plus longtemps par ici, hein" />
		<comment text="Comme si c'était une excuse pour ne pas partir au combat" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Ne dis pas à ma mère que je suis dans l'armée" />
		<comment text="Pourquoi donc ?" />
		<comment text="Elle pense que je joue du piano dans un bordel ..." />
		<comment text="Oh, ok" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="T'as des clopes ?" />
		<comment text="Nan j'en ai plus, je ne savais pas que tu fumais" />
		<comment text="Je ne fume pas, je veux les échanger contre une nouvelle arme" />
		<comment text="Qu'est-ce qui ne va pas avec ton arme actuelle ?" />
		<comment text="Je pense que j'ai mis trop de sable à l'intérieur" />
		<comment text="Tu dois juste la nettoyer à fond" />
		<comment text="Bah, ils n'ont plus de cotons de nettoyage à l'armurerie" />
		<comment text="C'est incroyable" />
		<comment text="Ils ont des dizaines d'armes mais aucun moyen de les garder fonctionnelles" />
		<comment text="C'est comme s'ils ne croient pas que nous allons survivre assez longtemps pour avoir à les nettoyer" />
		<comment text="Tu pourrais avoir raison" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Aucun signe de ce camion de communication ?" />
		<comment text="Non mais je suis quasiment sûr qu'il n'est pas là" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Tu sais quoi? J'ai trouvé du whisky et je l'ai caché dans ma piaule" />
		<comment text="Chut, pas si fort! Tu n'es pas censé le garder" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="J'ai réfléchis récemment ..." />
		<comment text="Quoi donc?" />
		<comment text="Euh, zut j'ai oublié" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Chef ? On ne fait rien ?" />
		<comment text="Ne remet pas les ordres en question. Remettre les ordres en question te mènera à la mort" />
		<comment text="Oui chef"/>      
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="J'sais pas si je devrais rejoindre le choeur de l'armée" />
		<comment text="Pourquoi pas ?" />
		<comment text="Eh bien, la dernière fois que j'ai rejoins un choeur, c'était le choeur de l'église"/>  
		<comment text="Et ?" /> 
		<comment text="200 personnes ont changé de religion ..." />           
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
		<comment text="C'est bien que l'ennemi ne nous attaque pas par derrière ..." />
		<comment text="Oui, on ne serait pas prêt pour ça" />
	</dialogue>   
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="" />
		<comment text="" />
	</dialogue> 
  
	<dialogue key="defense dialogue 2 men">
		<comment text="J'ai récemment eu un échange de tirs avec les devs" />
		<comment text="Tu veux dire Pasik et JackMayol ?" />
    <comment text="Ouais, Pasik vise comme une grand-mère mais JackMayol c'est encore pire !" />
	</dialogue>     

	<dialogue key="defense dialogue 2 men">
		<comment text="'Osumia Games'... d'où sortent de tels noms ?" />
		<comment text="Attends, tu parles de quoi là ?" />
    <comment text="Même moi je ne sais pas" />
	</dialogue>  

	<dialogue key="defense dialogue 2 men">
		<comment text="Par moment j'ai l'impression qu'on est juste en train de courir avec des fusils ici" />
		<comment text="Tu pourrais être sur une piste" />
	</dialogue>  

	<dialogue key="vehicle dialogue 2 men">
		<comment text="Aïe, mon orteil !" />
		<comment text="Désolé camarade" />
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Le jeu est sorti ?" />
		<comment text="Bien sûr, sur Steam !" />
		<comment text="Parfait !" />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men tag=truck" >
		<comment text="Mec, t'as pêté ?" />
		<comment text="Peut-être" />
		<comment text="Roooh, ouvre la fenêtre !" />    
	</dialogue>    

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Tu sais quoi ?" />
		<comment text="Hmm ?" />
		<comment text="Je crois que je t'aime" />   
		<comment text="Arrête ça tout de suite ..." />     
	</dialogue> 

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Où est-ce que tu as eu ton permis ?" />
		<comment text="Ta mère me l'a donné" />
	</dialogue> 

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Hit me baby one more tiiiime" />
		<comment text="Avec plaisir si tu continues de chanter !" />
	</dialogue>
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Je ne me sens pas en sécurité dans cette caisse" />
		<comment text="Pourquoi ça ?" />      
		<comment text="Regarde les roues" />
		<comment text="Qu'est-ce qu'elles ont les roues ?" />
		<comment text="Elles ne sont même pas connectées aux essieux" />    
	</dialogue>  

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="J'aimerai écouter la radio ..." />
		<comment text="grave !" />
	</dialogue> 
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="J'ai toujours eu peur d'être assigné dans la même escouade que toi" />
		<comment text="Qu'est-ce qu'il y a de mal à cela ?" />
		<comment text="Les objets étranges attirent le feu et tu es étrange..." />    
	</dialogue> 
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Le succès arrive toujours quand personne ne regarde" />
		<comment text="L'échec, arrive quand le commandant regarde ..." />
	</dialogue> 
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Méfie-toi des grenades AT" />
		<comment text="Ouais, elles font plus de dégâts que les grenades à fragmentation" />
		<comment text="Heureusement, elles ont un rayon d'impact plus petit" />    
	</dialogue> 

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="" />
		<comment text="" />
	</dialogue>  

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Un peu plus de vraies filles dans l'armée ne ferait pas de mal" />
		<comment text="C'est vrai, ça aiderait pour les hormones" />
		<comment text="Non, je n'ai pas dis ça pour ça ..." />
		<comment text="Mh ?" /> 
		<comment text="Nous aurions quelqu'un pour le repassage, la cuisine et le nettoyage" />               
	</dialogue>   

	<dialogue key="vehicle dialogue 2 men">
		<comment text="Ils auraient pu ajouter un peu plus de polygones là" />
		<comment text="Pourquoi ça ?" />
		<comment text="Les sièges sont pas assez arrondis ..." />    
	</dialogue> 

	<dialogue key="vehicle dialogue 2 men">
		<comment text="C'est dur dur d'être bébé *chante*" />
		<comment text="Tu devrais devenir chanteur" />
		<comment text="Vraiment ? T'es sérieux ?" /> 
		<comment text="Ouais, comme ça on aurait pas à t'écouter toute la journée" />    
	</dialogue> 

	<dialogue key="vehicle dialogue 2 men">
		<comment text="Ils t'ont donné du nouvel équipement ?" />
		<comment text="Ouais" />
		<comment text="Arf, c'est injuste ..." /> 
   	<comment text="You mad bro ?" />    
	</dialogue> 

	<dialogue key="vehicle dialogue 2 men">
		<comment text="Tu peux bouger un petit peu ?" />
		<comment text="Non" />
		<comment text="Merci" />
		<comment text="Pas de quoi !" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men">
		<comment text="Un jour sans soleil est comme, tu sais ... la nuit" />
		<comment text="Merci, tu m'as ouvert l'esprit" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men">
		<comment text="Tu connais les prévisions météo pour ce soir ?" />
		<comment text="Oui, il fera nuit" />
		<comment text="..." />
  </dialogue>

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Je souhaiterais que plus de gens jouent en pvp" />
		<comment text="Pourquoi ?" />
		<comment text="Ils nous laisseraient, nous les bots, en vie" />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="En cas de doute, videz votre chargeur" />
		<comment text="Oui chef !" />
	</dialogue>   
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="J'ai une idée" />
		<comment text="Oublie, un plan parfait n'existe pas" />
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Vous êtes chauds les gars ?!" />
		<comment text="Chef, oui chef !" />
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="N'oubliez pas ce que je vous ai dit ce matin !" />
		<comment text="Oui chef !" />
		<comment text="Si notre attaque marche trop bien, c'est une embuscade !" />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Je pense que le plan est stupide" />
		<comment text="S'il est stupide et qu'il marche, alors il n'est pas stupide" />
	</dialogue>   
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Que faisons-nous si tout échoue ?" />
		<comment text="On fait appel aux gros canons de la marine" />
	</dialogue>  

  <dialogue key="vehicle dialogue 2 men">
      <comment text="Alors, c'est quand la dernière fois que tu as conduit ?" />
      <comment text="Euh, c'est ma première fois là" />
      <comment text="Alors qu'est-ce tu fiches à la place du conducteur ?!" />
      <comment text="..." />
      <comment text="Tu vas me faire tuer avant d'atteindre les lignes de front" />
  </dialogue>
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="" />
		<comment text="" />
	</dialogue>  
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Il y a 2 règles principales à l'armée" />
		<comment text="Qui sont ?" />
		<comment text="#1: Le commandant a toujours raison" />
		<comment text="#2: Si le commandant a tort, révisez la règle #1" />        
	</dialogue>           

	<dialogue key="vehicle dialogue 2 men tag=campfire">
		<comment text="Mes pieds brûlent" />
		<comment text="Recule alors" />
		<comment text="Je ne peux pas" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="J'adore ce char" />
		<comment text="Tais toi bordel" />
		<comment text="J'peux pas" />
	</dialogue>

  <dialogue key="vehicle dialogue 2 men tag=tank">
      <comment text="On va donner un nom à ce char ?" />
      <comment text="Pourquoi tu veux faire ça ?" />
      <comment text="Ben, nous allons l'avoir pendant un certain temps, donc ..." />
  </dialogue>

	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="La meilleure armure, c'est de rester hors de portée" />
		<comment text="Petit malin" />
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="This is Spartaaaaa !" />
		<comment text="..." />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="Préparez vous à bouffer de l'acier !" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="Le meilleur terrain pour un char, c'en est un sans armes anti-chars" /> 
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="Tout problème peut être résolu par des explosifs" /> 
	</dialogue>  
  
  <dialogue key="vehicle dialogue 2 men tag=tank">
      <comment text="QUOI, Pourquoi il y a un chat dans le tank ?!" />
      <comment text="La vision nocturne est cassée, voilà pourquoi" />
  </dialogue> 
   
  <dialogue key="vehicle dialogue 2 men tag=tank">
      <comment text="Tu sais pourquoi on appelle l'infanterie : craquants ?" />
      <comment text="Négatif. Pourquoi ?" />
      <comment text="C'est le bruit qu'ils font quand on les écrase" />
  </dialogue>    
              
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Aie" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Je pense que je vais être malade" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="J'suis pas sûr si le gars sait par où passer" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="On est bientôt arrivé ?" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="zzZZZzzzzZz" />
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="lol, ton visage !" />
		<comment text="Quoi ?" />
		<comment text="Il est plein de voxels" />     
	</dialogue>  
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="J'adore dans les films d'horreur comment les gens crient 'y'a quelqu'un ?'" />
		<comment text="Comme si le tueur disait 'ouais j'suis dans la cuisine, tu veux un sandwich ?'" />   
	</dialogue>  
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="J'aimerais que le joueur puisse voir à l'intérieur de ces véhicules" />
		<comment text="Ouais, aucun détail du tout" /> 
		<comment text="Parresseux développeurs !" />         
	</dialogue>     

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="" />
	</dialogue>  

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="" />
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Je me sentirais plus en sécurité en dehors de cette caisse" />
	</dialogue>  

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Imagine une pizza" />
		<comment text="Ou une glace" />
		<comment text="Ou un poulet rôti" />
		<comment text="Ou une salade de tofu" />
		<comment text="Quoi ?!" />                
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Hé mec, t'as bouffé un cimetière ce matin ?" />
		<comment text="Désolé, j'ai perdu mon dentifrice la semaine dernière" />    
	</dialogue>  
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Hein?  Il sert à quoi ce bouton vert ?" />
		<comment text="Euh ... à rien ..." />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Hé, pourrais-tu redémarrer le jeu s'il te plaît ?" />
		<comment text="Qu'est-ce qu'il se passe ?" /> 
		<comment text="J'suis bloqué dans une texture" />        
	</dialogue>       
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Tu ferais mieux de porter ton casque à la place de ce bandeau rouge" />
		<comment text="T'as raison, mais ça fait plus méchant" />    
		<comment text="Cela ne va certainement pas intimider une balle ..." />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Ca pue trop la transpiration de pieds voxelisés là-dedans !" /> 
	</dialogue>    
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Tu veux un chewing gum ?" /> 
		<comment text="Non merci" /> 
		<comment text="Nous sommes tous sûr que t'en veux un" />
		<comment text="Hein, qu'est-ce que tu veux dire ...?" />
		<comment text="Tu as deviné, mon pote! " />                
	</dialogue> 
  
  <dialogue key="vehicle dialogue 2 men tag=truck">
     <comment text="Tu te souviens de ce film où les chauffeurs de camions sauvent le monde ?" />
     <comment text="Nope" />
     <comment text="Ouais, moi non plus. On va tous mourir" />
  </dialogue>  
          

	<dialogue key="defense dialogue 2 men">
		<comment text="Je suis sûr que je vais obtenir une promotion dans pas longtemps" />
		<comment text="Il suffit de ne pas se faire tuer avant !" />
		<comment text="Merci mec, t'es vraiment rassurant toi !" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Je me sens si bien, mec" />
	</dialogue>
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Je me sens comme si j'étais réapparu 100 fois aujourd'hui" />
    <comment text="Ouais, moi pareil" />  
    <comment text="Imagine ça dans la vraie vie" />
    <comment text="haha" />           
	</dialogue>
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Les vieux lors des mariages me disent souvent 'tu seras le prochain'" />
    <comment text="Il faut juste que tu dises la même chose avec eux lors des funérailles" />     
	</dialogue>    
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Ces télévendeurs sont tellement chiants ..." />
    <comment text="Donne le téléphone à ta fille et dis que c'est le père-Noël" />     
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
		<comment text="J'ai fais un cauchemar étrange la nuit dernière" />
    <comment text="Comment ?" />   
    <comment text="Il y avait des 1 et des 0 partout" />
    <comment text="Quel est le problème alors ?" />
    <comment text="Et soudainement j'ai vu un 2 !" />
    <comment text="Oh mon dieu !" />          
	</dialogue>   
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Ma femme dit que je suis laid, mon affaire dit que je suis joli" />
    <comment text="Et alors ?" /> 
    <comment text="Ben tu penses quoi toi ?" />
    <comment text="Hmm ta femme et moi avons toujours eu les même goûts" />    
    <comment text="Aller, tu pourrais pas être sérieux pour une fois ?" /> 
    <comment text="Crois moi, je le suis ..." />              
	</dialogue>      

	<dialogue key="defense dialogue 2 men">
		<comment text="Mec, tu parles beaucoup" />
    <comment text="C'est une tradition de famille" /> 
    <comment text="Qu'est-ce que tu veux dire ?" />
    <comment text="Mon grand-père était vendeur ambulant, mon père était prof" />    
    <comment text="Et ta mère ?" /> 
    <comment text="C'est une femme" />              
	</dialogue>   

	<dialogue key="defense dialogue 2 men">
		<comment text="Comment je peux transmettre ces nouvelles à mon père ?" />
    <comment text="Quelles nouvelles tu veux dire ?" /> 
    <comment text="Que j'ai pas réussi à être promu" />
    <comment text="Envoie lui un télégramme" />    
    <comment text="Et ?" /> 
    <comment text="'Même performance que l'année dernière" />              
	</dialogue>  

	<dialogue key="defense dialogue 2 men">
		<comment text="Je suis heureux que les devs ne mettent pas de véhicules aériens" />
		<comment text="Hm ouais, une inconnue de moins à se soucier" /> 
    <comment text="Yep, pas besoin de nous soucier de ce qui vient d'en haut" />          
    <comment text="Outre l'artillerie, le mortier et ... arghhhhh !" />
    <comment text="Hahaha et la merde de pigeon !" /> 
    <comment text="Arf!" />                                    
	</dialogue>     

	<dialogue key="defense dialogue 2 men">
    <comment text="Les soldats professionnels sont prévisibles" />  
    <comment text="Mais ce monde est plein d'amateurs dangereux" />                                      
	</dialogue> 
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Ils parlent sans cesse d'intelligence militaire" />  
    <comment text="Qu'est-ce qu'il y a de mal à ça ?" />
    <comment text="L'intelligence militaire est une contradiction" /> 
    <comment text="Bah parle pour toi, gros !" />                                            
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
    <comment text="J'aimerais tellement pouvoir voir aussi loin que le joueur" />  
    <comment text="Joueur ?" />
    <comment text="Oui le mec tout moche qui nous mate derrière son écran" /> 
    <comment text="En effet, c'est une sorte de tricherie" /> 
    <comment text="Et j'peux plus supporter sa tête à claques !" />                                               
	</dialogue>    

	<dialogue key="defense dialogue 2 men">
    <comment text="Si tu as un conflit de personnalité avec ton supérieur" />  
    <comment text="hm ?" />
    <comment text="Il a la personnalité, tu as le conflit" />                                       
	</dialogue>   

	<dialogue key="defense dialogue 2 men">
    <comment text="Plus ton chef est stupide, plus ses missions sont importantes" />  
    <comment text="Tu as tellement raison" />                                     
	</dialogue>  

	<dialogue key="defense dialogue 2 men">
    <comment text="Il y a toujours un chemin pour tout" />  
    <comment text="Qui ne mène généralement nul part" />                                     
	</dialogue>  

	<dialogue key="defense dialogue 2 men">
    <comment text="T'as vu la nouvelle femme du commandant ?" />  
    <comment text="Tu veux dire la meuf avec le grand nez ?" /> 
    <comment text="Oui, avec un tel pif elle pourrait même fumer sous la douche" />                                         
	</dialogue> 

	<dialogue key="defense dialogue 2 men">
    <comment text="C'est vrai que l'homme descend du singe ?" />  
    <comment text="Oui, les soldats probablement. Mais pas les sergents" />                                     
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Il y a une fille déguisée en homme qui a récemment rejoint l'armée" />  
    <comment text="Elle devra s'habiller et se doucher avec les garçons, non ?" /> 
    <comment text="Bien sûr" />  
    <comment text="Ca devrait vite aller aux oreilles des supérieurs" /> 
    <comment text="Qui la dénoncerait ?" />                                             
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Pourquoi avons-nous besoin d'avoir des bombes encore plus chères ?" />  
    <comment text="Va comprendre..." /> 
    <comment text="Les gens que nous avons bombardés au fil des années se sont-ils plaint ?" />                                        
	</dialogue>      
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Pourquoi nos propres gars reculent ces derniers jours ?" />  
    <comment text="Ils ne battent pas en retraite, ils vont juste dans le mauvais sens" />  
    <comment text="oh ok" />                                       
	</dialogue>  

	<dialogue key="defense dialogue 2 men">
    <comment text="T'as pas besoin d'être straight pour rejoindre l'armée" />  
    <comment text="Merci pour ton soutien, mec" />                                     
    <comment text="Tu as juste à tirer droit" />
	</dialogue>     
  
	<dialogue key="defense dialogue 2 men">
    <comment text="La guerre est une façon à Dieu d'enseigner la géographie aux ignorants" />  
    <comment text="Tellement vrai" />                                     
	</dialogue> 
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Ne jamais interrompre votre ennemi quand il fait une erreur" />  
    <comment text="" />                                     
	</dialogue>    

	<dialogue key="defense dialogue 2 men">
    <comment text="Il y a tellement d'objets de valeur qui traînent sur le champ de bataille" />  
    <comment text="Et la plupart des soldats s'en foutent" /> 
    <comment text="Les vendre à l'armurerie vaut pourtant tellement le coup !" />                                         
	</dialogue> 

	<dialogue key="defense dialogue 2 men">
    <comment text="Je dois être très concentré aujourd'hui" />  
    <comment text="T'as quelque chose de spécial de prévu ?" /> 
    <comment text="Peut-être qu'un youtubeur sort une vidéo aujourd'hui" />
    <comment text="Et tu veux lui mettre des bâtons dans les roues ?" /> 
    <comment text="C'est mon plan, oui" />                                                
	</dialogue>  

  <dialogue key="defense dialogue 2 men">
      <comment text="Hé, je me demandais" />
      <comment text="Quoi ?" />
      <comment text="Notre renfort, d'où vient-il ?" />
      <comment text="Comment ça ?" />
      <comment text="Eh bien, ils ne semblent pas venir de transports ou quoi que ce soit" />
      <comment text="T'es en train de me dire qu'ils apparaissent comme la vierge Marie ?" />
  </dialogue>

  <dialogue key="defense dialogue 2 men">
      <comment text="Tu viens de larguer une caisse ?" />
      <comment text="Hé hé!" />
      <comment text="Tu me dégoûtes !" />
      <comment text="Chef, oui chef !" />
  </dialogue>
   
  <dialogue key="defense dialogue 2 men">
      <comment text="Ils ne nous paient pas assez pour ça, je trouve" />
      <comment text="Pas assez pour devoir voir ton visage, mec" />
      <comment text="Quoi ? C'est une blague ?" />
      <comment text="Oh, j'aimerais que ça le soit" />
  </dialogue>   
  
	<dialogue key="defense dialogue 2 men">
    <comment text="" />  
    <comment text="" />                                     
	</dialogue> 
  
