	<comment key="fighting near a base" text="Renforts demandés à proximité de %base_name" />
	<comment key="fighting near a base" text="Coups de feu à proximité de %base_name" />

	<comment key="defense timer started" text="%faction_name contrôle toutes les bases, %time_left secondes restantes !" />
