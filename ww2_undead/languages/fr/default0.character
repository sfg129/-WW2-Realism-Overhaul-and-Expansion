	<comment key="we have lost our last base" text="Nous avons perdu notre dernière base - La bataille est perdue !" />
	<comment key="enemy has lost their last base" text="%faction_name ont perdu!" />
	
	<comment key="our assault ran out of time" text="Notre assaut a dépassé le temps requis - La bataille est perdue !" />
	<comment key="enemy assault ran out of time" text="%faction_name ont perdu !" />

	<comment key="we won by map conquer" text="Notre faction est victorieuse, nous avons capturé toutes les bases !" />
	<comment key="we won by defense timer" text="Notre faction est victorieuse !" />

