	<comment key="enemy vehicle spotted, near base" text="%vehicle_name des %enemy_name près de %base_name" />
	<comment key="enemy vehicle spotted, not near base" text="%vehicle_name des %enemy_name repéré" />

	<comment key="comms have been restored" text="La communication radio a été restaurée" />
	<comment key="enemy comms have been restored" text="La communication radio des %enemy_name a été entièrement restaurée" />

	<comment key="comms have been destroyed" text="La communication radio a été sabotée par l'ennemi" />
