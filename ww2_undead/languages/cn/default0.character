  <comment key="grenade alert, grenade tag = rocket" text="火箭弹！" />
  <comment key="enemy not seen, area alerted" text="找掩护" />
  <comment key="enemy not seen, area alerted" text="保持警惕" />
  <comment key="Lone leader, enemy not seen, area alerted" text="我得谨慎前行" />
  <comment key="leader, enemy not seen, taking suppressed fire" text="隐蔽！" />
  <comment key="leader, enemy not seen, taking suppressed fire" text="火力来袭！" />
  <comment key="Lone leader, enemy not seen, taking suppressed fire" text="我知道你在这！" />
  <comment key="Lone leader, enemy not seen, taking suppressed fire" text="火力来袭！" />
  <comment key="Lone leader, enemy not seen, taking suppressed fire" text="该死！" />
  <comment key="Lone leader, enemy not seen, taking suppressed fire" text="！" />
  <comment key="Lone leader, enemy not seen, taking suppressed fire" text="胆小鬼！" />
  <comment key="Lone leader, enemy not seen, taking suppressed fire" text="" />
  <comment key="Lone leader, enemy not seen, taking suppressed fire" text="" />
  <comment key="enemy seen, vehicle tag = tank" text="大家伙来了！" />
  <comment key="enemy seen, vehicle tag = apc" text="前方有步战车！" />
  <comment key="enemy seen, vehicle tag = apc" text="前方有步战车！炸了它！" />
  <comment key="enemy seen, vehicle tag = apc" text="发现步战车！" />
  <comment key="enemy seen, vehicle tag = apc" text="发现步战车！" />
  <comment key="enemy seen, vehicle tag = apc" text="步战车！小心！" />
  <comment key="enemy seen, vehicle tag = apc" text="步战车！士兵们打烂它！" />
  <comment key="enemy seen" text="在那！" />
  <comment key="enemy seen" text="警报！" />
  <comment key="enemy seen" text="遇敌！" />

  <comment key="enemy not seen, taking suppressed fire" text="？" />
  <comment key="enemy not seen, taking suppressed fire" text="那是什么？" />
  <comment key="enemy not seen, taking suppressed fire" text="警报！" />
  <comment key="enemy not seen, taking suppressed fire" text="火力来袭！" />
  <comment key="Waiting for reinforcements" text="等援军过来"/>
  <comment key="Waiting for reinforcements" text="我们在这等会吧" />
  <comment key="Hold on!" text="挺住！" />
  <comment key="Hold on!" text="坚持住！" />
  <comment key="Hold on!" text="我马上就来！" />
  <comment key="Hold on!" text="坚持下去！" />
  <comment key="Move out" text="出发" />
  <comment key="Move out" text="我们走" />
  <comment key="Move out" text="跟我来" />
 
  <comment key="All quiet here" text="这里静悄悄的" />
  <comment key="All quiet here" text="这里一切正常" />
  <comment key="All quiet here" text="*打哈欠*" />
  <comment key="All quiet here" text="那里没有人" />
  <comment key="All quiet here" text="*吹口哨*" />
  <comment key="All quiet here" text="暴风雨前的宁静？" />
  <comment key="All quiet here" text="没有他们的踪迹" />
  <comment key="All quiet here" text="再有两个星期..." />
  <comment key="Yes sir" text="是的长官" />
  <comment key="Yes sir" text="已上路" />
  <comment key="Yes sir" text="OK" />
  <comment key="Yes sir" text="马上就到" />
  <comment key="Yes sir" text="明白" />
  <comment key="Yes sir" text="收到" />
  <comment key="Yes sir" text="了解" />
  <comment key="Uh, I can't drive this thing" text="额，我驾驭不了这个玩意" />
  <comment key="Uh, I can't drive this thing" text="回驾校再学学，嗯？" />
  <comment key="Uh, I can't drive this thing" text="艾玛！" />
  <comment key="Uh, I can't drive this thing" text="见鬼！" />
  <comment key="Uh, I can't drive this thing" text="我打赌机轴坏了" />
  <comment key="Uh, I can't drive this thing" text="我敢肯定汽化器坏了" />
  <comment key="Uh, I can't drive this thing" text="我确信这个方向盘不能用了" />
  <comment key="Uh, I can't drive this thing" text="啊，原来这就是离合器啊" />
  <comment key="Uh, I can't drive this thing" text="真希望我不用开车" />
  <comment key="Uh, I can't drive this thing" text="哎哟！" />
  <comment key="Uh, I can't drive this thing" text="哎哟，再来一遍！" />
  <comment key="Uh, I can't drive this thing" text="有谁想试试开车吗？" />
  <comment key="Uh, I can't drive this thing" text="把近视镜给我" />
  <comment key="Uh, I can't drive this thing" text="额，方向盘好像倒了" />
  <comment key="Uh, I can't drive this thing" text="这不是我的错" />
  <comment key="Waiting for squad" text="等下队员" />
  <comment key="Waiting for squad" text="上车吧，快点！" />
  <comment key="Shield up" text="竖盾" />
  <comment key="Shield up" text="防御" />
  <comment key="Shield up" text="" />
  <comment key="overencumbered" text="该死的背包！" />
  <comment key="overencumbered" text="不能背着这么重的东西准确射击" />
  <comment key="overencumbered" text="我应该减轻背包的重量" />
  <comment key="Where to, chief?" text="去哪，头儿？" />
  <comment key="Where to, chief?" text="特地去哪吗?" />
  <comment key="Where to, chief?" text="听候吩咐" />
  <comment key="Where to, chief?" text="等待命令" />
  <comment key="Press SPACE to continue!" text="按 空格键 以继续" />

  <comment key="about to drive over a friendly" text="当心！" />
  <comment key="about to drive over a friendly" text="让开！" />
  <comment key="this is as close as i can get" text="我只能接近这么多了" />
  <comment key="this is as close as i can get" text="不能再靠近了" />
  <comment key="enemy vehicle spotted, near base" text="在&#37;base_name附近发现敌军&#37;enemy_name的&#37;vehicle_name" />
  <comment key="enemy vehicle spotted, not near base" text="发现敌军&#37;enemy_name的&#37;vehicle_name" />
  <comment key="comms have been restored" text="已恢复通讯" />
  <comment key="enemy comms have been restored" text="敌军&#37;enemy_name通讯已经完全恢复" />
  <comment key="comms have been destroyed" text="我方通讯被敌军破坏" />
  <comment key="enemy comms have been destroyed, by us" text="做得好，敌军&#37;enemy_name的通讯被破坏！" />
  <dialogue key="wander dialogue 2 men">
    <comment text="看看这个地方" />
    <comment text="太平静了" />
    <comment text="我都想住这了" />
  </dialogue>
  <dialogue key="wander dialogue 2 men">
    <comment text="我想我以前来过这里" />
  </dialogue>
  <dialogue key="wander dialogue 2 men">
    <comment text="我们需要在这采取一些行动" />
  </dialogue>
  <dialogue key="wander dialogue 2 men">
    <comment text="我感觉今天战无不胜" />
  </dialogue>
  <dialogue key="wander dialogue 2 men">
    <comment text="他..他们说参..参军，很..很有趣..趣" />
  </dialogue>
  <dialogue key="wander dialogue 2 men">
    <comment text="要是知道我会走这么远的路，我宁愿加入海军" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="你快升官了吗？" />
    <comment text="你想多了" />
  </dialogue>
  <dialogue key="wander dialogue 2 men">
    <comment text="想看看很酷东西吗?" />
    <comment text="别闹了，我不会再上当了" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="你懂的，我们曾经深入敌后，只有军士长和我" />
    <comment text="所以你加入了一个潜行小队?" />
    <comment text="那是，还发现了一辆运货卡车" />
    <comment text="喔，兄弟你太牛了" />
    <comment text="侦察敌方领土肯定比在这里浪费时间好" />
    <comment text="至少在这我们活得更长，嗯" />
    <comment text="好像是这么回事" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="不要跟我妈说我在军队中" />
    <comment text="为什么这么说？" />
    <comment text="她以为我还在妓院弹钢琴" />
    <comment text="哦哦好..." />
  </dialogue>

  <dialogue key="defense dialogue 2 men">
    <comment text="有烟吗?" />
    <comment text="没了，我不知道你抽烟" />
    <comment text="我不抽，我只是想拿来换一把新枪" />
    <comment text="你现在的枪怎么了?" />
    <comment text="我想它里面进了太多沙子了" />
    <comment text="你应该彻底清理一下它" />
    <comment text="嗯，但军械库里面好像没有清洁棉" />
    <comment text="真不敢相信" />
    <comment text="他们有一堆武器但是没法保证它们的性能" />
    <comment text="可能他们觉得我活不到保养武器的时候" />
    <comment text="你说的有点道理" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="有任何通讯车的迹象没？" />
    <comment text="没有，但是我确定它不在这里" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="你知道吗？我发现了一些威士忌并藏了起来" />
    <comment text="嘘，小点声，你不应该留着它" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="我一直在想..." />
    <comment text="想什么？" />
    <comment text="额，突然忘了" />
  </dialogue>

  <dialogue key="defense dialogue 2 men">
    <comment text="长官？为什么我们什么事都不做？" />
    <comment text="不要质疑命令孩子，质疑命令会被杀的" />
    <comment text="是，长官！" />
  </dialogue>

  <dialogue key="defense dialogue 2 men">
    <comment text="我不太确定应不应该加入军队的合唱团" />
    <comment text="为什么不呢？" />
    <comment text="是这样的，上次我加入的是教堂的合唱团" />
    <comment text="然后呢？" />
    <comment text="200个人改变了他们的宗教信仰" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="敌人没有偷袭我们真是太好了" />
    <comment text="是啊，我们可能还没对他们的偷袭做好准备" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="'Modulaatio Games'... 这游戏公司名字听起来真别扭" />
    <comment text="哈哈，是啊" />
    <comment text="他们可能'A'键按了半天" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="我最近在游戏里碰到了游戏开发者" />
    <comment text="你是说Pasik和JackMayol么？" />
    <comment text="是的，Pasik的瞄准就跟个老太太似的，但JackMayol比他还差劲！" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="'Osumia Games'... 谁提出来的这个名字？" />
    <comment text="等会儿，嘛玩儿？你说的嘛？" />
    <comment text="我也不知道自己说的嘛" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="有时候我真的感觉我们只是带着枪跑来跑去" />
    <comment text="被你发现了" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="哎哟，你轧我脚了！" />
    <comment text="应该轧你嘴" />
  </dialogue>
<dialogue key="vehicle dialogue 2 men">
    <comment text="这个游戏发售了吗？" />
    <comment text="是的，在Steam平台发售了！" />
    <comment text="太棒了" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="哥们儿，你放屁了？" />
    <comment text="可能吧" />
    <comment text="我去！快把窗户开开！" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="你知道吗？" />
    <comment text="嗯？" />
    <comment text="我想我爱你" />
    <comment text="滚犊子..." />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="你在哪拿的驾照？" />
    <comment text="你妈给我的" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Hit me baby one more tiiiime~~" />
    <comment text="好嘞！*啪*" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="我觉得在这里不安全" />
    <comment text="为什么？" />
    <comment text="看看车轮" />
    <comment text="有什么问题吗？" />
    <comment text="他们根本没有连在车轴上！" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Sure可能会喜欢听广播" />
    <comment text="确实" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="总怕和你分到同一个小队里" />
    <comment text="有什么问题么？" />
    <comment text="奇怪的东西容易吸引火力。你长的就很奇怪" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="成功总是发生在没人注意你的时候" />
    <comment text="失败总是发生在指挥官注意你的时候" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="注意点反坦克手榴弹" />
    <comment text="是的，它们造成的伤害比破片手榴弹要大得多" />
    <comment text="幸运的是，它们的爆炸范围没那么大" />
  </dialogue>

  <dialogue key="vehicle dialogue 2 men">
    <comment text="" />
    <comment text="" />
  </dialogue>

  <dialogue key="vehicle dialogue 2 men">
    <comment text="军队中要是有些妹子就好了" />
    <comment text="确实，有助于刺激荷尔蒙" />
    <comment text="不，我不是那个意思..." />
    <comment text="那是什么意思？" />
    <comment text="那样我们就有人熨衣服，做饭和打扫卫生了" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="他们可以在这里多加一些棱角" />
    <comment text="为什么？" />
    <comment text="嗯...因为座椅没开抗锯齿硌屁股" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="今天是星期五！星期五！ *唱歌*" />
    <comment text="你应该去做个歌手" />
    <comment text="真的吗？你认真的吗?" />
    <comment text="是的，那样我们就不用整天听你唱歌了" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="他们给你新装备了吗？" />
    <comment text="给了" />
    <comment text="啊啊啊！不公平！" />
    <comment text="兄弟你生气了？" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="你可以往那边挪挪吗？" />
    <comment text="不可以" />
    <comment text="谢谢" />
    <comment text="不客气" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="一天要是没有阳光就像，你懂的...就像晚上" />
    <comment text="呸" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="你知道今晚什么天气吗？" />
    <comment text="黑天！" />
    <comment text="..." />
  </dialogue>

  <dialogue key="vehicle dialogue 2 men">
    <comment text="我希望更多的人能玩pvp模式" />
    <comment text="为什么？" />
    <comment text="他们至少会让咱这俩个AI活着" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="遇到麻烦时要倾泻出弹匣里的子弹" />
    <comment text="是的，长官！" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="我有个主意" />
    <comment text="算了吧，你出的都是馊主意" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="伙计们这仗打的爽么？" />
    <comment text="长官，是的长官！" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="别忘了我今天早上跟你讲的" />
    <comment text="是的长官！" />
    <comment text="如果我们的攻击一切顺利，那一定是个埋伏！" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="我认为这个计划真蠢" />
    <comment text="如果它是蠢但是有用，那么它就不是蠢" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="如果一切都失败了我们该怎么办？" />
    <comment text="那我们就呼叫火炮支援" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="所以你最后一次开车是什么时候？" />
    <comment text="啊？这是我第一次开车" />
    <comment text="那特么开车的怎么是你?" />
    <comment text="..." />
    <comment text="还没上前线我就得被你弄死" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="" />
    <comment text="" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="军队中有两条铁律" />
    <comment text="哪两条？" />
    <comment text="#1: 指挥官永远是对的" />
    <comment text="#2: 如果指挥官不对，遵守#1" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=campfire">
    <comment text="我的脚着火了" />
    <comment text="动一下" />
    <comment text="我做不到" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=tank">
    <comment text="我太爱这辆坦克了" />
    <comment text="闭嘴吧你" />
    <comment text="我就不" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=tank">
    <comment text="我们给这辆坦克起个什么名好呢？" />
    <comment text="你为什么要那样做？" />
    <comment text="好吧 我们得用它一段时间所以..." />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=tank">
    <comment text="对装甲车最好的防护是呆在敌军炮火射程之外" />
    <comment text="你真特么机智" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=tank">
    <comment text="这就是斯巴达~！" />
    <comment text="..." />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=tank">
    <comment text="吃我一炮！" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=tank">
    <comment text="最适合坦克的地形就是没有反坦克武器的地方" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=tank">
    <comment text="没有什么事是一炮解决不了的，如果有，那就两炮" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=tank">
    <comment text="Doh，为什么有只猫在坦克里？！" />
    <comment text="夜视仪坏了，你说为什么" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=tank">
    <comment text="你知道为什么我们叫步兵嘎嘣脆吗?" />
    <comment text="不知道。为什么？" />
    <comment text="因为我们从他们身上辗过去时会发出这样的声音" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="哎呦喂" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="我想吐..." />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="不确定这个家伙是否知道他要去哪" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="我们还没到吗？" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="ZZZ" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="哈哈哈！你的脸" />
    <comment text="什么？" />
    <comment text="满脸都是像素" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="我就喜欢惊悚美剧里有人喊“哈喽有人吗？”的时候" />
    <comment text="就好像凶手要回答“有啊 我在厨房呢，想来个三明治么？”" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="我希望玩家可以看看车辆内部" />
    <comment text="对，一点细节都没有" />
    <comment text="开发者真懒！" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="我开始觉得不呆在这个棺材里更安全了" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="想想有张美味的披萨摆在眼前" />
    <comment text="或者冰淇淋" />
    <comment text="或者烤鸡" />
    <comment text="或者草莓水饺" />
    <comment text="什么水饺？！" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="哦孩子，今天早上你吃了整个墓地吗？" />
    <comment text="不好意思兄弟，我上周弄丢了我的牙刷" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="额，这个绿色的小玩意是干什么用的？" />
    <comment text="额... 没什么..." />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="嘿，就是你，你可以重新开始游戏吗?" />
    <comment text="怎么了？" />
    <comment text="我好像卡bug了" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="你最好带上你的头盔而不是这些布料" />
    <comment text="你或许是对的，但是那样像个二逼一样" />
    <comment text="子弹打过来你就不这么说了" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="车里闻起来就像臭脚丫子一样" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="你想来片口香糖吗？" />
    <comment text="不，谢了" />
    <comment text="我们都认为你需要" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="你还记得有部电影里的卡车司机在最后逆转了战局吗？" />
    <comment text="不记得" />
    <comment text="耶，我也不记得。反正我们要死了。" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="我很确定我很快就要升级了" />
    <comment text="可别还没升级就挂了！" />
    <comment text="谢谢你，你真是个好人" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="我感觉好极了，伙计" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="我感觉今天好像出生了100次" />
    <comment text="是啊，我也是" />
    <comment text="想象一下如果现实真的这样" />
    <comment text="呵呵" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="老人们在婚礼上戳我并说“下一个就是你了”" />
    <comment text="在葬礼上对他们做同样的事就是了" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="那些电话销售员可真够烦的！" />
    <comment text="把电话给你的3岁女儿并告诉她这是圣诞老人就好了" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="我昨晚做了一个奇怪的噩梦" />
    <comment text="做了什么梦？" />
    <comment text="到处都是1和0" />
    <comment text="有什么问题吗？" />
    <comment text="我突然看见一个2！" />
    <comment text="啊啊，真可怕" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="我的妻子说我丑，但我做事很漂亮" />
    <comment text="所以呢？" />
    <comment text="你觉得呢？" />
    <comment text="嗯，两个都有一点，我认为你丑得漂亮" />
    <comment text="拜托，你能至少认真一次吗？" />
    <comment text="相信我，我是真心的" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="老兄，你说了很多" />
    <comment text="这是家庭传统" />
    <comment text="你这是什么意思？" />
    <comment text="我的爷爷是个街头小贩，我的爸爸是一个老师" />
    <comment text="你的妈妈呢？" />
    <comment text="她是个女人" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="我该如何向我父亲传达这个消息？" />
    <comment text="你指的什么？" />
    <comment text="我没能晋升" />
    <comment text="给他发个电报" />
    <comment text="然后呢？" />
    <comment text="写上“和去年的表现一样”" />
  </dialogue>

  <dialogue key="defense dialogue 2 men">
    <comment text="我很高兴开发者没有制作空中载具" />
    <comment text="恩对，少了一点担忧" />
    <comment text="是啊，不用担心上面掉下来的什么" />
    <comment text="除了火炮和迫击炮和...啊啊啊啊啊！" />
    <comment text="哈哈哈，还有鸽子屎！" />
    <comment text="该死！" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="职业军人是有预判意识的" />
    <comment text="但这个世界遍布着危险的菜鸟" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="他们总是谈论军事情报..." />
    <comment text="有什么问题吗？" />
    <comment text="军事情报是矛盾的" />
    <comment text="呸，管好你自己就好了！" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="我真希望能和这个为所欲为的玩家看得一样远" />
    <comment text="玩家？" />
    <comment text="是的，就是正躲在屏幕后面盯着我们看的那货" />
    <comment text="事实上，这是一种欺骗" />
    <comment text="而且我不能忍受他愚蠢的笑容！" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="如果你和你的上级发生人格冲突" />
    <comment text="啥？" />
    <comment text="他有人格，你有冲突" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="领导越愚蠢，派给他任务却越重要" />
    <comment text="你说的没错" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="总会有办法" />
    <comment text="然而并没有什么卵用" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="你见过指挥官的新老婆了吗?" />
    <comment text="你是说那个长鼻子的女人？" />
    <comment text="是的，有这么大的鼻子她都能在洗澡的时候抽烟了" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="人从猴子进化而来这是真的吗?" />
    <comment text="是的，列兵可能是那样。但中士不是" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="最近有个女孩伪装成男人加入了军队" />
    <comment text="她得和男人们一起穿衣一起洗澡，对吗？" />
    <comment text="当然" />
    <comment text="好吧，难道他们不会发现吗？" />
    <comment text="这事谁看见了会说出来？" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="为什么我们需要更昂贵的炸弹？" />
    <comment text="你猜" />
    <comment text="这些年被我们轰炸过的人里就没有抱怨的吗？" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="为什么这几天我们的人在撤退？" />
    <comment text="他们没有撤退，他们只是朝相反的方向前进" />
    <comment text="好吧好吧" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="你不必偏要参军" />
    <comment text="谢谢你的支持，老兄" />
    <comment text="你只需要打准了就行" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="战争是上帝给无知的人教地理的方式" />
    <comment text="很对" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="当敌人犯错误时千万别打断他" />
    <comment text="" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="战场上有很多值钱的宝贝" />
    <comment text="很多士兵都不在意" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="我今天需要高度集中" />
    <comment text="有什么特别的吗？" />
    <comment text="今天可能会有个游戏主播在这录视频" />
    <comment text="然后你想给他们捣乱？" />
    <comment text="对，我就是这么想的" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="嘿，我一直在想" />
    <comment text="想什么？" />
    <comment text="我们的援军到底从哪来的？" />
    <comment text="你什么意思？" />
    <comment text="好吧，我没看到他们从运输工具或者别的东西里出来" />
    <comment text="你是想告诉我他们是从空气里蹦出来的吗？" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="我刚才放屁了吗？" />
    <comment text="呵呵！" />
    <comment text="你太让我恶心了" />
    <comment text="长官，是的长官！" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="他们没给我们足够的薪水，兄弟" />
    <comment text="都不够你看自己的脸Drake" />
    <comment text="什么？这是个笑话吗？" />
    <comment text="哦，我倒希望它是个笑话" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="" />
    <comment text="" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="" />
    <comment text="" />
  </dialogue>
