  <comment key="Hey, wait up" text="嘿，等会儿我！" />
  <comment key="Hey, wait up" text="嘿，等等我！" />
  <comment key="Hey, wait up" text="士兵，把你的铁驴勒住" />
  <comment key="Quickly!" text="快！" />
  <comment key="Quickly!" text="冲啊！" />
  <comment key="Buzz off" text="一边儿去" />
