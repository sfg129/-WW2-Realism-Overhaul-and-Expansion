  <comment key="hostile vehicle takeover" text="！？" />
  <comment key="hostile vehicle takeover" text="我去？" />
  <comment key="hostile vehicle takeover" text="嗯？" />
  <comment key="Can't respawn - the last base is under attack" text="无法重生 - 最后的基地正在被攻击" />
  <comment key="Can't respawn - spawning is locked" text="无法重生 - 重生锁定" />
  <comment key="Hmm.. not enough room here" text="嗯…这里没地方了" />
