	<comment key="enemy counterattack begins with armour" text="Scouts are reporting in, enemy armour is supporting their attack!" />
	<comment key="enemy counterattack begins with heavy armour" text="Scouts report they can hear heavy armour in the distance! Gear up on anti-tank!" />
-->
	<comment key="sicily tiger spawn info 1" text="我们已经占领所有重要区域，但是侦查发现敌军部队正朝我们接近！"/>
	<comment key="sicily tiger spawn info 2" text="侦察兵报告远处有重型装甲的声音！准备好反坦克火力！"/>
	<comment key="sicily tiger destroyed" text="“虎”式坦克已被摧毁！重复：“虎”式坦克已被摧毁！好样的！"/>
	
	<comment key="enemy generic counterattack begins" text="我方已经占领所有要点，但敌军已经集结部队准备反扑！"/> 
	<comment key="enemy generic counterattack begins with armour" text="侦察兵报告有装甲部队支援敌方进攻！"/>

	<comment key="varsity radio tower hint 1" text="我们需要炸毁在韦塞尔城区废墟内的无线电塔以延缓敌军增援"/>  
	<comment key="varsity radio tower hint 2" text="务必确保在城堡总攻之前先摧毁信号塔！"/>    

	<comment key="capture_base_with_vehicle mode, health=90" text="小心敌方反坦克火力！"/>     
	<comment key="capture_base_with_vehicle mode, health=50" text="我们的维修坦克受损较为严重！"/> 
	<comment key="capture_base_with_vehicle mode, health=10" text="任务即将失败，需要加强对维修坦克的保护！"/>         
	<comment key="capture_base_with_vehicle mode, health=0" text="维修坦克已被摧毁！护送任务失败！"/> 
    
    <comment key="Waiting for squad, taxi, vehicle = cargo_tank" text="伯莎，我们被命令停车！" />    
    <comment key="Waiting for squad, taxi, vehicle = cargo_tank" text="汉斯，快踩刹车！" />
    <comment key="Waiting for squad, taxi, vehicle = cargo_tank" text="是，停车！" />
    <comment key="Waiting for squad, taxi, vehicle = cargo_tank" text="停停停！" />    
	
	<!-- note, happens after "awesome, let's see what what we can come up with this" -->
