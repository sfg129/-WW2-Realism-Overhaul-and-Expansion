	<comment key="hostile vehicle takeover" text="啥情况？别啊啊啊"/>
	
	<comment key="enemy seen, vehicle tag = tank" text="遭遇装甲部队！"/> 
	<comment key="enemy seen, vehicle tag = tank" text="需要反坦克火力！"/>
	
 	<comment key="enemy seen, vehicle tag = truck" text="遭遇敌方车辆！"/>  
 	<comment key="enemy seen, vehicle tag = truck" text="他们开了辆卡车来！"/>   

 	<comment key="enemy seen, vehicle tag = truck" text="敌方车队！"/>   
 	<comment key="enemy seen, vehicle tag = truck" text="遭遇敌方车辆！"/>  
 	<comment key="enemy seen, vehicle tag = truck" text="他们开了卡车来！"/>   
 	<comment key="enemy seen, vehicle tag = truck" text="快把那车炸了！"/>                  

	<comment key="Reloading" text="换弹，掩护我！"/>
	<comment key="Reloading" text="我得装弹！"/>  

	<comment key="celebrating" text="给敌人点颜色看看！"/>
	<comment key="celebrating" text="我活下来了...."/>
	<comment key="celebrating" text="哈，暂时...结束了..."/>


	<dialogue key="defense dialogue 2 men">
		<comment text="我听说我们的敌人喜欢搞偷袭"/>
		<comment text="日了狗，我们有应对措施没？"/>
	</dialogue>   

	<dialogue key="vehicle dialogue 2 men">
		<comment text="今晚天气预报是啥？"/>
		<comment text="中到大炮弹雨！"/>
		<comment text="..."/>
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="这些螃蟹真操蛋！"/>  
		<comment text="很烦是吧？"/> 
		<comment text="我杀的这东西比我这辈子杀的敌军还多"/>  
	</dialogue>
	
	<comment key="we captured a base" text="%base_name已被我军控制。"/>
	<comment key="we captured a base" text="我们占领了%base_name，向前巩固阵地"/>
	<comment key="enemy captured a base" text="%faction_name已经占领了%base_name，准备反攻！"/>
	
	<comment key="we won by map conquer" text="干得漂亮，伙计们，我们把敌人赶跑了"/>
	<comment key="we won by defense timer" text="他们已经没力气继续打了，我们赢了！"/>
	
	<comment key="our base is under attack" text="%base_name正遭受攻击！"/>

	<comment key="we are attacking a base" text="我方部队正在突击%base_name"/>
	
	<comment key="fighting near a base" text="有报告称%base_name附近发现敌情"/>
	<comment key="fighting near a base" text="%base_name周边请求支援"/>

	<comment key="defense timer started" text="%faction_name占据着据点，还有%time_left秒！"/>
	<comment key="defense timer to go" text="还剩%time_left秒！"/>

	<comment key="Lone leader, enemy not seen, taking suppressed fire" text="该死，快点找到他！"/>

	<comment key="Medic!" text="呃啊，好痛！"/> 
	<comment key="We surrender!" text="他们怎么打败了我们...不可能..."/>

    <comment key="uncapturable_last_base_end_timer, start" text="我们把敌人赶了出去，不过他们似乎还想把地皮拿回来"/>
    <comment key="uncapturable_last_base_end_timer, cancel" text="决不能让敌人在任何一块地方站稳脚跟！夺回来！"/>

