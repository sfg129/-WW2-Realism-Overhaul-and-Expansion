  <comment key="Gunner, there" text="炮手，瞄准那里" />
  <comment key="Gunner, there" text="炮手，朝目标开火" />
  <comment key="We surrender!" text="我们投降！" />
  <comment key="We surrender!" text="别开枪！" />
  <comment key="We surrender!" text="" />
  <comment key="We surrender!" text="" />
  <comment key="Medic!" text="医疗兵！" />
  <comment key="Medic!" text="卫生兵！" />
  <comment key="Medic!" text="啊，我需要一个医疗兵！" />
  <comment key="Medic!" text="我被击中了！" />
  <comment key="Medic!" text="医疗兵！我倒下了！" />
  <comment key="I feel good!" text="我感觉好多了！" />
  <comment key="I feel good!" text="谢谢伙计！" />
  <comment key="I feel good!" text="谢谢你为我治疗！" />
  <comment key="I feel good!" text="谢谢医生！" />

  <comment key="Reloading" text="换弹" />
  <comment key="Reloading" text="掩护我" />
  <comment key="Reloading" text="" />
  <comment key="Reloading" text="" />
