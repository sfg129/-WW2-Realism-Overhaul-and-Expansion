	<comment key="spawn_in_base_call, denied, key=ija_vehicle1.call" text="No se dispone de puntos de despliegue, captura una base!" />

	<comment key="spawn_in_base_call, accepted, key=ija_vehicle2.call" text="Ka-Tsu desplegado en %base_name" />
	<comment key="spawn_in_base_call, denied, key=ija_vehicle2.call" text="No se dispone de puntos de despliegue, captura una base!" />

	<comment key="spawn_in_base_call, accepted, key=ija_vehicle_armoury_marine.call" text="Armería Type 4 Su-Ki desplegado en %base_name" />
	<comment key="spawn_in_base_call, denied, key=ija_vehicle_armoury_marine.call" text="No se dispone de puntos de despliegue, captura una base!" />
	
