  <comment key="Reloading" text="Cúbreme" />
  <comment key="Reloading" text="" />
  <comment key="Reloading" text="" />
  <comment key="cancel radio call" text="Ah nada, corto" />
  <comment key="cancel radio call" text="Olvídalo, corto" />
  <comment key="initiate radio call" text="Cuartel general, ¿me recibe? Cambio" />
  <comment key="commander radio response" text="Aquí Cuartel general. Cambio" />
  <comment key="commander radio full" text="Aquí Alfa Zero. Tenemos demasiadas peticiones que atender, intente de nuevo brevemente."/>  
  <comment key="no radio equipment" text="Todavía no tengo una radio" />
  <comment key="no radio equipment" text="No les dan radios a los %rank_names" />
  <comment key="no radio equipment" text="Parece que me dejé la radio en otros pantalones" />
  <comment key="squad chat, not in squad" text="No estoy dentro de una patrulla de jugadores" />
  <comment key="Hey, wait up" text="Hey, espere" />
  <comment key="Hey, wait up" text="Hey, espere" />
  <comment key="Hey, wait up" text="Hey, ¡aguarde!" />
  <comment key="Hey, wait up" text="¡Cálmese Soldado!" />
  <comment key="Quickly!" text="¡Rápido!" />
  <comment key="Quickly!" text="¡Vamos vamos vamos!" />
  <comment key="Buzz off" text="Piérdete" />
  <comment key="Step out, kid" text="Apártese, chico" />
  <comment key="Step out, kid" text="Salga de ahí, chico" />

  <comment key="Can't respawn - the last base is under attack" text="Spawn no posible - la última base está siendo atacada" />
  <comment key="Can't respawn - spawning is locked" text="Spawn no posible - el spawn está bloqueado" />
  <comment key="Press SPACE to continue!" text="¡Pulsa ESPACIO para continuar!" />
  <comment key="Hmm.. not enough room here" text="Hmm.. no hay demasiado espacio aquí" />
  <comment key="I'm outta here" text="Me largo de aquí" />
  <comment key="I'm outta here" text="Vámonos de aquí" />
  <comment key="Good job, soldiers" text="Buen trabajo, soldados" />
  <comment key="Good job, soldiers" text="Bien hecho, caballeros" />
  <comment key="Good job, soldiers" text="" />
  <comment key="Good job, soldiers" text="" />
  <comment key="Open fire" text="¡Fuego!" />
  <comment key="Open fire" text="Hostiles" />
  <comment key="Lone leader, open fire" text="" />
  <comment key="fire opened, weapon tag = sniper" text="Francotirador" />
  <comment key="fire opened, weapon tag = sniper" text="Francotirador en alguna parte" />
