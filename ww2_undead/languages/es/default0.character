  <comment key="Squad, change position" text="Patrulla, adelante" />
  <comment key="Squad, change position" text="Patrulla, ¡vamos!" />
  <comment key="Driver, take us there" text="Conductor, llévenos allí" />
  <comment key="Driver, over there" text="Conductor, por ahí" />
  <comment key="Gunner, there" text="Artillero, ¡ahí!" />
  <comment key="Gunner, there" text="Artillero, mire allí" />
  <comment key="Gunner, there" text="Artillero, !apunte allí!" />
  <comment key="Gunner, there" text="Artillero, ataque el objetivo" />
  <comment key="We surrender!" text="¡Nos rendimos!" />
  <comment key="We surrender!" text="¡No disparen!" />
  <comment key="We surrender!" text="" />
  <comment key="We surrender!" text="" />
  <comment key="Medic!" text="¡Médico!" />
  <comment key="Medic!" text="¡Que alguien llame a un médico!" />
  <comment key="Medic!" text="Aah, ¡necesito un médico!" />
  <comment key="Medic!" text="¡Me han dado!" />
  <comment key="Medic!" text="¡Hombre abatido!" />
  <comment key="I feel good!" text="¡Me siento bien!" />
  <comment key="I feel good!" text="¡Gracias camarada!" />
  <comment key="I feel good!" text="Gracias por el arreglo" />
  <comment key="I feel good!" text="¡Gracias doc!" />
  <comment key="I feel good!" text="¡Sí señor!" />
