  <comment key="enemy not seen, area alerted" text="A cubierto" />
  <comment key="enemy not seen, area alerted" text="Estén alerta" />
  <comment key="Lone leader, enemy not seen, area alerted" text="" />
  <comment key="leader, enemy not seen, taking suppressed fire" text="A cubierto" />
  <comment key="leader, enemy not seen, taking suppressed fire" text="Fuego enemigo" />
  <comment key="Lone leader, enemy not seen, taking suppressed fire" text="¡Sé que estás ahí en algún sitio!" />
  <comment key="Lone leader, enemy not seen, taking suppressed fire" text="Fuego enemigo" />
  <comment key="Lone leader, enemy not seen, taking suppressed fire" text="¡Carajo!" />
  <comment key="Lone leader, enemy not seen, taking suppressed fire" text="!" />
  <comment key="Lone leader, enemy not seen, taking suppressed fire" text="¡Cobarde!" />
  <comment key="Lone leader, enemy not seen, taking suppressed fire" text="" />
  <comment key="Lone leader, enemy not seen, taking suppressed fire" text="" />
  <comment key="enemy seen, vehicle tag = apc" text="¡APC a la vista!" />
  <comment key="enemy seen, vehicle tag = apc" text="¡APC a la vista! ¡Reviéntenlo!" />
  <comment key="enemy seen, vehicle tag = apc" text="¡APC Localizado!" />
  <comment key="enemy seen, vehicle tag = apc" text="¡APC Localizado!" />
  <comment key="enemy seen, vehicle tag = apc" text="¡APC! ¡Cuidado!" />
  <comment key="enemy seen, vehicle tag = apc" text="¡APC! ¡Neutralicen esa cosa soldados!" />  
  <comment key="enemy seen" text="Por aquí" />
  <comment key="enemy seen" text="¡Alerta!" />
  <comment key="enemy seen" text="Hostiles" />

  <comment key="enemy not seen, taking suppressed fire" text="?" />
  <comment key="enemy not seen, taking suppressed fire" text="¿Qué ha sido eso?" />
  <comment key="enemy not seen, taking suppressed fire" text="¡Alerta!" />
  <comment key="enemy not seen, taking suppressed fire" text="Disparos" />
  <comment key="Waiting for reinforcements" text="Esperando refuerzos" />
  <comment key="Waiting for reinforcements" text="Esperemos aquí" />
  <comment key="Hold on!" text="¡Aguanta!" />
  <comment key="Hold on!" text="¡Aguanta!" />
  <comment key="Hold on!" text="¡Voy para allá!" />
  <comment key="Hold on!" text="¡Aguanta ahí!" />
  <comment key="Move out" text="Adelante" />
  <comment key="Move out" text="Vamos" />
  <comment key="Move out" text="Síganme" />
  <comment key="Move out" text="Aprisa" />
  <comment key="All quiet here" text="Todo tranquilo por aquí" />
  <comment key="All quiet here" text="Todo parece en calma" />
  <comment key="All quiet here" text="*bostezando*" />
  <comment key="All quiet here" text="Nadie por ahí" />
  <comment key="All quiet here" text="*silbando*" />
  <comment key="All quiet here" text="¿La calma de antes de la tempestad?" />
  <comment key="All quiet here" text="Ningún rastro de enemigos aquí" />
  <comment key="All quiet here" text="Tan solo un par más de semanas..." />
  <comment key="Yes sir" text="Sí Señor" />
  <comment key="Yes sir" text="En ello" />
  <comment key="Yes sir" text="Ok" />
  <comment key="Yes sir" text="Voy para allá" />
  <comment key="Yes sir" text="Recibido" />
  <comment key="Yes sir" text="Comprendido" />
  <comment key="Yes sir" text="A la orden" />
  <comment key="Uh, I can't drive this thing" text="Uh, esto no se deja manejar" />
  <comment key="Uh, I can't drive this thing" text="De vuelta a la autoescuela, ¿eh?" />
  <comment key="Uh, I can't drive this thing" text="Oops" />
  <comment key="Uh, I can't drive this thing" text="¡Maldito trasto!" />
  <comment key="Uh, I can't drive this thing" text="Apostaría a que el cigüeñal está defectuoso" />
  <comment key="Uh, I can't drive this thing" text="Estoy segurísimo de que el carburador está roto" />
  <comment key="Uh, I can't drive this thing" text="Ajj, diría que este volante no funciona" />
  <comment key="Uh, I can't drive this thing" text="Ah, así que eso era el embrague" />
  <comment key="Uh, I can't drive this thing" text="Ojalá no tuviera que conducir" />
  <comment key="Uh, I can't drive this thing" text="¡Ay cabrón!" />
  <comment key="Uh, I can't drive this thing" text="Ay madre, ¡otra vez!" />
  <comment key="Uh, I can't drive this thing" text="¿Alguien que quiera probar a conducir?" />
  <comment key="Uh, I can't drive this thing" text="Necesito mis lentes de contacto" />
  <comment key="Uh, I can't drive this thing" text="Uh, la dirección parece invertida" />
  <comment key="Uh, I can't drive this thing" text="Eso no fue mi culpa" />
  <comment key="Waiting for squad" text="Esperando a la patrulla" />
  <comment key="Waiting for squad" text="Suban, ¡rápido!" />
  <comment key="Shield up" text="Escudo en posición" />
  <comment key="Shield up" text="" />
  <comment key="Shield up" text="" />
  <comment key="overencumbered" text="Maldita sea esta mochila" />
  <comment key="overencumbered" text="No puedo apuntar bien con todo este peso" />
  <comment key="overencumbered" text="Debería reducir la carga de la mochila" />
  <comment key="Where to, chief?" text="¿Hacia dónde, jefe?" />
  <comment key="Where to, chief?" text="¿A algún sitio en concreto?" />
  <comment key="Where to, chief?" text="A su servicio" />
  <comment key="Where to, chief?" text="Esperando órdenes" />
  <comment key="Press SPACE to continue!" text="Pulsa ESPACIO para continuar" />

  <comment key="about to drive over a friendly" text="¡Cuidado!" />
  <comment key="about to drive over a friendly" text="¡Fuera de mi camino!" />
  <comment key="this is as close as i can get" text="Esto es todo lo cerca que puedo" />
  <comment key="this is as close as i can get" text="Imposible acercarse más" />
  <comment key="enemy vehicle spotted, near base" text="%vehicle_name de %enemy_name cerca de %base_name" />
  <comment key="enemy vehicle spotted, not near base" text="Detectado %vehicle_name de %enemy_name" />
  <comment key="comms have been restored" text="Telecomunicaciones restablecidas" />
  <comment key="enemy comms have been restored" text="%enemy_name ha restablecido sus telecomunicaciones" />
  <comment key="comms have been destroyed" text="Telecomunicaciones destruidas por el enemigo" />
  <comment key="enemy comms have been destroyed, by us" text="Bien hecho, ¡telecomunicaciones de %enemy_name destruidas!" />
  <dialogue key="wander dialogue 2 men">
    <comment text="Mira este sitio" />
    <comment text="Está tan tranquilo" />
    <comment text="Creo que podría vivir aquí" />
  </dialogue>
  <dialogue key="wander dialogue 2 men">
    <comment text="Diría que ya he estado aquí antes" />
  </dialogue>
  <dialogue key="wander dialogue 2 men">
    <comment text="Necesitamos un poco de acción por aquí" />
  </dialogue>
  <dialogue key="wander dialogue 2 men">
    <comment text="Hoy me siento invencible" />
  </dialogue>
  <dialogue key="wander dialogue 2 men">
    <comment text="Alístate en el ejército dijeron, será divertido dijeron" />
  </dialogue>
  <dialogue key="wander dialogue 2 men">
    <comment text="Si hubiera sabido que andaríamos tanto, me habría alistado en la Marina" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="¿Te van a ascender pronto?" />
    <comment text="Nah, no creo" />
  </dialogue>
  <dialogue key="wander dialogue 2 men">
    <comment text="¿Quieres ver algo interesante?" />
    <comment text="Nop, no caeré otra vez en esa trampa" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Sabes, el sargento y yo estuvimos en territorio enemigo" />
    <comment text="Ah, ¿formas parte de un escuadrón de sigilo?" />
    <comment text="Sip, y localizamos un camión de cargo también" />
    <comment text="Wow, eso está genial" />
    <comment text="Hacer incursiones de reconocimiento es mejor que esto" />
    <comment text="Aquí al menos viviremos más" />
    <comment text="Como si no hubiera cosas más importantes" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="No le digas a mi madre que me alisté al ejército" />
    <comment text="¿Y eso?" />
    <comment text="Le dije que toco el piano en un burdel" />
    <comment text="Ah, vale" />
  </dialogue>

  <dialogue key="defense dialogue 2 men">
    <comment text="¿Tienes cigarrillos?" />
    <comment text="No me quedan, no sabía que fumaras" />
    <comment text="No es que fume, los quiero cambiar por un arma nueva" />
    <comment text="¿Qué le pasa a la que llevas?" />
    <comment text="Creo que tiene tierra por dentro" />
    <comment text="No seas vago y límpiala a fondo" />
    <comment text="Bueno, no les queda algodón para limpiarla en el arsenal" />
    <comment text="Increíble" />
    <comment text="Tienen decenas de armas pero no medios para mantenerlas en buen estado" />
    <comment text="Como si creyeran que no sobreviviremos lo suficiente como para tener que limpiarlas" />
    <comment text="Ése es un punto interesante..." />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="¿Algún rastro de aquel camión de comunicaciones?" />
    <comment text="Ninguno, pero seguro que no está aquí" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="¿Sabes qué? Encontré algo de whisky y lo escondí" />
    <comment text="Shh que no te oigan, se supone que no te lo puedes quedar" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="He estado pensando..." />
    <comment text="¿Qué cosa?" />
    <comment text="Ehh, ya no me acuerdo" />
  </dialogue>

  <dialogue key="defense dialogue 2 men">
    <comment text="¿Señor, por qué no estamos haciendo nada?" />
    <comment text="No cuestiones las órdenes chico. Cuestionar órdenes te lleva a la tumba" />
    <comment text="Señor, sí Señor" />
  </dialogue>

  <dialogue key="defense dialogue 2 men">
    <comment text="No sé si unirme al coro del ejército" />
    <comment text="¿Por qué no?" />
    <comment text="Bueno, la última vez que estuve en un coro fue en el de la iglesia" />
    <comment text="¿Y?" />
    <comment text="y ¿200 personas cambiaron de religión?" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Menos mal que el enemigo no nos está atacando las espaldas" />
    <comment text="Sí, sería algo totalmente inesperado, no estamos preparados" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="" />
    <comment text="" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Hace poco tuve un tiroteo con los desarrolladores" />
    <comment text="¿Con Pasik y JackMayol?" />
    <comment text="Sí, ¡Pasik apunta como una viejita pero este JackMayol es incluso peor!" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="'Osumia Games'... ¿a quién se le ocurren estos nombres?" />
    <comment text="Espera, ¿de qué estás hablando?" />
    <comment text="Ni siquiera yo lo sé" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="A veces me parece que simplemente estamos corriendo con rifles aquí" />
    <comment text="Tú y tu clarividencia" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Ouch, ¡mi pie!" />
    <comment text="Perdona camarada" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="¿Se ha publicado este juego ya?" />
    <comment text="Claro, ¡en Steam!" />
    <comment text="¡Bravo!" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Oye, ¿ese pedo era tuyo?" />
    <comment text="Podría ser" />
    <comment text="¡Demonios! ¡Abre las ventanas!" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="¿Sabes qué?" />
    <comment text="¿Hmm?" />
    <comment text="Creo que te amo" />
    <comment text="No sigas por ahí..." />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="¿De dónde sacaste tu licencia de conducir?" />
    <comment text="Tu madre me la dio" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Hit me baby one more tiiiime" />
    <comment text="Gustosamente" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="No me siento seguro aquí dentro" />
    <comment text="¿Y eso?" />
    <comment text="Mira las ruedas" />
    <comment text="¿Qué sucede con las ruedas?" />
    <comment text="No están siquiera conectadas con los ejes" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Me encantaría escuchar la radio" />
    <comment text="Totalmente de acuerdo" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Siempe tuve miedo de que nos tocara en la misma patrulla" />
    <comment text="¿Qué hay de malo en ello?" />
    <comment text="Los objetos extraños atraen el fuego. Tú eres extraño" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="El éxito siempre sucede cuando no hay nadie para verlo" />
    <comment text="Y el fracaso cuando el comandante está mirando" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Estate alerta a las granadas AT" />
    <comment text="Sí, provocan mayores daños que las de fragmentación" />
    <comment text="Afortunadamente tienen una explosión de menor alcance" />
  </dialogue>

  <dialogue key="vehicle dialogue 2 men">
    <comment text="" />
    <comment text="" />
  </dialogue>

  <dialogue key="vehicle dialogue 2 men">
    <comment text="Contar con unas pocas mujeres más en el ejército no haría daño a nadie" />
    <comment text="Ya, nos ayudaría con las hormonas" />
    <comment text="No, no me refería a eso" />
    <comment text="¿Entonces?" />
    <comment text="Tendríamos a alguien para planchar, cocinar y limpiar" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Podrían haber añadido algunos polígonos más aquí" />
    <comment text="¿Por qué?" />
    <comment text="Estos asientos son muy puntiagudos" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="¡Al fin es VIERNES! ¡VIERNES! *canta*" />
    <comment text="Tú deberías hacer carrera como cantante" />
    <comment text="¿Sí? ¿Lo dices en serio?" />
    <comment text="Completamente, así no tendríamos que escucharte todo el santo día" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="¿A ti te dieron ya el nuevo equipo?" />
    <comment text="Sí" />
    <comment text="Aw, no es justo..." />
    <comment text="¿Celoso bróder?" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="¿Podrías moverte un poco?" />
    <comment text="No" />
    <comment text="Gracias" />
    <comment text="¡No hay de qué!" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Un día sin sol eso como, ya sabes... una noche" />
    <comment text="Ah, otro poeta en el ejército" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="¿Sabes qué tiempo hará esta noche?" />
    <comment text="Oscuro" />
    <comment text="..." />
  </dialogue>

  <dialogue key="vehicle dialogue 2 men">
    <comment text="Ojalá mas gente jugara pvp" />
    <comment text="¿Por qué?" />
    <comment text="Así al menos no nos matarían a los bots indiscriminadamente" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="En caso de duda, vacía el cargador" />
    <comment text="¡Sí Señor!" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Tengo una idea" />
    <comment text="Olvídalo, el plan perfecto no existe" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="¿Están animados caballeros?" />
    <comment text="¡Señor, sí, Señor!" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="No olvides lo que te dije esta mañana" />
    <comment text="¡Sí Señor!" />
    <comment text="Si el ataque va demasiado bien, ¡es una emboscada!" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Creo que el plan es absurdo" />
    <comment text="Si es absurdo y funciona, entonces no es absurdo" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="¿Qué hacemos si todo sale mal?" />
    <comment text="Solicitamos un ronda de artillería" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="¿Cuándo fue la última vez que condujiste?" />
    <comment text="Oh, esta es mi primera vez" />
    <comment text="¿Entonces por qué carajo estás conduciendo?" />
    <comment text="..." />
    <comment text="Conseguirás que me maten incluso antes de llegar al frente" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="" />
    <comment text="" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Hay 2 normas importantes en el ejército" />
    <comment text="Y son..." />
    <comment text="#1: El oficial en cargo siempre tiene la razón" />
    <comment text="#2: Si el oficial en cargo no tiene la razón, mire #1" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=campfire">
    <comment text="Me arden los pies" />
    <comment text="Entonces muévete un poco" />
    <comment text="No puedo" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=tank">
    <comment text="Adoro este maldito tanque" />
    <comment text="Ah cállate" />
    <comment text="No puedo" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=tank">
    <comment text="¿Qué nombre le ponemos al tanque?" />
    <comment text="¿Por qué harías algo así?" />
    <comment text="Vamos a tenerlo durante un rato largo así que..." />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=tank">
    <comment text="La mejor armadura: estar fuera de alcance" />
    <comment text="Un tipo inteligente" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=tank">
    <comment text="¡Esto es Espartaaaaa!" />
    <comment text="..." />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=tank">
    <comment text="¡Prepárense para tragar acero!" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=tank">
    <comment text="Lo mejor para el tanque, evitar las defensas anti-tanque" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=tank">
    <comment text="No hay problema que no se solucione con una buena cantidad de explosivos" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=tank">
    <comment text="Doh, ¡¿Por qué hay un gato en el tanque?!" />
    <comment text="El sistema de visión nocturna está roto, listillo" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=tank">
    <comment text="¿Sabes por qué llamamos 'crunchis' a la infantería?" />
    <comment text="No, ¿por qué?" />
    <comment text="Es lo que se oye cuando les pasamos por encima" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Ouch" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Creo que me estoy mareando" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="No estoy seguro de si este tipo sabe a dónde va" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="¿Ya llegamos?" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="ZZZ" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="lol, ¡tu cara!" />
    <comment text="¿Qué le pasa?" />
    <comment text="Está llena de voxels" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Me encanta cómo en las películas de terror dicen '¿Hay alguien ahí?'" />
    <comment text="Como si el asesino fuera a decir 'Estoy en la cocina, ¿te hago un sandwich?'" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Ojalá el jugador pudiera ver el interior de estos vehículos" />
    <comment text="Ya, no hay detalle alguno" />
    <comment text="¡Qué vagos los desarrolladores!" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Me sentiría más seguro afuera de este espanto de vehículo" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Imagínate una buena pizza" />
    <comment text="O un helado" />
    <comment text="O un pollo asado" />
    <comment text="O una ensalada de tofu" />
    <comment text="¡¿Qué?!" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Aj, ¿te comiste un cementerio esta mañana o qué?" />
    <comment text="Lo siento, perdí el cepillo de dientes la semana pasada" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="¿Para qué es este botón verde?" />
    <comment text="Uh... nada..." />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Hey, tú, ¿podrías reiniciar el juego por favor?" />
    <comment text="¿Qué sucede?" />
    <comment text="Estoy bloqueado en esta textura" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Deberías llevar tu casco en lugar de esa banda roja en la cabeza" />
    <comment text="Probablemente, pero así parezco un jefazo" />
    <comment text="Las balas no tienen criterio" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Huele un poco a pies de voxel sudados" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="¿Quieres un chicle?" />
    <comment text="Ah, no gracias" />
    <comment text="Venga, sabemos que quieres" />
    <comment text="¿Qué se supone que quiere decir eso?" />
    <comment text="¡Has acertado colega!" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="¿Recuerdas esa película en la que los conductores de camión eran los héroes?" />
    <comment text="Mhm, no" />
    <comment text="Ya, yo tampoco. ¡Vamos a morir!" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Estoy seguro de que me van a ascender de rango en breve" />
    <comment text="¡Pues no permitas que te maten antes!" />
    <comment text="Gracias camarada, eres una bellísima persona" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Me siento realmente bien, amigo" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Creo que hoy he utilizado como 100 spawns" />
    <comment text="¡Ha!, igual que yo" />
    <comment text="Imagínate eso en la realidad" />
    <comment text="heh" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Los viejetes en las bodas se ríen de mí diciendo 'tú eres el siguiente'" />
    <comment text="Hazles tú lo mismo en los funerales" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Estos tipos de la televenta, ¡son tan molestos!" />
    <comment text="Solo dale el teléfono a tu hija de 3 años y dile que es Santa Claus" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Tuve una extraña pesadilla anoche" />
    <comment text="¿Qué pasó?" />
    <comment text="Había unos y ceros por todas partes" />
    <comment text="¿Qué hay de malo en ello?" />
    <comment text="¡De repente vi un 2!" />
    <comment text="¡Ay qué miedo cabrón!" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Mi amante dice que soy bastante guapo, mi mujer un poco feo" />
    <comment text="¿Y bien?" />
    <comment text="¿Tú cómo me ves?" />
    <comment text="Hmm, un poco como las dos, bastante y feo" />
    <comment text="Bah, ¿podrías dejar de bromear por una vez?" />
    <comment text="Créeme, lo digo en serio" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Amigo, hablas un montón" />
    <comment text="Hablar es una tradición familiar" />
    <comment text="¿Qué quieres decir?" />
    <comment text="Mi abuelo era vendedor ambulante, mi padre es profesor" />
    <comment text="¿Y tu madre?" />
    <comment text="Ella es mujer" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="¿Cómo le doy la noticia a mi padre?" />
    <comment text="¿A qué noticia te refieres?" />
    <comment text="A que he fallado en conseguir una promoción" />
    <comment text="Envíale un telegrama" />
    <comment text="¿Y?" />
    <comment text="'Rendimiento similar al del año pasado'" />
  </dialogue>

  <dialogue key="defense dialogue 2 men">
    <comment text="Doy gracias de que los desarrolladores no hayan añadido vehículos aéreos" />
    <comment text="Hm sí, un peligro menos del que peocuparse" />
    <comment text="Sip, no hay que preocuparse de lo que venga del cielo" />
    <comment text="Excepto por los bombardeos de artillería y mortero...¡arghhhhh!" />
    <comment text="¡Jajaja y de las cacas de las palomas!" />
    <comment text="¡Malditas ratas aladas!" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Los soldados profesionales son previsibles" />
    <comment text="Pero el mundo está repleto de principiantes peligrosos" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Toda esta historia sobre inteligencia militar..." />
    <comment text="¿Qué sucede con eso?" />
    <comment text="Inteligencia militar es una contradicción" />
    <comment text="Bah, ¡habla por tí mismo!" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Desearía poder ver tan lejos como este jugador aficionado" />
    <comment text="¿Jugador?" />
    <comment text="Sí, el tipo detrás del monitor que nos está observando" />
    <comment text="Cierto, ¡eso es como hacer trampas!" />
    <comment text="¡Y no soporto esa estúpida sonrisa en su cara!" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Si tienes un conflicto de personalidad con tu superior..." />
    <comment text="¿Hm?" />
    <comment text="... él tiene la personalidad, tú el conflicto" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Cuánto más estúpido es nuestro líder, más importantes las misiones que le encargan" />
    <comment text="Tienes toda la razón" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Siempre hay una manera" />
    <comment text="Y generalmente no funciona" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="¿Viste a la nueva mujer del comandante?" />
    <comment text="¿Te refieres a aquella mujer narizona?" />
    <comment text="Sí, con tal narizota seguro puede fumar bajo la ducha" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Oye, ¿es verdad que el hombre desciende del mono?" />
    <comment text="Sí, los soldados rasos seguramente. Los sargentos no" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Hay una mujer disfrazada de hombre que se ha unido al ejército recientemente" />
    <comment text="Tendrá que ducharse y vestirse con los hombres, ¿no?" />
    <comment text="Seguramente" />
    <comment text="Y bien, ¿no se darán cuenta?" />
    <comment text="¿Quién la va a delatar?" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="¿Para qué necesitamos tener bombas todavía más caras?" />
    <comment text="Imagínate" />
    <comment text="¿Acaso la gente a la que bombardeamos se ha quejado estos años?" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="¿Por qué nuestras propias unidades están en retirada últimamente?" />
    <comment text="No estaban en retirada, avanzaban en la dirección opuesta" />
    <comment text="Ah ¡muy bien!" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Aunque seas daltónico puedes ser útil en el ejército" />
    <comment text="Gracias por tu comprensión, camarada" />
    <comment text="Tú solo... apunta a donde yo dispare" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="La guerra es la manera en que Dios enseña geografía a los incultos" />
    <comment text="Totalmente cierto" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Nunca interrumpas al enemigo cuando esté cometiendo un error" />
    <comment text="" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Hay tantos objectos valiosos tirados por todo el campo de batalla" />
    <comment text="Y la mayoría de soldados ni se dan cuenta" />
    <comment text="Venderlos en el arsenal merece la pena, no obstante" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Hoy necesito concentrarme al máximo" />
    <comment text="¿Tienes algo especial en mente?" />
    <comment text="Es posible que algún youtuber haga un video hoy" />
    <comment text="¿Y lo que quieres es amargarle el día?" />
    <comment text="Efectivamente, ese es el plan" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Hey, he estado pensando" />
    <comment text="¿De qué se trata?" />
    <comment text="¿De dónde vienen nuestros refuerzos?" />
    <comment text="¿Qué quieres decir?" />
    <comment text="Pues no es que vengan en transportes o algo así" />
    <comment text="¿Me estás diciendo que aparecen por arte de magia?" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="¿Acabas de tirarte un pedo?" />
    <comment text="¡Hehe!" />
    <comment text="Me disgustas" />
    <comment text="¡Señor, sí, Señor!" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Bah, no nos pagan lo suficiente para lo que hacemos" />
    <comment text="No lo suficiente por tener que verte la cara Drake" />
    <comment text="¿Qué? ¿Bromeas?" />
    <comment text="Oh, ojalá fuera así" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="" />
    <comment text="" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="" />
    <comment text="" />
  </dialogue>

