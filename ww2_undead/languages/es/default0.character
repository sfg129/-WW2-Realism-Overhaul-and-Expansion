		<comment text="He matado más cangrejos que enemigos en lo que llevo de guerra."/>  
	</dialogue>
	
	<comment key="we captured a base" text="%base_name ha sigo asegurado por nuestras fuerzas."/>
	<comment key="we captured a base" text="Hemos tomado %base_name, asegurad la posición."/>
	<comment key="enemy captured a base" text="Los %faction_name ha capturado %base_name, preparad el contrataque!"/>
	
	<comment key="we won by map conquer" text="Un trabajo excelente señores, hemos expulsado al enemigo."/>
	<comment key="we won by defense timer" text="Su asalto ha perdido toda su fuerza, hemos ganado!"/>
	
	<comment key="our base is under attack" text="%base_name está bajo ataque!"/>

	<comment key="we are attacking a base" text="Nuestras fuerzas están asaltando %base_name"/>
	
	<comment key="fighting near a base" text="Tenemos informes de contactos enemigos cerca de %base_name"/>
	<comment key="fighting near a base" text="Refuerzos solicitados cerca de %base_name"/>

	<comment key="defense timer started" text="%faction_name ha tomado el área, %time_left segundos para acabar!"/>
	<comment key="defense timer to go" text="%time_left segundos para acabar!"/>

	<comment key="Lone leader, enemy not seen, taking suppressed fire" text="Encontradlo! Maldita sea!"/>

	<comment key="Medic!" text="Aah, duele!"/> 
	<comment key="We surrender!" text="Como han podido vencernos... imposible..."/>

