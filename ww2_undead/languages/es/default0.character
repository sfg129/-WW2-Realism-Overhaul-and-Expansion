  <comment key="Squad, follow me" text="Patrulla, ¡reagruparse!" />
  <comment key="Squad, follow me" text="Patrulla, en formación" />
  <comment key="Squad, follow me" text="Patrulla, en línea" />
  <comment key="Squad, follow me" text="Patrulla, conmingo" />
  <comment key="Squad, follow me" text="Patrulla, ¡aquí y rápido!" />
  <comment key="Driver, stop the vehicle" text="Conductor, pare el vehículo" />
  <comment key="Driver, stop the vehicle" text="¡Hey! Deténgase aquí" />
  <comment key="Driver, stop the vehicle" text="Conductor, pare" />
  <comment key="Driver, stop the vehicle" text="Conductor, pise el freno" />
  <comment key="Gunner, fire at will" text="Artillero, ¡fuego a discreción!" />
  <comment key="Driver, stop the vehicle" text="Conductor, detenga el vehículo" />
  <comment key="Driver, stay close" text="Conductor, manténgase cerca" />
  <comment key="Driver, stay close" text="Conductor, sígame" />
  <comment key="Driver, stay close" text="Conductor, no se aleje" />
  <comment key="Squad, move over there" text="Patrulla, hacia allá" />
  <comment key="Squad, move over there" text="Patrulla, por ahí" />
  <comment key="Squad, move over there" text="Patrulla, a aquella posición" />
