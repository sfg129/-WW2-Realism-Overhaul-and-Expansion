	<dialogue key="wander dialogue 2 men">
		<comment text="You know, despite being in the Navy, we're doing an awful lot of walking here." />
	</dialogue>    
	
	
   <!-- commander comments -->
	<comment key="we captured a base" text="Our Marines have cleared out %base_name!" />
	<comment key="enemy captured a base" text="The Japanese have captured %base_name, prepare to counter-attack!" />
	<comment key="enemy captured a base" text="The Japanese have overrun %base_name." />
	<comment key="our base is under attack" text="We've got reports of Japanese forces attacking %base_name." />
	<comment key="fighting near a base" text="Gun shots fired near %base_name" />
	
	
   <!-- adventure mode -->
	<comment key="guadalcanal intro, part 1" text="Attention, incoming commander briefing" />
	<comment key="guadalcanal intro, part 2" text="The Navy just left - we're alone out here." />
	<comment key="guadalcanal intro, part 3" text="And what's worse, the Japanese look like they're going to hit this line with everything they've got." />
	<comment key="guadalcanal intro, part 4" text="Hold the line, and hold the Airfield at all costs!" />
	<comment key="guadalcanal intro, part 5" text="The enemy will be approaching over the river, be prepared." />
	<comment key="guadalcanal intro, part 6" text="Good luck and God speed, soldiers! You should have about 30 seconds to get into position!" />
	<comment key="guadalcanal intro, part 7" text="The enemy is probing us, it won't be long now!" />
	
	<comment key="guadalcanal stage 1" text="Enemy bombardment, get to cover! (Phase 1 started)" />
	<comment key="guadalcanal stage 2" text="Second wave incoming! (Phase 2 started)" />
	<comment key="guadalcanal stage 3" text="Tanks! They've got tanks! (phase 3 started)" />
	<comment key="guadalcanal stage 4" text="The enemy aren't letting up, keep up the defense! (phase 4 started)" />
	<comment key="guadalcanal stage 5" text="Looks like they're regrouping for another wave - set up more defenses! (2 min break started)" />
	<comment key="guadalcanal stage 6" text="The Army just landed, but the enemy doesn't look too keen on stopping their attack.  (phase 6 started)" />
	<comment key="guadalcanal stage 7" text="The Navy's back with the big guns! Give 'em hell!" />
	<comment key="guadalcanal stage 8" text="Counter-attack!" />
	
	<comment key="map start with 1 base, part 3" text="The fleet arrived today and have prepared for landing operations."/>
	
	<comment key="map start with 1 base, capture" text="Now we're ready to launch the invasion, the objective is to capture %map_name completely" />
	
	<comment key="map advance, held by enemy" text="Our battalion S-2 says that %map_name is the next strategic target. The %faction_name have dug in tight as a tick." />
	<comment key="map advance, new map" text="The division is preparing another landing force, let's move!" />
	
	<comment key="final map, part 1" text="Attention, incoming commander briefing" />
	<comment key="final map, part 2" text="Good to have you all here at %map_name" />
	<comment key="final map, part 3" text="This is it - the enemy mainland!" />
	<comment key="final map, part 5" text="Island after island, battle after battle we've pushed back the %faction_name." />
	<comment key="final map, part 6" text="But here and now, Operation Downfall has already begun." />
	<comment key="final map, part 7" text="Win this battle and end this war, once and for all!" />
	
   <!-- reinforcement commander lines -->
	<comment key="spawn_in_base_call, accepted, key=usmc_inf.call" text="Army rifles squad dispatched to %base_name" />
	<comment key="spawn_in_base_call, accepted, key=usmc_vehicle.call" text="M3 Stuart deploying at %base_name" />
	<comment key="spawn_in_base_call, accepted, key=usmc_vehicle1.call" text="LVT-4 deploying at %base_name" />
	<comment key="spawn_in_base_call, accepted, key=usf_vehicle_m4_sherman.call" text="M4A3 Sherman deploying at %base_name" />
	<comment key="spawn_in_base_call, denied, key=usmc_inf.call" text="No valid deployment points found, capture a base!" />
	<comment key="spawn_in_base_call, denied, key=usmc_vehicle.call" text="No valid deployment points found, capture a base!" />
	<comment key="spawn_in_base_call, denied, key=usmc_vehicle1.call" text="No valid deployment points found, capture a base!" />
	<comment key="spawn_in_base_call, denied, key=usf_vehicle_m4_sherman.call" text="No valid deployment points found, capture a base!" />

	<comment key="spawn_in_base_call, accepted, key=usf_vehicle_armoury_marine.call" text="DUKW Armory deploying at %base_name" />
	<comment key="spawn_in_base_call, denied, key=usf_vehicle_armoury_marine.call" text="No valid deployment points found, capture a base!" />
	
   <!-- character specific animation override table -->
	<animation key="recoil, pistol, 2hand" target_key="recoil, pistol" />
	<animation key="reloading, pistol, 2hand" target_key="reloading, pistol, pacific" />
	<animation key="still, pistol, 2hand" target_key="hold, pistol" />
	<animation key="crouch, pistol, 2hand" target_key="crouch, pistol" />
	<animation key="reloading, c96 pistol, 2hand" target_key="reloading, c96 pistol"/>
	<animation key="reloading, enfield pistol, 2hand" target_key="reloading, enfield pistol"/>
	
</character>