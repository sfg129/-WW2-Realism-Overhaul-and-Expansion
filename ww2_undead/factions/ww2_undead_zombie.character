  <animation key="still, heavy weapon"	animation_key="still, zombie" />
  <animation key="crouch still, no weapon, 62" target_key="still, zombie" />
  <animation key="stabbing" target_key="stabbing, zombie" />
  <animation key="walking" target_key="walking, zombie" />
