<?xml version="1.0" encoding="utf-8"?>
<ai filename="sentry.ai">


  <parameter class="strike_frequency_time" value="3.0" /> <!--90-->
  <parameter class="check_reinforcement_need_time" value="3.0" /> <!--30-->
  <parameter class="force_comparison_multiplier_to_call_reinforcements" value="0.001" /> <!--1.1-->
  <parameter class="call_reinforcements_max_distance" value="50.0" />


  <parameter class="force_as_leader" value="1.0" />

  <parameter class="dive_from_grenade_probability" value="0.5" />

  <parameter class="max_leader_authority_willing_to_join_another_squad" value="0.0" />
  <parameter class="defending_authority_offset_to_join_squad" value="10.0" />

  <parameter class="active_guarding_probability" value="1.0" />
  <parameter class="willingness_to_guard" value="1.0" />

  <parameter class="willingness_to_charge" value="0.0" />

  <parameter class="throw_grenade_time_interval_max" value="7.0" />
  <parameter class="throw_grenade_time_interval_min" value="2.0" />
  <parameter class="min_distance_to_throw_grenade" value="15.0" />
  <parameter class="max_distance_to_throw_grenade" value="40.0" />
  <parameter class="min_number_of_enemies_to_throw_grenade" value="1.0" />


	<!-- officer needs to have short burst times in this file AND in weapon settings to make pistol shoot somewhat fast -->
  <parameter class="shooting_accuracy_ratio_requirement" value="0.4" />  	<!-- 0.6 in vanilla. this determines when the AI considers it OK to fire based on accuracy -->
  <parameter class="burst_time" value="0.25" />					<!-- also affects how fast semi-autos fire, so improved -->
  <parameter class="burst_time_variance" value="0.05" />
  <parameter class="choose_enemy_time" value="1.0" />				<!-- 1.0 is default -->

</ai>
