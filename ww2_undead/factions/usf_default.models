	<!-- ------- -->
	<!-- weapons -->
	<!-- ------- -->

	<!-- we have to overwrite the default model with one that has no backpack, just so it doesn't clip the flamethrower tank -->
	<!-- unfortunately this means we have to do FULL vest handling with flamethrower, which is tedious, but.. well.. necessary for reliability -->

	<model filename="soldier_usf_paratrooper_1.xml">
		<requirement class="weapon" slot="0" key="type93_flamethrower.weapon" />
	</model>
	<model filename="soldier_usf_paratrooper_1.xml">
		<requirement class="weapon" slot="0" key="m2_flamethrower.weapon" />
	</model>

