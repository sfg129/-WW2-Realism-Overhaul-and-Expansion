	/>

		<!-- DESPITE ITS NAME -->
		<!-- this is actually just a sword now. -->

	
	<animation key="recoil" animation_key="melee, 1hand sword" />
	<animation key="recoil" stance_key="over_wall" ref="melee, 1hand sword" />
	<animation state_key="reload"	animation_key="reloading, resurrector" />
