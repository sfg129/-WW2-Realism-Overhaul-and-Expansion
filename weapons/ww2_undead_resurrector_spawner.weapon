<?xml version="1.0" encoding="utf-8"?>
<weapon key="ww2_undead_resurrector_spawner.weapon" time_to_live_out_in_the_open="0.0" drop_count_factor_on_death="0.0">
	<tag name="assault" />
<access_tag name="ww2" />
	
	<specification 
	retrigger_time="-1" 
	spread_range="0.125"
	accuracy_factor="1" 
	sustained_fire_grow_step="3.0" 
