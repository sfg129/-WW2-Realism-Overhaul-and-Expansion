<?xml version="1.0" encoding="utf-8"?>
<weapon on_ground_up="0 0 1" time_to_live_out_in_the_open="60.0" drop_count_factor_on_death="1">
	<tag name="assault" />
	
	<specification
	spread_range="0.285"
	sustained_fire_diminish_rate="2"
	sight_range_modifier="1.1"
/>

	<!-- stance accuracy rate is default 8.0 -->
	
	<animation key="recoil" stance_key="prone" animation_key="recoil1, big, prone" />
	
	<modifier class="speed" value="-0.04" />

	<sound class="impact" fileref="rifle_drop.wav" />
	
	<stance state_key="running" accuracy="0.4" />
	<stance state_key="walking" accuracy="0.5" />
	<stance state_key="crouch_moving" accuracy="0.6" />
		<stance state_key="prone_moving" accuracy="0.6" />
	<stance state_key="standing" accuracy="0.9" />
	<stance state_key="crouching" accuracy="0.95" />
	<stance state_key="prone" accuracy="1.1" /> 
	<stance state_key="over_wall" accuracy="1.1" />		
	
</weapon>
