<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_primary_rifle.weapon" key="svt40.weapon">
	<tag name="assault" />

	<!--<access_tag name="easternfront" />-->

	<specification 
	retrigger_time="0.2" 
	accuracy_factor="0.95" 
	spread_range="0.28"
	sustained_fire_grow_step="0.95" 
	sustained_fire_diminish_rate="2.45"
	magazine_size="11" 
	can_shoot_standing="1" 
	suppressed="0" 
	name="SVT-40" 
	class="4" 
	burst_shots="1"
	reload_one_at_a_time="1" 
	projectile_speed="130" 
	barrel_offset="0.6" 
	projectiles_per_shot="1"
	/>

	<!-- the SVT-40 is reknowned for unusually poor accuracy due to a problem with its floating barrel -->
	<!-- however, it is also known for an exceptionally excellent muzzle brake that reduced its recoil to almost nothing -->
	<!-- both of these aspects are simulated in its balance -->

	<!-- crouching is 0.915 -->
	

	<next_in_chain key="svt40_b.weapon" share_ammo="1" />

	<animation key="recoil" ref="27" />
	<animation key="cycle" ref="30" />
	<animation key="reload" animation_key="reloading, g432" />
	<animation key="reload" stance_key="prone" animation_key="reloading, g432, prone" />
		<sound key="effect" fileref="kar43_reload.wav" pitch_variety="0" />
	<control key="effect" value="1" />
	<weak_hand_hold offset="0.3" />
		
	<sound key="fire" fileref="weapon_rifle_svt40.wav" pitch_variety="0.05" volume="1.65"/>

	<sound key="magazine_out" fileref="rifle_clip_out.wav" />
	<sound key="magazine_in" fileref="rifle_clip_in.wav" />
	<sound key="cycle" fileref="rifle_chamber.wav" />
	
	<model filename="weapon_svt40.xml" />
	<hud_icon filename="hud_svt40.png" />
	
	<commonness value="0.0275" can_respawn_with="1"/>
	<inventory encumbrance="8.0" price="30.0" />
	
	<projectile file="bullet.projectile">
		<result 
		class="hit" 
		kill_probability="1.9" 
		kill_decay_start_time="0.5" 
		kill_decay_end_time="0.9"
		/>
	</projectile>
	
</weapon>
