<?xml version="1.0" encoding="utf-8"?>
<projectile class="grenade" name="strafing run" slot="1" time_to_live="4.0" radius="2.0" pulldown_in_air="0" key="strafing_run.projectile" >
	<tag name="strafing run"/>
	
		
	<sound class="result" key="other" fileref="mortar_01.wav" volume="2.0" pitch_variety="0.1"/>
	<sound class="result" key="other" fileref="mortar_02.wav" volume="2.0" pitch_variety="0.1"/>
	<sound class="result" key="other" fileref="mortar_03.wav" volume="2.0" pitch_variety="0.1"/>
	
	<sound class="result" key="terrain" copy="other" />
	<sound class="result" key="vehicle" copy="other" />
	<sound class="result" key="static_object" copy="other" />
	<sound class="result" key="character" fileref="body_hit_explosive_ammo.wav" pitch_variety="0.1" volume="0.6"/>

	<!-- radius was 5.0 in edel release, 2.75 in 1.87, 3.0 in 1.88 -->
	<trigger class="impact" />
	<result
	class="blast"
	radius="3.6"
	damage="4.2"
	push="0.0"
	decal="0"
	/>
	
	<model mesh_filename="40mm.mesh" texture_filename="40mm.png" />
	
	<rotation class="motion" />
	
  	<effect class="result" key="terrain" ref="OstvetSmokeBigSphere" />
   	<effect class="result" key="terrain" ref="OstvetHitSparks" />
    <effect class="result" key="terrain" ref="OstvetBurstShine" lighting="0" />

	<effect class="result" key="terrain" ref="HitTank" lighting="1" />
   	<effect class="result" key="terrain" ref="HitTankSparks" />
	<effect class="result" key="terrain" ref="SmokeBurst" post_processing="1" />
    <effect class="result" key="terrain" ref="Godray" lighting="0" />


	
	<effect class="result" key="static_object" copy="terrain" />
	<effect class="result" key="vehicle" copy="terrain" />
	<effect class="result" key="character" copy="terrain" />
		
    <effect class="result" type="splat_map" surface_tag="" size="2.0" atlas_index="0" layer="1" />
    <effect class="result" type="splat_map" surface_tag="" size="4.0" atlas_index="4" layer="0" />
    <effect class="result" type="splat_map" surface_tag="" size="5.0" atlas_index="0" layer="2" additive="0" /> <!-- remove top snow everywhere -->

	
	<trail probability="1.0" />
	
</projectile>
