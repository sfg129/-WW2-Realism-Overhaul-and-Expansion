<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_primary_heavy_bipod.weapon" key="mg34.weapon">
	
<access_tag name="edelweiss" />

	<specification 
	retrigger_time="0.0775" 
	accuracy_factor="0.9" 
    	sustained_fire_grow_step="0.18" 
    	sustained_fire_diminish_rate="2" 
	stance_accuracy_rate="1.0"
	magazine_size="50" 
	can_shoot_standing="1" 
	can_shoot_crouching="1" 
	suppressed="0" 
	name="MG 34" 
	class="0" 
	barrel_offset="0.85" 
	projectile_speed="120.0"
	/>
	<modifier class="speed" value="-0.1" />  
	<!-- when this gun was a mid-tier rare, it had: projectile speed 125, accuracy 0.81, stance rate 0.75, kill prob 0.5, decay start 0.35, prone/wall accuracy 1.15 -->	
	<!-- more recently recoil was 0.2175 -->

	<stance state_key="running" accuracy="0.1" />
	<stance state_key="walking" accuracy="0.2" />
	<stance state_key="standing" accuracy="0.2" />
	<stance state_key="crouching" accuracy="0.3" />
	<stance state_key="prone" accuracy="1.1" />
	<stance state_key="over_wall" accuracy="1.1" />  

	<animation key="recoil" ref="12" />
	<animation key="recoil" ref="13" />
	<animation key="recoil" ref="14" />
	<animation state_key="reload" animation_key="reloading, mg34" />
	<animation state_key="reload" stance_key="prone" animation_key="reloading, mg34, prone" />
		<animation state_key="hold_on_wall" animation_key="still" />
    	<animation state_key="hold" animation_key="hold, lmg" />
		<animation state_key="walking" animation_key="walking, heavy weapon" />
		<animation state_key="walking_backwards" animation_key="walking backwards, heavy weapon" />
		<animation state_key="crouching" animation_key="crouch, hold, hip fire" />
		<animation state_key="crouch_moving" animation_key="crouching forwards, hip fire" />
		<animation state_key="crouch_moving_backwards" animation_key="crouching backwards, hip fire" />
	
	<weak_hand_hold offset="0.4" />
	
	<sound class="operation" key="fire" fileref="weapon_mg_mg34.wav" pitch_variety="0.05" volume="1.75"/>

	<sound key="magazine_out" fileref="mg_clip_out.wav" />
	<sound key="magazine_in" fileref="mg_clip_in.wav" />
	<sound key="cycle" fileref="rifle_chamber.wav" />
	
	<model filename="weapon_mg34.xml" />
	<hud_icon filename="hud_mg34_drum.png" />
	
	<commonness value="0.05" can_respawn_with="1" />
	<inventory encumbrance="15.0" price="30.0" />
	
	<capacity value="0" source="rank" source_value="0.0" />
	<capacity value="1" source="rank" source_value="0.0" />
	
	<!-- decay start was 0.375, damage 0.515 -->
	<projectile file="bullet.projectile">
		<result
		class="hit"
		kill_probability="0.88"
		kill_decay_start_time="0.475"
		kill_decay_end_time="0.73"
		/>
	</projectile>
	
</weapon>
