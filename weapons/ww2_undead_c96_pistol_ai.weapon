<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_secondary_pistol.weapon" key="ww2_undead_c96_pistol_ai.weapon" drop_count_factor_on_death="0.0"
	ai_burst_time="0.2" 
	ai_burst_time_variance="0.05" 
	ai_burst_wait_time="0.15" 
	ai_burst_wait_time_variance="0.1">


<access_tag name="edelweiss" />

	<specification
	retrigger_time="0.155"
	accuracy_factor="0.9"
	sustained_fire_grow_step="0.55"
	magazine_size="10"
	carry_in_two_hands="0"
	can_shoot_standing="1"
	suppressed="0"
	name="C96 Red 9"
	class="4"
	reload_one_at_a_time="0" 
	projectile_speed="100.0" 
	barrel_offset="0.0"
	projectiles_per_shot="1"
	burst_shots="1"

	slot="0"
	/>

	<!-- AI versions of these weapons are worse than player versions to reduce the frustration of getting insta-killed so often -->
	<!-- they have lower damage, lower velocity, and lose the mild sight range boost for bolt-actions -->
	<!-- when the AI dies with them they must transform into their normal version, handled below. a requirement with this is drop-count factor on death be 0 -->
	<drop_on_death_result class="spawn" instance_class="weapon" instance_key="c96_pistol.weapon" min_amount="1" max_amount="1" offset="0 1.0 0" position_spread="0 0" direction_spread="0 0" />


	<!-- recoil was 0.5 and accuracy 0.92 but felt a bit op -->

	<!-- c96 is set to be less accurate when moving, similar to how revolvers are -->
	<stance state_key="running" accuracy="0.56" />
	<stance state_key="walking" accuracy="0.58" />
	<stance state_key="crouch_moving" accuracy="0.58" />

	<animation state_key="reload" animation_key="reloading, c96 pistol, 2hand" />
	<animation state_key="reload" stance_key="prone" animation_key="reloading, c96 pistol, prone" />

	<weak_hand_hold offset="0.1" />

	<sound key="fire" fileref="pistol_02_c96.wav" pitch_variety="0.05" volume="2.49"/>
    	<sound key="reload_one" fileref="park_off.wav" />
	<sound key="magazine_in" fileref="park_off.wav" />
	<sound key="cycle_in" fileref="rifle_clip_in.wav" />
	
	<model filename="weapon_c96_pistol.xml" />
	<hud_icon filename="hud_c96_pistol.png" />
	
	<commonness value="1.0"/>
	<inventory encumbrance="1.0" price="25.0" />
	
	<capacity value="0" source="rank" source_value="0.0" />
	<capacity value="1" source="rank" source_value="0.0" />
	
	<!-- dmg start was 0.3 with old reload speed, but now that reload is slightly nerfed, range is buffed -->
	<projectile file="bullet.projectile">
		<result
		class="hit"
		kill_probability="0.85"
		kill_decay_start_time="0.3"
		kill_decay_end_time="0.5"
		/>
	</projectile>
	
</weapon>
