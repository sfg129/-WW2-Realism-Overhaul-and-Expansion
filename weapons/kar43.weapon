<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_primary_rifle.weapon" key="kar43.weapon">
	<tag name="assault" />
	
<access_tag name="edelweiss" />

	<specification 
	retrigger_time="0.12" 
	accuracy_factor="0.95" 
	spread_range="0.28"
	sustained_fire_grow_step="1.1" 
	sustained_fire_diminish_rate="2.4"
	magazine_size="11" 
	can_shoot_standing="1" 
	suppressed="0" 
	name="Gewehr 43" 
	class="4" 
	burst_shots="1"
	reload_one_at_a_time="1" 
	projectile_speed="130.0" 
	barrel_offset="0.6" 
	projectiles_per_shot="1"
	/>
	<!-- recoil recovery was 1.4, fire time 0.235 -->

	<!-- G 43 balance was redesigned with Eastern Front. We're now pretending it is firing late-war 8mm Mauser -->
	<!-- this ammo is lighter and higher velocity, with a bit less recoil -->
	<!-- accuracy has also been reduced since this weapon fires from short-relief iron sights while the M1 Garand has long-relief aperture sights -->
	<!-- though technically the base accuracy factor is now the same as Garand, velocity is lower, which reduces this accuracy -->
	<!-- compared to the G 41, the G 43 (at least when watching in slow-motion) appears to have a noteworthy advantage:  -->
	<!-- the travel of the bolt forwards after cycling pushes the whole gun down, recovering some of the recoil automatically (G 41 does not) -->

	<animation key="recoil" ref="27" />
	<animation key="cycle" ref="30" />
	<animation key="reload" animation_key="reloading, g432" />
	<animation key="reload" stance_key="prone" animation_key="reloading, g432, prone" />
		<sound key="effect" fileref="kar43_reload.wav" pitch_variety="0" />
	<control key="effect" value="1" />
	<weak_hand_hold offset="0.3" />
		
	<sound key="fire" fileref="weapon_rifle_kar43.wav" pitch_variety="0.05" volume="1.75"/>
	<sound key="magazine_out" fileref="rifle_clip_out.wav" />
	<sound key="magazine_in" fileref="rifle_clip_in.wav" />
	<sound key="cycle" fileref="rifle_chamber.wav" />
	
	<model filename="weapon_k43.xml" />
	<hud_icon filename="hud_kar43.png" />
	
	<commonness value="0.06" can_respawn_with="1"/>
	<inventory encumbrance="8.0" price="30.0" />
	
	<capacity value="0" source="rank" source_value="0.0" />
	<capacity value="1" source="rank" source_value="0.0" />
	
	<projectile file="bullet.projectile">
		<result 
		class="hit" 
		kill_probability="1.5"
		kill_decay_start_time="0.59"
		kill_decay_end_time="0.9"
		/>
	</projectile>
	
</weapon>
