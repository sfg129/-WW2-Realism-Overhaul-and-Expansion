<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_primary_lmg_crouch_fire.weapon" key="breniii.weapon"
	ai_burst_time="1.5" 
	ai_burst_time_variance="0.5" 
	ai_burst_wait_time="0.2" 
	ai_burst_wait_time_variance="0.1"
>


<access_tag name="edelweiss" />

	<specification 
	retrigger_time="0.108" 
	accuracy_factor="0.95"
		spread_range="0.33"
	sustained_fire_grow_step="0.27"
	sustained_fire_diminish_rate="2"	
	stance_accuracy_rate="1.6"
	magazine_size="30" 
	can_shoot_standing="1" 
	can_shoot_crouching="1" 
	suppressed="0" 
	name="Bren Mk III LMG" 
	class="0" 
	barrel_offset="0.6" 
	projectile_speed="125.0"
	/>

	<!-- RoF was formerly 0.1175 -->
	<!-- compared to an LMG such as the Type 96, the Bren is more accurate and powerful, but has more recoil. -->

				<stance state_key="running" accuracy="0.45" />
	<stance state_key="walking" accuracy="0.7" />
	<stance state_key="crouch_moving" accuracy="0.75" />
	<stance state_key="prone_moving" accuracy="0.75" />
	<!-- was 0.925 -->

	<stance state_key="standing" accuracy="0.9" />
	<stance state_key="crouching" accuracy="0.95" />
	<stance state_key="prone" accuracy="1.2" />
	<stance state_key="over_wall" accuracy="1.2" />   
	

		<modifier class="speed" value="-0.08" />
	<animation key="recoil" ref="12" />
	<animation key="recoil" ref="13" />
	<animation key="recoil" ref="14" />
	<animation key="recoil" stance_key="over_wall" ref="12" />
	<animation key="recoil" stance_key="over_wall" ref="13" />
	<animation key="recoil" stance_key="over_wall" ref="14" />


	<animation key="recoil" stance_key="over_wall" ref="12" />
	<animation key="recoil" stance_key="over_wall" ref="13" />
	<animation key="recoil" stance_key="over_wall" ref="14" />
	<animation state_key="reload" animation_key="reloading, type 96" />
	<animation state_key="reload" stance_key="prone" animation_key="reloading, type 96, prone" />
		<animation state_key="hold_on_wall" animation_key="still" />

		<animation state_key="walking" animation_key="walking, hip fire" />
		<animation state_key="walking_backwards" animation_key="walking backwards, hip fire" />

		<animation state_key="crouch_moving" animation_key="crouching forwards, hip fire" />
		<animation state_key="crouch_moving_backwards" animation_key="crouching backwards, hip fire" />
	
	<weak_hand_hold offset="0.4" />
	
	<sound key="fire" fileref="weapon_mg_bren3.wav" pitch_variety="0.05" volume="0.4"/>
	<sound key="magazine_out" fileref="rifle_clip_out.wav" />
	<sound key="magazine_in" fileref="rifle_clip_in.wav" />
	<sound key="cycle" fileref="rifle_chamber.wav" />
	
	<model filename="weapon_bren_mkiii.xml" />
	<hud_icon filename="hud_bren_mkiii.png" />
	
	<commonness value="0.02" in_stock="0"/>
	<inventory encumbrance="8.0" price="30" />
	
	<capacity value="0" source="rank" source_value="0.0" />
	<capacity value="1" source="rank" source_value="0.0" />
	
	<projectile file="bullet.projectile">
		<result
		class="hit"
		kill_probability="0.95" 
		kill_decay_start_time="0.59"
		kill_decay_end_time="0.9" />
	</projectile>
	
</weapon>
