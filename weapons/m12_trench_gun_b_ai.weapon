<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_primary_shotgun.weapon" key="m12_trench_gun_b_ai.weapon" drop_count_factor_on_death="0.0">
	<tag name="assault" />
	<tag name="has_bayonet" />

<access_tag name="ww2" />
	
	<specification 
	retrigger_time="-1.0" 
	accuracy_factor="0.812"
	sustained_fire_grow_step="4.0" 

	magazine_size="7" 
	can_shoot_standing="1" 
	suppressed="0" 
	name="M12 Trench Gun Bayonet" 
	class="1" 
	reload_one_at_a_time="1" 
	projectile_speed="100" 
	projectiles_per_shot="9"
    stab_enabled="1"
    stab_range="3.5"
	/>

	<!-- AI version only to affect commonness on an Assault soldier -->
	<!-- when the AI dies with them they must transform into their normal version, handled below. a requirement with this is drop-count factor on death be 0 -->
	<drop_on_death_result class="spawn" instance_class="weapon" instance_key="m12_trench_gun_b.weapon" min_amount="1" max_amount="1" offset="0 1.0 0" position_spread="0 0" direction_spread="0 0" />
	
	<animation state_key="recoil" ref="27" />
	<animation state_key="cycle" ref="28" />
	<animation key="reload" animation_key="reloading, m12 trench gun" />
	<animation key="reload" stance_key="prone" animation_key="reloading, m12 trench gun, prone" />
	<animation key="cycle" stance_key="prone" animation_key="cycle pump action, prone" />
	<animation state_key="stabbing"	animation_key="melee, bayonet" />
	
	<weak_hand_hold offset="0.3" />
	
	<sound key="fire" fileref="shotgun_01.wav" pitch_variety="0.05" volume="1.5"/>
	<sound key="stab" fileref="grenade_throw1.wav" pitch_variety="0.05" volume="0.5"/>
	<sound key="cycle" fileref="mossberg500_cycle.wav" />
	<sound key="reload_one" fileref="mossberg500_reload.wav" />

	<model filename="m12_shotgun_b.xml" />
	<hud_icon filename="hud_m12_shotgun_b.png" />
	
	<commonness value="0.055" in_stock="1" can_respawn_with="1"/>
	<inventory encumbrance="8.0" price="60.0" />
	
	<capacity value="1" source="rank" source_value="0.0" />
	
	<!-- decay start was 0.3, end was 0.425, damage more recently was 0.6-->
	<projectile file="bullet.projectile">
		<result 
		class="hit"
		kill_probability="0.7"
		kill_decay_start_time="0.2"
		kill_decay_end_time="0.7"
		/>
	</projectile>
	
</weapon>
