<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_secondary.weapon" 
        key="light_mortar_resource.weapon" 
        time_to_live_out_in_the_open="240.0" drop_count_factor_on_death="0.4" drop_count_factor_on_player_death ="1.0" player_death_drop_owner_lock_time="30.0"
        on_ground_up="0 0 1" 
        radius="0.35">

    <tag name="engineer" />

    <specification
        magazine_size="1" 
        can_shoot_standing="0" 
        can_shoot_crouching="1" 
        carry_in_two_hands="1" 
        can_shoot_prone="0" 
        name="Light Mortar Deploy" 
        class="5" 
        spawn_instance_class="vehicle" 
        spawn_instance_key="light_mortar.vehicle"   
        consume="1" 
        sight_range_modifier="1" 
        slot="1"
        cover_deployment="1"
        deny_ladder_range="3.5"
        />


    <animation state_key="running"      animation_key="walking, carrying load" />
    <animation state_key="walking"      animation_key="walking, carrying load" />
    <animation state_key="hold"         animation_key="still, carrying load" />
    <animation state_key="hold_on_wall" animation_key="still, carrying load" />
    <animation state_key="hold_casual"  animation_key="still, carrying load" />
    <animation state_key="still_against_wall" animation_key="still, carrying load" />
    
    <animation state_key="recoil"       animation_key="deploy1" />
    <animation state_key="crouching"    animation_key="crouch still, carrying load" />
    <animation state_key="crouch_moving" animation_key="crouching forwards, carrying load" />
    <animation state_key="changing_weapon_in" animation_key="change weapon in, single hand carry" />

    <sound class="impact" fileref="sandbag_drop.wav" />


    <model mesh_filename="heavy_mortar_turret.mesh" texture_filename="heavy_mortar.png" />


    <capacity value="1" source="rank" source_value="0.0" />

    <hud_icon filename="hud_mortar_d.png" />
    <commonness value="0.005" can_respawn_with="0" />

    <inventory encumbrance="26.0" price="600.0" />   

    <modifier class="speed" value="-0.5" />  

</weapon>