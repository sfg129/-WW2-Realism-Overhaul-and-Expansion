<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_secondary_pistol.weapon" key="enfield_mkii_revolver.weapon">
   
<access_tag name="edelweiss" />

	<specification
	retrigger_time="0.25"
	accuracy_factor="0.95"
	sustained_fire_grow_step="0.9"
	sustained_fire_diminish_rate="4"

	magazine_size="6"
	carry_in_two_hands="0"
	can_shoot_standing="1"
	suppressed="0"
	name="Enfield No.2 Mk I"
	class="4"
	reload_one_at_a_time="0"
	projectile_speed="100.0"
	barrel_offset="-0.1"
	projectiles_per_shot="1"
	burst_shots="1"
	slot="1"
	/>

	<!-- revolvers are less accurate when moving -->
	<stance state_key="running" accuracy="0.575" />
	<stance state_key="walking" accuracy="0.6" />
	<stance state_key="crouch_moving" accuracy="0.6" />
	
	<weak_hand_hold offset="0.1" />
	
	<!-- note: figure out a way to clear all previous animations from a base file if possible-->
	<animation state_key="reload" animation_key="reloading, enfield pistol, 2hand" />
	<animation state_key="reload" stance_key="prone" animation_key="reloading, enfield pistol, prone" />

	<sound key="fire" fileref="weapon_revolver_enfield_no2.wav" pitch_variety="0.05" volume="2.3" />
    <sound key="cycle_out" fileref="revolver_cycle_out.wav" volume="1" />
    <sound key="cycle_in" fileref="revolver_cycle_in.wav" volume="1" />
	
	<model filename="weapon_enfield_mkii_revolver.xml" />
	<hud_icon filename="hud_enfield_no2_revolver.png" />
	
	<commonness value="0.06" />
	<inventory encumbrance="1.0" price="30" />
	
	<capacity value="0" source="rank" source_value="0.0" />
	<capacity value="1" source="rank" source_value="0.0" />
	
	<projectile file="bullet.projectile">
		<result class="hit"
		kill_probability="0.65"
		kill_decay_start_time="0.35"
		kill_decay_end_time="0.5" />
	</projectile>
	
</weapon>
