<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_primary_carbine_smg.weapon" key="danuvia_43m.weapon" time_to_live_out_in_the_open="120.0" drop_count_factor_on_death="1.0" player_death_drop_owner_lock_time="60.0">

<access_tag name="edelweiss" />

	<specification 
	retrigger_time="0.081" 
	accuracy_factor="0.95" 
	spread_range="0.335"
	sustained_fire_grow_step="0.19" 
	sustained_fire_diminish_rate="2"
	magazine_size="40" 
	can_shoot_standing="1" 
	suppressed="0" 
	name="Danuvia 43M" 
	class="0" 
	projectile_speed="110"
	slot="0"
