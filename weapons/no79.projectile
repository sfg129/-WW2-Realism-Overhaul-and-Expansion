<?xml version="1.0" encoding="utf-8"?>
<projectile class="grenade" name="No.79 Smoke Grenade" key="no79.projectile" slot="0" radius="0.15" can_be_detected_by_driver="0" can_be_detected_by_footmen="0" drop_count_factor_on_death="0.5" time_to_live_out_in_the_open="60.0">
    <tag name="grenade" />
    <access_tag name="ww2" />

    <!-- Impact leaves a visible four-second delay body. The delay result then
         starts the 45-second visual and sight-blocking smoke sequence. -->
    <trigger class="impact" />
    <result class="spawn" instance_class="projectile" instance_key="no79_smoke_delay.projectile" min_amount="1" max_amount="1" offset="0 0 0" position_spread="0 0" direction_spread="0 0" />

    <sound class="result" key="other" fileref="burst.wav" volume="0.5" />
    <sound class="result" key="terrain" copy="other" />
    <sound class="result" key="static_object" copy="other" />
    <sound class="result" key="vehicle" copy="other" />
    <sound class="result" key="character" copy="other" />

    <model mesh_filename="no79.xml" />
    <hud_icon filename="hud_no79.png" />
    <rotation class="random" />
    <throwable curve_height="5" near_far_distance="12.0" speed_estimation_near="17.0" speed_estimation_far="17.0" max_speed="16.5" randomness="0.07" />
    <commonness value="0.1" can_respawn_with="1" />
    <inventory encumbrance="1.5" price="5.0" />
    <capacity value="4" source="rank" source_value="0" />
</projectile>
