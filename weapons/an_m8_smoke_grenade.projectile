<?xml version="1.0" encoding="utf-8"?>
<projectile class="grenade" name="AN-M8 smoke grenade" key="an_m8_smoke_grenade.projectile" slot="0" radius="0.15" can_be_detected_by_driver="0" can_be_detected_by_footmen="0" drop_count_factor_on_death="0.5" time_to_live_out_in_the_open="60.0">
    <tag name="grenade" />
    <access_tag name="ww2" />

    <!-- Keep the native projectile untouched for its entire flight. Its first
         impact creates a motionless visible delay body; only that body owns
         the two-second smoke fuze. -->
    <trigger class="impact" />
    <result class="spawn" instance_class="projectile" instance_key="an_m8_smoke_wait_for_landing.projectile" min_amount="1" max_amount="1" offset="0 0 0" position_spread="0 0" direction_spread="0 0" />

    <model mesh_filename="an_m8.xml" />
    <hud_icon filename="hud_an_m8.png" />
    <rotation class="random" />
    <throwable curve_height="5.5" near_far_distance="5.0" speed_estimation_near="12.0" speed_estimation_far="17.0" max_speed="17" randomness="0.07" />
    <commonness value="0.1" can_respawn_with="1" />
    <inventory encumbrance="1" price="4.0" />
    <capacity value="4" source="rank" source_value="0" />
</projectile>
