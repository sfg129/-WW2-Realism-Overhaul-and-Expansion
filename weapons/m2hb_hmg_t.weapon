<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_primary_heavy_bipod.weapon" key="m2hb_hmg_t.weapon"
	ai_burst_time="1" 
	ai_burst_time_variance="0.5" 
	ai_burst_wait_time="0.1" 
	ai_burst_wait_time_variance="0.05">
	<!-- these parameters are used to control AI burst times in vehicles. -->
	<!-- using these as default values for normal vehicle-born machine guns -->
	<!-- they must be placed on cannons too, occasionally, since the 'first weapon' is used to control burst times of all weapons-->

    <specification slot="0" 
    retrigger_time="0.114" 
    accuracy_factor="0.9" 
    spread_range="0.325"
    sustained_fire_grow_step="0.01303" 
    sustained_fire_diminish_rate="0.08"  
    sight_range_modifier="2"
    ai_sight_range_modifier="1"
    magazine_size="-1" 
    reload_one_at_a_time="0" 
    can_shoot_standing="0" 
    can_shoot_crouching="0" 
    suppressed="0" 
    name="M2HB" 
    class="0" 
    barrel_offset="0.85"
    projectile_speed="140.0" 
    sight_height_offset="2.0"
    cooldown_start="0.4"
    cooldown_end="0.0"/>

    <animation key="hold" ref="32" />
    <animation key="hold_on_wall" ref="1" />

	<!-- stats prior to 1.87: accuracy 0.85, spread not overwritten, recoil 0.25, recovery 0.7, velocity 110, damage 0.8 -->
    <target_factors tag="" distance="1.0" direction="0.0" squad_command="1.0" base_score="0.5" />
    <target_factors tag="bazooka" distance="1.0" direction="0.0" squad_command="1.0" base_score="8.0" />		<!-- Enemy AT Soldiers are priority for this MG -->
    <target_factors tag="light_armour" distance="1.0" direction="0.0" squad_command="1.0" base_score="6.0" />
    <target_factors tag="light_vehicle" distance="1.0" direction="0.0" squad_command="1.0" base_score="6.0" />
	<sound class="operation" key="fire" fileref="mg_04_m2hb.wav" pitch_variety="0.05" volume="1.8"/>
    <sound key="magazine_out" fileref="mg_clip_out.wav" />
    <sound key="magazine_in" fileref="mg_clip_in.wav" />
    <sound key="cycle" fileref="rifle_chamber.wav" />
    <model filename="willys_mb_mg.mesh" texture_filename="willys_mb.png" />

    <hud_icon filename="hud_m2hb.png" />
    <commonness value="0.0" />
    <inventory encumbrance="11.0" price="2.0" />

    <weak_hand_hold offset="0.4" />

	<!-- damage was 0.75 -->
    <projectile file="50cal_bullet.projectile">
        <result 
        class="blast"
    radius="1.5"
       damage="1.6"
    push="0.1"
    decal="1"
    damage_origin_vehicle="0"  
    faction_compare="not_equal" />
    </projectile>

	<sound key="cooldown" fileref="overheating_mg.wav" volume="0.4"/>
    
</weapon>
