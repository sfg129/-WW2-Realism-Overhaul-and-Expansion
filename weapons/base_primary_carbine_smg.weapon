<?xml version="1.0" encoding="utf-8"?>
<weapon on_ground_up="0 0 1" time_to_live_out_in_the_open="60.0" drop_count_factor_on_death="1">
	<tag name="cqb" />
	
	<specification
	spread_range="0.365"
	sustained_fire_diminish_rate="1.4"
	sight_range_modifier="1.1"
	/>

	<!-- stance accuracy rate is default 8.0 -->
	
	<animation key="recoil" stance_key="prone" animation_key="recoil1, prone" />
	<animation key="recoil" stance_key="prone" animation_key="recoil2, prone" />
	<animation key="recoil" stance_key="prone" animation_key="recoil3, prone" />
	
	<modifier class="speed" value="-0.03" />

	<sound class="impact" fileref="rifle_drop.wav" />

	<!-- I think default standing accuracy is 0.85 and crouching 0.9 -->
	<stance state_key="running" accuracy="0.55" />
	<stance state_key="walking" accuracy="0.8" />
	<stance state_key="crouch_moving" accuracy="0.8" />
	<stance state_key="prone_moving" accuracy="0.8" />
	<stance state_key="over_wall" accuracy="1" />     
	<stance state_key="standing" accuracy="0.9" />
	<stance state_key="crouching" accuracy="0.95" />
	<stance state_key="prone" accuracy="1.0" />
	<stance state_key="over_wall" accuracy="1.0" />     
</weapon>
