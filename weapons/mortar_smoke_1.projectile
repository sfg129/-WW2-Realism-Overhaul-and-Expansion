<?xml version="1.0" encoding="utf-8"?>
<projectile class="grenade" name="" key="mortar_smoke_1.projectile" slot="2" radius="0.15" can_be_detected_by_driver="0" drop_count_factor_on_death="1" time_to_live_out_in_the_open="60.0">

    <!-- Impact creates a zero-lifetime fan-out vehicle. It starts the visual
         smoke and burst immediately, then creates the sight blockers after a
         separate 0.5-second delay. -->
    <trigger class="impact" />
    <result class="spawn" instance_class="vehicle" instance_key="mortar_smoke_1_spawner.vehicle" min_amount="1" max_amount="1" offset="0 0 0" position_spread="0 0" direction_spread="0 0" />

    <sound class="result" key="other" fileref="no77.wav" volume="1.5" />
    <sound class="result" key="terrain" copy="other" />
    <sound class="result" key="static_object" copy="other" />
    <sound class="result" key="vehicle" copy="other" />
    <sound class="result" key="character" copy="other" />

    <model mesh_filename="mortar_shell.xml" />
    <rotation class="motion" />
    <commonness value="0" can_respawn_with="0" />
</projectile>
