<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_primary_carbine_smg.weapon" key="type100_folding.weapon" >
   
<access_tag name="pacific" />

	<specification 
	retrigger_time="0.133" 
	accuracy_factor="0.95" 
	sustained_fire_grow_step="0.16"
		sustained_fire_diminish_rate="1.45"
	magazine_size="30" 
	can_shoot_standing="1" 
	suppressed="0" 
	name="Type 100 Folding Stock" 
	class="0" 
	projectile_speed="100"
	slot="1"
	/>

	<!-- Type 100 SMG with Folding Stock, used for Paratroopers -->
	<!-- not featuring bipod like standard Type 100/40 -->

	<!-- balancing moving accuracy -->

	
	<animation key="recoil" ref="12" />
	<animation key="recoil" ref="13" />
	<animation key="recoil" ref="14" />
	<animation state_key="reload" animation_key="reloading, type 100" />
	<animation state_key="reload" stance_key="prone" animation_key="reloading, type 100, prone" />
	
	<weak_hand_hold offset="0.2" />
	
	<sound key="fire" fileref="smg_03_type100-44.wav" pitch_variety="0.05" volume="1.13"/> 	<!-- vol was 1.15 -->
	<sound key="magazine_out" fileref="rifle_clip_out.wav" />
	<sound key="magazine_in" fileref="rifle_clip_in.wav" />
	<sound key="cycle" fileref="rifle_chamber_mp40.wav" />
	
	<model filename="weapon_type100_40_paratrooper.xml" />
	<hud_icon filename="hud_type100_folding.png" />
	
	<commonness value="0.04" can_respawn_with="1"/>
	<inventory encumbrance="3.0" price="20"/>

	<capacity value="1" source="rank" source_value="0.0" />
	
	<!-- start decay was 0.26 -->
	<projectile file="bullet.projectile">
		<result
		class="hit"
		kill_probability="0.6"
		kill_decay_start_time="0.3"
		kill_decay_end_time="0.8"
		/>
	</projectile>
	
</weapon>
