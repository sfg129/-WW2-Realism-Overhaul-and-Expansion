<weapon file="base_primary_lmg_crouch_fire.weapon" key="charlton_automatic_rifle.weapon" time_to_live_out_in_the_open="90.0" drop_count_factor_on_death="1.0" player_death_drop_owner_lock_time="45.0" >
	
