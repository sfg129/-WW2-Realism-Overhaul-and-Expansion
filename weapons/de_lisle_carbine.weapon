<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_primary_rifle.weapon" key="de_lisle_carbine.weapon" time_to_live_out_in_the_open="90.0" drop_count_factor_on_death="0.375" drop_count_factor_on_player_death="1.0" player_death_drop_owner_lock_time="45.0">
	<tag name="cqb" />

<access_tag name="edelweiss" />

	<specification 
	retrigger_time="-1.0" 
	spread_range="0.3"
	accuracy_factor="0.97" 
	sustained_fire_grow_step="0.2" 
	sustained_fire_diminish_rate="1.0"
	magazine_size="8" 
	reload_one_at_a_time="1" 
	can_shoot_standing="1" 
	suppressed="1" 
	name="De Lisle Commando" 
	class="2" 
	
	projectile_speed="85" 
	barrel_offset="0.4" 
	projectiles_per_shot="1"
	/>

	<modifier class="speed" value="-0.05" />

	<stance state_key="running" accuracy="0.65" />
	<stance state_key="walking" accuracy="0.7" />
	<stance state_key="crouch_moving" accuracy="0.7" />
	<stance state_key="prone_moving" accuracy="0.7" />
	<stance state_key="standing" accuracy="0.9" />
	<stance state_key="crouching" accuracy="0.95" />  


	<animation key="recoil" ref="27" />
	<animation key="cycle" animation_key="bolt cycle" />
	<animation key="cycle" stance_key="prone" animation_key="bolt cycle, prone" />
	<animation key="reload" animation_key="reloading, delisle2" />
	<animation key="reload" stance_key="prone" animation_key="reloading, delisle2, prone" />
	
	<weak_hand_hold offset="0.3" />
	
	<sound key="fire" fileref="weapon_rifle_de_lisle_carbine.wav" pitch_variety="0.05" volume="1.4"/>
	<sound key="magazine_out" fileref="rifle_clip_out.wav" />
	<sound key="magazine_in" fileref="rifle_clip_in.wav" />
	<sound key="cycle_out" fileref="sniper_cycle_out.wav" />
	<sound key="cycle_in" fileref="sniper_cycle_in.wav" />
		<sound key="effect" fileref="delisle_reload.wav" pitch_variety="0" />
	<control key="effect" value="1" />

	<model filename="weapon_de_lisle.xml" />
	<hud_icon filename="hud_de_lisle.png" />
	
	<commonness value="0.004" can_respawn_with="0" in_stock="1"/>
	<inventory encumbrance="5.0" price="500"/>
	
	<capacity value="0" source="rank" source_value="0.0" />
	<capacity value="1" source="rank" source_value="1.0" />
	
	<!-- while undetected, stealth weapons that strike with any kill% chance >0 get raised up to 1.0 (unless they already are above that) -->
	<!-- kill_probability_offset_on_successful_hit adds on top of this, raising damage further -->

	<!-- total de lisle kill% on a successful hit in short range is 2.55 -->
	<projectile file="bullet.projectile">
		<result
		class="hit"
	kill_probability="0.8"
	kill_decay_start_time="0.25"
	kill_decay_end_time="0.8"
		/>
	</projectile>
	
</weapon>
