<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_primary_carbine_smg.weapon" key="m1928a1_thompson.weapon">
	
<access_tag name="edelweiss" />

	<specification 
	retrigger_time="0.09"
	accuracy_factor="0.94" 

	sustained_fire_grow_step="0.19" 
	sustained_fire_diminish_rate="1.8"
	magazine_size="30" 
	can_shoot_standing="1" 
	suppressed="0" 
	name="M1928A1 Thompson" 
	class="0" 
	projectile_speed="91.0"
	/>
	<next_in_chain key="m1928a1_thompson_drum.weapon" share_ammo="0" />
	<animation state_key="next_in_chain_in" animation_key="ammo switch2" />


	<!-- M1928A1 Thompson with 30round mag and muzzle recoil compensator. -->

	<!-- simple SMG sight ; though technically an aperture, it is often regarded as a horrible one -->

	<modifier class="speed" value="-0.04" />  
	<!-- certain weapons like the MP 40 and StG 44 have reduced prone accuracy, due to the height of the weapon with magazine colliding with the ground. -->
	
	
	<animation key="recoil" ref="12" />
	<animation key="recoil" ref="13" />
	<animation key="recoil" ref="14" />
	<animation key="reload" animation_key="reloading, m1a1 thompson" />
	<animation key="reload" stance_key="prone" animation_key="reloading, m1a1 thompson, prone" />
	
	<weak_hand_hold offset="0.2" />
	
	<sound key="fire" fileref="smg_01_thompson.wav" pitch_variety="0.05" volume="2.05"/>	<!-- was 1.9 with old sound -->
	<sound key="magazine_out" fileref="rifle_clip_out.wav" />
	<sound key="magazine_in" fileref="rifle_clip_in.wav" />
	<sound key="cycle" fileref="rifle_chamber_mp40.wav" />
	
	<model filename="weapon_m1928a1_thompson.xml" />
	<hud_icon filename="hud_m1928a1_thompson.png" />
				<sound key="effect" fileref="ammo_switch2.wav" pitch_variety="0" />
	<control key="effect" value="1" />
	<commonness value="0.03" can_respawn_with="1"/>
	<inventory encumbrance="5.0" price="50" />
	
	<capacity value="0" source="rank" source_value="0.0" />
	<capacity value="1" source="rank" source_value="0.0" />
	
	<projectile file="bullet.projectile">
		<result
		class="hit"
	kill_probability="0.85"
	kill_decay_start_time="0.25"
	kill_decay_end_time="0.8"
		/>
	</projectile>
	
</weapon>
