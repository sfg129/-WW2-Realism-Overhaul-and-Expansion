<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_primary_carbine_smg.weapon" key="mp34_o_b_ai.weapon" drop_count_factor_on_death="0.0">
	<tag name="has_bayonet" />

<access_tag name="edelweiss" />

	<specification 
	retrigger_time="0.095" 
	accuracy_factor="0.95" 
	sustained_fire_grow_step="0.175" 
	sustained_fire_diminish_rate="1.6"
	stance_accuracy_rate="2.5"
	magazine_size="32" 
	can_shoot_standing="1" 
	suppressed="0" 
	name="MP 34(o) Bayonet" 
	class="0" 
	projectile_speed="103.0"
    stab_enabled="1"
    stab_range="3.3"
	/>

	<!-- AI version only to affect commonness on an Assault soldier -->
	<!-- when the AI dies with them they must transform into their normal version, handled below. a requirement with this is drop-count factor on death be 0 -->
	<drop_on_death_result class="spawn" instance_class="weapon" instance_key="mp34_o_b.weapon" min_amount="1" max_amount="1" offset="0 1.0 0" position_spread="0 0" direction_spread="0 0" />

	<!-- simple SMG sight -->


	<!-- This is the 9mm MP 34, we couldn't use the old file because people still would have Type STE's in their stash. -->
	
	<animation key="recoil" ref="12" />
	<animation key="recoil" ref="13" />
	<animation key="recoil" ref="14" />
	<animation state_key="reload" animation_key="reloading, type 100" />
	<animation state_key="reload" stance_key="prone" animation_key="reloading, type 100, prone" />
	<animation state_key="stabbing"	animation_key="melee, bayonet" />
	
	<weak_hand_hold offset="0.2" />
	
	<sound key="fire" fileref="weapon_smg_mp34.wav" pitch_variety="0.05" volume="1.21"/>
	<sound key="magazine_out" fileref="rifle_clip_out.wav" />
	<sound key="magazine_in" fileref="rifle_clip_in.wav" />
	<sound key="cycle" fileref="rifle_chamber_mp40.wav" />
	<sound key="stab" fileref="grenade_throw1.wav" pitch_variety="0.05" volume="0.5"/>
	
	<model filename="weapon_mp34_o_smg_b.xml" />
	<hud_icon filename="hud_mp34_o_b.png" />

	<commonness value="0.025" can_respawn_with="1"/>
	<inventory encumbrance="5.0" price="25.0"/>
	
	<capacity value="0" source="rank" source_value="0.0" />
	<capacity value="1" source="rank" source_value="0.0" />
	
	<projectile file="bullet.projectile">
		<result
		class="hit"
		kill_probability="0.65"
		kill_decay_start_time="0.35"
		kill_decay_end_time="0.8"
		/>
	</projectile>
	
</weapon>
