<?xml version="1.0" encoding="utf-8"?>
<projectile class="grenade" name="Hawkins grenade" key="hawkins_grenade.projectile" slot="0" radius="0.15" drop_count_factor_on_death="0.5"

can_be_disarmed="1" 
disarm_instance_class="projectile"
disarm_instance_key="hawkins_grenade.projectile"
can_be_detected_by_driver="0" 
use_time_to_live="1" 
time_to_live="600">
	<tag name="antitank_grenade" />
	
	<sound class="result" key="other" fileref="at_grenade_01.wav" volume="1.9" pitch_variety="0.1"/>  
	<sound class="result" key="other" fileref="at_grenade_02.wav" volume="1.9" pitch_variety="0.1"/>  
	<sound class="result" key="terrain" copy="other" />
	<sound class="result" key="static_object" copy="other" />
	<sound class="result" key="vehicle" copy="other" />
	<sound class="result" key="character" copy="other" />
	


    <trigger class="impact"> 
     <collider class="terrain" enabled="0" /> 
     <collider class="static_object" enabled="1" /> 
     <collider class="vehicle" enabled="1"/> 
     <collider class="character" enabled="0" />
    </trigger>

	<result
	class="blast"
	radius="4.5"
	damage="10.5"
	push="0.4"
	decal="1" 
	
	faction_compare="not_equal"
	/>
	
	<model mesh_filename="hawkins_grenade.xml" />
	<hud_icon filename="hawkins_grenade.png" />
	
	<rotation class="random" />
    <throwable 
	curve_height="5" 
	near_far_distance="5.0" 
	speed_estimation_near="9.0" 
	speed_estimation_far="17.0" 
	max_speed="15.5" 
	randomness="0.06" 
	tweak_factor="1.1" />
	
    <commonness value="0.15" />
    <inventory encumbrance="2.0" price="8.0" />
	

    <capacity value="6" source="rank" source_value="0" />
		<effect class="result" key="terrain" ref="OstvetSmokeBigSphere" />
   	<effect class="result" key="terrain" ref="OstvetHitSparks" />
    <effect class="result" key="terrain" ref="OstvetBurstShine" lighting="0" />
	<effect class="result" key="terrain" ref="HitTank" lighting="1" />
   	<effect class="result" key="terrain" ref="HitTankSparks" />
	
    	<effect class="result" key="terrain" ref="HandGrenadeSmokeTop" post_processing="1" />
    	<effect class="result" key="terrain" ref="HandGrenadeSmoke" post_processing="1" />
    	<effect class="result" key="terrain" ref="ShadowSmoke" shadow="1" />
	<effect class="result" type="splat_map" surface_tag="" size="3.0" atlas_index="0" layer="1" />
	<effect class="result" type="splat_map" surface_tag="" size="6.0" atlas_index="4" layer="0" />
	<effect class="result" type="splat_map" surface_tag="" size="6.0" atlas_index="0" layer="2" additive="0" /> <!-- remove top snow everywhere -->
	
   	<effect class="result" key="other" ref="HandGrenadeSmokeTop" post_processing="1" />
    	<effect class="result" key="other" ref="HandGrenadeSmoke" post_processing="1" />
    	<effect class="result" key="other" ref="ShadowSmoke" shadow="1" />
	
	<effect class="result" key="static_object" copy="terrain" />
	<effect class="result" key="vehicle" copy="terrain" />
	<effect class="result" key="character" copy="terrain" />
	
</projectile>
