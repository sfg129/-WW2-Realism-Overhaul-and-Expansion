<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_primary_lmg_crouch_fire.weapon" key="m1918_s.weapon">


	<specification 
	retrigger_time="0.109" 
	accuracy_factor="0.95" 
	sustained_fire_grow_step="0.32"
	sustained_fire_diminish_rate="2.4"	
	stance_accuracy_rate="2"
	magazine_size="20" 
	can_shoot_standing="1" 
	suppressed="0" 
	burst_shots="1"
	name="M1918 BAR Semi-Auto" 
	class="4" 
	barrel_offset="0.5" 
projectile_speed="140.0" 
	/>

	<!-- BAR is a low-capacity, low-rate of fire weapon which offers high accuracy and moderate damage. -->
	<!-- The Lightweight version has a few things removed such as the bipod, flash hider, and stock rest to provide a more mobile platform; this was commonly done in the Pacific theatre. -->
	<!-- consequentially movement speed is a bit better as is standing accuracy, but without the bipod, accuracy while prone or behind cover is not as excellent. -->
    <next_in_chain key="m1918.weapon" share_ammo="1" />
	<modifier class="speed" value="-0.1" />
 
				<stance state_key="running" accuracy="0.5" />
	<stance state_key="walking" accuracy="0.75" />
	<stance state_key="crouch_moving" accuracy="0.75" />
	<stance state_key="prone_moving" accuracy="0.75" />
	<!-- was 0.925 -->

	<stance state_key="standing" accuracy="0.92" />
	<stance state_key="crouching" accuracy="0.97" />
	<stance state_key="prone" accuracy="1.05" />
	<stance state_key="over_wall" accuracy="1.05" />    
	
	<animation key="recoil" ref="12" />
	<animation key="recoil" ref="13" />
	<animation key="recoil" ref="14" />
	<animation state_key="reload" animation_key="reloading, bar" />
	<animation state_key="reload" stance_key="prone" animation_key="reloading, bar, prone" />
	
	<weak_hand_hold offset="0.2" />
	
	<sound key="fire" fileref="mg_15_vickers.wav" pitch_variety="0.05" volume="1.29"/>
	<sound key="magazine_out" fileref="rifle_clip_out.wav" />
	<sound key="magazine_in" fileref="rifle_clip_in.wav" />
	<sound key="cycle" fileref="rifle_chamber.wav" />
	
	<model filename="weapon_m1918a2_bar_rapid_fire.xml" />
	<hud_icon filename="hud_bar_rapid_fire.png" />
	
	<commonness value="0.01" in_stock="0"/>
	<inventory encumbrance="8.0" price="20" />
	
	<capacity value="0" source="rank" source_value="0.0" />
	<capacity value="1" source="rank" source_value="0.0" />
	
	<!-- kill decay start was 0.225, then 0.39, then 0.3 -->
	<projectile file="bullet_rifle_3006_mg.projectile" />
	
</weapon>
