	<!-- damage was 0.525 until patch 1.95 -->

	<!-- former stats: accuracy was 0.6, grow_step 0.1, diminished_rate default, velocity 110 -->

	<!-- The Type 96 has a low rate of fire and low damage, but is precise and easily controllable at long ranges. -->
	<!-- This variation is fitted with a protective Shield, as well as a Scope for extended range. -->

	<!-- scope power is 2.5x for the standard scope, but at the moment sight_range_modifier is based on class/rarity rather than that -->

	<stance state_key="standing" accuracy="0.83" />
	<stance state_key="crouching" accuracy="0.9" />
	<stance state_key="prone" accuracy="1.2" />
	<stance state_key="over_wall" accuracy="1.2" />  
