	/>

	<!-- recoil was 0.295, recoil recovery was default; 1.4 -->
	
	<!-- the M55 Reising is an early-war  US SMG, with only 20 rounds, and a high rate of fire. -->

	<!-- simple SMG sight ; though technically an aperture -->
 <modifier class="speed" value="-0.06" />

