<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_secondary.weapon" key="kar98k_rifle_grenade_he.weapon">
	<tag name="assault" />
	
<access_tag name="edelweiss" />

	<specification 
	retrigger_time="-1" 
	spread_range="0.1"
	accuracy_factor="0.9" 
	sustained_fire_grow_step="3.0" 
	sustained_fire_diminish_rate="1.0" 
	magazine_size="5" 
	can_shoot_standing="1" 
	can_shoot_prone="1"
	suppressed="0" 
	sight_range_modifier="1.5" 
	ai_sight_range_modifier="0.7" 
	name="Schiessbecher HE Rifle Grenade" 
	class="2" 
	slot="1"
	projectile_speed="43.0" 
	barrel_offset="1.05" 
	/>
	<next_in_chain key="kar98k_rifle_grenade_at.weapon" share_ammo="1" />
	<stance state_key="standing" accuracy="0.85" />
<stance state_key="crouching" accuracy="0.95" />
	<stance state_key="prone" accuracy="0.95" />
		<animation key="crouching" animation_key="rifle grenade crouch" />
	<animation key="recoil" animation_key="rifle grenade recoil" />
	<animation key="recoil" stance_key="over_wall" ref="27" />
	<animation key="cycle" animation_key="launcher reload" />
	<animation key="cycle" stance_key="prone" animation_key="launcher reload" />
	<animation key="reload" animation_key="reloading, bolt action" />
	<animation key="reload" stance_key="prone" animation_key="reloading, bolt action, prone" />
	<animation state_key="next_in_chain_in" animation_key="reloading, m1 garand grenade launcher" />
	
	<weak_hand_hold offset="0.4" />
	
	<sound key="fire" fileref="rifle_grenade.wav" pitch_variety="0.05" volume="2.44"/>
	<sound key="magazine_in" fileref="sniper_clip_in.wav" />
	<sound key="cycle" fileref="rifle_kar98k.wav" pitch_variety="0.05" volume="2.6"/>
	
	<!-- i had to swap which models are AT and HE since it made a bit more sense gameplay-wise to have AT rifle grenades stick out a little more-->
	<!-- in real life, the German "HE" Grenade has a yellow colouring, but as said above.. that was more desirable for gameplay to be on AT -->
	<model filename="weapon_kar98k_rifle_grenade_at.xml" />
	<hud_icon filename="hud_kar98k_at_grenade.png" />
			<modifier class="speed" value="-0.05" />
	<commonness value="0" can_respawn_with="1" in_stock="0"/>
	<inventory encumbrance="5.0" price="20" />
	
	<capacity value="0" source="rank" source_value="0.0" />
	<capacity value="1" source="rank" source_value="0.0" />
	
	<projectile file="kar98k_rifle_grenade_he.projectile" />
	<ballistics
	curve_height="6.0"
	near_far_distance="0.0"
	speed_estimation_near="9.0"
	speed_estimation_far="17.0"
	max_speed="43.0"
	randomness="0.0"
	tweak_factor="1.1"
	/> 
	

	<effect class="muzzle" ref="LawMuzzle" />
	<effect class="muzzle" ref="UpDust" />
	
</weapon>
