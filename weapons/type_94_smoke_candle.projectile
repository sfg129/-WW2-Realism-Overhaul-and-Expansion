<?xml version="1.0" encoding="utf-8"?>
<projectile class="grenade" name="Type 94 small smoke candle" key="type_94_smoke_candle.projectile" slot="0" radius="0.15" can_be_detected_by_driver="0" can_be_detected_by_footmen="0" drop_count_factor_on_death="0.5" time_to_live_out_in_the_open="60.0">
    <tag name="grenade" />
    <access_tag name="ww2" />

    <!-- Light visual smoke follows the projectile immediately. The first
         impact starts the full 45-second AN-M8 plume and its sight blockers. -->
    <trigger class="impact" />
    <result class="spawn" instance_class="vehicle" instance_key="type_94_smoke_candle_smoke_spawner.vehicle" min_amount="1" max_amount="1" offset="0 0 0" position_spread="0 0" direction_spread="0 0" />

    <sound class="result" key="other" fileref="smoke_m8.wav" volume="1.0" />
    <sound class="result" key="terrain" copy="other" />
    <sound class="result" key="static_object" copy="other" />
    <sound class="result" key="vehicle" copy="other" />
    <sound class="result" key="character" copy="other" />

    <model mesh_filename="type_94_smoke_candle.xml" />
    <hud_icon filename="hud_type_94_smoke_candle.png" />
    <rotation class="random" />
    <effect class="activated" ref="Type94SmokeCandlePreSmoke" post_processing="1" />

    <throwable
        curve_height="5.5"
        near_far_distance="5.0"
        speed_estimation_near="12.0"
        speed_estimation_far="17.0"
        max_speed="16"
        randomness="0.07"
    />

    <commonness value="0.0" can_respawn_with="1" />
    <inventory encumbrance="1" price="4.0" />
    <capacity value="4" source="rank" source_value="0.0" />
</projectile>
