<?xml version="1.0" encoding="utf-8"?>
<carry_items>

	<!-- variation that spawns only on the AI Sniper Soldiers, granting bonus health and making them a miniboss -->

    <carry_item key="camouflage_suit_for_ai.carry_item" name="Sniper" slot="1" transform_on_consume="camouflage_suit_for_ai_2" time_to_live_out_in_the_open="0.0" drop_count_factor_on_death="0.0">
        <hud_icon filename="vest_sniper.png" />
        <capacity value="0" source="rank" source_value="0.0" />
        <capacity value="1" source="rank" source_value="0.3" />
        <inventory encumbrance="3" price="25" />

        <model mesh_filename="camouflage_suit.xml" />

        <commonness value="1.0" in_stock="0" can_respawn_with="0" />


		<modifier class="projectile_blast_result" input_character_state="death" output_character_state="none" consumes_item="1"/>
		<modifier class="projectile_blast_result" input_character_state="wound" output_character_state="wound" consumes_item="1"/>
		<modifier class="projectile_blast_result" input_character_state="stun" output_character_state="stun" consumes_item="0"/>
		<modifier class="projectile_hit_result" input_character_state="death" output_character_state="none" consumes_item="1" />
		<modifier class="projectile_hit_result" input_character_state="wound" output_character_state="wound" consumes_item="1" />
		<modifier class="projectile_hit_result" input_character_state="stun" output_character_state="stun" consumes_item="0" />

        <modifier class="speed" value="+0.08" /> 
		<modifier class="hit_success_probability" value="-0.125" />
        <modifier class="detectability" value="-0.12" />
	    <modifier class="night_detectability" value="-0.11" />	
     </carry_item>

     <carry_item key="camouflage_suit_for_ai_2" name="Sniper, Moderately Injured" slot="1" transform_on_consume="camouflage_suit_for_ai_3" time_to_live_out_in_the_open="0.0" drop_count_factor_on_death="0.0">
        	<hud_icon filename="vest_sniper.png" />
		<capacity value="1" source="rank" source_value="0.0" />
		<inventory encumbrance="0" price="1" />
		
        	<model mesh_filename="camouflage_suit.xml" />

		<modifier class="projectile_blast_result" input_character_state="death" output_character_state="wound" consumes_item="1"/>
		<modifier class="projectile_blast_result" input_character_state="wound" output_character_state="wound" consumes_item="1"/>
		<modifier class="projectile_blast_result" input_character_state="stun" output_character_state="stun" consumes_item="0"/>
		<modifier class="projectile_hit_result" input_character_state="death" output_character_state="wound" consumes_item="1" />
		<modifier class="projectile_hit_result" input_character_state="wound" output_character_state="wound" consumes_item="1" />
		<modifier class="projectile_hit_result" input_character_state="stun" output_character_state="stun" consumes_item="0" />

		<commonness value="0.0" in_stock="0" can_respawn_with="0" />
		
        <modifier class="speed" value="+0.08" /> 
		<modifier class="hit_success_probability" value="-0.125" />
        <modifier class="detectability" value="-0.12" />
	    <modifier class="night_detectability" value="-0.11" />	
     </carry_item>

     <carry_item key="camouflage_suit_for_ai_3" name="Sniper, Severely Injured" slot="1" time_to_live_out_in_the_open="0.0" drop_count_factor_on_death="0.0">
        	<hud_icon filename="vest_sniper.png" />
		<capacity value="1" source="rank" source_value="0.0" />
		<inventory encumbrance="0" price="1" />
		
        	<model mesh_filename="camouflage_suit.xml" />
		


		<commonness value="0.0" in_stock="0" can_respawn_with="0" />
		
        <modifier class="speed" value="+0.08" /> 
		<modifier class="hit_success_probability" value="-0.125" />
        <modifier class="detectability" value="-0.12" />
	    <modifier class="night_detectability" value="-0.11" />	
     </carry_item>

</carry_items>
