<?xml version="1.0" encoding="utf-8"?>
<carry_items>
	
	<!-- This vest is only issued to AI Veteran Flamethrower Operators, to give them additional health. They are not available to players. -->	

	<carry_item key="vest_veteran_flamethrower_operator.carry_item" name="Operator Veteran" slot="1" transform_on_consume="vest_veteran_flamethrower_operator_2" time_to_live_out_in_the_open="0.0">
		<hud_icon filename="vest_unkillable.png" />
		<capacity value="1" source="rank" source_value="0.0" />
		<inventory encumbrance="3" price="0" />
		
		<model mesh_filename="vest1.xml" />
		
		<commonness value="1.0" in_stock="0" can_respawn_with="0" />

		<modifier class="projectile_hit_result" input_character_state="death" output_character_state="none" />
		<modifier class="projectile_hit_result" input_character_state="wound" output_character_state="none" />
		<modifier class="projectile_hit_result" input_character_state="stun" output_character_state="stun" consumes_item="0" />
		<modifier class="projectile_blast_result" input_character_state="stun" output_character_state="stun" consumes_item="0"/>	
		<modifier class="speed" value="+0.15" />
		<modifier class="detectability" value="0.65" />
		<modifier class="hit_success_probability" value="-0.125" />
		
	</carry_item>

