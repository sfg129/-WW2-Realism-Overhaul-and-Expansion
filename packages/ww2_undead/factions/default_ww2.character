<?xml version="1.0" encoding="utf-8"?>
<character filename="default_base.character">
	<sound class="vehicle" tag="tank_treads" filename="generic_death_crushed_01.wav" volume="1.75"/>
	<sound class="vehicle" tag="tank_treads" filename="generic_death_crushed_02.wav" volume="1.75"/>
	<sound class="vehicle" tag="tank_treads" filename="generic_death_crushed_03.wav" volume="1.75"/>
	
	<parameter class="accuracy_encumbered" low="0.995" high="0.94" />
	
	<!-- character specific animation override table -->
	<animation key="going prone" target_key="pacific, going prone" />
	<animation key="prone" target_key="pacific, prone" />
	<animation key="leaving prone" target_key="pacific, leaving prone" />
	
	<parameter class="taxi_request_time" value="15" />
</character>