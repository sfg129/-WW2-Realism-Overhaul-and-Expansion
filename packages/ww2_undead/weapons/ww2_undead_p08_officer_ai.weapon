<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_secondary_pistol.weapon" key="ww2_undead_p08_officer_ai.weapon" drop_count_factor_on_death="0.0"
	ai_burst_time="0.2" 
	ai_burst_time_variance="0.05" 
	ai_burst_wait_time="0.15" 
	ai_burst_wait_time_variance="0.1">

<access_tag name="edelweiss" />

	<specification 
	retrigger_time="0.125" 
	carry_in_two_hands="0" 
	accuracy_factor="0.92" 
	sustained_fire_grow_step="0.785" 
	magazine_size="8" 
	can_shoot_standing="1" 
	suppressed="0" 
	name="Officer's Engraved Luger P 08" 
	class="4" 
	reload_one_at_a_time="0" 
	projectile_speed="95.0" 
	barrel_offset="-0.2" 
	projectiles_per_shot="1" 
	burst_shots="1" 

	slot="0"

	/>


	<!-- AI versions of these weapons are worse than player versions to reduce the frustration of getting insta-killed so often -->
	<!-- they have lower damage, lower velocity, and lose the mild sight range boost for bolt-actions -->
	<!-- when the AI dies with them they must transform into their normal version, handled below. a requirement with this is drop-count factor on death be 0 -->
	<drop_on_death_result class="spawn" instance_class="weapon" instance_key="p08_officer.weapon" min_amount="1" max_amount="1" offset="0 1.0 0" position_spread="0 0" direction_spread="0 0" />
	


	<animation state_key="reload" animation_key="reloading, pistol, 2hand" />
	<animation state_key="reload" stance_key="prone" animation_key="reloading, pistol, prone" />

	<!-- former stats: kill chance 0.8 -->
	
	<!-- special Officer-only Luger pistol, engraved. -->
	<!-- since its kept in pristine condition, it is more reliable; more accurate and cycling its action quicker. -->
	<!-- however the difference is very minimal. Its largest significance is that it is worth a LOT of rp to sell! -->
	
	<weak_hand_hold offset="0.3" />
	
	<sound key="fire" fileref="weapon_pistol_luger_p08.wav" pitch_variety="0.05" volume="1.875" />
	<sound key="magazine_out" fileref="pistol_clip_out.wav" />
	<sound key="magazine_in" fileref="pistol_clip_in.wav" volume="0.5" />    
	<sound key="cycle" fileref="pistol_chamber.wav" volume="0.5" />
	
	<model filename="weapon_p08_officer.xml" />
	<hud_icon filename="hud_p08_officer.png" />
	
	<commonness value="0.2" can_respawn_with="0" in_stock="0" />
	<inventory encumbrance="1.0" price="500.0" />
	
	<capacity value="0" source="rank" source_value="0.0" />
	<capacity value="1" source="rank" source_value="0.0" />
	
	<projectile file="bullet.projectile">
		<result
		class="hit"
		kill_probability="0.85"
		kill_decay_start_time="0.25"
		kill_decay_end_time="0.53"
		/>
	</projectile>
	
	<!-- was 0.525 kill probability -->
	
</weapon>
