<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_primary_carbine_smg.weapon" key="stg44_n.weapon" time_to_live_out_in_the_open="90.0" drop_count_factor_on_death="1" drop_count_factor_on_player_death ="1.0" player_death_drop_owner_lock_time="45.0" >
	<tag name="assault" />
	
<access_tag name="edelweiss" />

	<specification 
	retrigger_time="0.109"
	accuracy_factor="0.95" 
	spread_range="0.3"
	sustained_fire_grow_step="0.255" 
	sustained_fire_diminish_rate="1.6"
	stance_accuracy_rate="1.25"
	magazine_size="31" 
	reload_one_at_a_time="1" 
	can_shoot_standing="1" 
	suppressed="0" 
	name="Vampir StG 44" 
	class="0" 
	projectile_speed="120" 
	barrel_offset="0.6" 
	projectiles_per_shot="1"
	sight_range_modifier="1.5"
  
	/>
	<modifier class="speed" value="-0.1" />  
	<!-- former stats: drop chance 0.05 -->
	<!-- formerly had stance accuracy rate but i cut it -->
	<!-- scope zoom was 1.45 -->

	<!-- scope power is unknown for the Vampir scope, but at the moment sight_range_modifier is based on class/rarity rather than that -->

	<addon_model filename="weapon_stg44_ar_n_backpack.xml" />
	
	<!-- certain weapons like the MP 40 and StG 44 have reduced prone accuracy, due to the height of the weapon with magazine colliding with the ground. -->
	<!-- larger assault rifle weapons have reduced walking accuracy compared to SMGs -->
	<stance state_key="running" accuracy="0.4" />
	<stance state_key="walking" accuracy="0.5" />
	<stance state_key="crouch_moving" accuracy="0.6" />
	<stance state_key="prone_moving" accuracy="0.6" />
	<stance state_key="over_wall" accuracy="1" />     
	<stance state_key="standing" accuracy="0.9" />
	<stance state_key="crouching" accuracy="0.95" />
	<stance state_key="prone" accuracy="1.0" />
	<stance state_key="over_wall" accuracy="0.75" />   

	<modifier class="speed" value="-0.12" />

	<animation key="recoil" ref="12" />
	<animation key="recoil" ref="13" />
	<animation key="recoil" ref="14" />
	<animation key="recoil" stance_key="over_wall" animation_key="recoil blind" />
	<!-- holy hell blind fire works -->

	<animation key="reload" animation_key="reloading, stg442" />
	<animation key="reload" stance_key="prone" animation_key="reloading, stg442, prone" />
	<weak_hand_hold offset="0.2" />
    <sound key="fire" fileref="weapon_autorifle_stg44.wav" pitch_variety="0.05" volume="1.2"/>
	<sound key="effect" fileref="stg44_reload.wav" pitch_variety="0" />
	<control key="effect" value="1" />
	<model filename="weapon_stg44_ar_n.xml" />
	<hud_icon filename="hud_stg44_vampir.png" />
	
	<commonness value="0.0175" can_respawn_with="0"/>
	<inventory encumbrance="8.0" price="475.0" />
	
	<capacity value="0" source="rank" source_value="0.0" />
	<capacity value="1" source="rank" source_value="0.0" />
	
	<!-- gave it bonus damage for more of an edge; let's explain it away with how the IR optics make hitting targets easier -->
	<projectile file="bullet.projectile">
		<result 
		class="hit" 
		kill_probability="0.85" 
		kill_decay_start_time="0.4" 
		kill_decay_end_time="0.9"
		/>
	</projectile>
	
</weapon>
