<?xml version="1.0" encoding="utf-8"?>
<projectile class="bullet" name="Bofors Gun" slot="1" time_to_live="2.0" radius="2.0" pulldown_in_air="0" key="bofors_gun.projectile">
	
	<sound class="result" key="other" fileref="ricochet_b1.wav" />
	<sound class="result" key="terrain" copy="other" />
	<sound class="result" key="vehicle" copy="other" />
	<sound class="result" key="static_object" copy="other" />
	<sound class="result" key="character" fileref="body_hit_explosive_ammo.wav" pitch_variety="0.1" volume="0.6"/>	

	<trigger class="impact" />
	<result
	class="blast"
	radius="3"
	damage="4.4"
	push="0.4"
	decal="0"
	faction_compare="not_equal"
damage_origin_vehicle="0" 
	/>
	
	<model mesh_filename="40mm.mesh" texture_filename="40mm.png" />
	
	<rotation class="motion" />
	
  	<effect class="result" key="terrain" ref="BoforsSmokeBigSphere" />
   	<effect class="result" key="terrain" ref="BoforsHitSparks" />
    <effect class="result" key="terrain" ref="BoforsBurstShine" lighting="0" />

   	<effect class="result" key="character" ref="BoforsSmokeBigSphere" />
   	<effect class="result" key="character" ref="BoforsHitSparks" />
    <effect class="result" key="character" ref="BloodSplat50Cal" lighting="1" />
    <effect class="result" key="character" ref="BurstShine50Cal" lighting="1" post_processing="0" />
    <effect class="result" key="character" ref="BoforsBurstShine" lighting="0" />
	
    <effect class="result" key="static_object" copy="terrain" />
    <effect class="result" key="vehicle" copy="terrain" />
    <effect class="result" key="shield" copy="terrain" />
    <effect class="result" key="other" copy="terrain" />
		
    <effect class="result" type="splat_map" surface_tag="" size="2.0" atlas_index="0" layer="1" />
    <effect class="result" type="splat_map" surface_tag="" size="4.0" atlas_index="4" layer="0" />
    <effect class="result" type="splat_map" surface_tag="" size="5.0" atlas_index="0" layer="2" additive="0" /> <!-- remove top snow everywhere -->
	
	<trail probability="1.0" />
	
</projectile>
