
<weapon file="base_primary_lmg_crouch_fire.weapon" key="m1918_bar_rapid_fire.weapon" >
		<!-- nolonger use -->
<access_tag name="ww2" />

	<specification
	retrigger_time="0.172"
	accuracy_factor="0.96"
	sustained_fire_grow_step="0.28"
	sustained_fire_diminish_rate="1.75"
	stance_accuracy_rate="2"
	magazine_size="20"
	can_shoot_standing="1"
	suppressed="0"
	name="M1918A2 BAR Lightweight Low Firerate" 
	class="0" 
	barrel_offset="0.5" 
	projectile_speed="140.0" 
	/>
	<modifier class="speed" value="-0.09" />
	<next_in_chain key="m1918_bar.weapon" share_ammo="1" />
	<!-- former stats: velocity 91 -->

	<!-- BAR is a low-capacity, low-rate of fire weapon which offers high accuracy and moderate damage. -->
	<!-- It suffers a long reload, but is effective at long ranges when fired from Crouch, Prone, or over Walls. -->

	<!-- bipod accuracy was 1.15, recoil was 0.185 -->
				<stance state_key="running" accuracy="0.4" />
	<stance state_key="walking" accuracy="0.5" />
	<stance state_key="crouch_moving" accuracy="0.75" />
	<stance state_key="prone_moving" accuracy="0.75" />
	<!-- was 0.925 -->

	<stance state_key="standing" accuracy="0.9" />
	<stance state_key="crouching" accuracy="0.95" />
	<stance state_key="prone" accuracy="1.05" />
	<stance state_key="over_wall" accuracy="1.05" />    
	
	<animation key="recoil" ref="12" />
	<animation key="recoil" ref="13" />
	<animation key="recoil" ref="14" />
	<animation state_key="reload" animation_key="reloading, bar" />
	<animation state_key="reload" stance_key="prone" animation_key="reloading, bar, prone" />
	
	<weak_hand_hold offset="0.2" />
	
	<sound key="fire" fileref="mg_15_vickers.wav" pitch_variety="0.05" volume="1.07"/>
	<sound key="magazine_out" fileref="rifle_clip_out.wav" />
	<sound key="magazine_in" fileref="rifle_clip_in.wav" />
	<sound key="cycle" fileref="rifle_chamber.wav" />
	
	<model filename="weapon_m1918a2_bar_light.xml" />
	<hud_icon filename="hud_bar_light.png" />
	
	<commonness value="0.01" can_respawn_with="1" in_stock="1"/>
	<inventory encumbrance="8.0" price="15.0" />
	

	
	<!-- kill decay start was 0.225, then 0.39, then 0.3 -->
	<projectile file="bullet_rifle_3006_mg.projectile" />
	
