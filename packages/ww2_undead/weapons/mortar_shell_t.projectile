<?xml version="1.0" encoding="utf-8"?>
<projectile class="grenade" name="light mortar shell" slot="0" radius="0.15" drop_count_factor_on_death="1" time_to_live_out_in_the_open="60.0" key="mortar_shell_t.projectile" >
	
	<sound class="result" key="other" fileref="mortar_01.wav" volume="2.45" pitch_variety="0.1"/>
	<sound class="result" key="other" fileref="mortar_02.wav" volume="2.45" pitch_variety="0.1"/>
	<sound class="result" key="other" fileref="mortar_03.wav" volume="2.45" pitch_variety="0.1"/>
	
