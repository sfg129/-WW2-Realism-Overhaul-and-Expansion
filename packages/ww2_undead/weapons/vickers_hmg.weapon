<?xml version="1.0" encoding="utf-8"?>
<weapon key="vickers_hmg.weapon"
	ai_burst_time="2" 
	ai_burst_time_variance="0.5" 
	ai_burst_wait_time="0.1" 
	ai_burst_wait_time_variance="0.05">
	<!-- these parameters are used to control AI burst times in vehicles. -->
	<!-- using these as default values for normal vehicle-born machine guns -->
	<!-- they must be placed on cannons too, occasionally, since the 'first weapon' is used to control burst times of all weapons-->
	
	<specification
	retrigger_time="0.12"
	accuracy_factor="0.9"
	spread_range="0.21"
	sustained_fire_grow_step="0.0203"
	sustained_fire_diminish_rate="0.155"
	sight_range_modifier="2"
  	ai_sight_range_modifier="0.75"   
	magazine_size="-1"
	can_shoot_standing="0"
	can_shoot_crouching="0"
	suppressed="0"
	name="Vickers Mk I HMG"
	class="0"
	projectile_speed="130.0"
	slot="2"
	barrel_offset="0.45"
	projectiles_per_shot="1"
	sight_height_offset="2.0"
	cooldown_start="0.4"
	cooldown_end="0.0"/>

	<!-- stats prior to 1.87: accuracy 0.725, spread not overwritten, recoil 0.115, recovery 0.7, velocity 145, damage 0.575 -->
	
	<model mesh_filename="vickers_gun.mesh" texture_filename="vickers.png" />
	<hud_icon filename="hud_vickers_hmg.png" />
	
	<commonness value="0.0" />
	
	<!-- damage was 0.55 -->
	<projectile file="bullet.projectile">
		<result
		class="hit"
		kill_probability="0.95" 
		kill_decay_start_time="0.59"
		kill_decay_end_time="1.1"
		/>
	</projectile>
	
	<sound class="operation" key="fire" fileref="weapon_mg_vickers_mki.wav" pitch_variety="0.05" volume="1.6"/>


</weapon>
