<?xml version="1.0" encoding="utf-8"?>
<projectile class="grenade" name="arty flare" slot="0" key="ww2_undead_artillery_flare_overlord.projectile" radius="0.15" time_to_live_out_in_the_open="90.0" drop_count_factor_on_death="0.0" drop_count_factor_on_player_death="0.0">
	
