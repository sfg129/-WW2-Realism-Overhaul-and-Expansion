<?xml version="1.0" encoding="utf-8"?>
<projectile class="grenade" name="Nebelhandgranate 39" key="nebelhandgranate_39.projectile" slot="0" radius="0.15" can_be_detected_by_driver="0" can_be_detected_by_footmen="0" drop_count_factor_on_death="0.5" time_to_live_out_in_the_open="60.0">
    <tag name="grenade" />
    <access_tag name="ww2" />

