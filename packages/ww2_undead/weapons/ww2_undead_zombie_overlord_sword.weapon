<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_primary_rare.weapon" key="ww2_undead_zombie_overlord_sword.weapon" time_to_live_out_in_the_open="0.0" drop_count_factor_on_death="0.0" drop_count_factor_on_player_death ="0.0">
    <tag name="cqb" />
	
    <specification
	magazine_size="-1" 
    can_shoot_prone="1" 
    carry_in_two_hands="1" 
    name=""
    class="5" 
    character_state="death" 
    consume="0" 
    sight_range_modifier="0.9" 
    slot="0" 
    range="5.5"
    success_probability="10.0"
    stab_enabled="1"
    stab_range="5.5"

  	ai_sight_range_modifier="1.75"  
	/>

    <animation state_key="recoil" 		animation_key="zweihander slash 1" />
    <animation state_key="recoil" 		animation_key="zweihander slash 2" />
    <animation state_key="recoil" 		animation_key="zweihander slash 3" />
    <animation state_key="hold" 		animation_key="still, overlord sword" />
    <animation state_key="hold_on_wall" 	animation_key="still, overlord sword" />
    <animation state_key="hold_casual" 		animation_key="still, overlord sword" />
    <animation state_key="still_against_wall" 	animation_key="still, overlord sword" />
    <animation state_key="running" 		animation_key="running, overlord sword" />
    <animation state_key="crouching" 		animation_key="still, overlord sword" />		<!-- was 'crouch, still, large wrench' -->
    <animation state_key="walking" 		animation_key="walking, heavy weapon" />
    <animation state_key="walking_backwards" animation_key="walking backwards, heavy weapon" />
    <animation state_key="crouch_moving" 	animation_key="walking, heavy weapon" />	<!-- was 'crouching forwards, large wrench' -->

    <animation state_key="stabbing" 		animation_key="zweihander stab" />
	
	<sound key="fire" fileref="katana_swoosh.wav" pitch_variety="0.05" />
	<sound key="stab" fileref="katana_swoosh.wav" pitch_variety="0.05" volume="0.8" />
	<sound key="stab_hit" fileref="katana_hit_fatal.wav" pitch_variety="0.05" volume="1.0" />
	<sound key="stab_hit_any" fileref="katana_hit.wav" pitch_variety="0.05" volume="0.8" />
	<sound key="effect" fileref="katana_swoosh.wav" pitch_variety="0.05" />

	<model filename="ww2_undead_weapon_overlord_sword.xml" />
	<hud_icon filename="hud_katana.png" />
	
	<commonness value="0.2" can_respawn_with="0"/>
	<inventory encumbrance="10.0" price="1000.0" />
	
	<stance state_key="running" accuracy="1.0" />
	<stance state_key="walking" accuracy="1.0" />
	<stance state_key="crouch_moving" accuracy="1.0" />
	<stance state_key="prone_moving" accuracy="1.0" />
	
	<stance state_key="standing" accuracy="1.0" />
	<stance state_key="crouching" accuracy="1.0" />
	<stance state_key="prone" accuracy="1.0" />
	
	<!--<modifier class="speed" value="+0.155" />-->
	<modifier class="speed" value="-0.2" />
	
</weapon>
