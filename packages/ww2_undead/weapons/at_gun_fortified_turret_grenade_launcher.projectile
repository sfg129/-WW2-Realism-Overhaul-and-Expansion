	class="blast"
	radius="5.0"
	damage="2"
	push="0.5"
	decal="1" 
        damage_origin_vehicle="0"
        faction_compare="not_equal" 
	/>
	
    <model filename="m1_garand_rifle_grenade.xml" />

    <rotation class="motion" />
	
    <commonness value="0.2" />
	
   
      <effect class="result" key="terrain" ref="OstvetSmokeBigSphere" />
