<?xml version="1.0" encoding="utf-8"?>
<projectile class="grenade" name="No.77 Smoke Grenade" key="no77_smoke_grenade.projectile" slot="0" radius="0.15" can_be_detected_by_driver="0" drop_count_factor_on_death="0.5" time_to_live_out_in_the_open="60.0">
    <tag name="grenade" />
    <access_tag name="ww2" />

    <!-- Impact creates a zero-lifetime fan-out vehicle. It starts the visual
         smoke and burst immediately, then creates the sight blockers after a
         separate 0.5-second delay. -->
    <trigger class="impact" />
    <result class="spawn" instance_class="vehicle" instance_key="no77_smoke_spawner.vehicle" min_amount="1" max_amount="1" offset="0 0 0" position_spread="0 0" direction_spread="0 0" />

    <sound class="result" key="other" fileref="no77.wav" volume="1.0" />
    <sound class="result" key="terrain" copy="other" />
    <sound class="result" key="static_object" copy="other" />
    <sound class="result" key="vehicle" copy="other" />
    <sound class="result" key="character" copy="other" />

    <model mesh_filename="no77.xml" />
    <hud_icon filename="hud_no77.png" />
    <rotation class="random" />
    <throwable curve_height="5.5" near_far_distance="12.0" speed_estimation_near="17.0" speed_estimation_far="17.0" max_speed="17" randomness="0.07" />
    <commonness value="0.0" can_respawn_with="1" />
    <inventory encumbrance="1" price="3.0" />
    <capacity value="6" source="rank" source_value="0" />
</projectile>
