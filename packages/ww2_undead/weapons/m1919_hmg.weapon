<?xml version="1.0" encoding="utf-8"?>
<weapon key="m1919_hmg.weapon"
	ai_burst_time="1" 
	ai_burst_time_variance="0.5" 
	ai_burst_wait_time="0.05" 
	ai_burst_wait_time_variance="0.03">
	<!-- these parameters are used to control AI burst times in vehicles. -->
	<!-- using these as default values for normal vehicle-born machine guns -->
	<!-- they must be placed on cannons too, occasionally, since the 'first weapon' is used to control burst times of all weapons-->
	
	<specification
	retrigger_time="0.11"
	accuracy_factor="0.9"
	spread_range="0.21"
	sustained_fire_grow_step="0.0203"
	sustained_fire_diminish_rate="0.16"
	sight_range_modifier="2"
  	ai_sight_range_modifier="0.75"     
	magazine_size="-1"
	can_shoot_standing="0"
	can_shoot_crouching="0"
	suppressed="0"
	name="M1919A4 HMG"
	class="0"
projectile_speed="140.0" 
	slot="2"
	barrel_offset="0.6"
	projectiles_per_shot="1"
	sight_height_offset="2.0"
	cooldown_start="0.8"
	cooldown_end="0.0"/>

	<!-- stats prior to 1.87: accuracy 0.82, spread not overwritten, recoil 0.15, recovery 0.8, velocity 110, damage 0.575 -->


	<model mesh_filename="m1919_hmg.mesh" texture_filename="m1919_hmg.png" />
	<hud_icon filename="hud_m1919_hmg.png" />
	
	<commonness value="0.0" />

	<!-- damage was 0.55 -->	
	<projectile file="bullet.projectile">
		<result
		class="hit"
		kill_probability="0.95"
		kill_decay_start_time="0.52"
		kill_decay_end_time="1.34"
		/>
	</projectile>
	
	<sound class="operation" key="fire" fileref="mg_03_m1919.wav" pitch_variety="0.05" volume="1.4"/>
	<sound key="cooldown" fileref="overheating_mg.wav" volume="0.4"/>
	
</weapon>
