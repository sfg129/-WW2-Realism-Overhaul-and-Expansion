<?xml version="1.0" encoding="utf-8"?>
<projectile class="grenade" name="grenade discharger shell" slot="2" key="mortar_shell_50mm.projectile" >
	
	<sound class="result" key="other" fileref="mortar_01.wav" volume="2.45" pitch_variety="0.1"/>
	<sound class="result" key="other" fileref="mortar_02.wav" volume="2.45" pitch_variety="0.1"/>
	<sound class="result" key="other" fileref="mortar_03.wav" volume="2.45" pitch_variety="0.1"/>
	
	<sound class="result" key="terrain" copy="other" />
	<sound class="result" key="static_object" copy="other" />
	<sound class="result" key="vehicle" copy="other" />
	<sound class="result" key="character" copy="other" />
	
	<trigger class="impact" />
	<result
	class="blast"
	radius="6"
	damage="1.4"
	push="1"
	decal="2"
	/>
	
	<model mesh_filename="mortar_shell.xml" />
	<commonness value="0.0" />
	
	<rotation class="motion" />
	<effect class="result" key="terrain" ref="OstvetSmokeBigSphere" />
   	<effect class="result" key="terrain" ref="OstvetHitSparks" />
