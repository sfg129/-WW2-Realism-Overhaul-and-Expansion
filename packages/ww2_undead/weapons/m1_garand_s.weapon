<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_primary_sniper.weapon" key="m1_garand_s.weapon" time_to_live_out_in_the_open="90.0" drop_count_factor_on_death="1.0" player_death_drop_owner_lock_time="30.0" >
    <tag name="sniper" />
<access_tag name="ww2" />
	
	<specification 
	retrigger_time="0.2" 
	accuracy_factor="1" 
	spread_range="0.285"
	sustained_fire_grow_step="1.1" 
	sustained_fire_diminish_rate="0.9"
	stance_accuracy_rate="1.1"
	magazine_size="8" 
	can_shoot_standing="1" 
	suppressed="0" 
	name="Scoped M1D Garand" 
	class="4" 
	burst_shots="1"
	reload_one_at_a_time="0" 
	projectile_speed="140.0" 
	barrel_offset="0.6" 
	projectiles_per_shot="1"
	sight_range_modifier="2"
	/>

	<!-- name in weapon file is M1D Garand, but this is handled in all translations (since M1D is post-war weapon) to fix it as M1C Garand -->

	<!-- recoil recovery is *0.79 normal rifle -->
	<!-- stance rate is a bit slower than other snipers because the scope is strangely mounted in an offset position -->
	<!-- overall the platform is quite heavy, too -->

	<!-- scope power is 2.5x for the M81 or M82 scope, but at the moment sight_range_modifier is based on class/rarity rather than that -->
	
	<!-- since the M1C Garand has such a huge amount of firepower bonus over other DMRs, and since its only real downside is mildly slower stance rate, -->
	<!-- and since its scope is technically supposed to be low power, I'm lowering its sight bonus from 1.6 to 1.475 -->

	<!-- semi-auto snipers need 1.0 prone/overwall instead of 1.1 like other snipers -->
	<!-- this is because for some reason recoil recovers more quickly down to 1.1, so they end up firing faster than unscoped-->
	<stance state_key="prone" accuracy="1.0" /> 
	<stance state_key="over_wall" accuracy="1.0" />		

	<animation key="recoil" ref="27" />
	<animation key="cycle" ref="30" />
	<animation state_key="reload" animation_key="reloading, m1 garand" />
	<animation state_key="reload" stance_key="prone" animation_key="reloading, m1 garand, prone" />

	<weak_hand_hold offset="0.3" />
	
	<sound key="fire" fileref="rifle_02_m1_garand.wav" pitch_variety="0.05" volume="2.45"/>
	<sound key="cycle" fileref="pistol2_chamber.wav" />
	<sound key="magazine_out" fileref="rifle_02_m1_garand_ping.wav" />
	<sound key="magazine_in" fileref="rifle_clip_in.wav" />
	<sound key="last_ammo" fileref="rifle_02_m1_garand_ping.wav" />
	
	<model filename="weapon_m1c_garand_sniper.xml" />
	<hud_icon filename="hud_m1d_garand.png" />
	
	<commonness value="0.085" can_respawn_with="1" />
	<inventory encumbrance="8.0" price="175.0" />
	
	<capacity value="0" source="rank" source_value="0.0" />
	<capacity value="1" source="rank" source_value="0.0" />
	
	<projectile file="bullet.projectile">
		<result 
		class="hit" 
		kill_probability="1.5" 
		kill_decay_start_time="0.59"
		kill_decay_end_time="0.9" />
	</projectile>
	
</weapon>
