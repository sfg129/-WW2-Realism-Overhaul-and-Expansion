<?xml version="1.0" encoding="utf-8"?>
<projectile class="grenade" name="" slot="0" key="ww2_undead_fsj_flare_overlord.projectile" radius="0.15" time_to_live_out_in_the_open="90.0" drop_count_factor_on_death="0.0" drop_count_factor_on_player_death="0.0">
	

	<!-- the overlord's flare will have a slightly shorter range, with more capacity in reserve just in case, -->
	<!-- and he will throw them faster on the AI file. however it spawns the same # of FSJ and same type per flare -->


    <result class="spawn" instance_class="vehicle" instance_key="ww2_undead_fsj_flare_despawner.vehicle" min_amount="1" max_amount="1" offset="0 0.5 0" position_spread="0 0" direction_spread="0 0" />


    <trigger class="time" time_to_live="3.0"/>  

    <rotation class="random" />

    <model mesh_filename="flare_stick.mesh" texture_filename="flare_stick.png" />
    <hud_icon filename="hud_flare.png" />


	<throwable
	curve_height="5.0"
	near_far_distance="5.0"
	speed_estimation_near="7.0"
	speed_estimation_far="15.0"
	max_speed="11.0"
	randomness="0.07"
	/>
	
	<commonness value="1.0" />

	<capacity value="200" source="rank" source_value="0.0" />
	<inventory encumbrance="3.0" price="1.0" />	

	<effect class="activated" ref="FlareSparkleSmall" post_processing="0" offset="0 0.1 0.3"/>
	<effect class="activated" ref="FlareSmokePara" post_processing="0" offset="0 0.1 0.3"/>
	<effect class="activated" ref="FlareFlashPara" post_processing="0" offset="0 0.1 0.3"/>
	
</projectile>
