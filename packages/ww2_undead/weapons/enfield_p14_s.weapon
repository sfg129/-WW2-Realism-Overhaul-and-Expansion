<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_primary_sniper.weapon" key="enfield_p14_s.weapon" time_to_live_out_in_the_open="90.0" drop_count_factor_on_death="1.0" drop_count_factor_on_player_death ="1.0" player_death_drop_owner_lock_time="45.0">
    <tag name="sniper" />
	
<access_tag name="edelweiss" />

	<specification 
	retrigger_time="-1.0" 
	accuracy_factor="0.99" 
	sustained_fire_grow_step="1" 
	stance_accuracy_rate="0.95"
	sustained_fire_diminish_rate="0.95"
	magazine_size="5" 
	can_shoot_standing="1" 
	suppressed="0" 
	name="Scoped P14" 
	class="2" 
	reload_one_at_a_time="1" 
	projectile_speed="130.0" 
	barrel_offset="0.5" 
	projectiles_per_shot="1"
	sight_range_modifier="2.15"
	/>
	<next_in_chain key="enfield_p14_is.weapon" share_ammo="1" />

	<!-- scope zoom was 2.3 -->

	<!-- The Enfield P14 is a modestly rare sniper unlockable via briefcase like certain others -->
	<!-- in terms of class it is quite similar to the Type 99 Sniper Rifle; high zoom and bolt-action combat performance -->
	<!-- however directly compared to it, it has slower bolt-cycling, and reloads one at a time not being clip-fed, but higher velocity -->

	<!-- scope power is 3x for the M1918 scope, but at the moment sight_range_modifier is based on class/rarity rather than that -->

	<animation key="recoil" ref="27" />
	<animation key="cycle" animation_key="bolt cycle" />
	<animation key="cycle" stance_key="prone" animation_key="bolt cycle, prone" />
	<animation state_key="reload" animation_key="reloading, m1903 sniper" />
	<animation state_key="reload" stance_key="prone" animation_key="reloading, m1903 sniper, prone" />
	
	<weak_hand_hold offset="0.3" />
	
	<sound key="fire" fileref="weapon_rifle_enfield_p14.wav" pitch_variety="0.05" volume="2.45"/>
    <sound key="reload_one" fileref="hunter_cycle_in.wav" />
	<sound key="magazine_out" fileref="sniper_clip_out.wav" />
	<sound key="magazine_in" fileref="sniper_clip_in.wav" />
	<sound key="cycle_out" fileref="sniper_cycle_out.wav" />
	<sound key="cycle_in" fileref="sniper_cycle_in.wav" />
	
	<model filename="weapon_enfield_p14.xml" />
	<hud_icon filename="hud_p1914_sniper.png" />
	
	<commonness value="0.08" can_respawn_with="1"/>
	<inventory encumbrance="8.0" price="80.0" />
	
	<capacity value="0" source="rank" source_value="0.0" />
	<capacity value="1" source="rank" source_value="0.0" />
	
	<!-- kill_probability was 1.5, raised for better damage vs. body armour -->
	<projectile file="bullet.projectile">
		<result
		class="hit"
		kill_probability="1.75"
		kill_decay_start_time="0.66"
		kill_decay_end_time="0.9"
		/>
	</projectile>
	
</weapon>
