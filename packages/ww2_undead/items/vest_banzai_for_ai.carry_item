<?xml version="1.0" encoding="utf-8"?>
<carry_items>
	
	<!-- variation that spawns only on the AI Banzai Soldiers, not on regular Grunts. Statistically different from player version. -->
	
	<carry_item key="vest_banzai_for_ai.carry_item" name="Banzai Tenacity" slot="1" transform_on_consume="vest_banzai_for_ai_2" time_to_live_out_in_the_open="0.0">
		<hud_icon filename="vest_banzai.png" />
		<capacity value="1" source="rank" source_value="0.0" />
		<inventory encumbrance="6" price="20" />
		
		<model mesh_filename="vest_ija_banzai.xml" />
		
		<commonness value="1.0" in_stock="0" can_respawn_with="0" />
		
		<modifier class="projectile_hit_result" input_character_state="death" output_character_state="none" />
		<modifier class="projectile_hit_result" input_character_state="wound" output_character_state="none" />
		<modifier class="projectile_hit_result" input_character_state="stun" output_character_state="stun" consumes_item="0" />
		<modifier class="melee_hit_result" input_character_state="death" output_character_state="stun" />

		<modifier class="speed" value="+0.2" />	<!-- I made this slightly higher for AI so they can keep up with their Officer -->
		<modifier class="hit_success_probability" value="-0.15" /> <!-- previously +0.35 in v1.80 -->
		<modifier class="detectability" value="+4" />
	</carry_item>
	
	
	<!-- one stab yields stun, two yields death -->

	<carry_item key="vest_banzai_for_ai_2" name="Banzai Tenacity, Severely Injured" slot="1" time_to_live_out_in_the_open="0.0">
		<hud_icon filename="vest_banzai_2.png" />
		<capacity value="1" source="rank" source_value="0.0" />
		<inventory encumbrance="3" price="1" />
		
		<model mesh_filename="vest_ija_banzai.xml" />
		

		<commonness value="0.0" in_stock="0" can_respawn_with="0" />
		
		<modifier class="speed" value="+0.2" /> <!-- previously +0.21 in v1.80 -->
		<modifier class="hit_success_probability" value="-0.15" /> <!-- previously -0.17 in v1.80 -->
		<modifier class="detectability" value="+4" /> <!-- previously +4.5 in v1.80 -->
	</carry_item>

</carry_items>

