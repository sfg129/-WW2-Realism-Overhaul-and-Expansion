<?xml version="1.0" encoding="utf-8"?>
<carry_items>
	
	<!-- variation that spawns only on the AI Assault Troopers, not on regular Grunts. Statistically different from player version. -->	

	<carry_item key="vest_assault_webbing_for_ai.carry_item" name="Assault Trooper Zeal" slot="1" transform_on_consume="vest_assault_webbing_for_ai_2" time_to_live_out_in_the_open="30.0" drop_count_factor_on_death="0.0" drop_count_factor_on_player_death ="1.0" player_death_drop_owner_lock_time="30.0">
		<hud_icon filename="vest_assault.png" />

		<capacity value="0" source="rank" source_value="0.0" />
		<capacity value="1" source="rank" source_value="0.0" />

		<inventory encumbrance="4" price="15" />
		
		<model mesh_filename="vest_ija_banzai.xml" />
		
		<commonness value="1.0" in_stock="0" can_respawn_with="0" />
		
		<modifier class="projectile_hit_result" input_character_state="death" output_character_state="none" />
		<modifier class="projectile_hit_result" input_character_state="wound" output_character_state="none" />
		<modifier class="projectile_hit_result" input_character_state="stun" output_character_state="stun" consumes_item="0" />
		<modifier class="melee_hit_result" input_character_state="death" output_character_state="none" />
		<modifier class="speed" value="+0.15" />
		<modifier class="hit_success_probability" value="-0.15" />

	</carry_item>
	
	


	<carry_item key="vest_assault_webbing_for_ai_2" name="Assault Trooper Zeal, Severely Injured" slot="1" time_to_live_out_in_the_open="0.0">
		<hud_icon filename="vest_assault_3.png" />

		<capacity value="0" source="rank" source_value="0.0" />
		<capacity value="1" source="rank" source_value="0.0" />

