<?xml version="1.0" encoding="utf-8"?>
<carry_items>

	<!-- vulnerable to explosive weapons and a bit to melee -->

    <carry_item key="ww2_undead_axr_dog.carry_item" name="" slot="1" transform_on_consume="ww2_undead_axr_dog_2" time_to_live_out_in_the_open="0.0" drop_count_factor_on_death="0.0" draggable="0">
        <hud_icon filename="hud_vest.png" />
        <capacity value="1" source="rank" source_value="0.0"/>
        <inventory encumbrance="0" price="0" />

        <model mesh_filename="vest.xml" />

        <commonness value="1.0" in_stock="0" can_respawn_with="0"/>

	<!-- death or wound or stun -> no effect -->
        <modifier class="projectile_blast_result" input_character_state="wound" output_character_state="stun" />
        <modifier class="projectile_blast_result" input_character_state="stun" output_character_state="stun" consumes_item="0"/>
