<?xml version="1.0" encoding="utf-8"?>
<vehicle name="Pillbox" key="pillbox.vehicle" map_view_atlas_index="40" respawn_time="600.0" protectors="1" soldier_capacity_offset="1" character_leave_request_mode="friendly" >
	<tag name="target" />
	<tag name="pillbox" />
   	<tag name="defensive_weapon" />

	<tire_set offset="1.0 0.0 1.0" radius="0.65" />
	<tire_set offset="1.0 0.0 -1.0" radius="0.65" />
	
	<control max_speed="20.0" acceleration="6.7" max_reverse_speed="6.0" max_rotation="0.8" max_water_depth="1.0" />

	<modifier class="blast_range" value="0.5" /> <!-- radius raised to help with issues from AT Rifle Grenades - but not dramatically make other AT weapons overpowered -->
	<modifier class="blast_damage" value="-1.2" />
	
	<physics max_health="16.0" mass="10000.0" extent="2.0 0.0 2.0" offset="0 0.0 0" top_offset="0 5 0" collision_model_pos="0 0.5 0" collision_model_extent="3.3 1.8 3.3" visual_offset="0 0.0 0" /> 
	
	<turret offset="0 0.8 1.45" weapon_key="m1919_hmg.weapon" weapon_offset="0 0 0" weapon_recoil="0.05" physics_recoil="0.0"  max_rotation_step="0.00015" rotation="0" rotation_range="1.92" />
	
	<visual class="chassis" mesh_filename="pillbox_usmc.mesh" texture_filename="pillbox_usmc.png" />
	<visual class="chassis" key="broken" mesh_filename="pillbox_usmc_destroyed.mesh" texture_filename="pillbox_usmc_destroyed.png" />
	
	<character_slot type="gunner" enter_position="0 0.0 -1.6" seat_position="0 -0.5 0" rotation="0" exit_rotation="3.14" hiding="1" >
		<turret index="0" />
	</character_slot>
	
	<!-- sound handling -->
	<rev_sound filename="truck_rev0.wav" low_pitch="0.95" high_pitch="1.05" low_rev="0.0" high_rev="0.2" volume="1.0" />
	<rev_sound filename="truck_rev3.wav" low_pitch="0.7" high_pitch="1.0" low_rev="0.05" high_rev="0.7" volume="1.0" />
	<rev_sound filename="truck_rev4.wav" low_pitch="0.8" high_pitch="1.0" low_rev="0.4" high_rev="1.0" volume="1.0" />
	
	<sound key="slide" filename="slide_noise.wav" />
	<sound key="squeal" filename="tire_squeal.wav" />
	<sound key="ignition" filename="truck_ignition.wav" />
	<sound key="hit" filename="car_hit1.wav" />
	<sound key="hit" filename="car_hit2.wav" />
	<sound key="hit" filename="car_hit3.wav" />
	
	<event key="receive_damage_xp_reward">
		<trigger class="receive_damage" />
		<result class="reward" xp="0.0100" />
	</event>
	<event key="spot_rp_reward">
		<trigger class="spot" />
		<result class="reward" rp="25.0" />
	</event>
	<event key="destroy_rp_reward">
		<trigger class="destroy" />
		<result class="reward" rp="75.0" />
	</event>
	
	<event>
		<trigger class="destroy" />		
		<result class="spawn" instance_class="visual_item" instance_key="burning_piece_radartower.visual_item" min_amount="2" max_amount="3" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.05 0.2" />
	</event>
	<event>
		<trigger class="destroy" />		
		<result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor1.visual_item" min_amount="2" max_amount="3" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.2" />
	</event>  
	<event>
		<trigger class="destroy" />		
		<result class="spawn" instance_class="visual_item" instance_key="burning_piece_truck1.visual_item" min_amount="1" max_amount="2" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.2" />
	</event>   
	<event>
		<trigger class="destroy" />		
		<result class="spawn" instance_class="visual_item" instance_key="burning_piece_jeep2.visual_item" min_amount="1" max_amount="1" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.05 0.2" />
	</event>  
	
	<effect event_key="health" value="5.0" ref="SmallSmokeVehicle" offset="0 1.4 -0.66" />  
	<effect event_key="health" value="2.5" ref="MediumSmokeVehicle" offset="0 1.4 -0.66" />  
	<effect event_key="destroyed" ref="MediumSmokeVehicle" offset="0 1.4 -0.66" />    
	<effect event_key="destroyed" ref="SmallFireRepeat" offset="0 0.9 1.2" />
	<effect event_key="destroy" key="other" ref="woosh" post_processing="0" shadow="0" />   
	<effect event_key="cleanup" key="other" ref="woosh" post_processing="0" shadow="0" />  
	
	<event>
		<trigger class="cleanup" />		
		<result class="spawn" instance_class="visual_item" instance_key="burning_piece_cleanup.visual_item" min_amount="20" max_amount="30" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.1" /> 
	</event>
 	<event>
		<trigger class="cleanup" />
		<result class="spawn" instance_class="projectile" instance_key="debri_stun" min_amount="1" max_amount="1" offset="0 3.0 0" position_spread="0.0 0.0" direction_spread="0.0 0.0" />
	</event>
	
</vehicle>