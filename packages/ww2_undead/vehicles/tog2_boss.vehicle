<?xml version="1.0" encoding="utf-8"?>
<vehicle file="vehicle_base.vehicle" name="TOG II*" key="tog2_boss.vehicle" 
time_to_live_unsteerable="60" 
respawn_time="3600" 
map_view_atlas_index="19" 
max_character_collision_speed="-1" 
max_character_collision_speed_on_normal="3.5" 
allow_character_leave_request="0" 
usable_for_cover="0" 
allow_owner_to_use_only="1" 
existence="one_per_spawn_point" 
owner="faction" 
protectors="1" 
designated_squad_as_driver_only="0" 
minimum_fill_requirement="0.0" 
ai_force_designated_driver_xp="10.0"
ai_navigation_offset="0.0">

	<tag name="metal_heavy" />
	<tag name="crushes_hedgerows" />
   	<tag name="heavy_armour" />
	<tag name="tank_treads" />
  	<tag name="tog2_boss" />
	<tag name="boss" />
    <access_tag name="edelweiss" />     

	<!-- for now nothing is defined for the TOG II, not even its health -->
   
	<tire_set offset="1.6 0.0 +3.8" radius="0.52" />
	<tire_set offset="1.6 0.0 0" radius="0.52" />    
	<tire_set offset="1.6 0.0 -3.8" radius="0.52" />

	<control max_limiter_speed="4.0" max_speed="6.5" acceleration="7.5" max_reverse_speed="6.5" min_health_to_steer="0.5" max_rotation="0.0" max_water_depth="1.7" steer_smoothening="0.99" tracked="1" gears="1"/>

	<modifier class="blast_range" value="1.0" /> <!-- radius raised to help with issues from AT Rifle Grenades - but not dramatically make other AT weapons overpowered -->
	<!-- radius has to be higher on really big tanks, such as this, and 1.0 seems to work instead of 0.5 -->
	<modifier class="blast_damage" value="-4" />

	<!-- the King Tiger is invulnerable to many weapons, up to and including Light Tanks who only have 37mm guns. -->

	<physics max_health="100.0" blast_damage_threshold="3.91" mass="2000.0" extent="5.6 0.0 9" offset="0 0.0 0" top_offset="0 3.0 0" collision_model_pos="0 1.0 0" collision_model_extent="4.0 3.0 12.6" visual_offset="0 0.58 0.0" /> 

	<!-- one weapon per turret so that only one soldier controls the turret orientation -->
	<!-- similarly, a controllable turret can only exist if it has a weapon -->
	<!-- turrets may have sub-turrets, which may have more weapons, in the future -->
	<turret offset="0 2.45 2.6" weapon_key="tog2_cannon.weapon" weapon_offset="-0.08 0.65 1.05" weapon_recoil="0.2" max_rotation_step="0.000015" />
	<turret offset="2.0 1.78 3.2" weapon_key="tog2_mg.weapon" weapon_offset="0.0 +0.2 0.2" weapon_recoil="0.0" physics_recoil="0.0" max_rotation_step="0.0003" rotation="0.84" rotation_range="1.57" />
	<turret offset="-2.0 1.78 3.2" weapon_key="tog2_mg.weapon" weapon_offset="0.0 +0.2 0.2" weapon_recoil="0.0" physics_recoil="0.0" max_rotation_step="0.0003" rotation="-0.84" rotation_range="1.57" />
	<turret offset="2.0 1.78 1.61" weapon_key="tog2_mg.weapon" weapon_offset="0.0 +0.2 0.2" weapon_recoil="0.0" physics_recoil="0.0" max_rotation_step="0.0003" rotation="2.2" rotation_range="1.54" />
	<turret offset="-2.0 1.78 1.61" weapon_key="tog2_mg.weapon" weapon_offset="0.0 +0.2 0.2" weapon_recoil="0.0" physics_recoil="0.0" max_rotation_step="0.0003" rotation="-2.2" rotation_range="1.54" />

	<visual class="chassis" mesh_filename="tog2_chassis.mesh" texture_filename="tog2_chassis.png" max_tilt="0.02" />
	<visual class="chassis" key="broken" mesh_filename="tog2_chassis_damage.mesh" texture_filename="tog2_chassis_damage.png" />
	<visual class="turret" turret_index="0" key="broken" mesh_filename="tog2_turret_damage.mesh" texture_filename="tog2_turret_damage.png" />
	<visual class="turret" turret_index="1" key="broken" mesh_filename="tog2_mg.mesh" texture_filename="tog2_chassis_damage.png" />
	<visual class="turret" turret_index="2" key="broken" mesh_filename="tog2_mg.mesh" texture_filename="tog2_chassis_damage.png" />
	<visual class="turret" turret_index="3" key="broken" mesh_filename="tog2_mg.mesh" texture_filename="tog2_chassis_damage.png" />
	<visual class="turret" turret_index="4" key="broken" mesh_filename="tog2_mg.mesh" texture_filename="tog2_chassis_damage.png" />
	<visual class="turret" turret_index="0" mesh_filename="tog2_turret.mesh" texture_filename="tog2_turret.png" />
	<visual class="turret" turret_index="1" mesh_filename="tog2_mg.mesh" texture_filename="tog2_chassis.png" />
	<visual class="turret" turret_index="2" mesh_filename="tog2_mg.mesh" texture_filename="tog2_chassis.png" />
	<visual class="turret" turret_index="3" mesh_filename="tog2_mg.mesh" texture_filename="tog2_chassis.png" />
	<visual class="turret" turret_index="4" mesh_filename="tog2_mg.mesh" texture_filename="tog2_chassis.png" />

	<visual class="track" mesh_filename="tog2_track.mesh" offset="-1.20 0.0 0.0" >
		<part texture_filename="tog2_track.png" texture_animation="translate" factor="0.35" tire_binding="0" />
		<part texture_filename="tog2_chassis.png" />
		<part texture_filename="tog2_chassis.png" />
	</visual>

	<visual class="track" mesh_filename="tog2_track.mesh" offset="+1.2 0.0 0.0" >
		<part texture_filename="tog2_track.png" texture_animation="translate" factor="0.35" tire_binding="1" />
	</visual>

	<!-- just so you don't forget - XYZ is Leftright,Updown,Forwardback (left is a positive value) -->

	<character_slot type="driver" position="1.5 0.5 -1" rotation="0" exit_rotation="1.57" hiding="1" animation_id="36" />
	<character_slot type="gunner" position="-1.5 0.7 -1" rotation="0" exit_rotation="-1.57" hiding="1" animation_id="37">
		<turret index="0" />
	</character_slot>

	<character_slot type="gunner" enter_position="2.0 0.5 3.1" seat_position="2.0 0.5 3.1" rotation="0" exit_rotation="1.57" hiding="1" animation_key="tank mg still" marker_offset="0 1.0 0">
		<turret index="1" />
	</character_slot>
	<character_slot type="gunner" enter_position="-2.0 0.5 3.1" seat_position="-2 0.5 3.1" rotation="0" exit_rotation="-1.57" hiding="1" animation_key="tank mg still" marker_offset="0 1.0 0">
		<turret index="2" />
	</character_slot>
	<character_slot type="gunner" enter_position="2.0 0.5 1.3" seat_position="2 0.5 1.3" rotation="0" exit_rotation="1.57" hiding="1" animation_key="tank mg still" marker_offset="0 1.0 0">
		<turret index="3" />
	</character_slot>
	<character_slot type="gunner" enter_position="-2.0 0.5 1.3" seat_position="-2 0.5 1.3" rotation="0" exit_rotation="-1.57" hiding="1" animation_key="tank mg still" marker_offset="0 1.0 0">
		<turret index="4" />
	</character_slot>



	<!-- sound handling -->
	<!--<rev_sound filename="mus_battle_bastogne_boss.wav" low_pitch="1.0" high_pitch="1.0" low_rev="0.0" high_rev="1.0" volume="1.0" /> -->

	<rev_sound filename="tank_rev_tog2_idle.wav" low_pitch="0.8" high_pitch="1.05" low_rev="0.0" high_rev="1.0" volume="2.0" /> 				<!-- vol 2.2 -->
	<rev_sound filename="tank_rev_maus_low_speed_with_grinding.wav" low_pitch="0.8" high_pitch="1.05" low_rev="0.01" high_rev="0.85" volume="2.5" /> 	<!-- vol 2.9 -->
	<rev_sound filename="tank_rev_maus_high_speed1.wav" low_pitch="0.8" high_pitch="1.05" low_rev="0.7" high_rev="1.0" volume="2.2" /> 			<!-- vol 2.9 -->


	<sound key="horn" filename="rev_horn_9.wav" volume="4.0"/>  
	<sound key="squeal" filename="tire_squeal.wav" />
	<sound key="ignition" filename="jeep2_ignition.wav" />
	<sound key="hit" filename="car_hit1.wav" />
	<sound key="hit" filename="car_hit2.wav" />
	<sound key="destroy" filename="vehicle_explosion_1.wav" />   
	<sound key="cleanup" filename="vehicle_explosion_1.wav" />    

	<sound key="turret_rotation" filename="turret_rotation1.wav" volume="3.0" />
	<sound key="turret_rotation" filename="turret_rotation2.wav" volume="0.8"/>
  
	<effect event_key="drive" type="splat_map" surface_tag="dirt" size="1.0" atlas_index="2" layer="1" />
	<effect event_key="drive" type="particle" key="terrain" surface_tag="dirt" ref="Burst" use_surface_color="1" />
  
	<effect event_key="health" value="25.0" ref="SmallSmokeVehicle" offset="0.0 2.4 -3.3" /> 
    
	<effect event_key="health" value="10.0" ref="SmallSmokeVehicle" offset="0.0 2.4 -3.3" />
	<effect event_key="health" value="10.0" ref="BrokenSparkle" post_processing="0" offset="0.0 2.2 -3.3" />   
 
  <effect event_key="destroyed" ref="SmallSmokeVehicle" offset="0.0 2.4 -3.1" />
  <effect event_key="destroyed" ref="SmallSmokeVehicle" offset="-0.8 2.5 -3.1" />  
  <effect event_key="destroyed" ref="MediumSmokeVehicle" offset="0.0 3.2 1.5" />  
  <effect event_key="destroyed" ref="MediumSmokeVehicle" offset="-0.6 3.0 1.2" />    
  <effect event_key="destroyed" ref="SmallFireRepeat" offset="0.0 2.4 -3.2" />
        <effect event_key="destroy" key="other" ref="woosh" post_processing="0" shadow="0" />   
        <effect event_key="cleanup" key="other" ref="woosh" post_processing="0" shadow="0" />  
   

	<event><trigger class="destroy" /><result class="xml_command"><command class="play_sound" filename="mus_boss_death_cue.wav" volume="1.0"/></result></event>
 

	<event key="receive_damage_xp_reward">
		<trigger class="receive_damage" />
		<result class="reward" xp="0.060" />
	</event>
	<event key="destroy_xp_reward">
		<trigger class="destroy" />
		<result class="reward" xp="0.5000" />
	</event>
	<event key="spot_rp_reward">
		<trigger class="spot" />
		<result class="reward" rp="100.0" />
	</event>
	<event key="destroy_rp_reward">
		<trigger class="destroy" />
		<result class="reward" rp="500.0" />
	</event>

    
	<event>
		<trigger class="destroy" />
  	<result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor1.visual_item" min_amount="1" max_amount="3" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.15 0.3" />
	</event>
	<event>
		<trigger class="destroy" />  	
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor2.visual_item" min_amount="0" max_amount="1" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.10 0.15" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor3.visual_item" min_amount="1" max_amount="2" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.12 0.20" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor4.visual_item" min_amount="1" max_amount="2" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.25" />
	</event>    

  <event>
		<trigger class="cleanup" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_cleanup.visual_item" min_amount="20" max_amount="30" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.1" /> 
  </event>  
  
 	<event>
		<trigger class="cleanup" />
    <result class="spawn" instance_class="projectile" instance_key="debri_stun" min_amount="1" max_amount="1" offset="0 3.0 0" position_spread="0.0 0.0" direction_spread="0.0 0.0" />
  </event>     
  
</vehicle>