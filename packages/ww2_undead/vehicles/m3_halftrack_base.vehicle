<?xml version="1.0" encoding="utf-8"?>
<vehicle file="vehicle_base.vehicle" name="M3 Halftrack" time_to_live_unsteerable="60" map_view_atlas_index="24" minimum_fill_requirement="0.2" ai_use_throwables="1">
	<tag name="metal_heavy" />
	<tag name="tank_treads" />
   	<tag name="light_vehicle" />
	<tag name="apc" />



	<tire_set offset="1.00 0.0 +2.20" radius="0.58" />
	<tire_set offset="1.00 0.0 0.0" radius="0.58" />
	<tire_set offset="1.00 0.0 -2.40" radius="0.58" />

  <visual class="tire" index="0" mesh_filename="m3_wheel.mesh" texture_filename="m3.png" />
  <visual class="tire" index="1" mesh_filename="m3_wheel.mesh" texture_filename="m3.png" />
  <visual class="tire" index="2" />
  <visual class="tire" index="3" />
  <visual class="tire" index="4" />
  <visual class="tire" index="5" />

	<modifier class="blast_range" value="0.5" /> <!-- radius raised to help with issues from AT Rifle Grenades - but not dramatically make other AT weapons overpowered -->
	<modifier class="blast_damage" value="-1.1" />

	<!--<control max_limiter_speed="4.0" max_speed="11" acceleration="7.0" max_reverse_speed="7.0" min_health_to_steer="0.5" max_rotation="0.8" max_water_depth="1.6" steer_smoothening="0.8" tracked="0" gears="2" />-->
	<control 
	max_limiter_speed="4.0" 
	max_speed="12" 
	acceleration="10" 
	max_reverse_speed="9.0" 
	min_health_to_steer="0.5" 
	max_rotation="0.0" 
	max_water_depth="1.6" 
	steer_smoothening="0.98" 
	tracked="1" 
	gears="1" 
	tracked_visual_tire_max_rotation="0.5"
	tracked_visual_tire_rotation_smoothening="10.0"
	simulated_speed_factor="0.75"/>

	<physics 
    max_health="14" 
    mass="50.0" 
    broken_mass="5"
    remove_collision_threshold="0.2"
    extent="3.5 0.0 5" 
    offset="0 0.0 0" 
    top_offset="0 3.0 0" 
    collision_model_pos="0.0 1.0 -0.1" 
    collision_model_extent="3.3 2.5 7.75" 
    visual_offset="0 0.23 0.0" 
    friction_offset="0.15" />


<!-- using ai_driver_turns_to_target="1" - the driver always follows the target of the 1st gunner seat. So in the case of the Ho-Ha we must ensure that the centre gun is 1st gunner / turret.-->
<!-- for cases like tanks, we need to ensure their cannons are 1st gunner / turret -->
<!-- for Sdkfz 251, it's irrelevant as it only has 1 gun. -->

	<!-- one weapon per turret so that only one soldier controls the turret orientation -->
	<!-- similarly, a controllable turret can only exist if it has a weapon -->
	<!-- turrets may have sub-turrets, which may have more weapons, in the future -->
	<turret offset="-0.5 2.54 -0.2" weapon_key="m3_halftrack_mg.weapon" weapon_offset="-0.0 0.4 0.0" weapon_recoil="0.02" max_rotation_step="0.0003" rotation="0" />
			<!-- 望远镜炮塔 (index 1，无视觉) -->
	<turret offset="-0.7 0.73 -0.125" weapon_key="binoculars.weapon" weapon_recoil="0.0" physics_recoil="0.0" rotation_range="0" />

	<visual class="chassis" mesh_filename="m3_chassis.mesh" texture_filename="m3.png" max_tilt="0.02" />
	<visual class="chassis" key="broken" mesh_filename="m3_chassis_damage.mesh" texture_filename="m3_damage.png" />
	<visual class="turret" turret_index="0" key="broken" mesh_filename="" texture_filename="" />
	<visual class="turret" turret_index="0" mesh_filename="" texture_filename="" />

	<visual class="track" mesh_filename="m3_track.mesh" offset="-1.1 0.0 0.0" >
		<part texture_filename="m3_wheel.png" texture_animation="rotate" tire_binding="0" />
		<part texture_filename="m3.png" />
		<part texture_filename="m3_track.png" texture_animation="translate" factor="1.0" tire_binding="0" />
	</visual>


	<visual class="track" mesh_filename="m3_track.mesh" offset="+0.95 0.0 -0.18" >
		<part texture_filename="m3_wheel.png" texture_animation="rotate" tire_binding="1" />
		<part texture_filename="m3.png" />
		<part texture_filename="m3_track.png" texture_animation="translate" factor="1.0" tire_binding="1" />
	</visual>

	<!-- just so you don't forget - XYZ is Leftright,Updown,Forwardback (left is a positive value) -->

	<!-- PRIMARY CREW -->
	<character_slot type="driver" enter_position="1.6 0.5 0.2" seat_position="0.50 0.73 -0.125" rotation="0" exit_rotation="1.57" hiding="0" animation_id="36" />
	<character_slot type="gunner" attached_on_turret="0" enter_position="-2.01497 0.5 -0.3813" seat_position="0.0 -1.15 -0.45" rotation="0" exit_rotation="-1.57" hiding="0" animation_key="tank mg still">
		<turret index="0" />
	</character_slot>

	<!-- WEAPON ALLOWED PASSENGERS -->
	<character_slot type="passenger" enter_position="1.6 0.5 -1.5" seat_position="0.7 1.0 -0.8" rotation="1.17" exit_rotation="1.57" hiding="0" allow_weapon="1" animation_key="still"/>
	<character_slot type="passenger" enter_position="-1.6 0.5 -1.5" seat_position="-0.7 1.0 -1.4" rotation="-1.1" exit_rotation="-1.57" hiding="0" allow_weapon="1" animation_key="still"/>

		<!-- 观察手 (index 1- 望远镜) -->
		<character_slot type="gunner" hiding="0">
			<state class="entering" position="-1.6 0.5 0.2" rotation="2.30622" />
			<state class="leaving" position="-1.6 0.5 0.2" rotation="-1.57" />
			<state class="idle" animation_key="sitting, idling" rotation="0" position="-0.7 0.73 -0.125" />
			<turret index="1" />
		</character_slot>

	<!-- ABSOLUTE PASSENGERS -->
	<character_slot type="passenger" hiding="0" allow_weapon="0">
		<state class="entering" position="1.0 0.5 -3.7" rotation="0.0" />
		<state class="leaving" position="1.0 0.5 -3.7" rotation="1.57" />
		<state class="idle" animation_key="sitting, idling" rotation="-1.57" position="0.70 1.0 -1.6" />
	</character_slot>
	<character_slot type="passenger" hiding="0" allow_weapon="0">
		<state class="entering" position="-1.0 0.5 -3.7" rotation="0.0" />
		<state class="leaving" position="-1.0 0.5 -3.7" rotation="-1.57" />
		<state class="idle" animation_key="sitting, idling" rotation="1.57" position="-0.70 1.0 -2.1" />
	</character_slot>
	<character_slot type="passenger" hiding="0" allow_weapon="0">
		<state class="entering" position="1.0 0.5 -3.7" rotation="0.0" />
		<state class="leaving" position="1.0 0.5 -3.7" rotation="1.57" />
		<state class="idle" animation_key="sitting, idling" rotation="-1.57" position="0.70 1.0 -2.2" />
	</character_slot>
	<character_slot type="passenger" hiding="0" allow_weapon="0">
		<state class="entering" position="-1.0 0.5 -3.7" rotation="0.0" />
		<state class="leaving" position="-1.0 0.5 -3.7" rotation="-1.57" />
		<state class="idle" animation_key="sitting, idling" rotation="1.57" position="-0.70 1.0 -2.7" />
	</character_slot>
	<character_slot type="passenger" hiding="0" allow_weapon="0">
		<state class="entering" position="1.0 0.5 -3.7" rotation="0.0" />
		<state class="leaving" position="1.0 0.5 -3.7" rotation="1.57" />
		<state class="idle" animation_key="sitting, idling" rotation="-1.57" position="0.70 1.0 -2.8" />
	</character_slot>
	<character_slot type="passenger" hiding="0" allow_weapon="0">
		<state class="entering" position="-1.0 0.5 -3.7" rotation="0.0" />
		<state class="leaving" position="-1.0 0.5 -3.7" rotation="3.14" />
		<state class="idle" animation_key="sitting, idling" rotation="1.57" position="-0.70 1.0 -3.3" />
	</character_slot>
	<character_slot type="passenger" hiding="0" allow_weapon="0">
		<state class="entering" position="1.0 0.5 -3.7" rotation="0.0" />
		<state class="leaving" position="1.0 0.5 -3.7" rotation="3.14" />
		<state class="idle" animation_key="sitting, idling" rotation="-1.57" position="0.70 1.0 -3.4" />
	</character_slot>

	<!-- sound handling -->
	<rev_sound filename="tank_rev_halftrack_idle4.wav" low_pitch="0.8" high_pitch="1.05" low_rev="0.0" high_rev="1.0" volume="2.1" />		<!-- vol 1.7-->
	<rev_sound filename="tank_rev_halftrack_low_speed4_m3.wav" low_pitch="0.75" high_pitch="1.0" low_rev="0.01" high_rev="0.75" volume="2.3" />	<!-- vol 2.3-->
	<rev_sound filename="tank_rev_halftrack_high_speed6.wav" low_pitch="0.65" high_pitch="1.0" low_rev="0.55" high_rev="1.0" volume="1.4" />	<!-- vol 1.6-->

	<sound key="horn" filename="rev_horn_9.wav" volume="2.0"/>  
	<sound key="squeal" filename="tire_squeal.wav" />
	<sound key="ignition" filename="jeep2_ignition.wav" />
	<sound key="hit" filename="car_hit1.wav" />
	<sound key="hit" filename="car_hit2.wav" />
	<sound key="destroy" filename="vehicle_explosion_1.wav" />   
	<sound key="cleanup" filename="vehicle_explosion_1.wav" />    

	<!--<sound key="turret_rotation" filename="turret_rotation1.wav" volume="0.8" />-->
  
	<effect event_key="drive" type="splat_map" surface_tag="dirt" size="1.0" atlas_index="2" layer="1" />
	<effect event_key="drive" type="particle" key="terrain" surface_tag="dirt" ref="Burst" use_surface_color="1" />
    
  <effect event_key="health" value="2.5" ref="SmallSmokeVehicle" offset="0.0 1.8 2.6" />  

  <effect event_key="health" value="0.5" ref="SmallSmokeVehicle" offset="0.0 1.8 2.6" />
  <effect event_key="health" value="0.5" ref="BrokenSparkle" post_processing="0" offset="0.0 1.6 2.5" />      
  
  <effect event_key="destroyed" ref="SmallSmokeVehicle" offset="0.0 1.8 2.7" />
  <effect event_key="destroyed" ref="SmallSmokeVehicle" offset="0.4 1.9 2.6" />  
  <effect event_key="destroyed" ref="MediumSmokeVehicle" offset="0.0 3.2 0.5" />  
  <effect event_key="destroyed" ref="MediumSmokeVehicle" offset="-0.6 3.0 -0.2" />    
  <effect event_key="destroyed" ref="SmallFireRepeat" offset="0.3 1.7 2.6" />
        <effect event_key="destroy" key="other" ref="woosh" post_processing="0" shadow="0" />   
        <effect event_key="cleanup" key="other" ref="woosh" post_processing="0" shadow="0" />  
   

	<event key="receive_damage_xp_reward">
		<trigger class="receive_damage" />
		<result class="reward" xp="0.0100" />
	</event>

	<event key="spot_rp_reward">
		<trigger class="spot" />
		<result class="reward" rp="50.0" />
	</event>

	<event key="destroy_rp_reward">
		<trigger class="destroy" />
		<result class="reward" rp="50.0" />
	</event>
    
	<event>
		<trigger class="destroy" />
  	<result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor1.visual_item" min_amount="1" max_amount="3" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.15 0.3" />
	</event>
	<event>
		<trigger class="destroy" />  	
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor2.visual_item" min_amount="0" max_amount="1" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.10 0.15" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor3.visual_item" min_amount="1" max_amount="2" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.12 0.20" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor4.visual_item" min_amount="1" max_amount="2" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.25" />
	</event>    

  <event>
		<trigger class="cleanup" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_cleanup.visual_item" min_amount="20" max_amount="30" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.1" /> 
  </event>  
  
 	<event>
		<trigger class="cleanup" />
    <result class="spawn" instance_class="projectile" instance_key="debri_stun" min_amount="1" max_amount="1" offset="0 3.0 0" position_spread="0.0 0.0" direction_spread="0.0 0.0" />
  </event>     
  
</vehicle>