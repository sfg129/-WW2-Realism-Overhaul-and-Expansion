<?xml version="1.0" encoding="utf-8"?>
<vehicle name="Fortified Turret" key="fortified_turret_chi_ha.vehicle" map_view_atlas_index="65" respawn_time="900.0" protectors="2" soldier_capacity_offset="1" minimum_fill_requirement="0.3" character_leave_request_mode="friendly">
	<tag name="target" />
   	<tag name="at_gun" />
   	<tag name="fortified_turret" />

	<tire_set offset="1.0 0.0 1.0" radius="0.65" />
	<tire_set offset="1.0 0.0 -1.0" radius="0.65" />
	
	<control max_speed="24.0" acceleration="6.7" max_reverse_speed="6.0" max_rotation="0.8" max_water_depth="1.9" />
	
	<modifier class="blast_range" value="-2.0" />
	<modifier class="blast_damage" value="-1.6" />

	<physics max_health="20" mass="10000.0" extent="3.6 0.0 3.2" offset="0 0.0 0" top_offset="0 5 0" collision_model_pos="0 0.2 0" collision_model_extent="3.6 1.4 3.2" visual_offset="0 -0.4 0" /> 
	
	<!-- just so you don't forget - XYZ is Leftright,Updown,Forwardback (left is a positive value) -->

	<turret offset="-0.0 2.00 0.0" weapon_key="at_gun_fortified_turret_cannon_chi_ha.weapon" weapon_offset="0.0 -0.3 1.60" weapon_recoil="0.1" max_rotation_step="0.00004" />
	<turret offset="-0.275 0.85 -0.16" weapon_key="at_gun_fortified_turret_grenade_launcher.weapon" weapon_offset="0.0 -0.3 0.0" weapon_recoil="0.025" physics_recoil="0.0" max_rotation_step="0.00008" rotation="0" rotation_range="6.28" parent_turret_index="0"/>
	
	<visual class="chassis" mesh_filename="chi_ha_sandbags.mesh" texture_filename="chi_ha_sandbags.png" />
	<visual class="chassis" key="broken" mesh_filename="chi_ha_sandbags.mesh" texture_filename="chi_ha_sandbags_damage.png" />
	<visual class="turret" turret_index="0" key="broken" mesh_filename="chi_ha_turret_damage.mesh" texture_filename="chi_ha_damage.png" />  
	<visual class="turret" turret_index="0" mesh_filename="chi_ha_turret.mesh" texture_filename="chi_ha.png" />
	<!--<visual class="turret" turret_index="1" key="broken" mesh_filename="chi_ha_mg.mesh" texture_filename="chi_ha_damage.png" />-->
	<!--<visual class="turret" turret_index="1" mesh_filename="chi_ha_mg.mesh" texture_filename="chi_ha.png" />-->
	
	<character_slot type="gunner" position="1.8 0.7 0" rotation="0" exit_rotation="1.57" hiding="1" animation_id="37">
		<turret index="0" />
	</character_slot>
	<character_slot type="gunner" position="-1.8 0.7 0" rotation="0" exit_rotation="-1.57" hiding="1" animation_id="37">
		<turret index="1" />
	</character_slot>
		
	<!-- sound handling -->
	<rev_sound filename="truck_rev0.wav" low_pitch="0.95" high_pitch="1.05" low_rev="0.0" high_rev="0.2" volume="1.0" />
	<rev_sound filename="truck_rev3.wav" low_pitch="0.7" high_pitch="1.0" low_rev="0.05" high_rev="0.7" volume="1.0" />
	<rev_sound filename="truck_rev4.wav" low_pitch="0.8" high_pitch="1.0" low_rev="0.4" high_rev="1.0" volume="1.0" />
	
	<sound key="slide" filename="slide_noise.wav" />
	<sound key="squeal" filename="tire_squeal.wav" />
	<sound key="ignition" filename="truck_ignition.wav" />
	<sound key="hit" filename="car_hit1.wav" />
	<sound key="hit" filename="car_hit2.wav" />
	<sound key="hit" filename="car_hit3.wav" />

	<sound key="turret_rotation" filename="turret_rotation1.wav" volume="2.5" />
	
	<event>
		<trigger class="receive_damage" />
		<result class="reward" xp="0.0100" />
	</event>
	<event key="destroy_rp_reward">
		<trigger class="destroy" />
		<result class="reward" rp="200" />
	</event>
	<event key="spot_rp_reward">
		<trigger class="spot" />
		<result class="reward" rp="50.0" />
	</event>
	
	<event>
		<trigger class="destroy" />		
		<result class="spawn" instance_class="visual_item" instance_key="burning_piece_truck1.visual_item" min_amount="1" max_amount="2" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.2" /> 
	</event>
	<event>
		<trigger class="destroy" />		
		<result class="spawn" instance_class="visual_item" instance_key="burning_piece_jeep2.visual_item" min_amount="1" max_amount="1" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.05 0.2" /> 
	</event>

	<effect event_key="health" value="5.0" ref="SmallSmokeVehicle" offset="0 1.9 -0.66" />  
	<effect event_key="health" value="2.5" ref="MediumSmokeVehicle" offset="0 1.9 -0.66" />  
	<effect event_key="destroyed" ref="MediumSmokeVehicle" offset="0 1.6 -0.66" />    
	<effect event_key="destroyed" ref="SmallFireRepeat" offset="0 2.0 0.2" />
	<effect event_key="destroy" key="other" ref="woosh" post_processing="0" shadow="0" />   
	<effect event_key="cleanup" key="other" ref="woosh" post_processing="0" shadow="0" />  
	
	<event>
		<trigger class="cleanup" />		
		<result class="spawn" instance_class="visual_item" instance_key="burning_piece_cleanup.visual_item" min_amount="20" max_amount="30" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.1" /> 
	</event>
 	<event>
		<trigger class="cleanup" />
		<result class="spawn" instance_class="projectile" instance_key="debri_stun" min_amount="1" max_amount="1" offset="0 3.0 0" position_spread="0.0 0.0" direction_spread="0.0 0.0" />
	</event>
</vehicle>