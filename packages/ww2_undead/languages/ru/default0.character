	<comment key="enemy not seen, taking suppressed fire" text="В укрытие !" />
	<comment key="enemy not seen, taking suppressed fire" text="По нам стреляют !" />
	
	<comment key="Waiting for reinforcements" text="Ожидаем подкрепление"/>
	<comment key="Waiting for reinforcements" text="Подождём тут" />
	
	<comment key="Hold on!" text="Держись !" />
	<comment key="Hold on!" text="Уже бегу !" />  
	<comment key="Hold on!" text="Один момент !" />  
	<comment key="Hold on!" text="Я на подходе !" /> 
	
	<comment key="Move out" text="Вперёд !" />
	<comment key="Move out" text="Выдвигаемся !" />
	<comment key="Move out" text="За мной !" />
	<comment key="Move out" text="Перемещаемся !" />
	
	<comment key="All quiet here" text="Всё чисто." />
	<comment key="All quiet here" text="Тут всё спокойно." />
	<comment key="All quiet here" text="*зевает*" />
	<comment key="All quiet here" text="Тут никого." />
	<comment key="All quiet here" text="*свистит*" /> 
	<comment key="All quiet here" text="Затишье перед бурей ?" />
	<comment key="All quiet here" text="Врагов не видно." />  
	<comment key="All quiet here" text="Ещё пару недель, и всё..." />     
	
	<comment key="Yes sir" text="Так точно !" />
	<comment key="Yes sir" text="Выполняю !" />
	<comment key="Yes sir" text="Есть !" />
	<comment key="Yes sir" text="Слушаюсь !" />
	<comment key="Yes sir" text="Понял !" />
	<comment key="Yes sir" text="Да !" />
	<comment key="Yes sir" text="Будет сделано !" />  
	
	<comment key="Uh, I can't drive this thing" text="Я не умею управлять этой штукой." />
	<comment key="Uh, I can't drive this thing" text="Это не то что я хотел !" />
	<comment key="Uh, I can't drive this thing" text="Упс !" />
	<comment key="Uh, I can't drive this thing" text="Чёрт !" />
	<comment key="Uh, I can't drive this thing" text="Где здесь тромоз !" />
	<comment key="Uh, I can't drive this thing" text="Не та педаль." />
	<comment key="Uh, I can't drive this thing" text="Оно само !" />
	<comment key="Uh, I can't drive this thing" text="Я же тормозил !" />
	<comment key="Uh, I can't drive this thing" text="Кто-то еще хочет попробовать ?" />
	<comment key="Uh, I can't drive this thing" text="Ну надо же !" />
	<comment key="Uh, I can't drive this thing" text="Да как так то ?" />
	<comment key="Uh, I can't drive this thing" text="У кого есть права ?" />
	<comment key="Uh, I can't drive this thing" text="Черт, я дома забыл очки !" />
	<comment key="Uh, I can't drive this thing" text="В какую сторону руль крутить ?" />
	<comment key="Uh, I can't drive this thing" text="Я тут не при чём !" />
	
	<comment key="Waiting for squad" text="Садитесь быстрей !" />
	<comment key="Waiting for squad" text="Я жду, садитесь !" />   
	
	<comment key="Shield up" text="Выставляю щит !" />
	<comment key="Shield up" text="Прячтесь за мной !" />
	<comment key="Shield up" text="Держтесь позади меня !" />
	
	<comment key="overencumbered" text="Рюкзак слишком тяжелый !" />
	<comment key="overencumbered" text="Я еле на ногах стою с таким тяжелым рюкзаком !" />
	<comment key="overencumbered" text="Надо бы выбросить что-то из рюкзака !" />  
	
	<comment key="Where to, chief?" text="Куда, командир ?"/>
	<comment key="Where to, chief?" text="Куда направляемся ?" />
	<comment key="Where to, chief?" text="Куда едем ?" />
	<comment key="Where to, chief?" text="Жду приказов ?" />
	
	<comment key="Press SPACE to continue!" text="Нажмите ПРОБЕЛ, чтобы продолжить !" />
	
	<comment key="about to drive over a friendly" text="С дороги !" />
	<comment key="about to drive over a friendly" text="Дайте проехать !" />
	
	<comment key="this is as close as i can get" text="Не могу подъехать ближе !" />
	<comment key="this is as close as i can get" text="Дальше не проехать !" />
	
	<comment key="enemy vehicle spotted, near base" text="&#37;enemy_name разместили &#37;vehicle_name в районе &#37;base_name" />
	<comment key="enemy vehicle spotted, not near base" text="Обнаружен &#37;vehicle_name &#37;enemy_name" />
	
	<comment key="comms have been restored" text="Радиосвязь востановлена" />
	<comment key="enemy comms have been restored" text="&#37;enemy_name востановили Радиосвязь" />
	
	<comment key="comms have been destroyed" text="Мы потеряли радиосвязь !" />
	<comment key="enemy comms have been destroyed, by us" text="&#37;enemy_name потеряли радиосвязь" />
	
	<dialogue key="wander dialogue 2 men">
		<comment text="Посмотри на это место." />
		<comment text="Тут так спокойно." />
		<comment text="Я бы здесь поселился." />
	</dialogue>
	
	<dialogue key="wander dialogue 2 men">
		<comment text="Кажется, я тут уже был." />
	</dialogue>
	
	<dialogue key="wander dialogue 2 men">
		<comment text="Здесь становиться скучновато." />
	</dialogue>  
	
	<dialogue key="wander dialogue 2 men">
		<comment text="Чувствую себя непобедимым сегодня." />
	</dialogue>
	
	<dialogue key="wander dialogue 2 men">
		<comment text="Иди в армию, они говорят, там весело, они говорят." />
	</dialogue>  
	
	<dialogue key="wander dialogue 2 men">
		<comment text="Если бы знал что нужно столько бегать - пошёл бы в ВВС" />
	</dialogue>   
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Тебя скоро повысят ?" />
		<comment text="Не думаю" />
	</dialogue>
  
  <dialogue key="wander dialogue 2 men">
      <comment text="Хочешь увидить что-то прикольное ?" />
      <comment text="Нет, больше я на это не поведусь !" />
   </dialogue> 
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Знаешь, мы с сержантом были в рейде в тылу врага." />
		<comment text="В деверсанты записался ?" />
		<comment text="Ага, мы даже засекли их грузовик со снаряжением." />
		<comment text="Да ты крут." />
		<comment text="Уж лучше в рейде, чем здесь штаны протирать." />
		<comment text="Тут хоть жив останешься." />
		<comment text="Это не причина не идти в бой." />
	</dialogue>
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Не говори моей маме что я в армии" />
		<comment text="Почему же ?" />
		<comment text="Она думает я пианист в борделе." />
		<comment text="Оу, хорошо." />
	</dialogue>
	
	<dialogue key="defense dialogue 2 men">
		<comment text="У тебя не найдётся сигареты ?" />
		<comment text="Нет, А ты разве куришь ?" />
		<comment text="Не курю. Просто хочу обменять их на новую винтовку." />
		<comment text="А с твоей что не так ?" />
		<comment text="Да я её в песок уронил, клинит." />
		<comment text="Ну, ты же можешь её просто прочистить." />
		<comment text="Если бы я мог ! В оружейной ничего нет для чистки оружия." />
		<comment text="Невероятно !" />
		<comment text="У них куча оружия, но его нечем поддерживать в рабочем состоянии !" />
		<comment text="Да, как будто они уверенны что мы не проживём достаточно долго чтобы иметь в этом необходимость." />
		<comment text="Не нравится мне все это." />
	</dialogue>
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Где их грузовик связи ?" />
		<comment text="Не знаю, но уверен, что не здесь." />
	</dialogue>
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Я тут нашёл виски и припрятал его в тайнике." />
		<comment text="Тише ! Нам ведь не положено хранить алкоголь. "/>
	</dialogue>
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Я тут думал..." />
		<comment text="О чём  ?" />
		<comment text="Я забыл." />
	</dialogue>
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Командир, почему мы ничего не делаем ?" />
		<comment text="Отставить обсуждение приказов ! На поле боя это верный путь к смерти !" />
		<comment text="Так точно !"/>      
	</dialogue>
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Может не вступать в Строевой Хор ?" />
		<comment text="Почему же ?" />
		<comment text="Я раньше был в церковном хоре."/>  
		<comment text="И ?" /> 
		<comment text="200 человек сменило религию." />           
	</dialogue>  
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Нас хотя бы с тыла не атакуют." />
		<comment text="Ага, к этому мы точно не готовы." />
	</dialogue>   
	
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="" />
		<comment text="" />
	</dialogue>
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Недавно, перестреливался с разработчиками." />
		<comment text="Это были Pasik и JackMayol ?" />
		<comment text="Да, Pasik целится как моя бабушка JackMayol даже хуже !" />
	</dialogue>       
	
	<dialogue key="defense dialogue 2 men">
		<comment text="'Osumia Games'... Кому в голову приходят такие названия?" />
		<comment text="Погоди, о чем ты сейчас говоришь?" />
        <comment text="Сам не знаю." />
	</dialogue>  
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Мне иногда кажется что мы просто бегаем с винтовками." />
		<comment text="Да ладно !" />
	</dialogue>  
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Ай, мой палец !" />
		<comment text="Прости друг." />
	</dialogue>
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Эту игру хоть выпустли ?" />
		<comment text="Да, в Steam есть." />
		<comment text="Отлично !" />    
	</dialogue> 
	
	<dialogue key="vehicle dialogue 2 men tag=truck" >
		<comment text="Кто-то перндул ?" />
		<comment text="Может быть." />
		<comment text="Открыть окна !" />    
	</dialogue>   
	
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Знаешь что ?" />
		<comment text="Что ?" />
		<comment text="Мне кажется я люблю тебя." />   
		<comment text="Прекрати уже !" />     
	</dialogue> 
	
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Кто тебе права вообще дал ?" />
		<comment text="А я купил." />
	</dialogue> 
	
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="*поет* Hit me baby one more tiiiime" />
		<comment text="Если продолжишь петь, я вытолкну тебя из машины !" />
	</dialogue>
	
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Я не чувсвтвую себя в безопасности в этом штуке." />
		<comment text="Почему ?" />      
		<comment text="Глянь на колеса." />
		<comment text="А что с ними не так ?" />
		<comment text="Да они даже к осям не присоединены" />    
	</dialogue>  
	
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Сучно ехать без радио." />
		<comment text="И не говори." />
	</dialogue> 
	
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Я всегда боялся быть в одном отряде с тобой." />
		<comment text="А что не так то ?" />
		<comment text="С кем поведешься, того и наберешься." />    
	</dialogue> 
	
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Когда все получается, то никто не видит." />
		<comment text="А когда нет, то командир тут как тут." />
	</dialogue> 
	
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Остерегайся противотанковых гранат." />
		<comment text="Ага, они наносят больше урона, чем осколочные." />
		<comment text="К счастью, радиус поражения у них меньше." />    
	</dialogue> 
	
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="" />
		<comment text="" />
	</dialogue>  
	
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Несколько девушек в армии бы не помешали." />
		<comment text="Да, я бы успокоил свои гормоны." />
		<comment text="Да я не про это !" />
		<comment text="А ?" /> 
		<comment text="Не пришлось бы готовить, стирать и убирать." />               
	</dialogue>     
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Они бы могли добавить тут пару полигонов." />
		<comment text="Зачем ?" />
		<comment text="Сиденья слишком острые !" />    
	</dialogue> 
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="*поет* Золотые купола, Ветер Северный" />
		<comment text="Тебе надо было идти в артисты." />
		<comment text="Правда ? Ты серьезно ?" /> 
		<comment text="Да конечно, ведь нам бы не пришлось слышать это каждый божий день." />    
	</dialogue> 
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Тебе выдали новое снаряжение ?" />
		<comment text="Да." />
		<comment text="Нечестно !" /> 
		<comment text="Завидуй молча." />    
	</dialogue> 
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Ты не мог бы подвинуться?" />
		<comment text="Нет." />
		<comment text="Спасибо." />
		<comment text="Пожалуйста." />
	</dialogue>
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="День но без солнечного света это как-бы ночь." />
		<comment text="Неужели?" />
	</dialogue>
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Ты знаешь прогноз погоды наночь?" />
		<comment text="Темно!" />
		<comment text="..." />
	</dialogue>
	
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Вот бы больше людей играло в PvP." />
		<comment text="Почему ?" />
		<comment text="Нас, ботов, меньше убивали бы." />    
	</dialogue> 
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Если сомневаешся, выпускай весь магазин !" />
		<comment text="Да сер !" />
	</dialogue> 
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="У меня есть идея." />
		<comment text="Забудь, идеального плана не бывает." />
	</dialogue> 
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Вы готовы к бою?" />
		<comment text="Сэр, Да Сэр!" />
	</dialogue> 
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Помните, что я говорил вам сегодня утром !" />
		<comment text="Да капитан !" />
		<comment text="Если наша атака идет слишком хорошо, то это засада !" />    
	</dialogue> 
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Это глупый план !" />
		<comment text="Если это глупо, но работает, то это не глупо." />
	</dialogue>     
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Что мы будем делать если у нас ничего не получится?" />
		<comment text="Мы вызовем флот с большими пушками." />
	</dialogue>  
	
  <dialogue key="vehicle dialogue 2 men">
      <comment text="Когда ты в последний раз сидел за рулем ?!" />
      <comment text="Эмм, это мой первый раз." />
      <comment text="Что ты вообще делаешь на месте водителя ?!" />
      <comment text="..." />
      <comment text="До фронта живыми мы не доедем." />
  </dialogue>
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="" />
		<comment text="" />
	</dialogue>  
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="В армии есть два основных правила" />
		<comment text="Какие же ?" />
		<comment text="#1: Командир всегда прав" />
		<comment text="#2: Если командир не прав, обратитесь к правилу #1" />        
	</dialogue>            
	
	<dialogue key="vehicle dialogue 2 men tag=campfire">
		<comment text="Мои ступни горят." />
		<comment text="Отодвинься." />
		<comment text="Не могу." />
	</dialogue>
	
	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="Я просто обожаю этот танк." />
		<comment text="Да заткнись ты уже." />
		<comment text="Не могу." />
	</dialogue>
	
  <dialogue key="vehicle dialogue 2 men tag=tank">
      <comment text="Может дадим ему имя ?" />
      <comment text="Зачем ?" />
      <comment text="Ну он у нас уже достачно долго." />
  </dialogue>
	
	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="Лучшая защита - оставаться вне досягаемости врага" />
		<comment text="Умный сильно ?" />
	</dialogue>
	
	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="Это СПАРТА !!!" />
		<comment text="..." />
	</dialogue>
	
	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="Танк - лучшее противотакновое средство в бою !" />
	</dialogue>
	
	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="Нет лучше для танка дороги, чем дорога без противотанковых орудий и мин." /> 
	</dialogue>
	
	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="Нет такой проблемы, которую нельзя решить достаточным количеством взрывчатки." /> 
	</dialogue> 
	
  <dialogue key="vehicle dialogue 2 men tag=tank">
      <comment text="Откуда здесь кот ?" />
      <comment text="Прибор ночное виденья сломалося." />
  </dialogue> 
	
  <dialogue key="vehicle dialogue 2 men tag=tank">
      <comment text="А прикинь если бы эта штука летала ?" />
      <comment text="В ней и на земле страшно." />
      <comment text="Да чего тут бояться то?." />
  </dialogue>      
	
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Ай !" />
	</dialogue>
	
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Кажется меня тошнит" />
	</dialogue>
	
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Мне кажется что он не знает куда едет." />
	</dialogue>
	
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Мы уже приехали ?" />
	</dialogue>
	
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="*храпит*" />
	</dialogue>
	
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Ха ! Видел бы ты свое лицо свое лицо !" />
		<comment text="Что с ним ?" />
		<comment text="Оно все в вокселях." />     
	</dialogue>  
	
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Люблю когда в фильмах ужасов люди спрашивают:'Есть здесь кто-то ?' " />
		<comment text="Как если бы убийца сказал: 'Да, я на кухне, вы хотите бутерброд ?'" />   
	</dialogue>  
	
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Вот бы увидеть интерьер грузовика" />
		<comment text="Денег не хватило на детализацию." /> 
		<comment text="Ленивые разработчики !" />         
	</dialogue>        
	
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="" />
	</dialogue>  
	
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="" />
	</dialogue>
	
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Я на много спокойней когда не сижу в этой штуке." />
	</dialogue>  
	
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Сейчас бы пиццы" />
		<comment text="Или шашлычка" />
		<comment text="Или картошечки жареной" />
		<comment text="Или тофу" />
		<comment text="Чего ?!" />                
	</dialogue>
	
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Почему от тебя пахнет мертвячиной?" />
		<comment text="Прости, я зубную щетку потерял." />    
	</dialogue>  
	
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Слушай ? А для чего эта зеленая штука?" />
		<comment text="Э-э ... не для чего ..." />    
	</dialogue> 
	
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Извини, можешь перезапустить игру?" />
		<comment text="Что происходит?" /> 
		<comment text="Кажется я в текстуре застрял." />        
	</dialogue>        
	
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Лучше бы каску надел чем эту красную повязку." />
		<comment text="Ты прав, но она выглядит круто." />    
		<comment text="Пулям всеравно." />    
	</dialogue> 
	
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Фу, воняет потными вокселями!" /> 
	</dialogue>      
	
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Хочешь жвачку?" /> 
		<comment text="Нет спасибо." /> 
		<comment text="Мы думаем, что ты точно хочешь жвачку!" />
		<comment text="Это значит что у меня...?" />
		<comment text="Угадал! " />                
	</dialogue> 
	
  <dialogue key="vehicle dialogue 2 men tag=truck">
     <comment text="Ты помнишь фильм, в котором водители грузовика спасают всех?" />
     <comment text="Нет." />
     <comment text="Вот, я тоже. Мы все умрем!" />
  </dialogue>  
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Скоро я получу повышение." />
		<comment text="Постарайся не умереть до этого момента." />
		<comment text="Ну спасибо, обнадёжил!" />
	</dialogue>
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Я чувствую себя отлично!" />
	</dialogue>
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Я чувствую, что возродился уже 100 раз." />
		<comment text="Я тоже." />  
		<comment text="Так бы в жизни." />
		<comment text="Хех." />           
	</dialogue>
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Старики на свадьбах толкают меня локтями говоря 'Ты следующий'." />
		<comment text="Начал делать им так-же только на похоронах!" />     
	</dialogue>  
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Эти Телемагазины так раздражают!" />
		<comment text="Просто дай трубку трехлетнему ребенку и скажи что звонит Дед мороз." />     
	</dialogue>  
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Мне приснился кошмар" />
		<comment text="Расскажи" />   
		<comment text="Мне снились 1 и 0" />
		<comment text="Как страшно..." />
		<comment text="И тут я увидел 2" />
		<comment text="Какой ужас!!!" />          
	</dialogue>   
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Священик, фермер и вояка заходят в бар..." />
		<comment text="Если это твоя очередная шутка, то я клянусь, я самолично пущу тебе пулю в лоб !" /> 
		<comment text="Но я же только начал рассказывать..." />
		<comment text="Я серьезно !" />    
		<comment text="Ладно." />         
	</dialogue>           
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Парень, ты можешь помолчать ?" />
		<comment text="Это семейная традиция." /> 
		<comment text="Что ?" />
		<comment text="Мой дед был коммивояжёром, а отец - учителем" />    
		<comment text="А мать ?" /> 
		<comment text="Женщиной." />              
	</dialogue>   
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Как же мне сказать отцу ?" />
		<comment text="Сказать что ?" /> 
		<comment text="Что меня не повысили." />
		<comment text="Отправь телеграмму." />    
		<comment text="И что написать ?" /> 
		<comment text="Ситуация стабильная." />              
	</dialogue>  
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Хорошо, что авиации тут нет." />
		<comment text="Одной проблемой меньше." /> 
		<comment text="Ага, можно не беспокоиться, что прилетит сверху" />          
		<comment text="Ага, кроме артилерии, минометов и .... аргх ! " />
		<comment text="И голубей!" /> 
		<comment text="Вот черт!" />                                    
	</dialogue>     
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Профессиональный солдат - предсказуем." />  
		<comment text="Но мир полон опасных любителей." />                                      
	</dialogue> 
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Все постоянно говорят про военный интелект." />  
		<comment text="А что не так?" />
		<comment text="Военный интелект это противоречие!" /> 
		<comment text="Говори за себя!" />                                            
	</dialogue>   
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Хотел бы я видеть так же далеко, как игрок." />  
		<comment text="Игрок?" />
		<comment text="Ну этот чувак по ту сторону экрана который пялится на нас." /> 
		<comment text="Сплошное читерство!" /> 
		<comment text="Я уже устал от его взгляда." />                                               
	</dialogue>     
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Чем глупее командир, тем более важную задачу ему поручат." />  
		<comment text="В точку !" />                                     
	</dialogue>  
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Всегда можно найти выход." />  
		<comment text="В большинстве случаев он тебя не устраивает." />                                     
	</dialogue>  
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Ты видел новую жену командира ?" />  
		<comment text="Эта та девица с большим носом ?" /> 
		<comment text="Да она без проблем может курить под дождем !" />                                         
	</dialogue> 
	
	<dialogue key="defense dialogue 2 men">
		<comment text="А правда, что люди произошли от обезьян ?" />  
		<comment text="Разве что только рядовые солдаты, но уж точно не офицеры." />                                     
	</dialogue>   
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Среди новобранцев есть девушка, косящая под мальчика." />  
		<comment text="Ей же придется мыться и одеваться среди остальных." /> 
		<comment text="Конечно !" />  
		<comment text="Скоро командование об этом узнает." /> 
		<comment text="А кто расскажет ?" />                                             
	</dialogue>  
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Зачем нам больше дорогих бомб ?" />  
		<comment text="Ну знаешь ли..." /> 
		<comment text="Разве получатели жалуются на низкосортный продукт ?" />                                        
	</dialogue>         
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Почему мы отступаем ?" />  
		<comment text="Не отступаем, а наступаем в противоположном направлении." />  
		<comment text="Понял." />                                       
	</dialogue>  
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Знаешь, в армии твоя ориентация не важна" />  
		<comment text="Спасибо за поддержку, друг." />                                     
		<comment text="В отличии от ориентации твоего оружия." />
	</dialogue>     
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Война учит невежд географии." />  
		<comment text="В точку" />                                     
	</dialogue> 
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Никогда не прерывай врага, когда он совершает ошибку." />  
		<comment text="Просто смотри и наслаждайся." />                                     
	</dialogue>    
	
	<dialogue key="defense dialogue 2 men">
		<comment text="На поле боя валяется столько ценностей." />  
		<comment text="И никто не обращает внимания." /> 
		<comment text="А ты продай эти вещи в оружейной!" />                                         
	</dialogue> 
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Сегодня я максимально сосредоточен." />  
		<comment text="Почему?" /> 
		<comment text="Мне кажется сегодня мы наткнемся на игрока." />
		<comment text="Хочешь испорить его серию убийств?" /> 
		<comment text="О,да." />                                                
	</dialogue>  
	
  <dialogue key="defense dialogue 2 men">
		<comment text="Я вот тут подумал..." />
		<comment text="Чего?" />
		<comment text="Откуда берутся наши подкрпеления?" />
		<comment text="Всмысле откуда?" />
		<comment text="Они не приезжают на транспорте или что-то в этом роде." />
		<comment text="Ну не из воздуха же они появляются?" />
  </dialogue>
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Это ты испортил воздух?" />
		<comment text="Хаха!" />
		<comment text="Ты отвратителен." />
		<comment text="Сэр, да Сэр!" />
	</dialogue>
	
  <dialogue key="defense dialogue 2 men">
      <comment text="Нам мало платят за такую работу" />
      <comment text="Уж точно недостаточно, чтобы видеть твоё лицо каждый день" />
      <comment text="Чего? Ты шутишь?" />
      <comment text="Ох, если бы..." />
  </dialogue>   
	
	<dialogue key="defense dialogue 2 men">
		<comment text="" />  
		<comment text="" />                                     
	</dialogue> 
	
	<dialogue key="defense dialogue 2 men">
		<comment text="" />  
		<comment text="" />                                     
	</dialogue>    
	
