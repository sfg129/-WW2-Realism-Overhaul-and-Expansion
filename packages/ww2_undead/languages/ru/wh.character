   <!-- character specific animation override table -->

<!-- #EDELWEISS_TRANSLATION -->

	<comment key="We surrender!" text="Не стреляйте! Я поляк!"/>
	<comment key="We surrender!" text="Я сдаюсь! К черту эту войну!"/>
	<comment key="We surrender!" text="Я сдаюсь!"/>
	<comment key="We surrender!" text="Пожалуйста, я просто хочу окончить школу!"/>
	<comment key="We surrender!" text="Чертовы союзнические свиньи..."/>
	
	<comment key="Medic!" text="Врача!"/> 
	<comment key="Medic!" text="Помогите, быстрее!"/>    
	
	<comment key="Quickly!" text="Быстрее!"/>
	<comment key="Quickly!" text="Вперед вперед вперед!"/>    
	
	<comment key="initiate radio call" text="Штаб, это Кампфгруппа фон Лак, вы слышите?"/>

	
	<comment key="hostile vehicle takeover" text="Что? НЕТ!"/>
	<comment key="hostile vehicle takeover" text="Эй! Это - "/> 
	<comment key="hostile vehicle takeover" text="Что? Нет нет НЕТ!"/>    
	
	<comment key="enemy seen" text="Тревога!"/>
	
	<comment key="enemy not seen, taking suppressed fire" text="Тревога!"/>

	<comment key="enemy seen, vehicle tag = tank" text="Вражеский танк!"/> 
	<comment key="enemy seen, vehicle tag = tank" text="Ложись! Вражеский танк!"/> 
	<comment key="enemy seen, vehicle tag = tank" text="Танк Союзников!"/> 
	<comment key="enemy seen, vehicle tag = tank" text="Внимание, танк!!"/>        
	

	<comment key="Hold on!" text="Держись там приятель!"/>  

	<comment key="Yes sir" text="Так точно"/>
	<comment key="Yes sir" text="Понял"/>    
	
	<comment key="celebrating" text="Отличная работа, мужчины."/>
	<comment key="celebrating" text="Отличная работа!"/>    
	<comment key="celebrating" text="Мы выдавим вас обратно за канал!"/>
	<comment key="celebrating" text="Победа!"/>	<!-- do not translate this one in German! Use something else lol. -->
	<comment key="celebrating" text="Прекрасная работа парни."/>
	<comment key="celebrating" text="Получай, союзническая свинья!"/>
	<comment key="celebrating" text="Есть ли у тебя сигареты, союзническая сволочь?"/>
	<comment key="celebrating" text="Кто-нибудь видел моего прадеда? Он был в атаке в первой кампании."/>
	<comment key="celebrating" text="Думаю, я приготовлю себе капусту с сосисками и картошкой."/>
	<comment key="celebrating" text="Кто-нибудь видел моего племянника? Он был в разведывательном патруле."/>
    
	<comment key="Waiting for squad" text="Садись, быстрее!"/>     
	
	<dialogue key="wander dialogue 2 men">
		<comment text="We're doing an awful lot of walking here."/>
	</dialogue>    
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Они дали тебе новое снаряжение?"/>
		<comment text="Ага"/>
		<comment text="Чёрт, мне нужно что-то новенькое.."/> 
		<comment text="У нас только один ящик"/>    
	</dialogue> 
	
	
	<dialogue key="vehicle dialogue 2 men tag=light_tank">
		<comment text="Как мы назовем танк?"/>
		<comment text="Томмидавилка."/>
		<comment text="Когда ты так говоришь, Фриц, я волнуюсь за тебя."/>
	</dialogue>
		
   <!-- commander comments -->
	<comment key="we captured a base" text="Наши гренадеры зачистили %base_name!"/>
	<comment key="we captured a base" text="Мы захватили %base_name, обезопасите район."/>
	<comment key="enemy captured a base" text="Войска союзников захватили %base_name, приготовьтесь к немедленной контратаке!"/>
	<comment key="enemy captured a base" text="Мы потеряли %base_name, немедленно захватите её назад!"/>
	<comment key="our base is under attack" text="Мы получили сообщения о том, что силы Союзников атакуют %base_name."/>
	<comment key="fighting near a base" text="Стрельба рядом с %base_name"/>
	
	
   <!-- adventure mode -->
	<comment key="map start with 1 base, part 3" text="Наши войска прибыли сегодня и приготовились к наступательным операциям."/>
	
	<comment key="map start with 1 base, capture" text="Теперь мы готовы начать вторжение, цель - полностью захватить территорию."/>
	
	<comment key="map advance, held by enemy" text="Наше командование говорит что %map_name является следующей стратегической целью. %faction_name плотно окопались в этом районе."/>
	<comment key="map advance, new map" text="Дивизия готовится к еще одной атаке, пошли!"/>
	
	<comment key="final map, part 1" text="Внимание, новый инструктаж от командира"/>
	<comment key="final map, part 2" text="Хорошо, что вы все здесь, на %map_name"/>
	<comment key="final map, part 3" text="Это все! Последняя операция!"/>
	<comment key="final map, part 5" text="Битву за битвой мы отбросили %faction_name назад."/>
	<comment key="final map, part 6" text="Выиграй эту битву и покончи с этой войной, раз и навсегда!"/>

	<!-- WH campaign commander lines -->
	<comment key="sicily, part 1" text="Внимание, новый инструктаж от командира"/>
	<comment key="sicily, part 2" text="Хорошо, что вы все здесь, в Сицилии."/>
	<comment key="sicily, part 3" text="Американские десантники высадились в близлежащем районе и заняли все важную территорию."/>
	<comment key="sicily, part 4" text="Наша задача - вернуть эти позиции и устранить воздушную угрозу!"/>

	<comment key="brecourt, part 1" text="Внимание, новый инструктаж от командира"/>
	<comment key="brecourt, part 2" text="Войска, добро пожаловать в Нормандию."/>
	<comment key="brecourt, part 3" text="Нам сообщили, что прошлой ночью американские десантники захватили город Св. Мари-дю-Монт."/>
	<comment key="brecourt, part 4" text="Множество сообщений говорят о том, что происходит массовое наступление сил Союзников на континент."/>
	<comment key="brecourt, part 5" text="Сейчас мы должны позаботиться о ближайшей территории и сделать все, что в наших силах."/>
	<comment key="brecourt, part 6" text="В вашем распоряжении множество бронетехники, контратакуйте и обезопасьте территорию!"/>

	<comment key="overlord intro, part 1" text="Внимание, инструктаж от командования!" />
	<comment key="overlord intro, part 2" text="Армия только что ушла - мы здесь одни." />
	<comment key="overlord intro, part 3" text="И что еще хуже, союзники, похоже, собираются ударить по этой линии всем, что у них есть." />
	<comment key="overlord intro, part 4" text="Удерживайте позиции, и защищайте аэродром любой ценой!" />
	<comment key="overlord intro, part 5" text="Противник будет наступать через реку, будте готовы." />
	<comment key="overlord intro, part 6" text="Удачи вам солдаты! У вас есть 30 тсекунд чтобы занять позиции!" />
	<comment key="overlord intro, part 7" text="Противник прощупывает нашу оборону, осталось мало времени!" />
	
	<comment key="overlord stage 1" text="Вражеская бомбардировка, в укрытие! (Фаза 1 началась)" />
	<comment key="overlord stage 2" text="Приближается вторая волна! (Фаза 2 началась)" />
	<comment key="overlord stage 3" text="Танки! У них есть танки! (Фаза 3 началась)" />
	<comment key="overlord stage 4" text="Противник не сдается, держать оборону! (Фаза 4 началась)" />
	<comment key="overlord stage 5" text="Похоже они собирают силы для еше одной атаки - укрепляйте позиции! (Пауза 2 минуты)" />
	<comment key="overlord stage 6" text="Армия только что прибыла, но враг, похоже, не слишком стремится остановить их атаку.  (Фаза 6 началась)" />
	<comment key="overlord stage 7" text="Армия вернулась с большими пушками! Устройте им ад!" />
	<comment key="overlord stage 8" text="Пора вытеснить противника!" />

	<comment key="hill262, part 1" text="Внимание, новый инструктаж от командира"/>
	<comment key="hill262, part 2" text="Мы в трудном положении. Несмотря на наши усилия, мы отступаем от сил Союзников."/>
	<comment key="hill262, part 3" text="Близлежащая высота, Hill 262, имеет полный обзор на наши отступающие колонны и если мы её потеряем, мы будем отрезаны."/>
	<comment key="hill262, part 4" text="У нас есть сообщения, что польская бронетанковая дивизия готовится к массированной атаке."/>
	<comment key="hill262, part 5" text="Защитите и удерживайте холм любой ценой!"/>

	<comment key="hellshighway, part 1" text="Внимание, новый инструктаж от командира"/>
	<comment key="hellshighway, part 2" text="Теперь, когда британское наступление на шоссе 69 остановилось, мы посылаем ремонтный танк Bergetiger, чтобы убрать бардак на фронте."/>
	<comment key="hellshighway, part 3" text="Была подготовлена контратака для прикрытия его продвижения - если Bergetiger будет уничтожен, мы провалим нашу миссию!"/>
	<comment key="hellshighway, part 4" text="Противотанковые позиции обозначены на вашей тактической карте согласно данным нашей разведки."/>
	<comment key="hellshighway, part 5" text="Приготовьтесь и вперед!"/>

	<comment key="arnhem, part 1" text="Внимание, новый инструктаж от командира"/>
	<comment key="arnhem, part 2" text="Добро пожаловать в Нидерланды."/>
	<comment key="arnhem, part 3" text="Прошло некоторое время с тех пор, как мы избежали атаки союзников в Нормандии, но они начали новую атаку."/>
	<comment key="arnhem, part 4" text="Британские десантники захватили этот город, Арнем, и посылают колонну помощи, чтобы поддержать их."/>
	<comment key="arnhem, part 5" text="Однако до тех пор, пока колонна не прибудет сюда, они будут отрезаны и без тяжелой бронированной поддержки. Собирайтесь и захватите город!"/> 
    
	<comment key="arnhem, supply cut" text="Наша главная база снабжения была захвачена врагом, верни ее, быстрее!"/>    

	<comment key="bastogne, part 1" text="Внимание, новый инструктаж от командира"/>
	<comment key="bastogne, part 2" text="Господа, несколько дней назад мы начали массированную атаку через Арденны."/>
	<comment key="bastogne, part 3" text="Сегодня мы доставили вас сюда, к важному перекрестку дорог Бастонь."/>
	<comment key="bastogne, part 4" text="Город контролируется вашими старыми противниками, американскими десантниками."/>
	<comment key="bastogne, part 5" text="Они хорошо окопались и имеют стальные нервы, но мы выделяем некоторые из самых мощных танков, какие мы сможем достать."/>
	<comment key="bastogne, part 6" text="Хватайте оружие и поднимайтесь! Сегодня мы сломим их волю!"/>

	<comment key="sealion, part 1" text="Внимание, новый инструктаж от командира"/>
	<comment key="sealion, part 2" text="Войска, за последние несколько месяцев нам удалось чудесным образом оттолкнуть Союзников назад за Ла-Манш."/>
	<comment key="sealion, part 3" text="Несмотря на это, они отказываются сдаваться, так что наши оперативные планы здесь - атака в самое сердце Англии!"/>
	<comment key="sealion, part 4" text="Это воздушно-десантная операция, но если вам удастся обезопасить береговую линию, мы сможем предоставить бронетанковую поддержку."/>
	<comment key="sealion, part 5" text="Хватайте свои парашюты и держите себя в руках! Это будет последним поражением нашего врага!"/>
	<comment key="sealion, boss, part 1" text="Британское сопротивление ослабевает, но в Цитадели, по-видимому, находятся несогласные."/>
	<comment key="sealion, boss, part 2" text="Уничтожьте любое сопротивление, которое прячется в этих укреплениях!"/>

	<comment key="generic counter-attack" text="Враг начинает массированную контратаку! Держитесь любой ценой! Если мы потеряем территорию-захватите её назад!"/>

   <!-- reinforcement commander lines -->
	<comment key="spawn_in_base_call, accepted, key=wh_inf.call" text="Пехота собирается около %base_name"/>
	<comment key="spawn_in_base_call, denied, key=wh_inf.call" text="Не найдено подходящих точек развёртывания, захватите базу!"/>

	<comment key="spawn_in_base_call, accepted, key=wh_vehicle.call" text="Танк Panzer IV размещен около %base_name"/>
	<comment key="spawn_in_base_call, denied, key=wh_vehicle.call" text="Не найдено подходящих точек развёртывания, захватите базу!"/>

	<comment key="spawn_in_base_call, accepted, key=wh_vehicle_sdkfz251.call" text="Бронетранспортёр Sdkfz 251 размещен около %base_name"/>
	<comment key="spawn_in_base_call, denied, key=wh_vehicle_sdkfz251.call" text="Не найдено подходящих точек развёртывания, захватите базу!"/>

	<comment key="spawn_in_base_call, accepted, key=wh_vehicle_stug.call" text="САУ StuG III размещена около %base_name"/>
	<comment key="spawn_in_base_call, denied, key=wh_vehicle_stug.call" text="Не найдено подходящих точек развёртывания, захватите базу!"/>

	<comment key="spawn_in_base_call, accepted, key=wh_vehicle_luchs.call" text="Танк Panzer II Luchs размещен около %base_name"/>
	<comment key="spawn_in_base_call, denied, key=wh_vehicle_luchs.call" text="Не найдено подходящих точек развёртывания, захватите базу!"/>
	
</character>
