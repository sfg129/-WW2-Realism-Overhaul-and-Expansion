	<comment key="spawn_in_base_call, denied, key=wh_vehicle_sdkfz251.call" text="Non sono stati trovati punti di dispiegamento validi, catturare una base!"/>

	<comment key="spawn_in_base_call, accepted, key=wh_vehicle_stug.call" text="Dispiegamento di StuG III a %base_name"/>
	<comment key="spawn_in_base_call, denied, key=wh_vehicle_stug.call" text="Non sono stati trovati punti di dispiegamento validi, catturare una base!"/>

	<comment key="spawn_in_base_call, accepted, key=wh_vehicle_luchs.call" text="Dispiegamento di Panzer II Luchs a %base_name"/>
	<comment key="spawn_in_base_call, denied, key=wh_vehicle_luchs.call" text="Non sono stati trovati punti di dispiegamento validi, catturare una base!"/>
	
</character>
