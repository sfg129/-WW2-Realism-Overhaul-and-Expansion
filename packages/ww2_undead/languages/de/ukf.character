	<comment key="spawn_in_base_call, accepted, key=ukf_vehicle_churchill.call" text="Churchill Mk VII steht bereit bei %base_name"/>
	<comment key="spawn_in_base_call, denied, key=ukf_vehicle_churchill.call" text="Keine gültigen Einsatzpunkte gefunden, erobern Sie einen Stützpunkt!"/>
	
</character>
