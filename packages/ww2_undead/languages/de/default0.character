	<comment key="enemy vehicle spotted, near base" text="%enemy_name %vehicle_name bei %base_name" />
	<comment key="enemy vehicle spotted, not near base" text="%enemy_name %vehicle_name gesichtet" />

	<comment key="comms have been restored" text="Die Funkverbindung wurde wieder hergestellt"/>
	<comment key="enemy comms have been restored" text="%enemy_name Funkverbindung wurde vollständig wieder hergestellt" />

	<comment key="comms have been destroyed" text="Die Funkkommunikation wurde zerstört!" />
	<comment key="enemy comms have been destroyed, by us" text="Gute Arbeit, die Funkverbindung der %enemy_name wurde sabotiert!" />  

	<dialogue key="wander dialogue 2 men">
		<comment text="Schau dir diese Gegend an man" />
		<comment text="So ruhig" />
		<comment text="Könnte fast hier leben" />
	</dialogue>

	<dialogue key="wander dialogue 2 men">
		<comment text="Hmm hier war ich doch schonmal" />
	</dialogue>
  
	<dialogue key="wander dialogue 2 men">
		<comment text="Wir brauchen hier ein bisschen mehr Action" />
	</dialogue>  

	<dialogue key="wander dialogue 2 men">
		<comment text="Fühl' mich heute unbesiegbar" />
	</dialogue>
  
	<dialogue key="wander dialogue 2 men">
		<comment text="Geht zur Armee haben sie gesagt, es wird lustig sagten sie..." />
	</dialogue>  
  
	<dialogue key="wander dialogue 2 men">
		<comment text="Wenn ich gewusst hätte, wie viel wir laufen müssen wäre ich zur Luftwaffe" />
	</dialogue>    

	<dialogue key="defense dialogue 2 men">
		<comment text="Wirst du bald befördert?" />
		<comment text="Denk eher nicht" />
	</dialogue>
  
  <dialogue key="wander dialogue 2 men">
      <comment text="Willst du mal was cooles sehen?" />
      <comment text="Nee, werde da nicht nochmal reinfallen..." />
   </dialogue> 

	<dialogue key="defense dialogue 2 men">
		<comment text="Weisst du, wir waren hinter feindlichen Linien, Alex und ich" />
		<comment text="Also bist du einem Aufspühr-Squad beigetreten?" />
		<comment text="Jupp, wir haben auch ein Frachtfahrzeug geortet" />
		<comment text="Wow, das ist ziemlich abgefahren" />
		<comment text="Bestimmt mehr als hier rumhängen zumindest" />
		<comment text="Naja zumindest lebt man hier länger" />
		<comment text="Als ob das alles wäre..." />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Sag meiner Mutter bloss nicht, dass ich bei der Armee bin" />
		<comment text="Wieso denn nicht?" />
		<comment text="Sie denkt ich spiele Klavier in einem Bordell.." />
		<comment text="Oh ok" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Hast du Kippen für mich?" /> 
		<comment text="Ne, hab keine mehr. Aber seit wann rauchst du denn überhaupt?" />
		<comment text="Tu ich nicht, will sie gegen eine neue Waffe tauschen" />
		<comment text="Was stimmt denn nicht mit deiner aktuellen Waffe?" />
		<comment text="Ich glaub da ist zuviel Sand drin" />
		<comment text="Dann putz sie doch mal kräftig durch?" />
		<comment text="Bah, die haben keine Reinigungwolle mehr im Waffenlager" />
		<comment text="Das gibt's doch nicht" />
		<comment text="Die haben dutzende Waffen, aber nichts um sie zu warten" />
		<comment text="Sieht so aus, als würden die denken, dass wir sowieso nicht lange genug dafür überleben" />
		<comment text="Da könnte was dran sein" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Keine Spur des Funktrucks?" />
		<comment text="Nein, aber bin mir ziemlich sicher, dass er nicht hier ist" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Weisst du was? Ich habe 'ne Flasche Whiskey gefunden und in meinen Lagerraum getan" />
		<comment text="Psst, nicht so laut! Dir ist doch nicht erlaubt sie zu behalten" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Hmm ich dachte neulich..." /> 
		<comment text="Was denn?" />
		<comment text="Uh, Mist ich kann mich nicht mehr erinnern" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Chef? Wieso tun wir nichts?" />
		<comment text="Hinterfrage Befehle nicht, Junge. Das bringt dich nur um" />
		<comment text="OK Chef"/>      
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Ich weiss nicht, ob ich dem Armeechor beitreten soll" />
		<comment text="Was spricht dagegen?" />
		<comment text="Naja das letzte Mal war es beim Kirchenchor"/>  
		<comment text="Und?" /> 
		<comment text="200 Personen haben ihre Religion gewechselt..." />           
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Zum Glück greift der Gegner nicht von hinten an..." />
		<comment text="Ja, dafür wären wir nicht vorbereitet" />
	</dialogue>   
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="" />
		<comment text="" />
	</dialogue>
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Ich habe letztens ein Feuergefecht mit den Entwicklern gehabt" />
		<comment text="Meinst du Pasik und JackMayol ?" />
    <comment text="Yupp, Pasik zielt wie 'ne Oma, aber JackMayol ist noch schlimmer!" />
	</dialogue>     

	<dialogue key="defense dialogue 2 men">
		<comment text="'Osumia Games'... Wie kommt man auf so einen Namen?" />
		<comment text="Warte, von was redest du?" />
        <comment text="Ich glaub ich weiss es selbst nicht" />
	</dialogue>  

	<dialogue key="defense dialogue 2 men">
		<comment text="Manchmal hab ich das Gefühl, das wir einfach nur mit Gewehren rennen" />
		<comment text="Sag bloss..." />
	</dialogue>  

	<dialogue key="vehicle dialogue 2 men">
		<comment text="Autsch, mein Zeh!" />
		<comment text="Sorry mann" />
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Ist das Spiel schon raus?" />
		<comment text="Na klar, auf Steam!" />
		<comment text="Geil!" />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men tag=truck" >
		<comment text="Junge, hast du einen fahren lassen?" />
		<comment text="Kann sein" />
		<comment text="Igitt! Mach das Fenster auf!" />    
	</dialogue>    

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Weisste was?" />
		<comment text="Hmm?" />
		<comment text="Ich glaub ich bin in dich verliebt" />   
		<comment text="Hört sofort auf mit dem Quatsch..." />     
	</dialogue> 

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Woher hast du deinen Führerschein?" />
		<comment text="Von deiner Mutter" />
	</dialogue> 

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Hit me baby one more tiiiime" />
		<comment text="Aber gerne!" />
	</dialogue>
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Fühle mich voll nicht sicher in der Kiste" />
		<comment text="Wieso das denn?" />      
		<comment text="Guck mal die Räder" />
		<comment text="Was stimmt nicht mit den Rädern?" />
		<comment text="Die sind nicht mal mit den Achsen verbunden!" />    
	</dialogue>  

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Würd' so gerne Radio hören.." />
		<comment text="Wem sagste das" />
	</dialogue> 
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Hab' schon immer Schiss gehabt ins selbe Squad wie du eingeteilt zu werden" />
		<comment text="Was hab ich denn wieder getan?" />
		<comment text="Seltsame Objekte ziehen Feuer an. Du bist seltsam" />    
	</dialogue> 
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Erfolg passiert immer wenn keiner zuschaut" />
		<comment text="Misserfolg geschieht wenn der Kommandeur zuschaut..." />
	</dialogue> 
  
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Pass auf AT Granaten auf" />
		<comment text="Jupp, die machen mehr Schaden als konventionelle Handgranaten" />
		<comment text="Zum Glück ist aber der Explosionsradius geringer" />    
	</dialogue> 

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="" />
		<comment text="" />
	</dialogue>  

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Ein bisschen mehr richtige Frauen bei der Armee würden nicht schaden" />
		<comment text="Stimmt schon, wäre nicht verkehrt für unsere Hormone" />
		<comment text="Nein, so meinte ich das nicht..." />
		<comment text="Sondern?" /> 
		<comment text="Da hätten wir jemand fürs Bügeln, Kochen und Putzen" />               
	</dialogue>   

	<dialogue key="vehicle dialogue 2 men">
		<comment text="Sie hätten ruhig ein paar mehr Polygone hier hinzufügen können" />
		<comment text="Wieso das denn?" />
		<comment text="Die Sitze sind nicht rund genug..." />    
	</dialogue> 

	<dialogue key="vehicle dialogue 2 men">
		<comment text="It's FRIDAY! FRIDAY! *sing*" />
		<comment text="Hättest Sänger werden sollen" />
		<comment text="Wirklich, ist es dein Ernst?" /> 
		<comment text="Jupp, dann müssten wir dich nicht den ganzen Tag hier hören" />    
	</dialogue> 

	<dialogue key="vehicle dialogue 2 men">
		<comment text="Hast du neue Ausrüstung bekommen?" />
		<comment text="Jupp" />
		<comment text="Meh, das ist unfair..." /> 
   	<comment text="Heul doch!" />    
	</dialogue> 

	<dialogue key="vehicle dialogue 2 men">
		<comment text="Kannst du ein bisschen rutschen?" />
		<comment text="Nein" />
		<comment text="Danke..." />
		<comment text="Kein Ding!" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men">
		<comment text="Ein Tag ohne Sonne ist wie... naja Nacht" />
		<comment text="Danke, werde schlauer einschlafen als ich aufgestanden bin " />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men">
		<comment text="Kennst du die Wettervorhersage für heute Abend?" />
		<comment text="Ja, wird dunkel" />
		<comment text="..." />
  </dialogue>

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Wünschte, mehr Leute würden PvP spielen" />
		<comment text="Warum das?" />
		<comment text="Sie würden uns Bots dadurch wenigstens am Leben halten" />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Im Zweifelsfall einfach das Magazin abfeuern" />
		<comment text="Verstanden Sir!" />
	</dialogue>   
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Ich habe eine Idee" />
		<comment text="Vergiss es, sowas wie einen perfekten Plan gibt es nicht" />
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Seid ihr motiviert, Jungs?!" />
		<comment text="Chef, ja Chef!" />
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Vergesst nicht, was ich euch heute morgen gesagt habe!" />
		<comment text="Ja Chef!" />
		<comment text="Falls unser Angriff zu gut abläuft, ist es ein Hinterhalt!" />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Ich glaube der Plan ist doof" />
		<comment text="Wenn er doof ist und funktioniert, dann ist er nicht doof" />
	</dialogue>   
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Was machen wir, wenn alles versagt?" />
		<comment text="Dann helfen nur noch dicke Rohre der Marine" />
	</dialogue>  

  <dialogue key="vehicle dialogue 2 men">
      <comment text="Wann bist du eigentlich das letzte Mal gefahren?" />
      <comment text="Uh, das ist mein erstes Mal" />
      <comment text="Wieso fährst du dann hier?!" />
      <comment text="..." />
      <comment text="Du bringst mich noch um, bevor wir die Frontlinie erreichen!" />
  </dialogue>
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="" />
		<comment text="" />
	</dialogue>  
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Es gibt 2 Grundregeln bei der Armee" />
		<comment text="Die wären?" />
		<comment text="#1: der Kommandeur hat immer recht" />
		<comment text="#2: Wenn der Kommandeur unrecht hat, siehe #1" />        
	</dialogue>           

	<dialogue key="vehicle dialogue 2 men tag=campfire">
		<comment text="Meine Füsse brennen" />
		<comment text="Dann rutsch zurück" />
		<comment text="Ich kann nicht" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="Ich liebe diesen Panzer" />
		<comment text="Ach sei doch mal ruhig" />
		<comment text="Ich kann nicht" />
	</dialogue>

  <dialogue key="vehicle dialogue 2 men tag=tank">
      <comment text="Werden wir diesen Panzer taufen?" /> 
      <comment text="Wieso willst du das?" />
      <comment text="Naja, wir werden ihn ja für 'ne Weile haben, also..." />
  </dialogue>

	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="Die beste Panzerung ist, ausser Reichweite zu bleiben" />
		<comment text="Klugscheisser" />
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="Das ist Spartaaaaa!" />
		<comment text="..." />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="Bereitet euch darauf vor, Stahl zu fressen!" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="Die beste Umgebung für einen Panzer ist eine ohne Panzerabwehr" /> 
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="Es gibt kein Problem, das nicht mit Sprengstoff gelöst werden kann" /> 
	</dialogue>  
  
  <dialogue key="vehicle dialogue 2 men tag=tank">
      <comment text="WAS?! Wieso ist eine Katze im Panzer?" />
      <comment text="Das Nachtsichtgerät ist defekt, deswegen" />
  </dialogue> 
   
  <dialogue key="vehicle dialogue 2 men tag=tank">
      <comment text="Weisst du weshalb man Infantrie 'Crunchies' nennt?" />
      <comment text="Ne. Wieso?" />
      <comment text="Das ist das Geräusch, wenn man sie überfährt" />
  </dialogue>    
              
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Autsch" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Ich glaub mir wird schlecht" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Bin mir nicht sicher, ob der Kerl weiss wo es langgeht" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Sind wir bald angekommen?" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="zzZZZzzzzZz" />
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="lol dein Gesicht!" />
		<comment text="Was'n?" />
		<comment text="Es ist voller Voxel" />     
	</dialogue>  
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Ich liebe es wie Leute in Horrorfilmen fragen 'Ist jemand da?'" />
		<comment text="Wie wenn der Killer sagen würde 'bin in der Küche, willst 'n Brot?'" />   
	</dialogue>  
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Würde mir wünschen, dass die Spieler das Innere von Fahrzeugen sehen könnten" />
		<comment text="Jepp, null Details eingebaut" /> 
		<comment text="Faule Entwickler!" />         
	</dialogue>     

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="" />
	</dialogue>  

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="" />
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Würde mich wohler fühlen ausserhalb dieser Kiste" />
	</dialogue>  

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Stell dir jetzt eine Pizza vor" />
		<comment text="Oder ein Eis" />
		<comment text="Oder ein Brathähnchen" />
		<comment text="Oder einen Tofusalat" />
		<comment text="Wie bitte !?!" />                
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Woah Junge, hast du ein Friedhof geschluckt heute morgen?" />
		<comment text="Sorry, hab meine Zahnbürste letzte Woche verloren" />    
	</dialogue>  
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Ähm? Für was ist dieser grüne Knopf gut?" />
		<comment text="Uh... für nichts..." />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Hey, könntest du das Spiel neustarten bitte?" />
		<comment text="Was los?" /> 
		<comment text="Bin in einer Textur blockiert.." />        
	</dialogue>       
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Solltest lieber deinen Helm statt diesem roten Stirnband tragen" />
		<comment text="Hast schon recht, aber sieht viel böser aus" />    
		<comment text="Einer Kugel ist das egal" />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Stinkt krass nach Schweissvoxelfüssen hier drin, ekelig!" /> 
	</dialogue>    
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Willst du ein Kaugummi?" /> 
		<comment text="Nein danke" /> 
		<comment text="Wir denken alle, dass du einen willst!" />
		<comment text="Öhm, willst du mir damit was sagen...?" />
		<comment text="Du hast es erraten, Kumpel!" />                
	</dialogue> 
  
  <dialogue key="vehicle dialogue 2 men tag=truck">
     <comment text="Kannst du dich an dem Film erinnern, wo der Truckfahrer die Welt rettet?" />
     <comment text="Nope" />
     <comment text="Ja, ich auch nicht. Wir werden alle sterben..." />
  </dialogue>  
          

	<dialogue key="defense dialogue 2 men">
		<comment text="Ich glaube, dass ich bald befördert werde" />
		<comment text="Dann solltest du dich aber nicht davor erschiessen lassen!" />
		<comment text="Danke Mann, wirklich nett von dir!" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Ich fühle mich so gut heute" />
	</dialogue>
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Fühle mich als wäre ich heute bereits 100 Mal auferstanden" />
    <comment text="Jupp, geht mir ebenso" />  
    <comment text="Stell dir mal vor so im echten Leben" />
    <comment text="Haha" />           
	</dialogue>
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Ältere Leute bei Hochzeiten sagen mir öfters 'Du bist der Nächste'" />
    <comment text="Du solltest das gleiche tun bei Beerdigungen" />     
	</dialogue>    
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Diese Telefonverkäufer gehen mir auf den Sack" />
    <comment text="Gib doch den Hörer deiner Tochter und sag ihr, es sei der Weihnachtsmann!" />     
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Hatte einen seltsamen Albtraum letzte Nacht" />
    <comment text="Um was ging's?" />   
    <comment text="Habe überall nur 1 und 0 gesehen" />
    <comment text="Was ist daran so seltsam?" />
    <comment text="Plötzlich erschien eine 2!" />
    <comment text="Oh mein Gott!" />          
	</dialogue>   
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Meine Alte sagt, ich sei hässlich, meine Affäre sagt das Gegenteil" />
    <comment text="Und?" /> 
    <comment text="Naja, was denkst du denn?" />
    <comment text="Nun ja, ich teilte schon immer den Geschmack deiner Frau" />    
    <comment text="Könntest du nicht ausnahmsweise mal ehrlich sein?" /> 
    <comment text="Glaub mir, ich bin es..." />              
	</dialogue>      

	<dialogue key="defense dialogue 2 men">
		<comment text="Man, du redest aber viel wenn der Tag lang ist" />
    <comment text="Ist Familientradition" /> 
    <comment text="Wie meinst du das?" />
    <comment text="Mein Grossvater war Strassenhändler, mein Vater Lehrer" />    
    <comment text="Und deine Mutter?" /> 
    <comment text="Sie ist eine Frau" />              
	</dialogue>   

	<dialogue key="defense dialogue 2 men">
		<comment text="Wie kann ich die Neuigkeit meinem Vater übermitteln?" />
    <comment text="Welche Neuigkeit meinst du?" /> 
    <comment text="Naja, dass ich es nicht geschafft habe, befördert zu werden" />
    <comment text="Schick ihm ein Telegramm" />    
    <comment text="Mit welchem Inhalt?" /> 
    <comment text="'Letztjährige Leistung eingehalten'" />              
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Bin froh, dass die Entwickler keine Luftfahrzeuge implementieren" />
		<comment text="Hm ja, eine Unbekannte weniger, die man beachten muss" /> 
    <comment text="Jep, man muss sich nicht drum kümmern, was vom Himmel runterkommt" />          
    <comment text="Ausser Artillerie, Mörser und ... aaaaargh!!" />
    <comment text="Hahaha und Vogelscheisse!" /> 
    <comment text="Verdammt!" />                                    
	</dialogue>     

	<dialogue key="defense dialogue 2 men">
    <comment text="Profisoldaten sind berechenbar" />  
    <comment text="Aber diese Welt ist voller gefährlicher Amateure" />                                      
	</dialogue> 
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Die sprechen immer wieder von Militärintelligenz" />  
    <comment text="Was ist dabei?" />
    <comment text="Militärintelligenz ist ein Widerspruch" /> 
    <comment text="Meh, sprich für dich!" />                                            
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Würde so gern so eine weite Sicht wie die Spieler haben" />  
    <comment text="Spieler?" />
    <comment text="Ja, der hässliche Vogel hinter dem Bildschirm, der auf uns schaut" /> 
    <comment text="Es ist in der Tat ein bisschen cheaten" /> 
    <comment text="Und ich kann seine grinsende Fratze nicht mehr ausstehen!" />                                               
	</dialogue>    

	<dialogue key="defense dialogue 2 men">
    <comment text="Wenn du einen Personalitätskonflikt mit deinem Vorgesetzten hast" />  
    <comment text="Hm?" />
    <comment text="Er hat die Personalität, du den Konflikt" />                                       
	</dialogue>   

	<dialogue key="defense dialogue 2 men">
    <comment text="Je doofer der Chef, desto wichtiger sind die Missionen, die ihm zugeteilt werden" />  
    <comment text="Du hast so recht man" />                                     
	</dialogue>  

	<dialogue key="defense dialogue 2 men">
    <comment text="Es gibt immer einen Weg für alles" />  
    <comment text="Der meistens ins Nirgendwo führt" />                                     
	</dialogue>  

	<dialogue key="defense dialogue 2 men">
    <comment text="Hast du schon die Neue vom Kommandeur gesehen?" />  
    <comment text="Meinst du die Eine mit der grossen Nase?" /> 
    <comment text="Jo, mit so einem Zinken kann sie bestimmt unter der Dusche rauchen" />                                         
	</dialogue> 

	<dialogue key="defense dialogue 2 men">
    <comment text="Stimmt es, dass der Mensch vom Affen abstammt?" />  
    <comment text="Ja, Soldaten wahrscheinlich schon. Aber nicht Feldwebel" />                                     
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Eine Frau als Mann verkleidet ist kürzlich unserer Armee beigetreten" />  
    <comment text="Sie wird sich mit Männern anziehen und duschen müssen, oder?" /> 
    <comment text="Klar doch" />  
    <comment text="Aber wird das nicht schnell auffliegen?" /> 
    <comment text="Wer soll davon erzählen?" />                                             
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Wieso brauchen wir immer teurere Bomben?" />  
    <comment text="Wem sagst du das" /> 
    <comment text="Haben sich die Leute, die wir bombardiert haben, beschwert oder wie?" />                                        
	</dialogue>      
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Wieso ziehen sich unsere Jungs in letzter Zeit zurück?" />  
    <comment text="Tun sie nicht, die gehen nur in die falsche Richtung" />  
    <comment text="Oh ok" />                                       
	</dialogue>  

	<dialogue key="defense dialogue 2 men">
    <comment text="Du musst nicht straight sein, um zur Armee zu gehen" />  
    <comment text="Danke für deine Unterstützung, Mann" />                                     
    <comment text="Du musst nur straight schiessen müssen" />
	</dialogue>     
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Krieg ist eine Art, mit Geographie Unwissende zu belehren" />  
    <comment text="Das ist so wahr" />                                     
	</dialogue> 
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Unterbreche niemals deinen Feind, wenn er einen Fehler macht" />  
    <comment text="" />                                     
	</dialogue>    

	<dialogue key="defense dialogue 2 men">
    <comment text="Gibt so viele Wertgegenstände die auf dem Schlachtfeld rumliegen" />  
    <comment text="Und die meisten Soldaten scheren sich ein Dreck drum" /> 
    <comment text="Ja doof, denn man kann sie für viel Kohle verkaufen" />                                         
	</dialogue> 

	<dialogue key="defense dialogue 2 men">
    <comment text="Ich muss heute voll konzentriert sein" />  
    <comment text="Hast du etwas spezielles vor?" /> 
    <comment text="Vielleicht macht ein YouTuber heute ein Video" />
    <comment text="Und du willst ihm das versauen?" /> 
    <comment text="Jupp, das ist mein Plan" />                                                
	</dialogue>  

  <dialogue key="defense dialogue 2 men">
      <comment text="He, ich stellte mir neulich eine Frage" />
      <comment text="Was denn?" />
      <comment text="Unsere Verstärkung, wo kommt sie her?" />
      <comment text="Wie meinst du das?" />
      <comment text="Naja, die scheinen nicht durch Truppentransporte oder so zu kommen" />
      <comment text="Du meinst, die erscheinen einfach so aus dem Nichts?" />
  </dialogue>

  <dialogue key="defense dialogue 2 men">
      <comment text="Hast du einen fahren lassen?" />
      <comment text="Hehe!" />
      <comment text="Du bist so widerlich!" />
      <comment text="Jawohl Chef!" />
  </dialogue>
   
  <dialogue key="defense dialogue 2 men">
      <comment text="Sie bezahlen uns nicht genug dafür" />
      <comment text="Nicht genug, um dein Gesicht sehen zu müssen" />
      <comment text="Was? Ist das ein Scherz?!" />
      <comment text="Oh, ich wünschte, es wäre so" />
  </dialogue>   
  
	<dialogue key="defense dialogue 2 men">
    <comment text="" />  
    <comment text="" />                                     
	</dialogue> 
  
