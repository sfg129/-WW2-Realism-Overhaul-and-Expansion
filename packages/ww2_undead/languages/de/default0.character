	<comment key="Uh, I can't drive this thing" text="Dang!" />
  <comment key="Uh, I can't drive this thing" text="Hmm bestimmt die Kurbelwelle am Arsch" />
  <comment key="Uh, I can't drive this thing" text="Bin ziemlich sicher, dass der Vergaser futsch ist" />
  <comment key="Uh, I can't drive this thing" text="Muss was an der Lenkung sein, bin doch nicht blöd!" /> 
  <comment key="Uh, I can't drive this thing" text="Ah, das liegt bestimmt an der Kupplung" />
