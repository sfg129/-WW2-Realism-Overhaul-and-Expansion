  <comment key="Uh, I can't drive this thing" text="Junger Vater!" />
  <comment key="Uh, I can't drive this thing" text="Alter, nicht schon wieder!" />
  <comment key="Uh, I can't drive this thing" text="Hey, will jemand fahren?" />
  <comment key="Uh, I can't drive this thing" text="Vermisse meine Brille" />
  <comment key="Uh, I can't drive this thing" text="Uh, die Steuerung scheint invertiert zu sein" />
  <comment key="Uh, I can't drive this thing" text="Kann nichts dafür" />
  <comment key="Uh, I can't drive this thing" text="Alter Schwede, ich dreh hier noch am Rad!" />
