   <!-- character specific animation override table -->
	<animation key="recoil, pistol, 2hand" target_key="recoil, pistol" />
	<animation key="reloading, pistol, 2hand" target_key="reloading, pistol, pacific" />
	<animation key="still, pistol, 2hand" target_key="hold, pistol" />
	<animation key="crouch, pistol, 2hand" target_key="crouch, pistol" />
	<animation key="reloading, c96 pistol, 2hand" target_key="reloading, c96 pistol"/>
	<animation key="reloading, enfield pistol, 2hand" target_key="reloading, enfield pistol"/>
	
<!-- #EDELWEISS_TRANSLATION -->

   <!-- commander comments -->
	<comment key="enemy captured a base" text="Lo alemanes han conquistado %base_name"/>
		
	<comment key="our base is under attack" text="Tenemos informes de tropas alemanas atacando %base_name."/>
		
   <!-- adventure mode -->
	<comment key="highway intro, part 1" text="Atención, están llegando instrucciones del comandante"/>
	<comment key="highway intro, part 2" text="Me alegro de veros a todos aqui en la carretera 69."/>
	<comment key="highway intro, part 3" text="Estás aquí para llevar a cabo la operación Market Garden, se trata d eun ambicioso plan para liberar los Países Bajos."/>
	<comment key="highway intro, part 4" text="Mientras nuestros paracaidistas aseguran la ciudad de Arnhem, nuestro trabajo es recorrer esta carretera y darles apoyo."/>
	<comment key="highway intro, part 5" text="Buena suerte a todos!"/>

	<comment key="arnhem intro, part 1" text="Atención, están llegando instrucciones del comandante"/>
	<comment key="arnhem intro, part 2" text="Hemos asegurado Arnhem pero las patrullas estan informando de que nos han rodeado."/>
	<comment key="arnhem intro, part 3" text="Lo Alemanes han reagrupado unos cuantos blindados y estan preparandose para recuperar la ciudad."/>
	<comment key="arnhem intro, part 4" text="El enemigo ya ha establecido una cabeza de puente en la ciudad, y están preparandose para avanzar a través del puente del sur."/>
	<comment key="arnhem intro, part 5" text="Nos van a lanzar todo lo que tengan a mano. Comprobad vuestros mapas y dirigios al frente."/>
	<comment key="arnhem intro, part 6" text="Buena suerte soldados! Teneis 30 segundos para ir a vuestras posiciones!"/>
	<comment key="arnhem intro, part 7" text="El enemigo nos está tanteando, la ofensiva es inminente!"/>

	<comment key="arnhem stage attacks increase 1" text="Están enviando mas apoyo blindado!"/>
	<comment key="arnhem stage attacks increase 2" text="La ofensiva enemiga está avanzando! Id allá donde se encuentre el frente!"/>
	<comment key="arnhem stage attacks increase 3" text="Avistados blindados aproximandose a nuestra posición! Emboscadlos y detenedlos!"/>
	<comment key="arnhem stage counterattack 1" text="El enemigo está perdiendo fuerza, reagrupad vuestras fuerzas y atacad!"/>
	<comment key="arnhem stage counterattack 2" text="El enemigo está vacilando!"/>
	<comment key="arnhem stage counterattack 3" text="Asegurad vuestras posiciones"/>
	<comment key="arnhem test info 1" text="Poder reajustado; Aliados potenciados"/>
	<comment key="arnhem test info 2" text="Poder reajustado; facciones balanceadas"/>
	<comment key="arnhem test info 3" text="Los alemanes están cambiando su impetu"/>

	<comment key="bastogne intro, part 1" text="Atención, están llegando instrucciones del comandante"/>
	<comment key="bastogne intro, part 2" text="Los alemanes han lanzado una ofensiva masiva a través del bosque de las Ardenas."/>
	<comment key="bastogne intro, part 3" text="Han empujado el frente dentro de nuestras lineas, y Bastogne es un punto vital para su operaciones."/>
	<comment key="bastogne intro, part 4" text="Aguantad el frente, Bastogne no puede caer!"/>
	<comment key="bastogne intro, part 5" text="Nos van a lanzar todo lo que tengan a mano. Comprobad vuestros mapas y dirigios al frente."/>
	<comment key="bastogne intro, part 6" text="Buena suerte soldados! Teneis 30 segundos para ir a vuestras posiciones!"/>
	<comment key="bastogne intro, part 7" text="El enemigo nos está tanteando, la ofensiva es inminente!"/>

	<comment key="bastogne stage attacks increase 1" text="Están enviando mas apoyo blindado! Vigilad el flanco este!"/>
	<comment key="bastogne stage attacks increase 2" text="La ofensiva enemiga está avanzando! Id allá donde se encuentre el frente!"/>
	<comment key="bastogne stage attacks increase 3" text="Avistados blindados aproximandose a nuestra posición! Emboscadlos y detenedlos!"/>
	<comment key="bastogne stage counterattack 1" text="El enemigo está perdiendo fuerza, reagrupad vuestras fuerzas y atacad!"/>
	<comment key="bastogne stage counterattack 2" text="El enemigo está vacilando!"/>
	<comment key="bastogne stage counterattack 3" text="Asegurad vuestras posiciones antes de avanzar hacia Foy, al norte de aquí!"/>
	<comment key="bastogne test info 1" text="Poder reajustado; Aliados potenciados"/>
	<comment key="bastogne test info 2" text="Poder reajustado; Facciones balanceadas"/>
	
	<comment key="map start with 1 base, part 1" text="Atención, están llegando instrucciones del comandante"/>
	<comment key="map start with 1 base, part 2" text="Me alegro de ver que estais aquí en %map_name"/>
	<comment key="map start with 1 base, part 3" text="Estais aquí para participar en una operación importante."/>
	
	<comment key="map start with paradrop, part 1" text="Atención, están llegando instrucciones del comandante"/>
	<comment key="map start with paradrop, part 2" text="Estamos llevando a cabo un asalto aerotransportado aquí en %map_name"/>
	<comment key="map start with paradrop, part 3" text="Puedes escoger en que punto del campo de batalla quieres entrar"/>
	<comment key="map start with paradrop, part 4" text="El enemigo controla todo el territorio, ve con pies de plomo hasta haber establecido una cabeza de playa!"/>

	<comment key="map start with 1 base, capture" text="Ahora podemos empezar el ataque, el objetivo es capturar toda el área"/>
	<comment key="map start with 1 base, koth" text="Tu primera tarea es conquistar %target_base_name y defender la posición"/>
	
	<comment key="hill 262, part 1" text="Atención, están llegando instrucciones del comandante"/>
	<comment key="hill 262, part 2" text="Los alemanes están intentando huir de los acantilados de Falaise a través de este sector."/>
	<comment key="hill 262, part 3" text="Nos hemos unido a las tropas Polacas aquí en el monte Ormel"/>
	<comment key="hill 262, part 4" text="Aún así el trabajo aún no está acabado: tomad el control del Punto 262 y defendedlo"/>

	<comment key="map advance, held by enemy" text="El siguiente obejtivo estratégico es %map_name. Los alemanes tienen algo entre manos en ese sector."/>
	<comment key="map advance, another enemy present" text="Se han avistado %faction_name en el área"/>
	<comment key="map advance, new map" text="Coged vuestro equipo y salid!"/>
	<comment key="map advance, been there before" text="Aún tenemos control de %number_of_bases bases"/>
	<comment key="map advance, friendly map" text="%map_name está ocupado por %faction_name, han estado demasiado tranquilos por allá"/>
	
	<comment key="varsity, part 1" text="Atención, están llegando instrucciones del comandante"/>
	<comment key="varsity, part 2" text="Hemos lanzado la operación Varsity, en un intento de cruzar el Rhine y atacar alemania."/>
	<comment key="varsity, part 3" text="Preparate para el salto, pero ten esto en cuenta:"/>
	<comment key="varsity, part 5" text="El enemigo esta altamente fortificado en el noreste, cerca del viejo castillo."/>
	<comment key="varsity, part 6" text="Los aviones de reconocimiento no han obtenido información del área, podrían haber tropas escondidas."/>
	<comment key="varsity, part 7" text="No podrás atacar el sitio mientras el resto del área no este asegurada."/>
	<comment key="varsity, part 8" text="Estad preparados para una dura lucha! Buena suerte paracaidistas."/>
	<comment key="varsity, boss, part 1" text="La resistencia alemana está vacilando, es hora de atacar sus posiciones en el castillo."/>
	<comment key="varsity, boss, part 2" text="Destruid cualquier resistencia que encontreis en el castillo!"/>
	
  <!-- reinforcement commander lines -->
	<comment key="spawn_in_base_call, accepted, key=ukf_inf.call" text="Infanteria reagrupandose en %base_name"/>
	<comment key="spawn_in_base_call, denied, key=ukf_inf.call" text="No hay puntos de despliegue disponibles, captura una base!"/>

	<comment key="spawn_in_base_call, accepted, key=ukf_para_no_parachuting.call" text="Paracaidistas desplegados formandose en %base_name"/>
	<comment key="spawn_in_base_call, denied, key=ukf_para_no_parachuting.call" text="No hay puntos de despliegue disponibles, captura una base!"/>

	<comment key="spawn_in_base_call, accepted, key=usf_vehicle.call" text="Jeep .50 cal desplegado en %base_name"/>
