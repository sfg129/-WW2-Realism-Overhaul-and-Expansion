	<comment key="spawn_in_base_call, accepted, key=ukf_vehicle_m4_sherman_v.call" text="M4A4 Sherman V desplegado en %base_name"/>
	<comment key="spawn_in_base_call, denied, key=ukf_vehicle_m4_sherman_v.call" text="No hay puntos de despliegue disponibles, captura una base!"/>

	<comment key="spawn_in_base_call, accepted, key=ukf_vehicle_sherman_firefly.call" text="Sherman Firefly desplegado en %base_name"/>
