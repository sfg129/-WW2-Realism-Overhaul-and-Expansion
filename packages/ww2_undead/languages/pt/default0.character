  <comment key="cancel radio call" text="Ah nada, termino" />
  <comment key="cancel radio call" text="Esquece... Termino" />
  <comment key="initiate radio call" text="Quartel general , na escuta?" />
  <comment key="commander radio response" text="Aqui é o Quartel general. Na escuta" />
  <comment key="no radio equipment" text="Não tenho um rádio ainda" />
  <comment key="no radio equipment" text="Não dão rádios a %rank_names" />
  <comment key="no radio equipment" text="Acho que deixei o rádio nas outras calças" />
  <comment key="commander radio full" text="Aqué é Alfa Zero. Nós temos muitos chamados para atender, tente novamente em breve."/>  
  <comment key="squad chat, not in squad" text="Não estou numa patrulha de jogadores" />
  <comment key="Hey, wait up" text="Hey, espera" />
  <comment key="Hey, wait up" text="Hey, espera" />
  <comment key="Hey, wait up" text="Hey, espera por mim" />
  <comment key="Hey, wait up" text="Aguenta os cavalos Soldado!" />
