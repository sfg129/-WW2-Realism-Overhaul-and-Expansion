  <comment key="Step out, kid" text="Sai daí" />

  <comment key="Can't respawn - the last base is under attack" text="Ressurgimento não disponível - a última base está sob ataque" />
  <comment key="Can't respawn - spawning is locked" text="Ressurgimento não disponível - ponto de ressurgimento está bloqueado" />
  <comment key="Press SPACE to continue!" text="Pressione ESPAÇO para continuar!" />
  <comment key="Hmm.. not enough room here" text="Hmm... não há espaço suficiente aqui" />
  <comment key="I'm outta here" text="Vamos embora daqui" />
  <comment key="I'm outta here" text="Vamos sair daqui" />
