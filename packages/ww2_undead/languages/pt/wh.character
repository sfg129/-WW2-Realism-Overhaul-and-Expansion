   <!-- character specific animation override table -->

<!-- #EDELWEISS_TRANSLATION -->

	<comment key="We surrender!" text="Não atire! Eu sou Polonês!"/>
	<comment key="We surrender!" text="Eu desisto! Dane-se esta guerra!"/>
	<comment key="We surrender!" text="Eu me rendo!"/>
	<comment key="We surrender!" text="Por favor, eu só quero terminar a escola!"/>
	<comment key="We surrender!" text="Maldito Aliado schweinehund..."/>
	
	<comment key="Medic!" text="Médico!"/> 
	<comment key="Medic!" text="Socorro, depressa!"/>    
	
	<comment key="Quickly!" text="Schnell!"/>
	<comment key="Quickly!" text="los los los!"/>    
	
	<comment key="initiate radio call" text="QG, aqui é Kampfgruppe von Luck, na escuta?"/>

	
	<comment key="hostile vehicle takeover" text="O quê? NEIN!"/>
	<comment key="hostile vehicle takeover" text="Ei! Isso é - "/> 
	<comment key="hostile vehicle takeover" text="O quê? Nein nein NEIN!"/>    
	
	<comment key="enemy seen" text="Alerta!"/>
	
	<comment key="enemy not seen, taking suppressed fire" text="Alerta!"/>

	<comment key="enemy seen, vehicle tag = tank" text="Panzer inimigo!"/> 
	<comment key="enemy seen, vehicle tag = tank" text="Se abaixa! Panzer Inimigo!"/> 
	<comment key="enemy seen, vehicle tag = tank" text="Panzer Aliado!"/> 
	<comment key="enemy seen, vehicle tag = tank" text="Achtung, panzer!!"/>        
	

	<comment key="Hold on!" text="Aguenta ai camarada!"/>  

	<comment key="Yes sir" text="Jawohl"/>
	<comment key="Yes sir" text="Entendido"/>    
	
	<comment key="celebrating" text="Bom trabalho, soldados."/>
	<comment key="celebrating" text="Gute Arbeit!"/>    
	<comment key="celebrating" text="Vamos empurrá-lo de volta para o canal!"/>
	<comment key="celebrating" text="Viva a vitória!"/>	<!-- do not translate this one in German! Use something else lol. -->
	<comment key="celebrating" text="Excelente trabalho soldados."/>
	<comment key="celebrating" text="Toma essa, Aliado schweinehund!"/>
	<comment key="celebrating" text="Tem algum cigarro com você, Aliado schweinehund?"/>
	<comment key="celebrating" text="Alguém viu meu bisavô? Ele estava atacando com a primeira companhia."/>
	<comment key="celebrating" text="Acho que vou cozinhar um pouco de chucrute mit wurst und kartoffel."/>
	<comment key="celebrating" text="Alguém viu o meu sobrinho? Ele estava na patrulha de reconhecimento."/>
    
	<comment key="Waiting for squad" text="Entre, schnell!"/>     
	
	<dialogue key="wander dialogue 2 men">
		<comment text="We're doing an awful lot of walking here."/>
	</dialogue>    
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Eles te deram equipamento novo?"/>
		<comment text="Sim"/>
		<comment text="Droga, eu preciso de equipamento novo.."/> 
		<comment text="Só temos uma caixa"/>    
	</dialogue> 
	
	
	<dialogue key="vehicle dialogue 2 men tag=light_tank">
		<comment text="Qual nome vamos dar para o tanque?"/>
		<comment text="Tommy Squasher."/>
		<comment text="É quando você diz coisas assim, Fritz, que eu me preocupo com você."/>
	</dialogue>
		
   <!-- commander comments -->
	<comment key="we captured a base" text="Nossas forças limparam %base_name!"/>
	<comment key="we captured a base" text="Nós tomamos %base_name, protejam a área."/>
	<comment key="enemy captured a base" text="Os Aliados conquistaram %base_name, preparem um contra-ataque imediato!"/>
	<comment key="enemy captured a base" text="Perdemos %base_name, recupere imediatamente!"/>
	<comment key="our base is under attack" text="Temos relatos de forças aliadas atacando %base_name."/>
	<comment key="fighting near a base" text="Tiros disparados próximos de %base_name"/>
	
	
   <!-- adventure mode -->
	<comment key="map start with 1 base, part 3" text="Nossas forças chegaram e se prepararam para operações ofensivas."/>
	
	<comment key="map start with 1 base, capture" text="Agora estamos prontos para lançar a invasão, o objetivo é capturar a área completamente."/>
	
	<comment key="map advance, held by enemy" text="Nosso comando diz que %map_name é o próximo alvo estratégico. Os %faction_name ficaram firmes como uns carrapatos."/>
	<comment key="map advance, new map" text="A divisão está preparando outra força de assalto, vamos andando!"/>
	
	<comment key="final map, part 1" text="Achtung, instruções do comandante chegando"/>
	<comment key="final map, part 2" text="É bom ter todos você aqui em %map_name"/>
	<comment key="final map, part 3" text="É agora! A operação final!"/>
	<comment key="final map, part 5" text="Batalha após batalha nós empurramos os %faction_name."/>
	<comment key="final map, part 6" text="Ganhe esta batalha e acabe com esta guerra, de uma vez por todas!"/>

	<!-- WH campaign commander lines -->
	<comment key="sicily, part 1" text="Achtung, instruções do comandante chegando"/>
	<comment key="sicily, part 2" text="É bom ter todos você aqui na Sicília."/>
	<comment key="sicily, part 3" text="Paraquedistas Americanos desceram nas proximidades e ocuparam todos os setores importantes."/>
	<comment key="sicily, part 4" text="É nosso trabalho retomar essas posições e erradicar a ameaça aerotransportada!"/>

	<comment key="brecourt, part 1" text="Achtung, instruções do comandante chegando"/>
	<comment key="brecourt, part 2" text="Soldados, bem-vindos à Normandia."/>
	<comment key="brecourt, part 3" text="Recebemos relatórios de que na noite passada, paraquedistas Americanos asseguraram a cidade de St. Marie du Mont."/>
	<comment key="brecourt, part 4" text="Relatórios maiores circulam indicando que uma invasão maciça dos Aliados está acontecendo no continente."/>
	<comment key="brecourt, part 5" text="Por agora temos de nos preocupar com a nosso setor e fazer o que pudermos."/>
	<comment key="brecourt, part 6" text="À sua disposição estão inúmeros veículos Blindados; contra-ataque e proteja a área!"/>

	<comment key="overlord intro, part 1" text="Atenção, chegando relátorio do Comandante" />
	<comment key="overlord intro, part 2" text="O Exército acabou de sair - estamos sozinhos aqui." />
	<comment key="overlord intro, part 3" text="E o que é pior, parece que os Aliados vão atacar essa linha com tudo o que tem." />
	<comment key="overlord intro, part 4" text="Segurem a linha, e segurem o campo aéreo à todo custo!" />
	<comment key="overlord intro, part 5" text="O inimigo irá se aproximar pelo rio, estejam preparados." />
	<comment key="overlord intro, part 6" text="Boa sorte e que Deus esteja com vocês, soldados! Vocês devem ter uns 30 segundos para entrar em posição!" />
	<comment key="overlord intro, part 7" text="O inimigo está nos observando, não temos muito tempo!" />
	
	<comment key="overlord stage 1" text="Bombardeio inimigo, protejam-se! (Primeira fase começada)" />
	<comment key="overlord stage 2" text="Segunda onda vindo! (Segunda fase começada)" />
	<comment key="overlord stage 3" text="Tanques! Eles tem tanques! (Terceira fase começada)" />
	<comment key="overlord stage 4" text="Eles não desistem, continuem com as defesas! (Quarta fase começada)" />
	<comment key="overlord stage 5" text="Parece que eles estão se reagrupando para mais uma onda - montem mais defesas! (Intervalo de 2 minutos)" />
	<comment key="overlord stage 6" text="O Exército acaba de chegar, mas os inimigos não parecem muito determinados a pararem o ataque.  (Sexta fase começada)" />
	<comment key="overlord stage 7" text="O Exército está de volta com as armas grandes! Deem inferno para eles!" />
	<comment key="overlord stage 8" text="Contra ataque!" />

	<comment key="hill262, part 1" text="Achtung, instruções do comandante chegando"/>
	<comment key="hill262, part 2" text="Estamos numa posição difícil aqui. Apesar dos nossos esforços, estamos batendo em retirada total devido a invasão dos Aliados."/>
	<comment key="hill262, part 3" text="O terreno elevado mais próximo, o Monte 262, possui vista total para as nossas colunas de tropas que estão em retirada e se perdê-lo seremos cortados e cercados."/>
	<comment key="hill262, part 4" text="Temos relatos de que uma divisão blindada Polonesa está se preparando para um ataque maciço."/>
	<comment key="hill262, part 5" text="Proteja e segure a colina a todo custo!"/>

	<comment key="hellshighway, part 1" text="Achtung, instruções do comandante chegando"/>
	<comment key="hellshighway, part 2" text="Agora que o avanço britânico pela Rodovia 69 foi paralisado, estamos enviando um Bergetiger para limpar a bagunça na linha de frente."/>
	<comment key="hellshighway, part 3" text="Um contra-ataque foi intensificado para cobrir seu avanço - se o Bergetiger for destruído, nós falharemos em nossa missão!"/>
	<comment key="hellshighway, part 4" text="As posições Anti-Tanque foram marcadas no seu mapa tático de acordo com as nossas patrulhas de reconhecimento."/>
	<comment key="hellshighway, part 5" text="Preparem-se para mover!"/>

	<comment key="arnhem, part 1" text="Achtung, instruções do comandante chegando"/>
	<comment key="arnhem, part 2" text="Bem-vindos aos Países Baixos."/>
	<comment key="arnhem, part 3" text="Já passou algum tempo desde que escapamos da investida dos Aliados na Normandia, mas eles lançaram outro ataque."/>
	<comment key="arnhem, part 4" text="Paraquedistas Britânicos capturaram esta cidade, Arnhem, e estão enviando uma coluna de tropas para apoiá-los."/>
	<comment key="arnhem, part 5" text="No entanto até aquela coluna chegar aqui, eles estão cortados e sem apoio de blindados pesados. Preparem-se e retomem a cidade!"/> 
    
	<comment key="arnhem, supply cut" text="Nossa base principal de reabastecimento foi tomada pelo inimigo, capture de volta, schnell!"/>    

	<comment key="bastogne, part 1" text="Achtung, instruções do comandante chegando"/>
	<comment key="bastogne, part 2" text="Senhores, há vários dias lançamos um ataque maciço através das Ardenas."/>
	<comment key="bastogne, part 3" text="Trouxemos você aqui hoje para a batalha do cruzamento vital de Bastogne."/>
	<comment key="bastogne, part 4" text="A cidade é mantida por seus antigos adversários, os paraquedistas Americanos."/>
	<comment key="bastogne, part 5" text="Eles estão fortificados e têm nervos de aço, mas nós estamos fornecendo alguns dos tanques mais poderosos que podemos reunir."/>
	<comment key="bastogne, part 6" text="Peguem seus armamentos e preparem-se! Hoje vamos quebrar o espírito deles!"/>

	<comment key="sealion, part 1" text="Atenção, instruções do comandante chegando"/>
	<comment key="sealion, part 2" text="Soldados, nos últimos meses temos milagrosamente conseguido empurrar os Aliados de volta para o canal."/>
	<comment key="sealion, part 3" text="Apesar disso eles se recusam a se render, então nossos planos de operação aqui são atacar o próprio coração Inglês!"/>
	<comment key="sealion, part 4" text="Esta é uma operação aerotransportada, mas se você conseguir proteger a linha costeira poderemos fornecer apoio blindado."/>
	<comment key="sealion, part 5" text="Peguem seus paraquedas e armem-se até os dentes! Esta será a queda final do nosso inimigo!"/>
	<comment key="sealion, boss, part 1" text="A resistência Britânica está enfraquecendo, mas eles parecem ter redutos localizados na Cidadela."/>
	<comment key="sealion, boss, part 2" text="Destrua qualquer resistência que esteja escondida dentro dessas fortificações!"/>

	<comment key="generic counter-attack" text="O inimigo está lançando um contra-ataque maciço! Segure a todo custo! Se perdermos terreno, capture de volta!"/>

   <!-- reinforcement commander lines -->
	<comment key="spawn_in_base_call, accepted, key=wh_inf.call" text="Infantaria reagrupando em %base_name"/>
	<comment key="spawn_in_base_call, denied, key=wh_inf.call" text="Nenhum ponto válido para mobilização encontrado, capture uma base!"/>

	<comment key="spawn_in_base_call, accepted, key=wh_vehicle.call" text="Panzer IV mobilizado em %base_name"/>
	<comment key="spawn_in_base_call, denied, key=wh_vehicle.call" text="Nenhum ponto válido para mobilização encontrado, capture uma base!"/>

	<comment key="spawn_in_base_call, accepted, key=wh_vehicle_sdkfz251.call" text="Sdkfz 251 mobilizado em %base_name"/>
	<comment key="spawn_in_base_call, denied, key=wh_vehicle_sdkfz251.call" text="Nenhum ponto válido para mobilização encontrado, capture uma base!"/>

	<comment key="spawn_in_base_call, accepted, key=wh_vehicle_stug.call" text="StuG III mobilizado em %base_name"/>
	<comment key="spawn_in_base_call, denied, key=wh_vehicle_stug.call" text="Nenhum ponto válido para mobilização encontrado, capture uma base!"/>

	<comment key="spawn_in_base_call, accepted, key=wh_vehicle_luchs.call" text="Panzer II Luchs mobilizado em %base_name"/>
	<comment key="spawn_in_base_call, denied, key=wh_vehicle_luchs.call" text="Nenhum ponto válido para mobilização encontrado, capture uma base!"/>
	
</character>
