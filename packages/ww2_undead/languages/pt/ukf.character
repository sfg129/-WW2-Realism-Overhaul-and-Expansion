   <!-- character specific animation override table -->
	<animation key="recoil, pistol, 2hand" target_key="recoil, pistol" />
	<animation key="reloading, pistol, 2hand" target_key="reloading, pistol, pacific" />
	<animation key="still, pistol, 2hand" target_key="hold, pistol" />
	<animation key="crouch, pistol, 2hand" target_key="crouch, pistol" />
	<animation key="reloading, c96 pistol, 2hand" target_key="reloading, c96 pistol"/>
	<animation key="reloading, enfield pistol, 2hand" target_key="reloading, enfield pistol"/>
	
<!-- #EDELWEISS_TRANSLATION -->

   <!-- commander comments -->
	<comment key="enemy captured a base" text="Os Alemães conquistaram %base_name"/>
		
	<comment key="our base is under attack" text="Temos relatos de forças Alemãs atacando %base_name."/>
		
   <!-- adventure mode -->
	<comment key="highway intro, part 1" text="Atenção, instruções do comandante chegando"/>
	<comment key="highway intro, part 2" text="É bom ter todos vocês aqui na Rodovia 69."/>
	<comment key="highway intro, part 3" text="Trouxemos você aqui para realizar a Operação Market Garden, um plano ambicioso para libertar os Países Baixos."/>
	<comment key="highway intro, part 4" text="Enquanto nossos Paraquedistas asseguram a grande cidade de Arnhem, é nosso trabalho dirigir por esta estrada e ajudá-los."/>
	<comment key="highway intro, part 5" text="Boa sorte e vá com Deus!"/>

	<comment key="arnhem intro, part 1" text="Atenção, instruções do comandante chegando"/>
	<comment key="arnhem intro, part 2" text="Nós asseguramos Arnhem, mas as patrulhas estão reportando que agora fomos cortados e estamos cercados."/>
	<comment key="arnhem intro, part 3" text="Os Alemães reuniram forças blindadas nas proximidades e estão se preparando para tomar a cidade de volta."/>
	<comment key="arnhem intro, part 4" text="O inimigo já tem um ponto de apoio dentro da cidade, e também está se preparando para avançar pela ponte ao sul."/>
	<comment key="arnhem intro, part 5" text="Eles vão nos atingir com tudo que eles tem. Verifiquem seus mapas e vão para a linha de frente."/>
	<comment key="arnhem intro, part 6" text="Boa sorte e vão com Deus, soldados! Vocês devem ter por volta de 30 segundos para entrarem em posição!"/>
	<comment key="arnhem intro, part 7" text="O inimigo está nos sondando, não vai demorar muito mais agora!"/>

	<comment key="arnhem stage attacks increase 1" text="Eles estão enviando mais apoio blindado!"/>
	<comment key="arnhem stage attacks increase 2" text="O ataque inimigo está se intensificando! Vá até o local do avanço principal!"/>
	<comment key="arnhem stage attacks increase 3" text="Mais unidades blindadas avistadas se aproximando das nossas posições! Mova-se para onde eles estão e parem eles!"/>
	<comment key="arnhem stage counterattack 1" text="O inimigo está ficando sem forças, reagrupem-se e comecem a atacar!"/>
	<comment key="arnhem stage counterattack 2" text="O ataque deles está enfraquecendo!"/>
	<comment key="arnhem stage counterattack 3" text="Reassegure todas as nossas posições"/>
	<comment key="arnhem test info 1" text="Capacidades ajustadas; Aliados impulsionados"/>
	<comment key="arnhem test info 2" text="Capacidades ajustadas; facções igualadas"/>
	<comment key="arnhem test info 3" text="Alemães mudando a direção do ataque"/>

	<comment key="bastogne intro, part 1" text="Atenção, instruções do comandante chegando"/>
	<comment key="bastogne intro, part 2" text="Os Alemães lançaram uma grande ofensiva de inverno através da floresta das Ardenas."/>
	<comment key="bastogne intro, part 3" text="Eles empurraram nossa linha para trás em uma frente enorme e Bastogne é um cruzamento crítico que eles querem tomar."/>
	<comment key="bastogne intro, part 4" text="Protejam a linha, e protejam Bastogne a todo custo!"/>
	<comment key="bastogne intro, part 5" text="Eles vão nos atingir com tudo que eles tem. Verifiquem seus mapas e vão para as posições na linha de frente."/>
	<comment key="bastogne intro, part 6" text="Boa sorte e vão com Deus, soldados! Vocês devem ter por volta de 30 segundos para entrarem em posição!"/>
	<comment key="bastogne intro, part 7" text="O inimigo está nos sondando, não vai demorar muito mais agora! Eles parecem estar vindo pelo flanco oeste!"/>

	<comment key="bastogne stage attacks increase 1" text="Eles estão enviando mais apoio blindado! Tenha cuidado nos flancos a leste!"/>
	<comment key="bastogne stage attacks increase 2" text="O ataque inimigo está se intensificando! Vá até o local do avanço principal!"/>
	<comment key="bastogne stage attacks increase 3" text="Mais unidades blindadas foram avistadas se aproximando das nossas posições! Movam-se até onde estão e parem elas!"/>
	<comment key="bastogne stage counterattack 1" text="O inimigo está ficando sem forças, reagrupem-se e comecem a atacar!"/>
	<comment key="bastogne stage counterattack 2" text="O ataque deles está enfraquecendo!"/>
	<comment key="bastogne stage counterattack 3" text="Reassegurem todas as nossas posições antes de avançarem até Foy no norte!"/>
	<comment key="bastogne test info 1" text="Capacidades ajustadas; Aliados impulsionados"/>
	<comment key="bastogne test info 2" text="Capacidades ajustadas; facções igualadas"/>
	
	<comment key="map start with 1 base, part 1" text="Atenção, instruções do comandante chegando"/>
	<comment key="map start with 1 base, part 2" text="É bom ter todos você aqui em %map_name"/>
	<comment key="map start with 1 base, part 3" text="Trouxemos você aqui hoje para participar de uma operação importante."/>
	
	<comment key="map start with paradrop, part 1" text="Atenção, instruções do comandante chegando"/>
	<comment key="map start with paradrop, part 2" text="Nós estamos conduzindo uma operação aerotransportada aqui em %map_name"/>
	<comment key="map start with paradrop, part 3" text="Você pode escolher um local para entrar no campo de batalha"/>
	<comment key="map start with paradrop, part 4" text="Todo o território é território inimigo, por isso esteja atento até que consiga assegurar uma posição!"/>

	<comment key="map start with 1 base, capture" text="Agora nós estamos prontos para lançar um ataque, o objetivo é capturar a área completamente"/>
	<comment key="map start with 1 base, koth" text="A tarefa principal é ganhar controle de %target_base_name e defender"/>
	
	<comment key="hill 262, part 1" text="Atenção, instruções do comandante chegando"/>
	<comment key="hill 262, part 2" text="Os Alemães estão tentando fugir da Bolsa de Falaise através deste setor."/>
	<comment key="hill 262, part 3" text="Nós nos juntamos às forças Polonesas enfraquecidas aqui no Monte Ormel"/>
	<comment key="hill 262, part 4" text="No entanto, o trabalho ainda não acabou: assuma o controle do Ponto 262 e defenda"/>

	<comment key="map advance, held by enemy" text="%map_name é o próximo alvo estratégico. Os alemães têm estado ocupados neste setor."/>
	<comment key="map advance, another enemy present" text="%faction_name também foram vistos na área"/>
	<comment key="map advance, new map" text="Preparem-se para mover!"/>
	<comment key="map advance, been there before" text="Nós ainda temos o controle de %number_of_bases bases"/>
	<comment key="map advance, friendly map" text="%map_name é ocupado por %faction_name, tem sido bem pacífico lá"/>
	
	<comment key="varsity, part 1" text="Atenção, instruções do comandante chegando"/>
	<comment key="varsity, part 2" text="Lançamos a Operação Varsity na tentativa de atravessar o Reno e atacar a Alemanha."/>
	<comment key="varsity, part 3" text="Prepare-se para uma operação aerotransportada, mas fique avisado:"/>
	<comment key="varsity, part 5" text="O inimigo estabeleceu um poderoso ponto forte ao nordeste em torno de um velho castelo."/>
	<comment key="varsity, part 6" text="Nossas aeronaves de reconhecimento não conseguiram obter dados sobre a local, portanto eles podem estar escondendo forças na região."/>
	<comment key="varsity, part 7" text="Você não poderá atacar o local até que o resto da área esteja seguro."/>
	<comment key="varsity, part 8" text="Preparem-se para uma luta difícil!  Boa sorte e vá com Deus, paraquedistas."/>
	<comment key="varsity, boss, part 1" text="A resistência Alemã está enfraquecendo, é hora de atacar os redutos localizados no antigo castelo."/>
	<comment key="varsity, boss, part 2" text="Destruam qualquer resistência que esteja atrás daquelas paredes do castelo!"/>
	
  <!-- reinforcement commander lines -->
	<comment key="spawn_in_base_call, accepted, key=ukf_inf.call" text="Infantaria reagrupando em %base_name"/>
	<comment key="spawn_in_base_call, denied, key=ukf_inf.call" text="Nenhum ponto válido para mobilização encontrado, capture uma base!"/>

	<comment key="spawn_in_base_call, accepted, key=ukf_para_no_parachuting.call" text="Paraquedistas em solo reagrupando em %base_name"/>
	<comment key="spawn_in_base_call, denied, key=ukf_para_no_parachuting.call" text="Nenhum ponto válido para mobilização encontrado, capture uma base!"/>

	<comment key="spawn_in_base_call, accepted, key=usf_vehicle.call" text="Jeep calibre .50 mobilizado em %base_name"/>
