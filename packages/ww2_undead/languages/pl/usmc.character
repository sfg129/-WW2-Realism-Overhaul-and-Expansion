	<comment key="Medic!" text="Ala! Boli!" /> 
	
	<comment key="Reloading" text="Przykryj mnie, przeladowuje!" />
	<comment key="Reloading" text="Zmieniam pestki!" />  
	
	<comment key="initiate radio call" text="Akwarium? Halo? Tu ryba. Macie odczyt?" />
	<comment key="commander radio response" text="Slucham, ryba. Tu Akwarium, nadawaj." />
	
	<comment key="hostile vehicle takeover" text="Co? Jak? Skad?" />
	<comment key="hostile vehicle takeover" text="Ej! Zostaw to!" /> 
	<comment key="hostile vehicle takeover" text="Co? Nie!" />     
	
	<comment key="Lone leader, enemy not seen, taking suppressed fire" text="Gdzies tu jest, szukac go!" />
	
	<comment key="enemy seen, vehicle tag = tank" text="Widze puszke!" /> 
	<comment key="enemy seen, vehicle tag = tank" text="Dawac tu przeciwpancerny!"/>
	<comment key="enemy seen, vehicle tag = tank" text="Czooooolg!"/> 
	<comment key="enemy seen, vehicle tag = tank" text="Na ziemie, wrogi czolg!"/> 
	<comment key="enemy seen, vehicle tag = tank" text="Widze wrogi czolg!" />  
	
 	<comment key="enemy seen, vehicle tag = apc" text="Opancerzony na wprost!" /> 
 	<comment key="enemy seen, vehicle tag = apc" text="Wrogi Rosomak, rozwalic go!" />  
 	<comment key="enemy seen, vehicle tag = apc" text="Zauwazylem Rosomaka!" />
 	<comment key="enemy seen, vehicle tag = apc" text="Wrogi woz opancerzony!" /> 
 	<comment key="enemy seen, vehicle tag = apc" text="Uwaga, wrogi Rosomak w poblizu!" />
 	<comment key="enemy seen, vehicle tag = apc" text="Wytruc tego Rosomaka!" />  
	
	<comment key="enemy seen, vehicle tag = truck" text="Wrogi konwoj!" />   
 	<comment key="enemy seen, vehicle tag = truck" text="Kontakt z wrogimi pojazdami!" />  
 	<comment key="enemy seen, vehicle tag = truck" text="Jedzie tu wrogi pojazd!" />   
 	<comment key="enemy seen, vehicle tag = truck" text="Walic w ten pojazd!" />                   
	
	<comment key="Hold on!" text="Marian, te! Zaczekaj!" />  
	
	<comment key="celebrating" text="Macie za swoje!" />
	<comment key="celebrating" text="Ha, dalismy rade..." />
	<comment key="celebrating" text="Ufff, to tyle, na razie..." />
	<comment key="celebrating" text="Dobra robota, chlopcy." />
	<comment key="celebrating" text="Mam was tam, gdzie wasze Wielkie slonce nie dochodzi!" />
	<comment key="celebrating" text="Fajna wyspe mieliscie, zatrzymam ja sobie." />
	<comment key="celebrating" text="Nawet nie wiecie, co niedlugo na was spadnie!" />
	<comment key="celebrating" text="Baaardzo dooobrze!" />
	<comment key="celebrating" text="Skopalismy im tylki!" />
	<comment key="celebrating" text="Ej no, tak latwo sie poddajecie?" />
	<comment key="celebrating" text="Zabierajcie swoje klapki!" />
	<comment key="celebrating" text="Won mi z mojej piaskownicy!" />
	
	<dialogue key="wander dialogue 2 men">
		<comment text="Pomijajac to, ze robimy w marynarce to strasznie dlugo chodzimy w tych dziwnych kombinezonach" />
	</dialogue>    
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Slyszalem, ze ministerstwo uzbroi nas w nowa bron!" />
		<comment text="W bojowe parasole?" />
	</dialogue>   
      
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Dali ci nowy ekwipunek!?" />
		<comment text="Tia" />
		<comment text="A mi nie dali..." /> 
		<comment text="Moge ci pozyczyc bojowe klapki" />    
	</dialogue> 
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Ogladales prognoze pogody na dzis?" />
		<comment text="Ponoc ma padac napalemem.." />
		<comment text="..." />
	</dialogue>
	
	<dialogue key="vehicle dialogue 2 men tag=light_tank">
		<comment text="Jak nazwiemy nowy czolg?" />
		<comment text="Misiek..." />
		<comment text="To moze lepiej Misiewicz?." />
	</dialogue>
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Cholerne kraby!" />  
		<comment text="Wkurzajace, nie?" /> 
		<comment text="Zabilem ich wiecej niz przeciwnikow na tej wojnie." />  
	</dialogue>  
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Dlaczego pol naszego oddzialu sie wycofalo?" />  
		<comment text="Oni sie nie wycofali, zaatakowali w odwrotnym kierunku" />  
		<comment text="To ta nowa taktyka z Francji?" />                                       
	</dialogue>  
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Paaacyfik, piekne plaze, bunkry sa, jest za..." />  
		<comment text="Marian, przestan." />                                     
	</dialogue> 
	
   <!-- commander comments -->
	<comment key="player promotion" text="Gratulacje zolnierzu, twoja nowa ranga to %rank_name!" />
	<comment key="we captured a base" text="%base_name podpite przez nasze wojska!" />
	<comment key="we captured a base" text="Przejelismy kontrole w %base_name, oczyscic region." />
	<comment key="we captured a base" text="Nasi Marines zdobyli %base_name!" />
	<comment key="enemy captured a base" text=" %faction_name zdobyli %base_name, przygotowac sie na kontratak!" />
	<comment key="enemy captured a base" text="Skosnoocy przejeli %base_name" />
	<comment key="neutral captured a base" text="" />
	
	<comment key="we have lost our last base" text="Stracilismy ostatnia baze, bitwa przegrana!" />
	<comment key="enemy has lost their last base" text="%faction_name zostali pokonani!" />
	
	<comment key="our assault ran out of time" text="Wyczerpal sie czas przeznaczony na inwazje. Bitwa przegrana!" />
	<comment key="enemy assault ran out of time" text="%faction_name zostali pokonani!" />
	
	<comment key="we won by map conquer" text="Dobra robota, zolnierze. Wrog zostal wyparty!" />
	<comment key="we won by defense timer" text="Wroga inwazja stracila na sile! Wygralismy!" />
	
	<comment key="our base is under attack" text="%base_name jest pod ostrzalem wroga!" />
	<comment key="our base is under attack" text="Skosnoocy atakuja %base_name." />
	<comment key="we are attacking a base" text="Nasze wojska szturmuja %base_name" />
	
	<comment key="fighting near a base" text="Mamy raporty o ruchach wrogich wojsk w %base_name" />
	<comment key="fighting near a base" text="Potrzebne wsparcie w %base_name" />
	<comment key="fighting near a base" text="Slychac strzaly nieopodal %base_name" />
	
	<comment key="defense timer started" text="%faction_name utrzymuje teren, %time_left pozostalo!" />
	<comment key="defense timer to go" text="%time_left pozostalo!" />
	
   <!-- adventure mode -->
	<comment key="guadalcanal intro, part 1" text="Uwaga, tu dowodca" />
	<comment key="guadalcanal intro, part 2" text="Okrety odplynely, jestesmy tutaj sami." />
	<comment key="guadalcanal intro, part 3" text="A co gorsze, wyglada na to, ze Japonce uderza wszystkimi silami." />
	<comment key="guadalcanal intro, part 4" text="Utrzymac linie oraz lotnisko za wszelka cene!" />
	<comment key="guadalcanal intro, part 5" text="Wrog zbliza sie od strony rzeki, badzcie gotowi." />
	<comment key="guadalcanal intro, part 6" text="Powodzenia i zabierajcie zabawki, macie 30 sekund na dotarcie na pozycje!" />
	<comment key="guadalcanal intro, part 7" text="Wrog narazie tylko nas sprawdza, ale to nie potrwa dlugo!" />
	
	<comment key="guadalcanal stage 1" text="Wrogie bombardowanie, kryc sie! (Faza 1 rozpoczeta)" />
	<comment key="guadalcanal stage 2" text="Druga fala bombardowan! (Faza 2 rozpoczeta)" />
	<comment key="guadalcanal stage 3" text="Czolgi! Oni maja czolgi! (Faza 3 rozpoczeta)" />
	<comment key="guadalcanal stage 4" text="Wrog nas nie zlamie! Utrzymywac pozycje! (Faza 4 rozpoczeta)" />
	<comment key="guadalcanal stage 5" text="Chyba sie przegrupowuja przed kolejnym atakiem! (2 minuty przerwy rozpoczete)" />
	<comment key="guadalcanal stage 6" text="Wsparcie wyladowalo, ale wrog zdaje sie nie przerywac ataku!  (Faza 6 rozpoczeta)" />
	<comment key="guadalcanal stage 7" text="Okrety marynarki powrocily ze swoimi ciezkimi dzialami!" />
	<comment key="guadalcanal stage 8" text="Czas na kontratak!" />
	
	<comment key="map start with 1 base, part 1" text="Uwaga, tu dowodca" />
	<comment key="map start with 1 base, part 2" text="Dobrze was widziec, tutaj na %map_name" />
	<comment key="map start with 1 base, part 3" text="Flota dotarla dzisiejszego ranka, bedziemy przeprowadzac kolejne operacje."/>
	
	<comment key="map start with 1 base, capture" text="Jestesmy gotowi rozpoczac inwazje, cel to zajac %map_name calkowicie" />
	<comment key="map start with 1 base, koth" text="Glownym celem jest zajac %target_base_name oraz obronic ten punkt" />
	
	<comment key="map advance, held by enemy" text="Nasz batalion S-2 mowi, ze nastepny cel strategiczny to %map_name. Podobno %faction_name okopali sie calkiem przyzwoicie." />
	<comment key="map advance, another enemy present" text="Wojska %faction_name zauwazono w okolicy." />
	<comment key="map advance, new map" text="Przygotowujemy sie do ataku, ruszamy na przod!" />
	<comment key="map advance, been there before" text="Wciaz kontrolujemy %number_of_bases bazy." />
	<comment key="map advance, friendly map" text="%map_name jest pod kontrola %faction_name, raczej jest tam spokojnie." />
	
	<comment key="final map, part 1" text="Uwaga, uwaga. Mowi dowodca." />
	<comment key="final map, part 2" text="Dobrze, ze dozylisice walk na %map_name" />
	<comment key="final map, part 3" text="To juz prawie koniec - ojczyzna wroga" />
	<comment key="final map, part 5" text="Wyspa po wyspie, plaza po plazy, przebilismy sie przez ziemie %faction_name." />
	<comment key="final map, part 6" text="Jeszcze pare krokow, Operacja Slizgawka przed Wami." />
	<comment key="final map, part 7" text="Wygrana w tej finalnej bitwie i zakonczymy wojne naszym zwyciestwem!" />
	
   <!-- reinforcement commander lines -->
	<comment key="spawn_in_base_call, accepted, key=usmc_inf.call" text="Oddzial strzelcow zostal wyslany do %base_name" />
	<comment key="spawn_in_base_call, accepted, key=usmc_vehicle.call" text="Zrzucamy M3 Stuart w lokacji %base_name" />
	<comment key="spawn_in_base_call, accepted, key=usmc_vehicle1.call" text="LVT-4 zrzucony w lokacji %base_name" />
	<comment key="spawn_in_base_call, accepted, key=usf_vehicle_m4_sherman.call" text="M4A3 Sherman rozmieszczony w %base_name"/>
	<comment key="spawn_in_base_call, denied, key=usmc_inf.call" text="Nie mozemy zrzucic sprzetu na glowy wrogow, przejmijcie bazy!" />
	<comment key="spawn_in_base_call, denied, key=usmc_vehicle.call" text="Nie mozemy zrzucic sprzetu na glowy wrogow, przejmijcie bazy!" />
	<comment key="spawn_in_base_call, denied, key=usmc_vehicle1.call" text="Nie mozemy zrzucic sprzetu na glowy wrogow, przejmijcie bazy!" />
	<comment key="spawn_in_base_call, denied, key=usf_vehicle_m4_sherman.call" text="Nie znaleziono zadnych punktow rozmieszczenia, zdobyc baze!"/>

	<comment key="spawn_in_base_call, accepted, key=usf_vehicle_armoury_marine.call" text="DUKW Zbrojownia rozmieszczony w %base_name"/>
	<comment key="spawn_in_base_call, denied, key=usf_vehicle_armoury_marine.call" text="Nie znaleziono zadnych punktow rozmieszczenia, zdobyc baze!"/>
	
