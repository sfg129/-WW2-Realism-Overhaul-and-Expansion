	<comment key="Medic!" text="아악! 피탄당했다!" /> 
	
	<comment key="Reloading" text="장전중이다. 엄호해줘!" />
	<comment key="Reloading" text="재장전!" />  
	
	<comment key="initiate radio call" text="본부 응답하라, 여기는 에이블 중대, 듣고있나?" />
	<comment key="commander radio response" text="에이블 듣고있다, 계속 하라." />
	
	<comment key="hostile vehicle takeover" text="뭣? 안돼!" />
	<comment key="hostile vehicle takeover" text="이봐! 저거봐!" /> 
	<comment key="hostile vehicle takeover" text="이런? 안돼 안돼 안돼!" />    
	
	<comment key="Lone leader, enemy not seen, taking suppressed fire" text="그 새끼 찾아내, 망할!" />
	
	<comment key="enemy seen, vehicle tag = tank" text="기갑 발견!" /> 
	<comment key="enemy seen, vehicle tag = tank" text="여기 대전차 화기가 필요하다!"/>
	<comment key="enemy seen, vehicle tag = tank" text="전차!"/> 
	<comment key="enemy seen, vehicle tag = tank" text="맘소사, 엄폐해! 전차다!"/> 
	<comment key="enemy seen, vehicle tag = tank" text="놈들이 기갑을 끌고왔어!" />     
	
 	<comment key="enemy seen, vehicle tag = apc" text="장갑차 발견!" /> 
 	<comment key="enemy seen, vehicle tag = apc" text="장갑차다! 작살을 내버려!" />  
 	<comment key="enemy seen, vehicle tag = apc" text="적군 장갑차량!" />
 	<comment key="enemy seen, vehicle tag = apc" text="장갑차를 발견했다!" /> 
 	<comment key="enemy seen, vehicle tag = apc" text="장갑차다! 조심해!" />
 	<comment key="enemy seen, vehicle tag = apc" text="장갑차다! 저것을 파괴하라 제군들!" />  
	
 	<comment key="enemy seen, vehicle tag = truck" text="적군 수송차량!" />   
 	<comment key="enemy seen, vehicle tag = truck" text="적군 수송차량과 조우했다!" />  
 	<comment key="enemy seen, vehicle tag = truck" text="놈들이 트럭을 끌고왔다!" />   
 	<comment key="enemy seen, vehicle tag = truck" text="저 트럭을 박살내버려!" />                  
	
	<comment key="Hold on!" text="좀만 버텨 친구!" />  
	
	<comment key="celebrating" text="이거나 먹어라!" />
	<comment key="celebrating" text="내가 해냈어...." />
	<comment key="celebrating" text="휴, 끝났군, 지금은..." />
	<comment key="celebrating" text="잘했다, 제군들." />
	<comment key="celebrating" text="네놈들의 욱일이 보이지 않는 곳에 이거나 붙혀라!" />
	<comment key="celebrating" text="잘했어 섬을 우리가 접수했으니, 이제 이걸 사수하는 일만 남았군." />
	<comment key="celebrating" text="우후, 운이 좋았어." />
	<comment key="celebrating" text="이야! 훌륭했어." />
	<comment key="celebrating" text="우리가 한방 먹였지!" />
	<comment key="celebrating" text="겁나쉽군?" />
	<comment key="celebrating" text="카타나 찾으러 가야겠어" />
	<comment key="celebrating" text="장교용 권총을 찾을 수 있으면 좋겠군." />
	
	<dialogue key="wander dialogue 2 men">
		<comment text="너도 알다시피, 해군이 있자만, 우린 여기서 참 많은 걸 하고 있어." />
	</dialogue>    
	
	<dialogue key="defense dialogue 2 men">
		<comment text="일본군이 계속 급습을 하고있다고 들었어." />
		<comment text="제길, 급습을 대비하기는 했었나?" />
	</dialogue>   
      
	<dialogue key="vehicle dialogue 2 men">
		<comment text="새로운 장비를 지급받았어?" />
		<comment text="응," />
		<comment text="내 것도 새 거였으면.." /> 
		<comment text="있는거나 써라, 짜식아." />    
	</dialogue> 
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="오늘 밤 날씨는 어떻게 되는지 아십니까?" />
		<comment text="알고말고, 폭탄비가 내리겠는데!" />
		<comment text="..." />
	</dialogue>
	
	<dialogue key="vehicle dialogue 2 men tag=light_tank">
		<comment text="전차 이름을 뭐라고 할까?" />
		<comment text="'인간 뭉개기' 어떠냐." />
		<comment text="존나좋군." />
	</dialogue>
	
	<dialogue key="defense dialogue 2 men">
		<comment text="아으 짱나!" />  
		<comment text="왜, 짜증이야?" /> 
		<comment text="적을 죽인 것보다 더 많이 죽었어!" />  
	</dialogue>  
	
	<dialogue key="defense dialogue 2 men">
		<comment text="왜 우리 병사들이 며칠간 후퇴한 거지?" />  
		<comment text="후퇴한 적 없잖아, 반대 방향으로 진격했다고." />  
		<comment text="아, 그렇지." />                                       
	</dialogue>  
	
	<dialogue key="defense dialogue 2 men">
		<comment text="전쟁은 무식한 사람들에게 지리학을 가르치는 신의 방법이지." />  
		<comment text="그래?, 내 듣기로는 너의 몸이 1차 대전 때 참호를 많이도 파서 유약해진 거냐." />                                     
	</dialogue> 
	
   <!-- commander comments -->
	<comment key="player promotion" text="좋은 소식일세 제군, 자네는 방금 %rank_name으로 진급했다!" />
	<comment key="we captured a base" text="%base_name를 우리 병력이 점령했다." />
	<comment key="we captured a base" text="%base_name를 제어하고 점거하기 위해 이동하라." />
	<comment key="we captured a base" text="우리 해병대가 %base_name를 정리했다." />
	<comment key="enemy captured a base" text="%faction_name가 %base_name를 점령했다, 반격에 대비하라!" />
	<comment key="enemy captured a base" text="일본군이 %base_name를 점령했다." />
	<comment key="neutral captured a base" text="" />
	
	<comment key="we have lost our last base" text="우리의 모든 기지를 잃었다. 전투는 이미 끝났다!" />
	<comment key="enemy has lost their last base" text="%faction_name가 패배했다!" />
	
	<comment key="our assault ran out of time" text="우리의 공격은 시간을 지체했다. 전투는 이미 끝났다!" />
	<comment key="enemy assault ran out of time" text="%faction_name가 패배했다!" />
	
	<comment key="we won by map conquer" text="훌륭하네 제군, 우리가 놈들을 여기서 몰아냈다." />
	<comment key="we won by defense timer" text="놈들이 공격할 힘도 없나 보군, 우리가 승리했다!" />
	
	<comment key="our base is under attack" text="%base_name가 공격받고 있다." />
	<comment key="our base is under attack" text="일본군이 %base_name를 공격한다는 보고를 받았다." />
	<comment key="we are attacking a base" text="우리의 병력들이 %base_name지점을 공격하고 있다." />
	
	<comment key="fighting near a base" text="%base_name 인근에서 교전이 발생했다." />
	<comment key="fighting near a base" text="%base_name 인근에서 증원요청을 받았다." />
	<comment key="fighting near a base" text="%base_name 인근에서 총성을 감지했다." />
	
	<comment key="defense timer started" text="%faction_name hold the area, %time_left초 밖에 남지 않았네 빨리 공격하도록!" />
	<comment key="defense timer to go" text="%time_left초밖에 남지 않았다 이동하게!" />
	
   <!-- adventure mode -->
	<comment key="guadalcanal intro, part 1" text="집중하게, 지휘관 보고가 있겠다." />
	<comment key="guadalcanal intro, part 2" text="현재 해군이 이 지역에서 철수했다, 즉 우리만 여기 남게 된것이다." />
	<comment key="guadalcanal intro, part 3" text="그리고 더 심각한건, 일본놈들이 가능한 모든 방법으로 이 방어선을 공격할 것 같다." />
	<comment key="guadalcanal intro, part 4" text="전선을 사수하라, 모든 수단을 다 동원해서 비행장를 사수하라!" />
	<comment key="guadalcanal intro, part 5" text="놈들이 강을 넘어 공격해 올것이다, 준비하게나." />
	<comment key="guadalcanal intro, part 6" text="무운을 빌고 빨리 해결되길 바라겠네, 제군들! 이제 30초 남았네 빨리 자리로 이동하게!" />
	<comment key="guadalcanal intro, part 7" text="적들이 접근하고 있다, 오래가진 않겠지!" />
	
	<comment key="guadalcanal stage 1" text="적군의 포격이다, 엄폐하라! (제1 공세가 시작)" />
	<comment key="guadalcanal stage 2" text="적이 2차 공세를 시작하려 한다! (제2 공세가 시작)" />
	<comment key="guadalcanal stage 3" text="전차다! 적들이 전차를 몰고왔다! (제3 공세가 시작)" />
	<comment key="guadalcanal stage 4" text="적들이 포기하지 않으려고 한다, 방어선을 유지하라! (제4 공세가 시작)" />
	<comment key="guadalcanal stage 5" text="놈들이 다음 공세를 위해 재집결 하고 있다. 방어선을 보강하라! (2분간 휴식뒤 제5 공세가 시작)" />
	<comment key="guadalcanal stage 6" text="아군 부대가 상륙했다, 하지만 놈들은 공세를 멈출 생각이 없어 보이는군.  (제6 공세가 시작)" />
	<comment key="guadalcanal stage 7" text="해군이 함포와 함께 돌아왔다! 놈들에게 지옥을 보여줘라!" />
	<comment key="guadalcanal stage 8" text="반격하라!" />
	
	<comment key="map start with 1 base, part 1" text="집중하게, 지휘관 보고가 있겠다." />
	<comment key="map start with 1 base, part 2" text="%map_name에 모두 와주어서 고맙네." />
	<comment key="map start with 1 base, part 3" text="함대는 오늘 도착하여 상륙작전을 준비했다네."/>
	
	<comment key="map start with 1 base, capture" text="이제 침공할 준비가 되었으니 목표는 %map_name를 완전히 점령하는 것이다." />
	<comment key="map start with 1 base, koth" text="우리의 주 목표는 %target_base_name를 점령하고 사수하는 것이다." />
	
	<comment key="map advance, held by enemy" text="우리의 S-2 대대가 말하길 %map_name가 다음 전략 목표라고 한다. %faction_name가 빡빡하게 채우고 있군." />
	<comment key="map advance, another enemy present" text="%faction_name또한 그 지역에서 발견되었다." />
	<comment key="map advance, new map" text="우리 사단에서 또 다른 상륙부대를 준비하고 있다네, 빨리 가게나!" />
	<comment key="map advance, been there before" text="우리는 여전히 %number_of_bases개의 기지를 제어하고 있다." />
	<comment key="map advance, friendly map" text="%map_name는 %faction_name이 점거하고 있다, 꽤나 조용하군." />
	
	<comment key="final map, part 1" text="집중하게, 지휘관 보고가 있겠다." />
	<comment key="final map, part 2" text="%map_name에 와주어서 고맙네." />
	<comment key="final map, part 3" text="이곳은 적들의 심장부다!" />
	<comment key="final map, part 5" text="섬과 섬들을 지나, %faction_name놈들을 여기까지 몰아냈다." />
	<comment key="final map, part 6" text="하지만 이제 시작이다, 몰락 작전은 이미 시작했다." />
	<comment key="final map, part 7" text="이곳에서 승리하여 이 전쟁을 끝네자, 하나는 모두를 위해!" />
	
   <!-- reinforcement commander lines -->
	<comment key="spawn_in_base_call, accepted, key=usmc_inf.call" text="육군 소총 분대를 %base_name에 파견하겠다." />
	<comment key="spawn_in_base_call, accepted, key=usmc_vehicle.call" text="M3 스튜어트를 %base_name에 배치하겠다." />
	<comment key="spawn_in_base_call, accepted, key=usmc_vehicle1.call" text="LVT-4를 %base_name에 배치하겠다." />
	<comment key="spawn_in_base_call, accepted, key=usf_vehicle_m4_sherman.call" text="M4A3 셔먼 을 %base_name에 배치한다"/>
	<comment key="spawn_in_base_call, denied, key=usmc_inf.call" text="배치 가능한 지점을 발견하지 못했다, 기지를 점령하라!" />
	<comment key="spawn_in_base_call, denied, key=usmc_vehicle.call" text="배치 가능한 지점을 발견하지 못했다, 기지를 점령하라!" />
	<comment key="spawn_in_base_call, denied, key=usmc_vehicle1.call" text="배치 가능한 지점을 발견하지 못했다, 기지를 점령하라!" />
	<comment key="spawn_in_base_call, denied, key=usf_vehicle_m4_sherman.call" text="배치 가능한 지점을 발견하지 못했다, 기지를 점령하라!"/>

	<comment key="spawn_in_base_call, accepted, key=usf_vehicle_armoury_marine.call" text="DUKW Armory deploying at %base_name" />
	<comment key="spawn_in_base_call, denied, key=usf_vehicle_armoury_marine.call" text="배치 가능한 지점을 발견하지 못했다, 기지를 점령하라!"/>
	
   <!-- character specific animation override table -->
	<animation key="recoil, pistol, 2hand" target_key="recoil, pistol" />
	<animation key="reloading, pistol, 2hand" target_key="reloading, pistol, pacific" />
	<animation key="still, pistol, 2hand" target_key="hold, pistol" />
	<animation key="crouch, pistol, 2hand" target_key="crouch, pistol" />
	<animation key="reloading, c96 pistol, 2hand" target_key="reloading, c96 pistol"/>
	<animation key="reloading, enfield pistol, 2hand" target_key="reloading, enfield pistol"/>
	
</character>