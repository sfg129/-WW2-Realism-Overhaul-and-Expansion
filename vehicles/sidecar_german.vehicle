<vehicle file="vehicle_base.vehicle" name="KS-750" key="sidecar_german.vehicle" time_to_live_unsteerable="60" map_view_atlas_index="23" minimum_fill_requirement="0.5" ai_use_throwables="0">
	<tag name="metal_thin" />
   	<tag name="light_vehicle" />

	<tire_set offset="0.68 0.0 0.82" radius="0.42" />
	<tire_set offset="0.68 0.0 -0.82" radius="0.42" />
	<visual class="tire" index="0" />
	<visual class="tire" index="1" mesh_filename="sidecar_german_wheel.mesh" texture_filename="sidecar_german.png" />
	<visual class="tire" index="2" mesh_filename="sidecar_german_wheel.mesh" texture_filename="sidecar_german.png" />
	<visual class="tire" index="3" mesh_filename="sidecar_german_wheel.mesh" texture_filename="sidecar_german.png" />

	<control max_limiter_speed="8.0" max_speed="22.0" acceleration="8.5" max_reverse_speed="7.0" min_health_to_steer="0.12" max_rotation="0.6" max_water_depth="1.0" steer_smoothening="0.8" />

	<modifier class="blast_range" value="0.5" /> <!-- radius raised to help with issues from AT Rifle Grenades - but not dramatically make other AT weapons overpowered -->
	<modifier class="blast_damage" value="-0.5" />

	<physics max_health="1.6" mass="1.0" extent="2.4 0.0 4.2" offset="0 0.0 0" top_offset="0 4 0" collision_model_pos="0 0.5 -0.2" collision_model_extent="1.8 1.0 2.5" visual_offset="0 0.3 -0" gravity="-40" preserve_motion_on_impact_factor="1.0" friction_offset="0.0" drag_offset="-0.15" destroy_on_top_hit="1" destroy_on_top_hit_time="1.0" top_hit_tracking_time="0.6"/> 

	<turret offset="-0.19 1.14 0.38" weapon_key="sidecar_german_mg_dummy.weapon" weapon_offset="0.0 0.03 0.0" weapon_recoil="0.03" physics_recoil="0.0" max_rotation_step="0.0" rotation_range="1.2" />
	<turret offset="-0.19 1.14 0.38" weapon_key="sidecar_german_mg.weapon" weapon_offset="0.0 0.03 0.0" weapon_recoil="0.03" physics_recoil="0.0" max_rotation_step="0.0006" rotation_range="1.2" />

	<visual class="chassis" mesh_filename="sidecar_german_chassis.mesh" texture_filename="sidecar_german.png" />
	<visual class="chassis" key="broken" mesh_filename="sidecar_german_chassis_damage.mesh" texture_filename="sidecar_german_damage.png" />
	<visual class="turret" turret_index="0" key="broken" mesh_filename="sidecar_german_turret_damage.mesh" texture_filename="mg42_hmg.png" />  
	<visual class="turret" turret_index="0" mesh_filename="" texture_filename="" />
	<visual class="turret" turret_index="1" key="broken" mesh_filename="sidecar_german_turret_damage.mesh" texture_filename="mg42_hmg.png" />  
	<visual class="turret" turret_index="1" mesh_filename="sidecar_german_turret.mesh" texture_filename="mg42_hmg.png" />

	<character_slot type="driver" position="0.682 0.32 -0.48" rotation="0" exit_rotation="1.57" hiding="0" animation_key="driving motorcycle" marker_offset="0 0.35 0.2" />
	<character_slot type="gunner" attached_on_turret="0" enter_position="-1.1 0.5 -0.5" seat_position="0 -1.1 -0.9" rotation="0" exit_rotation="-1.57" hiding="0" animation_key="sidecar passenger" marker_offset="0 1.0 0">
		<turret index="0" />
		<turret index="1" />
	</character_slot>
 	<character_slot type="passenger" position="0.682 0.5 -0.94" rotation="3.14" exit_rotation="3.14" rotation_range="1.4" hiding="0" animation_key="passenger atv" marker_offset="0 0.35 0.0" />


	<!-- sound handling -->
	<!--
	<rev_sound filename="jeep_rev0.wav" low_pitch="0.8" high_pitch="1.1" low_rev="0.3" high_rev="1.1" volume="0.7" />
	<rev_sound filename="jeep_rev1.wav" low_pitch="0.7" high_pitch="1.3" low_rev="0.4" high_rev="1.0" volume="0.9" />
	-->
	<rev_sound filename="jeep2_rev0.wav" low_pitch="0.8" high_pitch="1.1" low_rev="0.0" high_rev="0.3" volume="0.8" />
	<rev_sound filename="jeep2_rev2.wav" low_pitch="0.6" high_pitch="1.1" low_rev="0.2" high_rev="0.7" volume="0.65" />
	<rev_sound filename="jeep2_rev3.wav" low_pitch="0.8" high_pitch="1.3" low_rev="0.7" high_rev="1.1" volume="0.6" />

	<sound key="slide" filename="slide_noise.wav" />
	<sound key="squeal" filename="tire_squeal.wav" />
	<sound key="ignition" filename="jeep2_ignition.wav" />
	<sound key="horn" filename="horn_jeep.wav" />   
	<sound key="hit" filename="car_hit1.wav" />
	<sound key="hit" filename="car_hit2.wav" />
	<sound key="hit" filename="car_hit3.wav" />
	<sound key="destroy" filename="vehicle_explosion_1.wav" />  
	<sound key="cleanup" filename="vehicle_explosion_1.wav" />  
  

	<effect event_key="slide" type="splat_map" surface_tag="road" size="2.0" atlas_index="5" layer="0" />
	<effect event_key="slide_hard" type="splat_map" surface_tag="road" size="2.0" atlas_index="5" layer="0" />
	<!-- <effect event_key="slide_hard" type="splat_map" surface_tag="road" size="0.5" atlas_index="2" layer="0" /> -->

	<effect event_key="slide" type="splat_map" surface_tag="dirt" size="1.0" atlas_index="2" layer="1" />
	<effect event_key="slide" type="particle" key="terrain" surface_tag="dirt" ref="Burst" use_surface_color="1" />
	<!-- <effect event_key="slide_hard" type="particle" key="terrain" ref="Burst" use_surface_color="1" /> -->

	<effect event_key="health" value="0.6" ref="SmallSmokeVehicle" offset="-0.7 1.5 -0.2" /> 
	
	<effect event_key="health" value="0.24" ref="SmallSmokeVehicle" offset="-0.7 1.5 -0.2" />        
	<effect event_key="health" value="0.24" ref="BrokenSparkle" post_processing="0" offset="-0.4 1.5 -0.2" /> 

        <effect event_key="destroyed" ref="SmallSmokeVehicle" offset="-0.7 1.8 -0.2" />
        <effect event_key="destroyed" ref="SmallFireRepeat" offset="-0.7 1.2 -0.2" />
        <effect event_key="destroy" key="other" ref="woosh" post_processing="0" shadow="0" />   
        <effect event_key="cleanup" key="other" ref="woosh" post_processing="0" shadow="0" />         


<!--
        <effect event_key="drive_chassis" ref="Propulsion" offset="0.4 0.5 -2.3" />
-->

<!--        <effect event_key="destroyed" ref="BurstRepeat" bind="0" />
        <effect event_key="destroyed" ref="BurstRepeat" bind="1" />
-->
		
	<event key="spot_rp_reward">
		<trigger class="spot" />
		<result class="reward" rp="10.0" />
	</event>

	<event>
		<trigger class="destroy" />
  	<result class="spawn" instance_class="visual_item" instance_key="burning_piece_jeep1.visual_item" min_amount="1" max_amount="3" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.15 0.3" />
	</event>
	<event>
		<trigger class="destroy" />  	
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_jeep2.visual_item" min_amount="0" max_amount="1" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.3" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_jeep3.visual_item" min_amount="1" max_amount="2" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.25" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_jeep4.visual_item" min_amount="1" max_amount="3" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.15 0.25" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_jeep5.visual_item" min_amount="2" max_amount="3" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.3" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_jeep6.visual_item" min_amount="2" max_amount="3" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.2" /> 
  </event>

  <event>
		<trigger class="cleanup" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_cleanup.visual_item" min_amount="20" max_amount="30" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.1" /> 
  </event>    
 	<event>
		<trigger class="cleanup" />
    <result class="spawn" instance_class="projectile" instance_key="debri_stun" min_amount="1" max_amount="1" offset="0 3.0 0" position_spread="0.0 0.0" direction_spread="0.0 0.0" />
  </event>  
  
  
</vehicle>
