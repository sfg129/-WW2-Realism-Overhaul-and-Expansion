<?xml version="1.0" encoding="utf-8"?>
<vehicle file="vehicle_base.vehicle" name="Tiger II" key="king_tiger.vehicle" time_to_live_unsteerable="60" respawn_time="360" map_view_atlas_index="61" minimum_fill_requirement="0.51" max_character_collision_speed="-1" max_character_collision_speed_on_normal="3.5" character_leave_request_mode="friendly" usable_for_cover="0" allow_owner_to_use_only="1" existence="one_per_spawn_point" owner="faction">
	<tag name="metal_heavy" />
	<tag name="crushes_hedgerows" />
   	<tag name="heavy_armour" />
	<tag name="tank_treads" />
  	<tag name="king_tiger" />
   	<tag name="cannot_steal" />	<!-- cannot be stolen, handled with allow_owner_to_use_only, existence=one_per_spawn_point and owner=faction above -->
    
    <access_tag name="edelweiss" />    
   
	<tire_set offset="1.8 0.0 +3.0" radius="0.52" />
	<tire_set offset="1.8 0.0 -3.0" radius="0.52" />

	<control max_limiter_speed="3.0" max_speed="6.5" acceleration="7.5" max_reverse_speed="6.5" min_health_to_steer="1.5" max_rotation="0.0" max_water_depth="1.7" steer_smoothening="0.99" tracked="1" gears="1" simulated_speed_factor="0.5" />

	<modifier class="blast_range" value="1.0" /> <!-- radius raised to help with issues from AT Rifle Grenades - but not dramatically make other AT weapons overpowered -->
	<!-- radius has to be higher on really big tanks, such as this, and 1.0 seems to work instead of 0.5 -->
	<modifier class="blast_damage" value="-6.4" />

	<!-- the King Tiger is invulnerable to many weapons, up to and including Light Tanks who only have 37mm guns. -->

	<physics 
    max_health="54" 
    blast_damage_threshold="3.91" 
    mass="1000.0" 
    broken_mass="20"  
    remove_collision_threshold="0.2"  
    extent="5 0.0 6.8" 
    offset="0 0.0 0" 
    top_offset="0 3.0 0" 
    collision_model_pos="0 1.2 -0.3" 
    collision_model_extent="5.3 3.0 8.9" 
    visual_offset="0 0.28 0.0" /> 

	<!-- one weapon per turret so that only one soldier controls the turret orientation -->
	<!-- similarly, a controllable turret can only exist if it has a weapon -->
	<!-- turrets may have sub-turrets, which may have more weapons, in the future -->
	<turret offset="0 2.43 -0.25" weapon_key="king_tiger_cannon.weapon" weapon_offset="-0.08 0.68 2.93" weapon_recoil="0.2" max_rotation_step="0.000015" />
	<turret offset="-0.81 2.04 3.2" weapon_key="king_tiger_hull_mg.weapon" weapon_offset="0.0 +0.2 0.6" weapon_recoil="0.0" physics_recoil="0.0" max_rotation_step="0.0003" rotation_range="0.5" />
	<turret offset="0.60 1.48 -0.27" weapon_key="king_tiger_cupola_mg.weapon" weapon_offset="0.0 +0.32 0.75" weapon_recoil="0.02" physics_recoil="0.0" max_rotation_step="0.0002" parent_turret_index="0" />
	<turret offset="0 2.43 -0.25" weapon_key="king_tiger_hull_mg.weapon" weapon_offset="-0.45 0.55 1.6" weapon_recoil="0.0" max_rotation_step="0.000015" />
		<!-- 观察望远镜 (index 4) -->
	<turret offset="1.8 0.7 0" weapon_key="binoculars.weapon" weapon_recoil="0.0" physics_recoil="0.0" rotation_range="0" />


	<visual class="chassis" mesh_filename="king_tiger_chassis.mesh" texture_filename="king_tiger.png" max_tilt="0.02" />
	<visual class="chassis" key="broken" mesh_filename="king_tiger_chassis_damage.mesh" texture_filename="king_tiger_damage.png" />
	<visual class="turret" turret_index="0" key="broken" mesh_filename="king_tiger_turret_damage.mesh" texture_filename="king_tiger_damage.png" />
	<visual class="turret" turret_index="2" key="broken" mesh_filename="king_tiger_cupola_damage.mesh" texture_filename="king_tiger_damage.png" />
	<visual class="turret" turret_index="0" mesh_filename="king_tiger_turret.mesh" texture_filename="king_tiger.png" />
	<visual class="turret" turret_index="1" mesh_filename="king_tiger_hull_mg.mesh" texture_filename="king_tiger.png" />
	<visual class="turret" turret_index="2" mesh_filename="king_tiger_cupola.mesh" texture_filename="king_tiger.png" />
	<visual class="turret" turret_index="3" mesh_filename="" texture_filename="" />

	<visual class="track" mesh_filename="king_tiger_track_right.mesh" offset="-1.88 0.0 0.0" >
		<part texture_filename="king_tiger_wheel.png" texture_animation="rotate" tire_binding="0" />
		<part texture_filename="king_tiger.png" />
		<part texture_filename="king_tiger_track.png" texture_animation="translate" factor="0.7" tire_binding="0" />
	</visual>

	<visual class="track" mesh_filename="king_tiger_track_left.mesh" offset="+1.88 0.0 0.0" >
		<part texture_filename="king_tiger_wheel.png" texture_animation="rotate" tire_binding="1" />
		<part texture_filename="king_tiger.png" />
		<part texture_filename="king_tiger_track.png" texture_animation="translate" factor="0.7" tire_binding="1" />
	</visual>

	<!-- just so you don't forget - XYZ is Leftright,Updown,Forwardback (left is a positive value) -->

	<character_slot type="driver" position="1.8 0.64369 1.48538" rotation="0" exit_rotation="1.45862" hiding="1" animation_id="36" />
	<character_slot type="gunner" position="-1.8 0.7 -0.57413" rotation="0" exit_rotation="-1.75877" hiding="1" animation_id="37">
		<turret index="0" /> <turret index="3" />
	</character_slot>

	<character_slot type="gunner" position="-1.5 0.7 2.44755" rotation="0" exit_rotation="-1.57" hiding="1" animation_key="tank mg still">
		<turret index="1" />
	</character_slot>
	<character_slot type="gunner" attached_on_turret="2"  enter_position="0 0.7 -4.5" seat_position="0.0 -1.3 0.0" rotation="0" exit_rotation="1.57" hiding="0" animation_key="tank mg still">
		<turret index="2" />
	</character_slot>
			<character_slot type="gunner" position="1.8 0.7 -0.86187" rotation="0" exit_rotation="1.57" hiding="1" animation_key="tank mg still">
			<turret index="4" />
		</character_slot>

	<!-- sound handling -->
	<!--<rev_sound filename="mus_battle_bastogne_boss.wav" low_pitch="1.0" high_pitch="1.0" low_rev="0.0" high_rev="1.0" volume="1.0" />-->

	<rev_sound filename="tank_rev_heavy_idle_king_tiger.wav" low_pitch="0.8" high_pitch="1.05" low_rev="0.0" high_rev="1.0" volume="1.8" />	<!-- vol 2.3 -->
	<rev_sound filename="tank_rev_tiger_low_speed6.wav" low_pitch="0.8" high_pitch="1.05" low_rev="0.01" high_rev="0.95" volume="2.4" />	<!-- vol 1.7 -->
	<rev_sound filename="tank_rev_heavy_low_speed2.wav" low_pitch="0.75" high_pitch="1.05" low_rev="0.15" high_rev="1.0" volume="3.3" />	<!-- vol 3.9 low_rev 0.55 low_pitch 0.75 -->

	<sound key="horn" filename="rev_horn_9.wav" volume="3.7"/>  
	<sound key="squeal" filename="tire_squeal.wav" />
	<sound key="ignition" filename="jeep2_ignition.wav" />
	<sound key="hit" filename="car_hit1.wav" />
	<sound key="hit" filename="car_hit2.wav" />
	<sound key="destroy" filename="vehicle_explosion_1.wav" />   
	<sound key="cleanup" filename="vehicle_explosion_1.wav" />    

	<sound key="turret_rotation" filename="turret_rotation1.wav" volume="3.0" />
	<sound key="turret_rotation" filename="turret_rotation2.wav" volume="0.8"/>
  
	<effect event_key="drive" type="splat_map" surface_tag="dirt" size="1.0" atlas_index="2" layer="1" />
	<effect event_key="drive" type="particle" key="terrain" surface_tag="dirt" ref="Burst" use_surface_color="1" />
  


	<effect event_key="health" value="10.0" ref="SmallSmokeVehicle" offset="0 2.4 -3.3" />
	
	<effect event_key="health" value="1.5" ref="SmallSmokeVehicle" offset="0 2.4 -3.3" />
	<effect event_key="health" value="1.5" ref="BrokenSparkle" offset="0 2.4 -3.3" />

  <effect event_key="destroyed" ref="SmallSmokeVehicle" offset="0.0 2.4 -3.1" />
  <effect event_key="destroyed" ref="SmallSmokeVehicle" offset="-0.8 2.5 -3.1" />  
  <effect event_key="destroyed" ref="MediumSmokeVehicle" offset="0.0 3.2 0.5" />  
  <effect event_key="destroyed" ref="MediumSmokeVehicle" offset="-0.6 3.0 -0.2" />    
  <effect event_key="destroyed" ref="SmallFireRepeat" offset="0.0 2.4 -3.2" />
        <effect event_key="destroy" key="other" ref="woosh" post_processing="0" shadow="0" />   
        <effect event_key="cleanup" key="other" ref="woosh" post_processing="0" shadow="0" />  
   

	<event key="receive_damage_xp_reward">
		<trigger class="receive_damage" />
		<result class="reward" xp="0.030" />
	</event>
	<event key="destroy_xp_reward">
		<trigger class="destroy" />
		<result class="reward" xp="0.0500" />
	</event>
	<event key="spot_rp_reward">
		<trigger class="spot" />
		<result class="reward" rp="100.0" />
	</event>
	<event key="destroy_rp_reward">
		<trigger class="destroy" />
		<result class="reward" rp="200.0" />
	</event>

    
	<event>
		<trigger class="destroy" />
  	<result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor1.visual_item" min_amount="1" max_amount="3" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.15 0.3" />
	</event>
	<event>
		<trigger class="destroy" />  	
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor2.visual_item" min_amount="0" max_amount="1" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.10 0.15" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor3.visual_item" min_amount="1" max_amount="2" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.12 0.20" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor4.visual_item" min_amount="1" max_amount="2" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.25" />
	</event>    

  <event>
		<trigger class="cleanup" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_cleanup.visual_item" min_amount="20" max_amount="30" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.1" /> 
  </event>  
  
 	<event>
		<trigger class="cleanup" />
    <result class="spawn" instance_class="projectile" instance_key="debri_stun" min_amount="1" max_amount="1" offset="0 3.0 0" position_spread="0.0 0.0" direction_spread="0.0 0.0" />
  </event>     
  
</vehicle>