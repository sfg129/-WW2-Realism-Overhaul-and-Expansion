<?xml version="1.0" encoding="utf-8"?>
<vehicle file="vehicle_base.vehicle" name="Churchill Mk VII" key="churchill_mkvii.vehicle" respawn_time="100" time_to_live_unsteerable="60" map_view_atlas_index="73" minimum_fill_requirement="0.51" max_character_collision_speed="-1" max_character_collision_speed_on_normal="4.5" character_leave_request_mode="friendly" allow_owner_to_use_only="1" existence="one_per_spawn_point" owner="faction">
	<tag name="metal_heavy" />
	<tag name="tank" />
   	<tag name="vehicle" />
	<tag name="churchill" />
	<tag name="tank_treads" />
   	<tag name="medium_armour" />
	<tag name="crushes_hedgerows" />
   	<tag name="cannot_steal" />	<!-- cannot be stolen, handled with allow_owner_to_use_only, existence=one_per_spawn_point and owner=faction above -->
    
	<tire_set offset="1.6 0.0 +3.0" radius="0.52" />
	<tire_set offset="1.6 0.0 0" radius="0.52" />    
	<tire_set offset="1.6 0.0 -3.0" radius="0.52" />

	<control max_limiter_speed="3.0" max_speed="6.5" acceleration="10.0" max_reverse_speed="5.5" min_health_to_steer="1.2" max_rotation="1" max_water_depth="1.7" steer_smoothening="0.99" tracked="1" gears="1" simulated_speed_factor="0.5"/>

	<!-- max speed was 6.75, accel 10, reverse 6.75 -->
	<modifier class="blast_range" value="0.65" /> <!-- radius raised to help with issues from AT Rifle Grenades - but not dramatically make other AT weapons overpowered -->
	<modifier class="blast_damage" value="-5.4" />

	<!-- Medium Tanks are immune to Flamethrowers. -->

	<physics max_health="54" 
    blast_damage_threshold="1.02" 
    mass="300.0" 
    broken_mass="15"  
    remove_collision_threshold="0.2"  
    extent="4.2 0.0 7.6" 
    offset="0 0.0 0" 
    top_offset="0 2.0 0" 
    collision_model_pos="0 1.1 -0.35" 
    collision_model_extent="4.2 2.4 8.3" 
    visual_offset="0 0.43 0.0" /> 
	<!-- visual offset was 0 0.28 0.0 but the treads slipped the ground -->

	<!-- one weapon per turret so that only one soldier controls the turret orientation -->
	<!-- similarly, a controllable turret can only exist if it has a weapon -->
	<!-- turrets may have sub-turrets, which may have more weapons, in the future -->
	<turret offset="0 2.46 -0.11" weapon_key="churchill_75_cannon.weapon" weapon_offset="0.0 0.41 3.9" weapon_recoil="0.125" max_rotation_step="0.00005" />
	<turret offset="0.48 1.9 2.65" weapon_key="churchill_hull_mg.weapon" weapon_offset="0.0 +0.1 1.9" weapon_recoil="0.0" physics_recoil="0.0" max_rotation_step="0.0003" rotation_range="0.5" />
	<turret offset="0 2.46 -0.11" weapon_key="churchill_coax_mg.weapon" weapon_offset="0.20 0.52 1.45" max_rotation_step="0.00005" />
	<turret offset="0.48 1.9 2.65" weapon_key="churchill_hull_mg_muzzle.weapon" weapon_offset="0.0 +0.1 0.0" weapon_recoil="0.0" physics_recoil="0.0" max_rotation_step="0.0003" rotation_range="0.5" />

	<turret offset="0 2.46 -0.11" weapon_key="binoculars.weapon" weapon_recoil="0.0" physics_recoil="0.0" rotation_range="0" />

	<visual class="chassis" mesh_filename="churchill_mkvii_chassis.mesh" texture_filename="churchill_mkvii.png" max_tilt="0.02" />
	<visual class="chassis" key="broken" mesh_filename="churchill_mkvii_chassis_damage.mesh" texture_filename="churchill_mkvii_damage.png" />
	<visual class="turret" turret_index="0" mesh_filename="churchill_mkvii_turret.mesh" texture_filename="churchill_mkvii.png" />	
	<visual class="turret" turret_index="0" key="broken" mesh_filename="churchill_mkvii_turret_damage.mesh" texture_filename="churchill_mkvii_damage.png" />  
	<visual class="turret" turret_index="1" mesh_filename="churchill_mkvii_hull_mg.mesh" texture_filename="churchill_mkvii.png" />

	<visual class="track" mesh_filename="churchill_mkvii_track.mesh" offset="-1.46 0.0 0.0" >
		<part texture_filename="churchill_mkvii_wheel.png" texture_animation="rotate" tire_binding="0" />
		<part texture_filename="churchill_mkvii_track.png" texture_animation="translate" factor="0.7" tire_binding="0" />
	</visual>

	<visual class="track" mesh_filename="churchill_mkvii_track.mesh" offset="+1.46 0.0 0.0" >
		<part texture_filename="churchill_mkvii_wheel.png" texture_animation="rotate" tire_binding="1" />
		<part texture_filename="churchill_mkvii_track.png" texture_animation="translate" factor="0.7" tire_binding="1" />
	</visual>

	<!-- just so you don't forget - XYZ is Leftright,Updown,Forwardback (left is a positive value) -->

	<character_slot type="driver" position="0.95 0.7 0.6" rotation="0.0" exit_rotation="1.57" hiding="1" animation_id="36" />
	<character_slot type="gunner" position="-0.95 0.7 1.4" rotation="0.0" exit_rotation="-1.57" hiding="1" animation_id="36">
		<turret index="0" /> <turret index="2" />
	</character_slot>	
	<character_slot type="gunner" position="0.0 0.7 4.0" rotation="0.0" exit_rotation="0.0" hiding="1" animation_id="36">
		<turret index="1" /> <turret index="3" /> <!-- Turret index 3 is the 'Hull MG' muzzle effect within the collision box -->
	</character_slot>
	<character_slot type="gunner" hiding="1" >
		<state class="entering" position="-0.95 0.7 0" rotation="0.0" />
		<state class="leaving" position="-0.95 0.7 0" rotation="-1.57" />
		<state class="idle" animation_key="sitting, idling" rotation="0.0" position="0 0.7 0.2" />
		<turret index="4" />
	</character_slot>	
	<character_slot type="passenger" hiding="1" allow_weapon="0">
		<state class="entering" position="0.95 0.7 -0.4" rotation="0.0" />
		<state class="leaving" position="0.95 0.7 -0.4" rotation="1.57" />
		<state class="idle" animation_key="sitting, idling" rotation="0.0" position="0.95 0.7 -0.4" />
	</character_slot>


	<!-- sound handling -->
	<rev_sound filename="tank_rev_sherman_idle6.wav" low_pitch="0.8" high_pitch="1.05" low_rev="0.0" high_rev="1.0" volume="1.9" />		<!-- vol 2.0 -->
	<rev_sound filename="tank_rev_sherman_low_speed1.wav" low_pitch="0.8" high_pitch="1.05" low_rev="0.01" high_rev="1.0" volume="2.7" />	<!-- vol 3.7 -->
	<rev_sound filename="tank_rev_sherman_high_speed2.wav" low_pitch="0.8" high_pitch="1.05" low_rev="0.67" high_rev="1.0" volume="2.0" />	<!-- vol 3.0 -->

	<sound key="horn" filename="rev_horn_9.wav" volume="3.7"/>  
	<sound key="squeal" filename="tire_squeal.wav" />
	<sound key="ignition" filename="jeep2_ignition.wav" />
	<sound key="hit" filename="car_hit1.wav" />
	<sound key="hit" filename="car_hit2.wav" />
	<sound key="destroy" filename="vehicle_explosion_1.wav" />   
	<sound key="cleanup" filename="vehicle_explosion_1.wav" />    

	<sound key="turret_rotation" filename="turret_rotation1.wav" volume="2.5" />
	<sound key="turret_rotation" filename="turret_rotation2.wav" volume="0.8"/>
  
	<effect event_key="drive" type="splat_map" surface_tag="dirt" size="1.0" atlas_index="2" layer="1" />
	<effect event_key="drive" type="particle" key="terrain" surface_tag="dirt" ref="Burst" use_surface_color="1" />
  
  <effect event_key="health" value="4.375" ref="SmallSmokeVehicle" offset="0.0 2.4 -2.0" />  

  <effect event_key="health" value="0.875" ref="SmallSmokeVehicle" offset="0.0 2.4 -2.0" />
  <effect event_key="health" value="0.875" ref="BrokenSparkle" post_processing="0" offset="0.0 2.2 -2.0" />  

  <effect event_key="destroyed" ref="SmallSmokeVehicle" offset="0.0 2.2 -2" />
  <effect event_key="destroyed" ref="SmallSmokeVehicle" offset="-0.8 2.5 -2.1" />  
  <effect event_key="destroyed" ref="MediumSmokeVehicle" offset="0.0 3.2 0.5" />  
  <effect event_key="destroyed" ref="MediumSmokeVehicle" offset="-0.6 3.0 -0.2" />    
  <effect event_key="destroyed" ref="SmallFireRepeat" offset="0.0 2.3 -2" />
        <effect event_key="destroy" key="other" ref="woosh" post_processing="0" shadow="0" />   
        <effect event_key="cleanup" key="other" ref="woosh" post_processing="0" shadow="0" />  
   

	<event key="receive_damage_xp_reward">
		<trigger class="receive_damage" />
		<result class="reward" xp="0.0150" />
	</event>
	<event key="spot_rp_reward">
		<trigger class="spot" />
		<result class="reward" rp="50.0" />
	</event>
	<event key="destroy_rp_reward">
		<trigger class="destroy" />
		<result class="reward" rp="75.0" />
	</event>

    
	<event>
		<trigger class="destroy" />
  	<result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor1.visual_item" min_amount="1" max_amount="3" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.15 0.3" />
	</event>
	<event>
		<trigger class="destroy" />  	
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor2.visual_item" min_amount="0" max_amount="1" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.10 0.15" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor3.visual_item" min_amount="1" max_amount="2" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.12 0.20" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor4.visual_item" min_amount="1" max_amount="2" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.25" />
	</event>    

  <event>
		<trigger class="cleanup" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_cleanup.visual_item" min_amount="20" max_amount="30" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.1" /> 
  </event>  
  
 	<event>
		<trigger class="cleanup" />
    <result class="spawn" instance_class="projectile" instance_key="debri_stun" min_amount="1" max_amount="1" offset="0 3.0 0" position_spread="0.0 0.0" direction_spread="0.0 0.0" />
  </event>     
  
</vehicle>