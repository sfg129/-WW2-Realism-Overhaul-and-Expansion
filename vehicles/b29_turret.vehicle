<vehicle name="B29 Turret" key="b29_turret.vehicle" respawn_time="60" map_view_atlas_index="-1" protectors="1" soldier_capacity_offset="1" usable_for_cover="0" >
	<tag name="target" />
   	<tag name="defensive_weapon" />

	<tire_set offset="0.75 0.0 0.75" radius="0.65" />
	<tire_set offset="0.75 0.0 -0.75" radius="0.65" />
	
	<modifier class="blast_range" value="-3.0" />
	<modifier class="blast_damage" value="-0.7" />
	
	<control max_speed="3.0" acceleration="1.0" max_reverse_speed="1.0" max_rotation="0.8" max_water_depth="1.0" />
	
	<physics max_health="8.0" mass="10000.0" extent="0.8 0 0.8" offset="0 0 0" top_offset="0 1 0" collision_model_pos="0 0 0" collision_model_extent="1.2 0.5 1.2" visual_offset="0 0 0" collision_response_factor="0.0" /> 
	
	<turret offset="0.0 0.3 0.0" weapon_key="b29_turret.weapon" weapon_offset="+0.2 -0.3 0.4" weapon_recoil="0.0" physics_recoil="0.0"  max_rotation_step="0.00015" rotation="0" rotation_range="6.28" />
	<turret offset="0.0 0.3 0.0" weapon_key="b29_turret2.weapon" weapon_offset="-0.2 -0.3 0.4" weapon_recoil="0.0" physics_recoil="0.0"  max_rotation_step="0.00015" rotation="0" rotation_range="6.28" />
	<turret offset="0.0 0.3 0.0" weapon_key="b29_blank.weapon" weapon_offset="0 0 0.0" weapon_recoil="0.0" physics_recoil="0.0" max_rotation_step="0.00015" rotation="0" rotation_range="6.28"/>

	
	<visual class="chassis" mesh_filename="" texture_filename="" />
	<visual class="chassis" key="broken" mesh_filename="" texture_filename="" />
	<visual class="turret" 	turret_index="2" key="broken" mesh_filename="" texture_filename="" />
	<visual class="turret" turret_index="2" mesh_filename="b29_turret.mesh" texture_filename="b29.png" />  
	
	<character_slot type="gunner" attached_on_turret="0" seat_position="0.0 0.0 0.0" enter_position="0 0 1.3" rotation="0" exit_rotation="-1.57" hiding="1" animation_key="tank mg still">
		<state class="entering" animation_key="crouching forwards short, no weapon" position="0.0 0 1.3" rotation="0" />
		<state class="leaving" animation_key="crouching forwards short, no weapon" position="0.0 0 1.3" rotation="-1.57" />
		<turret index="0" />		<turret index="1" />		<turret index="2" />
	</character_slot>
	
	<!-- sound handling -->
	<rev_sound filename="truck_rev0.wav" low_pitch="0.95" high_pitch="1.05" low_rev="0.0" high_rev="0.2" volume="1.0" />
	<rev_sound filename="truck_rev3.wav" low_pitch="0.7" high_pitch="1.0" low_rev="0.05" high_rev="0.7" volume="1.0" />
	<rev_sound filename="truck_rev4.wav" low_pitch="0.8" high_pitch="1.0" low_rev="0.4" high_rev="1.0" volume="1.0" />
	
	<sound key="slide" filename="slide_noise.wav" />
	<sound key="squeal" filename="tire_squeal.wav" />
	<sound key="ignition" filename="truck_ignition.wav" />
	<sound key="hit" filename="car_hit1.wav" />
	<sound key="hit" filename="car_hit2.wav" />
	<sound key="hit" filename="car_hit3.wav" />
	
	<effect event_key="destroyed" ref="SmallSmokeVehicle" offset="0.0 0.8 0.0" />  
	
	<event key="receive_damage_xp_reward">
		<trigger class="receive_damage" />
		<result class="reward" xp="0.0090" />
	</event>
	
	<event key="spot_rp_reward">
		<trigger class="spot" />
		<result class="reward" rp="10.0" />
	</event>
	
	<event>
		<trigger class="destroy" />		
		<result class="spawn" instance_class="visual_item" instance_key="burning_piece_radartower.visual_item" min_amount="3" max_amount="3" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.05 0.2" /> 
	</event>
	
	<event>
		<trigger class="destroy" />		
		<result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor1.visual_item" min_amount="2" max_amount="3" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.2" /> 
	</event>
	
	<event>
		<trigger class="destroy" />		
		<result class="spawn" instance_class="visual_item" instance_key="burning_piece_truck1.visual_item" min_amount="1" max_amount="2" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.2" /> 
	</event>
	
	<event>
		<trigger class="destroy" />		
		<result class="spawn" instance_class="visual_item" instance_key="burning_piece_jeep2.visual_item" min_amount="1" max_amount="1" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.05 0.2" /> 
	</event>
	 
</vehicle>