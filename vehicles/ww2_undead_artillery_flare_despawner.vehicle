<?xml version="1.0" encoding="utf-8"?>
<vehicle name="" key="ww2_undead_artillery_flare_despawner.vehicle" map_view_atlas_index="-1" time_to_live="0" allow_ai_to_use="0" should_be_destroyed="0" usable_for_cover="0" max_character_collision_speed="-1" max_character_collision_speed_on_normal="-1">
	<tire_set offset="0.1 0.0 0.1" radius="0.1" />
	<tire_set offset="0.1 0.0 -0.1" radius="0.1" />

	<control max_speed="20.0" acceleration="6.0" max_reverse_speed="5.0" max_rotation="0.8" max_water_depth="0.2" steer_smoothening="0.1" />

	<physics max_health="0.1" mass="70.0" extent="0.2 0.0 0.2" offset="0 0.0 0" top_offset="0 0.5 0" collision_model_pos="0 0.2 0" collision_model_extent="0.6 0.2 0.6" visual_offset="0 0.0 0" destroy_on_top_hit="0" /> 

	<modifier class="blast_range" value="15.0" /> <!-- hopefully reliably dies from its own artillery call -->
	<modifier class="blast_damage" value="15.0" /> <!-- hopefully reliably dies from its own artillery call -->

	<visual class="chassis" mesh_filename="flare_stick.mesh" texture_filename="flare_stick.png" />
<!--	<visual class="chassis" key="broken" mesh_filename="flare_stick.mesh" texture_filename="flare_stick.png" />  -->


	<!-- sound handling -->
	<rev_sound filename="truck_rev0.wav" low_pitch="0.95" high_pitch="1.05" low_rev="0.0" high_rev="0.2" volume="1.0" />
	<rev_sound filename="truck_rev1.wav" low_pitch="0.8" high_pitch="1.1" low_rev="0.05" high_rev="0.7" volume="0.75" />
	<rev_sound filename="truck_rev3.wav" low_pitch="0.8" high_pitch="1.1" low_rev="0.4" high_rev="1.0" volume="1.0" />


	<effect event_key="idle_chassis" ref="FlareSparkle" post_processing="0" offset="0 0.1 0.3"/>
	<effect event_key="idle_chassis" ref="FlareSmoke" post_processing="0" offset="0 0.4 0.3"/>
	<effect event_key="idle_chassis" ref="FlareFlash" post_processing="0" offset="0 0.1 0.3"/> 

	<effect event_key="destroy" key="other"  />


	<event>
		<trigger class="destroy" />
  		<result class="spawn" instance_class="vehicle" instance_key="ww2_undead_artillery_flare.vehicle" min_amount="1" max_amount="1" offset="0 0.5 0" position_spread="0 0" direction_spread="0 0" />
	</event>
	
	<event>
		<trigger class="destroy" />
  		<result class="spawn" instance_class="grenade" instance_key="ww2_undead_rocket_mortar_woosh.projectile" min_amount="1" max_amount="1" offset="0 25 0" position_spread="0 0" direction_spread="0 0" />
	</event>
	<event>
		<trigger class="destroy" />
  		<result class="spawn" instance_class="grenade" instance_key="ww2_undead_rocket_mortar.projectile" min_amount="1" max_amount="1" offset="0 65 0" position_spread="6 6" direction_spread="0 0" />
	</event>
	
	<event>
		<trigger class="destroy" />
  		<result class="spawn" instance_class="grenade" instance_key="ww2_undead_rocket_mortar_woosh.projectile" min_amount="1" max_amount="1" offset="0 50 0" position_spread="0 0" direction_spread="0 0" />
	</event>
	<event>
		<trigger class="destroy" />
  		<result class="spawn" instance_class="grenade" instance_key="ww2_undead_rocket_mortar.projectile" min_amount="1" max_amount="1" offset="0 95 0" position_spread="4 4" direction_spread="0 0" />
	</event>
	
	<event>
		<trigger class="destroy" />
  		<result class="spawn" instance_class="grenade" instance_key="ww2_undead_rocket_mortar_woosh.projectile" min_amount="1" max_amount="1" offset="0 75 0" position_spread="0 0" direction_spread="0 0" />
	</event>
	<event>
		<trigger class="destroy" />
  		<result class="spawn" instance_class="grenade" instance_key="ww2_undead_rocket_mortar.projectile" min_amount="1" max_amount="1" offset="0 125 0" position_spread="0 0" direction_spread="0 0" />
	</event>


</vehicle>
