<?xml version="1.0" encoding="utf-8"?>
<vehicle file="vehicle_base.vehicle" name="Panzer IV" time_to_live_unsteerable="60" map_view_atlas_index="30" minimum_fill_requirement="0.67" max_character_collision_speed_on_normal="5.0" character_leave_request_mode="friendly" allow_owner_to_use_only="0" existence="one_per_spawn_point" owner="faction">
	<tag name="metal_heavy" />
	<tag name="tank" />
   	<tag name="vehicle" />
	<tag name="tank_treads" />
    <tag name="medium_armour" />
	<tag name="crushes_hedgerows" />
   
    <access_tag name="edelweiss" />     

	<tire_set offset="1.6 0.0 +2.8" radius="0.52" />
	<tire_set offset="1.6 0.0 0" radius="0.52" />    
	<tire_set offset="1.6 0.0 -2.8" radius="0.52" />

	<control max_limiter_speed="4.0" max_speed="8.5" acceleration="10" max_reverse_speed="6.5" min_health_to_steer="3" max_rotation="1" max_water_depth="1.7" steer_smoothening="0.994" tracked="1" gears="1" simulated_speed_factor="0.4"/>

	<modifier class="blast_range" value="0.65" /> <!-- radius raised to help with issues from AT Rifle Grenades - but not dramatically make other AT weapons overpowered -->
	<modifier class="blast_damage" value="-4.2" />

	<!-- Medium Tanks are immune to Flamethrowers. -->

	<physics 
    max_health="30" 
    blast_damage_threshold="1.02" 
    mass="200.0" 
    broken_mass="10" 
    remove_collision_threshold="0.2" 
    extent="5.0 0.0 6.8" 
    offset="0 0.0 0" 
    top_offset="0 3.0 0" 
    collision_model_pos="0 1.0 0" 
    collision_model_extent="4.2 2.2 7.2" 
    visual_offset="0 0.31 0.0" /> 

	<!-- one weapon per turret so that only one soldier controls the turret orientation -->
	<!-- similarly, a controllable turret can only exist if it has a weapon -->
	<!-- turrets may have sub-turrets, which may have more weapons, in the future -->
	<turret offset="0.09 2.72 0.0" weapon_key="panzer_iv_cannon.weapon" weapon_offset="0.0 -0.18 2.45" weapon_recoil="0.2" max_rotation_step="0.0000419" />
	<turret offset="-0.73 1.76 2.3" weapon_key="panzer_iv_hull_mg.weapon" weapon_offset="0.0 +0.2 0.9" weapon_recoil="0.0" physics_recoil="0.0" max_rotation_step="0.0003" rotation_range="0.5" />
	<turret offset="0.09 2.72 0.0" weapon_key="king_tiger_hull_mg.weapon" weapon_offset="-0.50 -0.1 1.2" weapon_recoil="0.0" max_rotation_step="0.0000419" />

<turret offset="0.09 2.72 0.0" weapon_key="binoculars.weapon" weapon_recoil="0.0" physics_recoil="0.0" rotation_range="0" />

	<visual class="chassis" mesh_filename="panzer_iv_chassis.mesh" texture_filename="panzer_iv.png" max_tilt="0.02" />
	<visual class="chassis" key="broken" mesh_filename="panzer_iv_chassis_damage.mesh" texture_filename="panzer_iv_damage.png" />
	<visual class="turret" key="broken" mesh_filename="panzer_iv_turret_damage.mesh" texture_filename="panzer_iv_damage.png" />  
	<visual class="turret" turret_index="0" mesh_filename="panzer_iv_turret.mesh" texture_filename="panzer_iv.png" />
	<visual class="turret" turret_index="1" mesh_filename="panzer_iv_mg.mesh" texture_filename="panzer_iv.png" />
	<visual class="turret" turret_index="2" mesh_filename="" texture_filename="" />

	<visual class="track" mesh_filename="panzer_iv_track_1.mesh" offset="-1.52 0.0 0.0" >
		<part texture_filename="panzer_iv_road_wheel.png" texture_animation="rotate" tire_binding="0" />
		<part texture_filename="panzer_iv.png" />
		<part texture_filename="panzer_iv_track.png" texture_animation="translate" factor="0.65" tire_binding="0" />
	</visual>
	<visual class="track" mesh_filename="panzer_iv_track_2.mesh" offset="-1.52 0.0 0.0" >
		<part texture_filename="panzer_iv_drive_wheel.png" texture_animation="rotate" tire_binding="0" />
		<part texture_filename="panzer_iv.png" />
		<part texture_filename="panzer_iv_track.png" texture_animation="translate" factor="0.7" tire_binding="0" />
	</visual>
	<visual class="track" mesh_filename="panzer_iv_track_3.mesh" offset="-1.52 0.0 0.0" >
		<part texture_filename="panzer_iv_idler_wheel.png" texture_animation="rotate" tire_binding="0" />
		<part texture_filename="panzer_iv.png" />
		<part texture_filename="panzer_iv_track.png" texture_animation="translate" factor="0.7" tire_binding="0" />
	</visual>

	<visual class="track" mesh_filename="panzer_iv_track_1.mesh" offset="+1.52 0.0 0.0" >
		<part texture_filename="panzer_iv_road_wheel.png" texture_animation="rotate" tire_binding="1" />
		<part texture_filename="panzer_iv.png" />
		<part texture_filename="panzer_iv_track.png" texture_animation="translate" factor="0.65" tire_binding="1" />
	</visual>
	<visual class="track" mesh_filename="panzer_iv_track_2.mesh" offset="1.52 0.0 0.0" >
		<part texture_filename="panzer_iv_drive_wheel.png" texture_animation="rotate" tire_binding="1" />
		<part texture_filename="panzer_iv.png" />
		<part texture_filename="panzer_iv_track.png" texture_animation="translate" factor="0.7" tire_binding="1" />
	</visual>
	<visual class="track" mesh_filename="panzer_iv_track_3.mesh" offset="1.52 0.0 0.0" >
		<part texture_filename="panzer_iv_idler_wheel.png" texture_animation="rotate" tire_binding="1" />
		<part texture_filename="panzer_iv.png" />
		<part texture_filename="panzer_iv_track.png" texture_animation="translate" factor="0.7" tire_binding="1" />
	</visual>

	<!-- just so you don't forget - XYZ is Leftright,Updown,Forwardback (left is a positive value) -->

	<character_slot type="driver" position="1.5 0.7 1" rotation="0" exit_rotation="1.57" hiding="1" animation_id="36" />
	<character_slot type="gunner" position="-1.5 0.7 1" rotation="0" exit_rotation="-1.57" hiding="1" animation_id="37">
		<turret index="0" /> <turret index="2" />
	</character_slot>

	<character_slot type="gunner" position="-1.0 0.5 3.5" rotation="0" exit_rotation="-1.57" hiding="1" animation_key="tank mg still">
		<turret index="1"  />
	</character_slot>

	<character_slot type="gunner" hiding="1" allow_weapon="0">
		<state class="entering" position="1.5 0.7 0" rotation="0.0" />
		<state class="leaving" position="1.5 0.7 0" rotation="1.57" />
		<state class="idle" animation_key="sitting, idling" rotation="0.0" position="0 0.7 0.2" />
		<turret index="3" /> 
	</character_slot>


		<character_slot type="passenger" hiding="1">

		<state class="entering" position="-1.5 0.7 0" rotation="0.0" />
		<state class="leaving" position="-1.5 0.7 0" rotation="-1.57" />
		<state class="idle" animation_key="sitting, idling" rotation="0.0" position="-1.5 0.7 -0.4" />

		
	</character_slot>



	<!-- sound handling -->
	<rev_sound filename="tank_rev_panzer_idle3.wav" low_pitch="0.8" high_pitch="1.05" low_rev="0.0" high_rev="1.0" volume="1.6" />	<!-- was 1.8 -->
	<rev_sound filename="tank_rev_panzer_low_speed1.wav" low_pitch="0.8" high_pitch="1.05" low_rev="0.01" high_rev="0.9" volume="2.0" /> 	<!-- was 2.3 --> 
	<rev_sound filename="tank_rev_panzer_high_speed4.wav" low_pitch="0.75" high_pitch="0.975" low_rev="0.7" high_rev="1.0" volume="1.9" />	<!-- was 2.4 -->

	<sound key="horn" filename="rev_horn_9.wav" volume="3.7"/>   
	<sound key="squeal" filename="tire_squeal.wav" />
	<sound key="ignition" filename="jeep2_ignition.wav" />
	<sound key="hit" filename="car_hit1.wav" />
	<sound key="hit" filename="car_hit2.wav" />
	<sound key="destroy" filename="vehicle_explosion_1.wav" />   
	<sound key="cleanup" filename="vehicle_explosion_1.wav" />    

	<sound key="turret_rotation" filename="turret_rotation1.wav" volume="2.5" />
	<sound key="turret_rotation" filename="turret_rotation2.wav" volume="0.8"/>
  
	<effect event_key="drive" type="splat_map" surface_tag="dirt" size="1.0" atlas_index="2" layer="1" />
	<effect event_key="drive" type="particle" key="terrain" surface_tag="dirt" ref="Burst" use_surface_color="1" />
  
	<effect event_key="health" value="4.25" ref="SmallSmokeVehicle" offset="0.0 2.4 -2.0" />  

	<effect event_key="health" value="0.85" ref="SmallSmokeVehicle" offset="0.0 2.4 -2.0" />
	<effect event_key="health" value="0.85" ref="BrokenSparkle" post_processing="0" offset="0.0 2.2 -2.0" />    

  <effect event_key="destroyed" ref="SmallSmokeVehicle" offset="0.0 2.7 -1.9" />
  <effect event_key="destroyed" ref="SmallSmokeVehicle" offset="-0.8 2.0 -3.0" />  
  <effect event_key="destroyed" ref="MediumSmokeVehicle" offset="0.0 3.2 0.5" />  
  <effect event_key="destroyed" ref="MediumSmokeVehicle" offset="-0.6 3.0 -0.2" />    
  <effect event_key="destroyed" ref="SmallFireRepeat" offset="0.0 2.4 -1.9" />
        <effect event_key="destroy" key="other" ref="woosh" post_processing="0" shadow="0" />   
        <effect event_key="cleanup" key="other" ref="woosh" post_processing="0" shadow="0" />  
   

	<event key="receive_damage_xp_reward">
		<trigger class="receive_damage" />
		<result class="reward" xp="0.0150" />
	</event>
	<event key="spot_rp_reward">
		<trigger class="spot" />
		<result class="reward" rp="50.0" />
	</event>
	<event key="destroy_rp_reward">
		<trigger class="destroy" />
		<result class="reward" rp="75.0" />
	</event>

    
	<event>
		<trigger class="destroy" />
  	<result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor1.visual_item" min_amount="1" max_amount="3" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.15 0.3" />
	</event>
	<event>
		<trigger class="destroy" />  	
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor2.visual_item" min_amount="0" max_amount="1" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.10 0.15" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor3.visual_item" min_amount="1" max_amount="2" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.12 0.20" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor4.visual_item" min_amount="1" max_amount="2" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.25" />
	</event>    

  <event>
		<trigger class="cleanup" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_cleanup.visual_item" min_amount="20" max_amount="30" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.1" /> 
  </event>  
  
 	<event>
		<trigger class="cleanup" />
    <result class="spawn" instance_class="projectile" instance_key="debri_stun" min_amount="1" max_amount="1" offset="0 3.0 0" position_spread="0.0 0.0" direction_spread="0.0 0.0" />
  </event>     
  
</vehicle>