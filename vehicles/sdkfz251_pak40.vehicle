<vehicle file="vehicle_base.vehicle" name="Sd.Kfz.251/22" key="sdkfz251_pak40.vehicle" time_to_live_unsteerable="60" map_view_atlas_index="55" minimum_fill_requirement="0.2" ai_driver_turns_to_target="1" ai_use_throwables="0">
	<tag name="metal_heavy" />
	<tag name="tank_treads" />
   	<tag name="light_vehicle" />



	<tire_set offset="1.05 0.0 +2.4" radius="0.55" />
	<tire_set offset="1.05 0.0 -0.2" radius="0.55" />
	<tire_set offset="1.05 0.0 -2.8" radius="0.55" />

  <visual class="tire" index="0" mesh_filename="sdkfz251_wheel.mesh" texture_filename="sdkfz251.png" />
  <visual class="tire" index="1" mesh_filename="sdkfz251_wheel.mesh" texture_filename="sdkfz251.png" />
  <visual class="tire" index="2" />
  <visual class="tire" index="3" />
  <visual class="tire" index="4" />
  <visual class="tire" index="5" />

	<modifier class="blast_range" value="0.5" /> <!-- radius raised to help with issues from AT Rifle Grenades - but not dramatically make other AT weapons overpowered -->
	<modifier class="blast_damage" value="-1.2" />

	<control 
	max_limiter_speed="4.0" 
	max_speed="7" 
	acceleration="12.0" 
	max_reverse_speed="5.0" 
	min_health_to_steer="0.5" 
	max_rotation="0.0" 
	max_water_depth="1.6" 
	steer_smoothening="0.98" 
	tracked="1" 
	gears="1" 
	tracked_visual_tire_max_rotation="0.5"
	tracked_visual_tire_rotation_smoothening="10.0"
	simulated_speed_factor="0.75"/>

	<physics 
    max_health="16" 
    mass="50.0"
    broken_mass="5" 
    remove_collision_threshold="0.2"    
    extent="3.0 0.0 7.2" 
    offset="0 0.0 -0.25" 
    top_offset="0 3.0 0" 
    collision_model_pos="0.0 1.0 -0.5" 
    collision_model_extent="3.3 2.5 7.75" 
    visual_offset="0 0.4 0.0" 
    friction_offset="0.15" />


<!-- using ai_driver_turns_to_target="1" - the driver always follows the target of the 1st gunner seat. So in the case of the Ho-Ha we must ensure that the centre gun is 1st gunner / turret.-->
<!-- for cases like tanks, we need to ensure their cannons are 1st gunner / turret -->
<!-- for Sdkfz 251, it's irrelevant as it only has 1 gun. -->

	<!-- one weapon per turret so that only one soldier controls the turret orientation -->
	<!-- similarly, a controllable turret can only exist if it has a weapon -->
	<!-- turrets may have sub-turrets, which may have more weapons, in the future -->


<!--  AT炮塔 (index 0) -->
	<turret offset="0 1.6 -0.8" weapon_key="at_gun_pak40_2.weapon" weapon_offset="0.0 1 0.0" weapon_recoil="0.3" max_rotation_step="0.0002" rotation="0" rotation_range="0.4" />
<!--  后机枪 (index 1) -->
<turret offset="0.1 2.4 -4" weapon_key="sdkfz251_mg.weapon" weapon_offset="0.0 0.4 0.0" weapon_recoil="0.02" max_rotation_step="0.0005" rotation="3" rotation_range="2" />
<turret offset="-0.7 0 -0.125" weapon_key="binoculars.weapon" weapon_recoil="0.0" physics_recoil="0.0" rotation_range="0" />
									



	<visual class="chassis" mesh_filename="sdkfz251_chassis.mesh" texture_filename="sdkfz251.png" max_tilt="0.02" />
	<visual class="chassis" key="broken" mesh_filename="sdkfz251_chassis_damage.mesh" texture_filename="sdkfz251_damage.png" />

<visual class="track" mesh_filename="sdkfz_mg_base.mesh" offset="0.1 2.4 -4" >
	<part texture_filename="sdkfz251.png" />
	</visual>

<visual class="turret" turret_index="0" mesh_filename="pak_40_s.mesh" texture_filename="pak_40.png" />

	<visual class="track" mesh_filename="sdkfz251_track.mesh" offset="-1.1 0.0 0.0" >
		<part texture_filename="sdkfz251_wheel.png" texture_animation="rotate" tire_binding="0" />
		<part texture_filename="sdkfz251.png" />
		<part texture_filename="sdkfz251_track.png" texture_animation="translate" factor="1.0" tire_binding="0" />
	</visual>


	<visual class="track" mesh_filename="sdkfz251_track.mesh" offset="+1.1 0.0 0.0" >
		<part texture_filename="sdkfz251_wheel.png" texture_animation="rotate" tire_binding="1" />
		<part texture_filename="sdkfz251.png" />
		<part texture_filename="sdkfz251_track.png" texture_animation="translate" factor="1.0" tire_binding="1" />
	</visual>

	<!-- just so you don't forget - XYZ is Leftright,Updown,Forwardback (left is a positive value) -->

	<!-- 驾驶员 -->
	<character_slot type="driver" enter_position="1.6 0.5 0" seat_position="0.45 0.2 -0.125" rotation="0" exit_rotation="1.57" hiding="0" animation_id="36" />

	<!-- AT炮手 (index 0) -->
<character_slot type="gunner" hiding="0">
            <state class="entering" position="1.6 0.5 -2" rotation="0.0" />
            <state class="leaving" position="1.6 0.5 -2" rotation="1.57" />
            <state class="idle" animation_key="crouch still, no weapon, 62" rotation="0" position="0.4 1.2 -2" />
            <turret index="0" />
        </character_slot>

	<character_slot type="gunner" hiding="0" attached_on_turret="1">
		<state class="entering" position="1.0 0.5 -4" rotation="0.0" />
		<state class="leaving" position="1.0 0.5 -4" rotation="3.14" />
		<state class="idle" animation_key="tank mg still" rotation="3" position="-0.1 -1.33 -0.8" />
		<turret index="1" />
	</character_slot>


	<character_slot type="gunner" hiding="0" allow_weapon="0">
			<state class="entering" position="-1.0 0.5 -3.7" rotation="0.0" />
            <state class="leaving" position="-1.0 0.5 -3.7" rotation="-1.57" />
            <state class="idle" animation_key="hold, coastal gun" rotation="0" position="-0.70 1.07 -2.4" />
			<turret index="2" />
		</character_slot>

<character_slot type="passenger" hiding="0">
            <state class="entering" position="-1.6 0.5 -2" rotation="0.0" />
            <state class="leaving" position="-1.6 0.5 -2" rotation="-1.57" />
            <state class="idle" animation_key="crouch still, no weapon, 62" rotation="0" position="-0.4 1.2 -2" />
        </character_slot>
	
	<character_slot type="passenger" hiding="0" allow_weapon="0">
		<state class="entering" position="-1.6 0.5 0.0" rotation="0.0" />
		<state class="leaving" position="-1.6 0.5 0.0" rotation="-1.57" />
		<state class="idle" animation_key="sitting, idling" rotation="0" position="-0.45 0.2 -0.125" />
</character_slot>




	

	<!-- sound handling -->
	<rev_sound filename="tank_rev_halftrack_idle3.wav" low_pitch="0.8" high_pitch="1.05" low_rev="0.0" high_rev="1.0" volume="1.5" />		<!-- vol 1.5 -->
	<rev_sound filename="tank_rev_halftrack_low_speed5.wav" low_pitch="0.75" high_pitch="1.0" low_rev="0.01" high_rev="0.75" volume="1.5" />	<!-- vol 1.8 -->
	<rev_sound filename="tank_rev_halftrack_high_speed5.wav" low_pitch="0.65" high_pitch="1.0" low_rev="0.55" high_rev="1.0" volume="1.6" />	<!-- vol 1.9 -->

	<sound key="horn" filename="rev_horn_9.wav" volume="2.0"/>  
	<sound key="squeal" filename="tire_squeal.wav" />
	<sound key="ignition" filename="jeep2_ignition.wav" />
	<sound key="hit" filename="car_hit1.wav" />
	<sound key="hit" filename="car_hit2.wav" />
	<sound key="destroy" filename="vehicle_explosion_1.wav" />   
	<sound key="cleanup" filename="vehicle_explosion_1.wav" />    

	<!--<sound key="turret_rotation" filename="turret_rotation1.wav" volume="0.8" />-->
  
	<effect event_key="drive" type="splat_map" surface_tag="dirt" size="1.0" atlas_index="2" layer="1" />
	<effect event_key="drive" type="particle" key="terrain" surface_tag="dirt" ref="Burst" use_surface_color="1" />

  <effect event_key="health" value="2.5" ref="SmallSmokeVehicle" offset="0.4 1.8 2.7" />  
  
  <effect event_key="health" value="0.5" ref="SmallSmokeVehicle" offset="0.4 1.8 2.7" />  
  <effect event_key="health" value="0.5" ref="BrokenSparkle" post_processing="0" offset="0.4 1.6 2.7" />      
  
  <effect event_key="destroyed" ref="SmallSmokeVehicle" offset="0.0 1.7 2.9" />
  <effect event_key="destroyed" ref="SmallSmokeVehicle" offset="0.4 1.8 2.7" />  
  <effect event_key="destroyed" ref="MediumSmokeVehicle" offset="0.0 1.8 0.5" />  
  <effect event_key="destroyed" ref="MediumSmokeVehicle" offset="-0.6 1.6 -0.2" />    
  <effect event_key="destroyed" ref="SmallFireRepeat" offset="0.3 1.5 2.8" />
        <effect event_key="destroy" key="other" ref="woosh" post_processing="0" shadow="0" />   
        <effect event_key="cleanup" key="other" ref="woosh" post_processing="0" shadow="0" />  
   

	<event key="receive_damage_xp_reward">
		<trigger class="receive_damage" />
		<result class="reward" xp="0.0100" />
	</event>

	<event key="spot_rp_reward">
		<trigger class="spot" />
		<result class="reward" rp="50.0" />
	</event>

	<event key="destroy_rp_reward">
		<trigger class="destroy" />
		<result class="reward" rp="50.0" />
	</event>
    
	<event>
		<trigger class="destroy" />
  	<result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor1.visual_item" min_amount="1" max_amount="3" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.15 0.3" />
	</event>
	<event>
		<trigger class="destroy" />  	
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor2.visual_item" min_amount="0" max_amount="1" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.10 0.15" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor3.visual_item" min_amount="1" max_amount="2" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.12 0.20" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_armor4.visual_item" min_amount="1" max_amount="2" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.25" />
	</event>    

  <event>
		<trigger class="cleanup" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_cleanup.visual_item" min_amount="20" max_amount="30" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.1" /> 
  </event>  
  
 	<event>
		<trigger class="cleanup" />
    <result class="spawn" instance_class="projectile" instance_key="debri_stun" min_amount="1" max_amount="1" offset="0 3.0 0" position_spread="0.0 0.0" direction_spread="0.0 0.0" />
  </event>     
  
</vehicle>