<?xml version="1.0" encoding="utf-8"?>
<vehicle name="" key="dumpster.vehicle" map_view_atlas_index="-1" respawn_time="300.0">
  <tag name="metal_dumpster" />
	<tire_set offset="1.0 0.0 1.0" radius="0.65" />
	<tire_set offset="1.0 0.0 -1.0" radius="0.65" />

	<control max_speed="20.0" acceleration="6.7" max_reverse_speed="6.0" max_rotation="0.8" max_water_depth="1.9" />

	<modifier class="blast_damage" value="-0.9" />

	<physics max_health="15.0" mass="1.0" extent="2.0 0.0 1.5" offset="0 0.0 0" top_offset="0 3 0" collision_model_pos="0 0.2 0" collision_model_extent="2.8 3.0 1.9" visual_offset="0 0.0 0" /> 

	<visual class="chassis" mesh_filename="dumpster.mesh" texture_filename="dumpster.png" />

	<sound key="hit" filename="thin_metal_impact1.wav" />
	<sound key="hit" filename="thin_metal_impact2.wav" />
	<sound key="hit" filename="thin_metal_impact3.wav" />

	<event>
		<trigger class="receive_damage" />
		<result class="reward" xp="0.0" />
	</event>
	<event>
		<trigger class="destroy" />
		<result class="spawn" instance_class="weapon" min_amount="0" max_amount="4" offset="0 1.0 0" position_spread="0 0" direction_spread="0.04 0.2" /> 
	</event>
	<effect event_key="destroy" key="other" ref="SmokeMinor" post_processing="1" />
	<effect event_key="destroy" key="other" ref="ShadowSmokeMinor" shadow="1" />
</vehicle>