<vehicle name="Type 1 Ho-Ha" key="hoha.vehicle" respawn_time="80" time_to_live_unsteerable="60" map_view_atlas_index="52" minimum_fill_requirement="0.3" max_character_collision_speed="-1" max_character_collision_speed_on_normal="4.5" ai_driver_turns_to_target="1" ai_use_throwables="0">
	<tag name="metal_heavy" />
	<tag name="hoha" />
	<tag name="apc" />
	<tag name="tank_treads" />
   	<tag name="light_vehicle" />

	<!-- there is an issue regarding turning related to where the wheels are forward/backward on a "tracked" style vehicle -->
	<!-- seems to be moving the center and rear tire sets forward make it easier to turn (so logically moving the front one backwards might help too) -->
	<!-- however this completely messes up the visual position of the main vehicle body -->
	<!-- original and problematic tire set offsets (tire sets = 2 wheels, always from the index in respective order -->
	<!--<tire_set offset="1.1 0.0 +3.4" radius="0.66" />-->
	<!--<tire_set offset="1.1 0.0 0.0" radius="0.66" />-->
	<!--<tire_set offset="1.1 0.0 -3.4" radius="0.66" />-->

	<tire_set offset="1.05 0.0 +2.5" radius="0.55" />
	<tire_set offset="1.05 0.0 0.0" radius="0.55" />
	<tire_set offset="1.05 0.0 -2.8" radius="0.55" />

  <visual class="tire" index="0" mesh_filename="hoha_wheel.mesh" texture_filename="hoha.png" />
  <visual class="tire" index="1" mesh_filename="hoha_wheel.mesh" texture_filename="hoha.png" />
  <visual class="tire" index="2" />
  <visual class="tire" index="3" />
  <visual class="tire" index="4" />
  <visual class="tire" index="5" />

	<modifier class="blast_range" value="0.5" /> <!-- radius raised to help with issues from AT Rifle Grenades - but not dramatically make other AT weapons overpowered -->
	<modifier class="blast_damage" value="-0.9" />

	<control 
	max_limiter_speed="4.0" 
	max_speed="9.0" 
	acceleration="9.0" 
	max_reverse_speed="7.0" 
	min_health_to_steer="0.5" 
	max_rotation="1" 
	max_water_depth="1.6" 
	steer_smoothening="0.98" 
	tracked="1" 
	tracked_visual_tire_max_rotation="0.5"
	tracked_visual_tire_rotation_smoothening="10.0"
	simulated_speed_factor="0.75"
	gears="1" />

	<!-- was visual_offset="0 0.34 0.0" -->	
	<physics 
    max_health="18.0" 
    mass="50.0" 
    broken_mass="5"
    remove_collision_threshold="0.2"
    extent="3.2 0.0 7.6" 
    offset="0 0.0 -.2" 
    top_offset="0 3.0 0" 
    collision_model_pos="0.0 1.0 0" 
    collision_model_extent="3.0 2.0 8.0" 
    visual_offset="0 0.34 0.0"
    friction_offset="0.15" /> 

	<!-- one weapon per turret so that only one soldier controls the turret orientation -->
	<!-- similarly, a controllable turret can only exist if it has a weapon -->
	<!-- turrets may have sub-turrets, which may have more weapons, in the future -->
	<turret offset="0.54 2.32 1.35" weapon_key="hoha_mg.weapon" weapon_offset="-0.0 0.3 0.85" weapon_recoil="0.02"  max_rotation_step="0.0003" rotation="0" rotation_range="1.0" />
	<turret offset="1.1 2.44 0.0" weapon_key="hoha_mg.weapon" weapon_offset="0.0 0.0 0.5" weapon_recoil="0.0"  max_rotation_step="0.0003" rotation="1.57" rotation_range="2.2" />
	<turret offset="-1.1 2.44 0.0" weapon_key="hoha_mg.weapon" weapon_offset="0.0 0.0 0.5" weapon_recoil="0.0"  max_rotation_step="0.0003" rotation="-1.57" rotation_range="2.2" />
	<turret offset="0.0 0.0 0.0" weapon_key="hoha_shield.weapon" weapon_offset="0.0 0.0 0.0" weapon_recoil="0.0"  max_rotation_step="0.0003" rotation="0.0" rotation_range="0.0" />


<!-- using ai_driver_turns_to_target="1" - the driver always follows the target of the 1st gunner seat. So in this case of the Ho-Ha we must ensure that the centre gun is 1st gunner / turret.-->
<!-- for cases like tanks, we need to ensure their cannons are 1st gunner / turret -->
	<visual class="chassis" mesh_filename="hoha_chassis.mesh" texture_filename="hoha.png" max_tilt="0.02" />
	<visual class="chassis" key="broken" mesh_filename="hoha_damage.mesh" texture_filename="hoha_damage.png" />
	<visual class="turret" turret_index="0" key="broken" mesh_filename="hoha_mg_damage.mesh" texture_filename="hoha_damage.png" />
	<visual class="turret" turret_index="1" key="broken" mesh_filename="hoha_mg_damage.mesh" texture_filename="hoha_damage.png" />
	<visual class="turret" turret_index="2" key="broken" mesh_filename="hoha_mg_damage.mesh" texture_filename="hoha_damage.png" />
	<visual class="turret" turret_index="0" mesh_filename="hoha_mg.mesh" texture_filename="hoha.png" />
	<visual class="turret" turret_index="1" mesh_filename="hoha_mg.mesh" texture_filename="hoha.png" />
	<visual class="turret" turret_index="2" mesh_filename="hoha_mg.mesh" texture_filename="hoha.png" />

	<visual class="track" mesh_filename="hoha_track.mesh" offset="-1.0 0.0 0.0" >
		<part texture_filename="hoha_wheel.png" texture_animation="rotate" tire_binding="0" />
		<part texture_filename="hoha.png" />
		<part texture_filename="hoha_track.png" texture_animation="translate" factor="0.2" tire_binding="0" />
	</visual>


	<visual class="track" mesh_filename="hoha_track.mesh" offset="+1.0 0.0 0.0" >
		<part texture_filename="hoha_wheel.png" texture_animation="rotate" tire_binding="1" />
		<part texture_filename="hoha.png" />
		<part texture_filename="hoha_track.png" texture_animation="translate" factor="0.2" tire_binding="1" />
	</visual>


	<!-- just so you don't forget - XYZ is Leftright,Updown,Forwardback (left is a positive value) -->

	<character_slot type="driver" enter_position="-1.3 0.5 1.0" seat_position="-0.6 1.1 1.0" rotation="0" exit_rotation="-1.57" hiding="0" animation_id="36" />
	<character_slot type="gunner" attached_on_turret="0" enter_position="1.0 0.5 1.0" seat_position="0.1 -1.4 -0.6" rotation="0" exit_rotation="1.57" hiding="0" animation_key="hoha mg still">
		<turret index="0" />
	</character_slot>
	<character_slot type="gunner" attached_on_turret="1" enter_position="1.0 0.5 0.0" seat_position="0.0 -1.4 -0.7" rotation="-1.57" exit_rotation="1.57" hiding="0" animation_key="hoha mg still">
		<turret index="1" />
	</character_slot>
	<character_slot type="gunner" attached_on_turret="2" enter_position="-1.0 0.5 0.0" seat_position="0.15 -1.4 -0.7" rotation="1.57" exit_rotation="-1.57" hiding="0" animation_key="hoha mg still">
		<turret index="2" />
	</character_slot>
	<character_slot type="passenger" enter_position="1.0 0.5 -0.9" seat_position="0.75 1.0 -0.9" rotation="-1.57" exit_rotation="1.57" hiding="0" allow_weapon="0" animation_key="sitting, idling"/>
	<character_slot type="passenger" enter_position="-1.0 0.5 -0.9" seat_position="-0.75 1.0 -0.9" rotation="1.57" exit_rotation="-1.57" hiding="0" allow_weapon="0" animation_key="sitting, idling"/>
	<character_slot type="passenger" enter_position="1.0 0.5 -1.5" seat_position="0.75 1.0 -1.8" rotation="-1.57" exit_rotation="1.57" hiding="0" allow_weapon="0" animation_key="sitting, idling"/>
	<character_slot type="passenger" enter_position="-1.0 0.5 -1.5" seat_position="-0.75 1.0 -1.8" rotation="1.57" exit_rotation="-1.57" hiding="0" allow_weapon="0" animation_key="sitting, idling"/>
	<character_slot type="passenger" enter_position="1.0 0.5 -2.5" seat_position="0.75 1.0 -2.6" rotation="-1.57" exit_rotation="1.57" hiding="0" allow_weapon="0" animation_key="sitting, idling"/>
	<character_slot type="passenger" enter_position="-1.0 0.5 -2.5" seat_position="-0.75 1.0 -2.6" rotation="1.57" exit_rotation="-1.57" hiding="0" allow_weapon="0" animation_key="sitting, idling"/>
	<character_slot type="passenger" enter_position="1.0 0.5 -3.5" seat_position="0.75 1.0 -3.5" rotation="-1.57" exit_rotation="1.57" hiding="0" allow_weapon="0" animation_key="sitting, idling"/>
	<character_slot type="passenger" enter_position="-1.0 0.5 -3.5" seat_position="-0.75 1.0 -3.5" rotation="1.57" exit_rotation="-1.57" hiding="0" allow_weapon="0" animation_key="sitting, idling"/>

	<!-- sound handling -->

	<!-- sound handling -->
	<!--<rev_sound filename="tank_rev_halftrack_idle3.wav" low_pitch="0.8" high_pitch="1.05" low_rev="0.0" high_rev="1.0" volume="1.6" />-->		<!-- vol 1.6-->
	<rev_sound filename="tank_rev_halftrack_idle4.wav" low_pitch="0.8" high_pitch="1.05" low_rev="0.0" high_rev="1.0" volume="2.1" />		<!-- vol 1.7-->
	<rev_sound filename="tank_rev_halftrack_low_speed8_hoha.wav" low_pitch="0.75" high_pitch="1.0" low_rev="0.01" high_rev="0.75" volume="2.4" />	<!-- vol 2.3-->
	<rev_sound filename="tank_rev_halftrack_high_speed4.wav" low_pitch="0.65" high_pitch="1.05" low_rev="0.55" high_rev="1.0" volume="1.1" />	<!-- vol 1.3-->

	<sound key="horn" filename="rev_horn_9.wav" volume="2.8"/>  
	<sound key="squeal" filename="tire_squeal.wav" />
	<sound key="ignition" filename="jeep2_ignition.wav" />
	<sound key="hit" filename="car_hit1.wav" />
	<sound key="hit" filename="car_hit2.wav" />
	<sound key="destroy" filename="vehicle_explosion_1.wav" />   
	<sound key="cleanup" filename="vehicle_explosion_1.wav" />    

	<!--<sound key="turret_rotation" filename="turret_rotation1.wav" volume="0.8" />-->
	<!--<sound key="turret_rotation" filename="turret_rotation2.wav" volume="0.8"/>-->
	
	<effect event_key="drive" type="splat_map" surface_tag="dirt" size="1.0" atlas_index="2" layer="1" />
	<effect event_key="drive" type="particle" key="terrain" surface_tag="dirt" ref="Burst" use_surface_color="1" />
	
	
	<effect event_key="health" value="2.5" ref="SmallSmokeVehicle" offset="-0.7 1.8 2.8" />  
	
	<effect event_key="health" value="0.5" ref="SmallSmokeVehicle" offset="-0.7 1.8 2.8" />  
	<effect event_key="health" value="0.5" ref="BrokenSparkle" post_processing="0" offset="-0.7 1.8 2.8" />  
	
	<effect event_key="destroyed" ref="SmallSmokeVehicle" offset="-0.6 2.2 3.2" />
	<effect event_key="destroyed" ref="SmallSmokeVehicle" offset="0.7 1.4 2.7" />  
	<effect event_key="destroyed" ref="MediumSmokeVehicle" offset="0.0 1.2 -0.9" />  
	<effect event_key="destroyed" ref="MediumSmokeVehicle" offset="-0.6 1.7 -2.2" />    
	<effect event_key="destroyed" ref="SmallFireRepeat" offset="-0.6 1.7 3.2" />
	<effect event_key="destroy" key="other" ref="woosh" post_processing="0" shadow="0" />   
	
	<effect event_key="cleanup" key="other" ref="woosh" post_processing="0" shadow="0" />  
	
	
	<event key="receive_damage_xp_reward">
		<trigger class="receive_damage" />
		<result class="reward" xp="0.0100" />
	</event>

	<event key="spot_rp_reward">
		<trigger class="spot" />
		<result class="reward" rp="50.0" />
	</event>

	<event key="destroy_rp_reward">
		<trigger class="destroy" />
		<result class="reward" rp="50.0" />
	</event>
    

	    <event>
        <trigger class="destroy" />
        <result class="spawn" instance_class="weapon" instance_key="type97_m.weapon" min_amount="1" max_amount="1" offset="0 2.4 0" position_spread="1.5 1.5" direction_spread="0.15 0.3" />
    </event>
	<event>
		<trigger class="destroy" />
  	<result class="spawn" instance_class="visual_item" instance_key="burning_piece_truck1.visual_item" min_amount="1" max_amount="3" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.2" />
	</event>
	<event>
		<trigger class="destroy" />  	
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_truck2.visual_item" min_amount="2" max_amount="4" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.15 0.25" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_truck3.visual_item" min_amount="1" max_amount="2" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.18" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_truck4.visual_item" min_amount="1" max_amount="3" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.15" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_truck5.visual_item" min_amount="2" max_amount="3" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.05 0.2" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_radartower.visual_item" min_amount="3" max_amount="5" offset="0 3.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.2" />
	</event>  

  <event>
		<trigger class="cleanup" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_cleanup.visual_item" min_amount="20" max_amount="30" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.1" /> 
  </event>    
 	<event>
		<trigger class="cleanup" />
    <result class="spawn" instance_class="projectile" instance_key="debri_stun" min_amount="1" max_amount="1" offset="0 3.0 0" position_spread="0.0 0.0" direction_spread="0.0 0.0" />
  </event> 
</vehicle>