// Naval artillery smoke uses No.77's material, puff animation and hemispherical layout.
// Horizontal radius 12, above-ground vertical radius 9; the lower half is buried.
// 21 seconds of emission plus a 4-second particle tail = 25 seconds total.
// Quota is shared: leave headroom for several concurrent 27-round barrages.
particle_system MymodNavalArtillerySmokeCloud
{
    quota 16384
    material FlareSmoke
    particle_width 3.0
    particle_height 3.0
    cull_each false
    renderer billboard
    billboard_type point

    emitter Ellipsoid
    {
        angle 25
        colour 0.90 0.92 0.90 0
        colour_range_start 0.82 0.85 0.82 0
        colour_range_end 0.98 0.98 0.94 0
        direction 0 1 0
        emission_rate 60
        // Center the ellipsoid on the impact point. Its lower half goes below
        // the terrain, leaving a hemispherical cloud above the ground.
        position 0 0 0
        velocity_min 0.15
        velocity_max 0.35
        time_to_live_min 4.0
        time_to_live_max 4.0
        duration 21.0
        duration_min 21.0
        duration_max 21.0
        // Direction is upward, so Ogre aligns depth with world height;
        // width and height form the two ground-plane axes. The horizontal
        // radius is 12; depth 18 gives an above-ground vertical radius of 9.
        // Growing billboards can extend slightly outside this ellipsoid.
        width 24
        height 24
        depth 18
    }

    affector Scaler
    {
        rate 0.35
    }

    affector Rotator
    {
        rotation_speed_range_start -12
        rotation_speed_range_end 12
        rotation_range_start 0
        rotation_range_end 360
    }

    affector ColourInterpolator
    {
        colour0 1 1 1 0
        time0 0
        colour1 0.90 0.92 0.90 0.65
        time1 0.15
        colour2 0.82 0.85 0.82 0.58
        time2 0.72
        colour3 0.72 0.75 0.72 0
        time3 1
    }
}
