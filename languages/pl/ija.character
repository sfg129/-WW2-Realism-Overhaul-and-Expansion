	<comment key="spawn_in_base_call, denied, key=ija_vehicle.call" text="Brak punktow zrzutu, przejmijcie bazy!" />

	<comment key="spawn_in_base_call, accepted, key=ija_vehicle1.call" text="Zrzucamy wam Ho-Ha w %base_name" />
	<comment key="spawn_in_base_call, denied, key=ija_vehicle1.call" text="Brak punktow zrzutu, przejmijcie bazy!" />

	<comment key="spawn_in_base_call, accepted, key=ija_vehicle2.call" text="Zrzucamy wam Ka-Tsu w %base_name" />
	<comment key="spawn_in_base_call, denied, key=ija_vehicle2.call" text="Brak punktow zrzutu, przejmijcie bazy!" />

