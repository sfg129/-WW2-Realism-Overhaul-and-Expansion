	<comment key="enemy vehicle spotted, near base" text="%vehicle_name nalezacy do %enemy_name widziany przy %base_name" />
	<comment key="enemy vehicle spotted, not near base" text="%vehicle_name nalezacy do %enemy_name zostal zauwazony" />

	<comment key="comms have been restored" text="Naprawiono nasz system lacznosci" />
	<comment key="enemy comms have been restored" text="%enemy_name naprawili swoj system lacznosci" />

	<comment key="comms have been destroyed" text="Nasz system lacznosci zostal wysadzony" />
	<comment key="enemy comms have been destroyed, by us" text="Wysadzilismy system lacznosci nalezacy do %enemy_name" />

	<dialogue key="wander dialogue 2 men">
		<comment text="Spojrz na to miejsce" />
		<comment text="Jest takie spokojne" />
		<comment text="Moglbym sie tu zestarzec" />
	</dialogue>

	<dialogue key="wander dialogue 2 men">
		<comment text="Chyba tu juz kiedys bylem" />
	</dialogue>
  
	<dialogue key="wander dialogue 2 men">
		<comment text="Patrz! Zajaczek!" />
	</dialogue>  

	<dialogue key="wander dialogue 2 men">
		<comment text="Czuje sie dzis niewyraznie..." />
	</dialogue>
  
	<dialogue key="wander dialogue 2 men">
		<comment text="Dolacz do armi, powiedzieli, zabawisz sie, powiedzieli" />
	</dialogue>  
  
	<dialogue key="wander dialogue 2 men">
		<comment text="Myslalem, ze bede siedziec za biurkiem w armii..." />
	</dialogue>    

	<dialogue key="defense dialogue 2 men">
		<comment text="Jak tam zona?" />
		<comment text="Ponoc po mojej dwuletniej sluzbie niedawno urodzila synka" />
	</dialogue>
  
  <dialogue key="wander dialogue 2 men">
      <comment text="Chcesz zobaczyc cos fajnego?" />
      <comment text="Nie dam sie znow na to nabrac" />
   </dialogue> 

	<dialogue key="defense dialogue 2 men">
		<comment text="Raz bylismy za linia wroga, sierzant i ja" />
		<comment text="Przekradliscie sie?" />
		<comment text="Ta, znalezlismy tez woz zaopatrzenia" />
		<comment text="Wow, niesamowicie" />
		<comment text="Ha! To byla przygoda, nie to co teraz" />
		<comment text="Przynajmniej tym sposobem zyjemy dluzej" />
		<comment text="W sumie cos w tym jest" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Nie mow mamie ze jestem w armii" />
		<comment text="Czemu?" />
		<comment text="Wmowilem jej ze jestem pianista" />
		<comment text="Oh ok" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Masz fajki?" />
		<comment text="Nie, nie wiedzialem ze palisz" />
		<comment text="Nie pale, chce je sprzedac za nowa pukawke" />
		<comment text="A co zlego w tej?" />
		<comment text="Chyba nasypal sie do niej piasek" />
		<comment text="No to ja wyczysc" />
		<comment text="W zbrojowni nie ma srodkow czyszczacych" />
		<comment text="Niemozliwe" />
		<comment text="Maja setki broni, ale nikt ich nie czysci" />
		<comment text="Chyba nie sadza, ze beda nam potrzebne tak dlugo!" />
		<comment text="Cos w tym jest..." />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Masz moze wodke?" />
		<comment text="Dzentelmen nie pije przed poludniem!" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Tylek mnie swedzi" />
		<comment text="To sie podrap granatem" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Myslalem, ze..." />
		<comment text="Nie mysl, kiepsko ci to wychodzi" />
		<comment text="Bardzo smieszne" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Dlaczego ta swinia ma kly?" />
		<comment text="Bo to jest guziec" />
		<comment text="Taka swinia z Afryki?"/>      
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Nie wiem czy powinienem spiewac w wojskowym chorze" />
		<comment text="Czemu?" />
		<comment text="Ostatni raz spiewalem w kosciele"/>  
		<comment text="No i?" /> 
		<comment text="200 osob zmienilo religie" />           
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Dobrze, ze nasralem w tajnym przejsciu" />
		<comment text="Super, teraz przeciwnik tamtedy nie przejdzie" />
	</dialogue>   
  
  <dialogue key="vehicle dialogue 2 men">
    <comment text="" />
    <comment text="" />
  </dialogue>  
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Ostatnio strzelem sie z deweloperami" />
		<comment text="Mowisz o Pasik i JackMayol?" />
    <comment text="Ta, Pasik strzela jak babcia, ale JackMayol jeszcze gorzej!" />
	</dialogue>     

	<dialogue key="defense dialogue 2 men">
		<comment text="'Osumia Games'... Kto tak nazywa firmy!?" />
		<comment text="Errrr... o co ci chodzi?" />
        <comment text="A sam nie wiem!" />
	</dialogue>  

	<dialogue key="defense dialogue 2 men">
		<comment text="Czasami mam wrazenie, ze my tu tylko biegamy z karabinami" />
		<comment text="Siedzimy tu od miesiaca, masz refleks!" />
	</dialogue>  

	<dialogue key="vehicle dialogue 2 men">
		<comment text="Gazu! Kiler! Spi***aj!" />
		<comment text="Sam spi***aj bo mi tapicerke tym kebabem uwalisz!" />
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Czy ta gra juz wyszla?" />
		<comment text="Ta, na Steam!" />
		<comment text="Super!" />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men tag=truck" >
		<comment text="Koles, zesrales sie?" />
		<comment text="Mozliwe..." />
		<comment text="Ku**a! Otworz okno!" />    
	</dialogue>    

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Wiesz co..." />
		<comment text="Hmm?" />
		<comment text="Kocham cie" />   
		<comment text="Skoncz..." />     
	</dialogue> 

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Kto ci dal prawko!?" />
		<comment text="Twoja stara!" />
	</dialogue> 

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Oh tak! Tak! Mocno!" />
		<comment text="Zejdz z tej galki skrzyni biegow..." />
	</dialogue>
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Dziwnie sie tym jezdzi" />
		<comment text="Czemu?" />      
		<comment text="Nic nie widze przed soba" />
		<comment text="Jak to?" />
		<comment text="Oczy mam gdzies w chmurach i widze nas z gory" />    
	</dialogue>  

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Masz prawko kolego?" />
		<comment text="Mam paszport Polsatu" />
	</dialogue> 
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Sadzisz, ze Damian umie jezdzic?" />
		<comment text="Masz jakies watpliwosci?" />
		<comment text="Jednym okiem patrzy na Macka, drugim na Pawla" />    
	</dialogue> 
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Tylek mnie boli" />
		<comment text="Ciesz sie... Ty w ogole masz tylek!" />
	</dialogue> 
  
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Stary?" />
		<comment text="Tia?" />
		<comment text="Skad sie biora dzieci?" />    
	</dialogue> 
  
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Znasz Brodatego?" />
		<comment text="To ten slawny polski jutuber?" />
		<comment text="Ta! Gra w ta gre!" />    
	</dialogue>     

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Masz papier klozetowy?" />
		<comment text="No nie gadaj stary, prosze cie!" />
	</dialogue>  
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="A moglismy byc w domu" />
		<comment text="Pic piwko" />
		<comment text="Grac w RUNNING WITH RIFLES" />
		<comment text="Aleee nieee... musimy marznac w tym zlomie" />    
	</dialogue>       
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Musze wrocic do zbrojowni" />
		<comment text="Dlaczego?" />
		<comment text="Zapomnialem pieluchy" />    
	</dialogue> 
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Przydaloby sie wiecej kobiet..." />
		<comment text="Ta, pomoglyby mi... z hormonami" />
		<comment text="Nie o to mi chodzi" />
		<comment text="Czyli?" /> 
		<comment text="Ktos mi musi wyprac gacie" />               
	</dialogue>   

	<dialogue key="vehicle dialogue 2 men">
		<comment text="Mogliby dodac pare polygonow wiecej" />
		<comment text="Czemu tak sadzisz?" />
		<comment text="Te siedzenia sa strasznie kanciaste" />    
	</dialogue> 

	<dialogue key="vehicle dialogue 2 men">
		<comment text="No patrzcie co narobiliscie!" />
		<comment text="Ale to nie ja..." />
		<comment text="A kto kierowca ku**a jest?!" /> 
		<comment text="Chorazy!" />    
	</dialogue> 

	<dialogue key="vehicle dialogue 2 men">
		<comment text="Andrzeju! Nie denerwuj sie!" />
		<comment text="Zobacz co narobiles!" />
		<comment text="Zaraz wyklepiemy!" /> 
   	<comment text="Takiego blotnika juz nie dostane!" />    
	</dialogue> 

	<dialogue key="vehicle dialogue 2 men">
		<comment text="Suma podstawy rowna sie?" />
		<comment text="Dwa?" />
		<comment text="Kwadratowi obu ramion!" />
		<comment text="Lubie placki!" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men">
		<comment text="Czy wygladam jakbym mial za malo zelaza?" />
		<comment text="Wrog dowali ci pare kilo, w formie pociskow" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men">
		<comment text="Zaraz bedzie ciemno!" />
		<comment text="Zamknij sie!" />
		<comment text="..." />
  </dialogue>

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Odbierz w koncu ten telefon!" />
		<comment text="To nie telefon tylko moje Tamagotchi" />
	</dialogue>
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Mogliby ci ludzie pograc wiecej PVP..." />
		<comment text="Dlaczego?" />
		<comment text="Przynajmniej przestaliby nas tak mordowac" />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Ale ten samochod upierdolony!" />
		<comment text="Rurku!" />
	</dialogue>   
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Mam pomysl..." />
		<comment text="Zapomnij, nie ma planow idealnych" />
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Ogladam Radio Maryja" />
		<comment text="Wysiadaj..." />
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Koledzy? My sie znamy?" />
		<comment text="Jakos cie nie kojarze..." />
		<comment text="Bo mam wrazenie, ze jestescie z przeciwnego teamu" />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Niezle sie ten pojazd trzyma na tej tasmie" />
		<comment text="Caly wszechswiat trzyma sie na tasmie klejacej!" />
	</dialogue>   
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Jak wroce to zaloze Klapkart w Tesco" />
		<comment text="Doskonaly pomysl, sierzancie!" />
	</dialogue>  

  <dialogue key="vehicle dialogue 2 men">
      <comment text="Wiec to twoj pierwszy raz na misji?" />
      <comment text="Ta, boli mnie to bardzo" />
      <comment text="Jestes ranny!?" />
      <comment text="Nie, obieralem ziemniaki i sie zacialem" />
  </dialogue>
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="... a kto kierowca k**a jest?!" />
		<comment text="Chorazy!!!" />
	</dialogue>  
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="W armii sa dwie zasady" />
		<comment text="Jakie, sierzancie?" />
		<comment text="#1: Dowodca ma racje" />
		<comment text="#2: Jak nie ma, patrz punkt pierwszy" />        
	</dialogue>           

	<dialogue key="vehicle dialogue 2 men tag=campfire">
		<comment text="Stopa mi sie pali" />
		<comment text="To ja ugas" />
		<comment text="Nie moge, utknela w komorze silnika!" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="Kocham ten czolg" />
		<comment text="Tylko nie odbywaj z nim stosunku..." />
		<comment text="Lufe juz wyczyscilem" />
	</dialogue>

  <dialogue key="vehicle dialogue 2 men tag=tank">
      <comment text="Jak nazwiemy nasz czolg?" />
      <comment text="Rudy 102!" />
      <comment text="Rozumiem, ze ty jestes psem?!" />
  </dialogue>

	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="Cos mi siedzi w tylku" />
		<comment text="Nie dziwie sie, siedzisz na pociskach" />
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="A kto kierowca byl?!" />
		<comment text="Zamknij sie..." />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="Czuje sie jakbym jechal konno!" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="Najlepszy czolg!" /> 
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=tank">
		<comment text="Dajesz, chorazy!" /> 
	</dialogue>  
  
  <dialogue key="vehicle dialogue 2 men tag=tank">
      <comment text="Sierzancie, po co nam kot w czolgu?!" />
      <comment text="Zepsul sie system noktowizji, czyms trzeba zastapic" />
  </dialogue> 
   
  <dialogue key="vehicle dialogue 2 men tag=tank">
      <comment text="Pa! Je**nie!" />
      <comment text="Aaaale urwal!" />
      <comment text="Ale to bylo dobre!" />
  </dialogue>    
              
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="No ten tego..." />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Pyr, pyr, pyr..." />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Sierzancie, jedziemy na grzyby?" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Ale tu ciasno..." />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Czy ten pojazd pali dizlem czy paliwem?" />
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Jezu! Twoja twarz!" />
		<comment text="Co!?" />
		<comment text="Jest pelna wokseli!" />     
	</dialogue>  
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Hello... it's meeeee..." />
		<comment text="Kapralu. Podaj pistolet!" />   
	</dialogue>  
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Chcialbym pograc w RWR z pierwszej osoby!" />
		<comment text="O tak!" /> 
		<comment text="Co za leniwi dewsi!" />         
	</dialogue>     

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="5 zlotych za litr..." />
	</dialogue>  

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Tu jakas kontrolka mi sie swieci..." />
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Kurde, musze do kibla!" />
	</dialogue>  

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Oh... pizza..." />
		<comment text="Albo lody!" />
		<comment text="Albo dobry kebab!" />
		<comment text="Salatka z pasztetem..." />
		<comment text="Ze co?!" />                
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Czuje sie jak w czinkoczento" />
		<comment text="Mamy tu nowe dywaniki z Tesco!" />    
	</dialogue>  
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Masz fajki?" />
		<comment text="Uh... nie..." />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Sierzancie, moze pan zrestartowac gre?" />
		<comment text="O co chodzi, kapralu?" /> 
		<comment text="Chyba mi noga utknela w teksturach" />        
	</dialogue>       
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Zaloz helm zamiast tej czerwonej opaski" />
		<comment text="Wygladam w niej jak kozak!" />    
		<comment text="Kozak ci na czole wyrosnie jak dostaniesz kulke" />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Sierzancie, tu sie chyba woksele przepalaja!" /> 
	</dialogue>    
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Wiesz co najwazniejsze jest w zyciu?" /> 
		<comment text="Zdrowie?" /> 
		<comment text="Nie!" />
		<comment text="To nie wiem" />
		<comment text="Dobrze sie wysrac!" />                
	</dialogue> 
  
  <dialogue key="vehicle dialogue 2 men tag=truck">
     <comment text="Pamietasz ten film jak kierowca ciezarowki ratuje swiat?" />
     <comment text="Nope" />
     <comment text="No wlasnie ja tez nie. WSZYSCY ZGINIEMY!" />
  </dialogue>  
          

	<dialogue key="defense dialogue 2 men">
		<comment text="Niedlugo dostane awans" />
		<comment text="Czemu tak sadzisz?" />
		<comment text="Podobno sierzant jest od 20 pociskow w tylku" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Jajka mi przymarzly" />
	</dialogue>
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Czuje sie zle..." />
    <comment text="Dlaczego?" />  
    <comment text="Zespawnowalem sie dzis z 200 razy" />
    <comment text="To faktycznie musi meczyc" />           
	</dialogue>
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Staruszki na weselach mowia do mnie 'ty nastepny'" />
    <comment text="Zacznij im robic to samo na pogrzebach" />     
	</dialogue>    
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Te reklamy telefoniczne sa wkurzajace!" />
    <comment text="Podaj sluchawke swojej 3 letniej corce i powiedz, ze to Mikolaj" />     
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Mialem dzis koszmary!" />
    <comment text="Jakie?" />   
    <comment text="Wszedzie byly 1 i 0" />
    <comment text="To normalne w swiecie botow" />
    <comment text="I nagle widzialem jedno 2!" />
    <comment text="Oww, przerazajace!" />          
	</dialogue>   
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Urodzil mi sie synek" />
    <comment text="To super! Jak wyglada?" /> 
    <comment text="No coz, na razie ma 3 woksele" />
    <comment text="A, to podobny do mamy!" />             
	</dialogue>      

	<dialogue key="defense dialogue 2 men">
		<comment text="Kapralu. Zamknij sie!" />
    <comment text="Gadulstwo jest u mnie rodzinne" /> 
    <comment text="Jak to?" />
    <comment text="Dziadek byl politykiem, a tata nauczycielem" />    
    <comment text="A co z matka?" /> 
    <comment text="Po prostu byla kobieta" />              
	</dialogue>   

	<dialogue key="defense dialogue 2 men">
		<comment text="Jak powinienem napisac list do ojca?" />
    <comment text="Masz mu cos do przekazania?" /> 
    <comment text="Tragiczna wiadomosc..." />
    <comment text="Jaka?" />    
    <comment text="Zesralem sie podczas bitwy i mnie zdegradowano" /> 
    <comment text="Najgorzej..." />              
	</dialogue>  

	<dialogue key="defense dialogue 2 men">
		<comment text="Dobrze, ze dewsi nie wprowadzili samolotow..." />
		<comment text="Jeden problem z glowy, nie?!" /> 
    <comment text="Ta, nic nam nie spadnie na glowe" />          
    <comment text="Nie liczac mozdzierzy i artylerii" />
    <comment text="Hahaha i ptasiego gunwa!" /> 
    <comment text="Cholera!" />                                    
	</dialogue>     

	<dialogue key="defense dialogue 2 men">
    <comment text="Kiedys bede profesjonalnym snajperem..." />  
    <comment text="Ta, widzisz lewa i prawa strone, srodkowej juz nie!" />                                      
	</dialogue> 
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Bylem ostatnio na przepustce..." />  
    <comment text="Ta? To czemu masz tak pogryziony uniform?" />
    <comment text="Bo wiesz... Pies mnie nie poznal!" /> 
    <comment text="Juz myslalem, ze zona cie tak rozszarpala" />                                            
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Chcialbym umiec patrzec tak daleko jak ten gosc" />  
    <comment text="W sensie gracz?" />
    <comment text="Ta, ten co siedzi za monitorem i gapi sie na nas" /> 
    <comment text="Taaa, to jakas forma oszukiwania w grach" /> 
    <comment text="Nie moge wyrobic z jego durnego wyrazu twarzy" />                                               
	</dialogue>    

	<dialogue key="defense dialogue 2 men">
    <comment text="Jezeli masz konflikt ze swoim przelozonym..." />  
    <comment text="hm?" />
    <comment text="On jest przelozonym, a ty konfliktem" />                                       
	</dialogue>   

	<dialogue key="defense dialogue 2 men">
    <comment text="Im glupszy jest nasz dowodca, tym trudniejsze misje sie mu przydziela" />  
    <comment text="Zawsze znajdzie najprostszy sposob na jej zaliczenie?" />                                     
	</dialogue>  

	<dialogue key="defense dialogue 2 men">
    <comment text="Sikac mi sie chce..." />  
    <comment text="I co? Moze ci jeszcze potrzymac?" />                                     
	</dialogue>  

	<dialogue key="defense dialogue 2 men">
    <comment text="Widziales nowa zone sierzanta?" />  
    <comment text="Ta z wielkim nosem?" /> 
    <comment text="Ta, z takim nosem moze robic za parasol pod prysznicem!" />                                         
	</dialogue> 

	<dialogue key="defense dialogue 2 men">
    <comment text="To prawda, ze malpy to praludzie?" />  
    <comment text="Tak, ale sierzanci chyba nie pochodza od malp" />                                     
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Podobno jakas dziewczyna w przebraniu dolaczyla do meskiej armii" />  
    <comment text="To znaczy, ze bedzie sie kapac z innymi pod prysznicem?!" /> 
    <comment text="Oczywiscie" />  
    <comment text="Przeciez to sie wyda!" /> 
    <comment text="A sadzisz, ze ktos podkabluje?" />                                             
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Slyszales, ze mamy uzywac bomb o wiekszej mocy?" />  
    <comment text="Sadze, ze to wbrew prawom wojennym" /> 
    <comment text="Ci ktorych bombardowalismy do tej pory jakos nie narzekaja" />                                        
	</dialogue>      
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Czemu od trzech dni sie wycofujemy, sierzancie?!" />  
    <comment text="Nie wycofujemy sie, nacieramy w przeciwnym kierunku" />  
    <comment text="Tak jest, sierzancie!" />                                       
	</dialogue>  

	<dialogue key="defense dialogue 2 men">
    <comment text="Nie musisz byc prostym czlowiekiem, by dolaczyc do armii" />  
    <comment text="Dzieki, kolego" />                                     
    <comment text="Prosto, to ty musisz strzelac!" />
	</dialogue>     
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Wojna, wojna nigdy sie nie zmienia" />  
    <comment text="Klasyka..." />                                     
	</dialogue> 
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Nigdy nie przeszkadzaj przeciwnikowi kiedy popelnia bledy" />  
    <comment text="Prawda, prawda" />                                     
	</dialogue>    

	<dialogue key="defense dialogue 2 men">
    <comment text="Tyle wartosciowych rzeczy wala sie po polu bitwy" />  
    <comment text="I nikt tego nie podnosi" /> 
    <comment text="Sprzedawanie ich w zbrojowni przynosi zysk" />                                         
	</dialogue> 

	<dialogue key="defense dialogue 2 men">
    <comment text="Musze byc skoncentrowany dzisiaj!" />  
    <comment text="Coz dzis takiego specjalnego?" /> 
    <comment text="Dzis ponoc Brodaty nagrywa RWR!" />
    <comment text="I chcesz mu przebic opony w samochodzie?" /> 
    <comment text="Taki mam plan!" />                                                
	</dialogue>  

  <dialogue key="defense dialogue 2 men">
      <comment text="Zastanawiam sie" />
      <comment text="Co?" />
      <comment text="Skad nadciagaja posilki?" />
      <comment text="Co pod tym rozumiesz?" />
      <comment text="Nie widac zadnych ciezarowek ani nic" />
      <comment text="Sadzisz ze pojawiaja sie znikad?" />
  </dialogue>

  <dialogue key="defense dialogue 2 men">
      <comment text="Pusciles baka?" />
      <comment text="Hehe!" />
      <comment text="Obrzydzasz mnie" />
      <comment text="Rozkaz przyjety!" />
  </dialogue>
   
  <dialogue key="defense dialogue 2 men">
      <comment text="Za malo nam placa za ta robote" />
      <comment text="Za malo, by codziennie cie znosic" />
      <comment text="To byl zart?!" />
      <comment text="Oj, chcialbym!" />
  </dialogue>   
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Ponoc sierzantowi pies zdechl..." />  
    <comment text="To zdechl pies czy zmarl sierzant?" />                                     
	</dialogue> 
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Pojechalbym gdzies" />  
    <comment text="Moze na Walbrzych?" />                                     
	</dialogue>    

  <!-- adventure mode -->

