	<comment key="Medic!" text="Aah, fa male!" /> 
	
	<comment key="Reloading" text="Coprite, sto ricaricando!" />
	<comment key="Reloading" text="Devo ricaricare!" />  
	
	<comment key="initiate radio call" text="Quartiere Generale, qui è la compagnia Able, mi ricevete?" />
	<comment key="commander radio response" text="Vi riceviamo compagnia Able." />
	
	<comment key="hostile vehicle takeover" text="Cosa? NOOOO" />
	<comment key="hostile vehicle takeover" text="Hey! Quello è - " /> 
	<comment key="hostile vehicle takeover" text="Cosa? No no NO!" />    
	
	<comment key="Lone leader, enemy not seen, taking suppressed fire" text="Trovatelo, dannazione!" />
	
	<comment key="enemy seen, vehicle tag = tank" text="Carro in avvicinamento!" /> 
	<comment key="enemy seen, vehicle tag = tank" text="Abbiamo bisogno di armi anticarro qui!"/>
	<comment key="enemy seen, vehicle tag = tank" text="Caaaaarro!"/> 
	<comment key="enemy seen, vehicle tag = tank" text="Cristo, state giù! CARRO!"/> 
	<comment key="enemy seen, vehicle tag = tank" text="Hanno portato un carro!" />     
	
 	<comment key="enemy seen, vehicle tag = apc" text="APC in avvicinamento!" /> 
 	<comment key="enemy seen, vehicle tag = apc" text="APC in avvicinamento! Distruggete quell'affare!" />  
 	<comment key="enemy seen, vehicle tag = apc" text="APC avvistato!" />
 	<comment key="enemy seen, vehicle tag = apc" text="APC avvistato!" /> 
 	<comment key="enemy seen, vehicle tag = apc" text="APC! State attenti!" />
 	<comment key="enemy seen, vehicle tag = apc" text="APC! Distruggetelo soldati!" />  
	
 	<comment key="enemy seen, vehicle tag = truck" text="Convoglio nemico!" />   
 	<comment key="enemy seen, vehicle tag = truck" text="Contatto con convoglio nemico!" />  
 	<comment key="enemy seen, vehicle tag = truck" text="Convoglio in avvicinamento!" />   
 	<comment key="enemy seen, vehicle tag = truck" text="Fate esplodere quel convoglio!" />                  
	
	<comment key="Hold on!" text="Resisti amico!" />  
	
	<comment key="celebrating" text="Prendi questo!" />
	<comment key="celebrating" text="Ce l'ho fatta...." />
	<comment key="celebrating" text="Phew, è finita, per ora..." />
	<comment key="celebrating" text="Bel lavoro, ragazzi." />
	<comment key="celebrating" text="Infilatelo dove non batte il Sol Levante!" />
	<comment key="celebrating" text="Bell'isola ragazzi, credo che ci rimarrò." />
	<comment key="celebrating" text="Wow, che fortuna." />
	<comment key="celebrating" text="Wooo! Ben fatto uomini." />
	<comment key="celebrating" text="Gli abbiamo presi a calci in culo!" />
	<comment key="celebrating" text="Vi arrendete così facilmente?" />
	<comment key="celebrating" text="Devo trovare una katana" />
	<comment key="celebrating" text="Devo trovare la pistola di un ufficiale" />
	
	<dialogue key="wander dialogue 2 men">
		<comment text="Per appartenere alla Marina camminiamo tanto, sapete?" />
	</dialogue>    
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Ho sentito che i nostri nemici stanno effettuando dei raid." />
		<comment text="Merda, siamo pronti a questo?" />
	</dialogue>   
      
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Ti hanno dato il nuovo equipaggiamento?" />
		<comment text="Yeah" />
		<comment text="Dannazione, avrei bisogno anche io del nuovo equipaggiamento.." /> 
		<comment text="Arrangiati amico" />    
	</dialogue> 
	
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Sai per caso le previsioni del tempo per stasera?" />
		<comment text="Pioveranno bombe!" />
		<comment text="..." />
	</dialogue>
	
	<dialogue key="vehicle dialogue 2 men tag=light_tank">
		<comment text="Che nome possiamo dare al carro?" />
		<comment text="Il Mietitore." />
		<comment text="Oh yeah!." />
	</dialogue>
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Dannati granchi!" />  
		<comment text="Fastidiosi, eh?" /> 
		<comment text="Ho ucciso più granchi che nemici giapponesi!" />  
	</dialogue>  
	
	<dialogue key="defense dialogue 2 men">
		<comment text="Perché i nostri hanno arretrato negli ultimi giorni?" />  
		<comment text="Non stavano arretrando, stavano avanzando nella direzione opposta." />  
		<comment text="Ah, giusto." />                                       
	</dialogue>  
	
	<dialogue key="defense dialogue 2 men">
		<comment text="La guerra è il metodo che Dio usa per insegnare la geografia agli ignoranti?" />  
		<comment text="Ho sentito che tuo papà ha partecipato alla Grande Guerra." />                                     
	</dialogue> 
	
   <!-- commander comments -->
	<comment key="player promotion" text="Congratulazioni soldato, sei stato promosso a %rank_name!" />
	<comment key="we captured a base" text="%base_name è stata catturata dalle nostre squadre." />
	<comment key="we captured a base" text="Abbiamo preso il controllo di %base_name, entrate e mettete in sicurezza." />
	<comment key="we captured a base" text="La nostra Marina ha messo in sicurezza %base_name!" />
	<comment key="enemy captured a base" text="%faction_name ha catturato %base_name, preparatevi a contrattaccare!" />
	<comment key="enemy captured a base" text="I Giapponesi hanno conquistato %base_name" />
	<comment key="neutral captured a base" text="" />
	
	<comment key="we have lost our last base" text="Abbiamo perso la nostra ultima base - la battaglia è stata persa!" />
	<comment key="enemy has lost their last base" text="%faction_name sono stati sconfitti!" />
	
	<comment key="our assault ran out of time" text="Il nostro assalto non ha avuto un buon esito - la battaglia è stata persa!" />
	<comment key="enemy assault ran out of time" text="%faction_name sono stati sconfitti!" />
	
	<comment key="we won by map conquer" text="Ottimo lavoro uomini, abbiamo respinto il nemico" />
	<comment key="we won by defense timer" text="Il loro assalto ha perso di intensità, abbiamo vinto!" />
	
	<comment key="our base is under attack" text="%base_name è sotto attacco!" />
	<comment key="our base is under attack" text="Abbiamo notizie di attacchi giapponesi a %base_name." />
	<comment key="we are attacking a base" text="Le nostre squadre stanno assaltando %base_name" />
	
	<comment key="fighting near a base" text="Abbiamo notizie di contatti nemici vicino a %base_name" />
	<comment key="fighting near a base" text="Rinforzi richiesti a %base_name" />
	<comment key="fighting near a base" text="Spari nemici vicino a %base_name" />
	
	<comment key="defense timer started" text="%faction_name controllate la zona, rimangono %time_left!" />
	<comment key="defense timer to go" text="Rimane %time_left!" />
	
   <!-- adventure mode -->
	<comment key="guadalcanal intro, part 1" text="Attenzione, trasmissione del comandante in arrivo" />
	<comment key="guadalcanal intro, part 2" text="La Marina ci ha appena lasciati - siamo da soli qui." />
	<comment key="guadalcanal intro, part 3" text="Quel che è peggio, è che i Giapponesi sembrano volerci colpire ad ogni costo." />
	<comment key="guadalcanal intro, part 4" text="Tenete il fronte, mantenete lo spazio aereo ad ogni costo!" />
	<comment key="guadalcanal intro, part 5" text="Il nemico arriverà da oltre il fiume, tenetevi pronti." />
	<comment key="guadalcanal intro, part 6" text="Buona fortuna e che Dio ci assista soldati! Avete 30 secondi per posizionarvi!" />
	<comment key="guadalcanal intro, part 7" text="Il nemico ci sta studiando, non manca ancora molto!" />
	
	<comment key="guadalcanal stage 1" text="Bombardamento nemico, state in copertura! (Fase 1 iniziata)" />
	<comment key="guadalcanal stage 2" text="Arriva la seconda ondata! (Fase 2 iniziata)" />
	<comment key="guadalcanal stage 3" text="Carri! Arrivano con i carri! (Fase 3 iniziata)" />
	<comment key="guadalcanal stage 4" text="I nemici non stanno mollando, mantenete le difese! (Fase 4 iniziata)" />
	<comment key="guadalcanal stage 5" text="Pare che si stiano riorganizzando per un'altra ondata - posizionate altre difese! (Pausa di 2 minuti iniziata)" />
	<comment key="guadalcanal stage 6" text="L'esercito è appena sbarcato, ma pare che il nemico non voglia smettere di attaccare. (Fase 6 iniziata)" />
	<comment key="guadalcanal stage 7" text="La Marina è tornata con l'artiglieria pesante! Una pioggia di granate gli mostrerà l'inferno!" />
	<comment key="guadalcanal stage 8" text="Contrattacco!" />
	
	<comment key="map start with 1 base, part 1" text="Attenzione, trasmissione del comandante in arrivo" />
	<comment key="map start with 1 base, part 2" text="Ci fa piacere avervi qui a %map_name" />
	<comment key="map start with 1 base, part 3" text="La flotta è arrivata qui oggi e si è preparata per lo sbarco."/>
	
	<comment key="map start with 1 base, capture" text="Siamo pronti per l'invasione, l'obiettivo è catturare %map_name completamente" />
	<comment key="map start with 1 base, koth" text="L'obiettivo primario è prendere il controllo di %target_base_name e difenderlo" />
	
	<comment key="map advance, held by enemy" text="Il nostro battaglione S-2 dice che %map_name è il prossimo punto strategico. %faction_name si è asserragliata per bene." />
	<comment key="map advance, another enemy present" text="%faction_name sono stati avvistati in quest'area" />
	<comment key="map advance, new map" text="La divisione si sta preparando per un altro sbarco, muoviamoci!" />
	<comment key="map advance, been there before" text="Siamo ancora in controllo di %number_of_bases basi" />
	<comment key="map advance, friendly map" text="%map_name è occupata da %faction_name, era piuttosto tranquillo qui." />
	
	<comment key="final map, part 1" text="Attenzione, trasmissione del comandante in arrivo" />
	<comment key="final map, part 2" text="Ci fa piacere avervi qui a %map_name" />
	<comment key="final map, part 3" text="Ci siamo, terra nemica!" />
	<comment key="final map, part 5" text="Isola dopo isola, battaglia dopo battaglia, abbiamo respinto la %faction_name." />
	<comment key="final map, part 6" text="Ma qui e ora, l'operazione Downfall è già iniziata." />
	<comment key="final map, part 7" text="Vinciamo questa battaglia e finiamo questa guerra, una volta per tutte!" />
	
