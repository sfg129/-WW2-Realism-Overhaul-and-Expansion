  <comment key="Uh, I can't drive this thing" text="Uh, non so guidare questa roba" />
  <comment key="Uh, I can't drive this thing" text="Di nuovo a scuola guida, eh?" />
  <comment key="Uh, I can't drive this thing" text="Oops" />
  <comment key="Uh, I can't drive this thing" text="Maledetto aggeggio!" />
  <comment key="Uh, I can't drive this thing" text="Scommetto che il motore ? difettosso" />
  <comment key="Uh, I can't drive this thing" text="Sono sicurissimo che il radiatore ? rotto" />
  <comment key="Uh, I can't drive this thing" text="Ahh, mi sa che il volante non funziona" />
  <comment key="Uh, I can't drive this thing" text="Ah, ? cos? che funzionava la frizione!" />
  <comment key="Uh, I can't drive this thing" text="Prossima volta non guido" />
  <comment key="Uh, I can't drive this thing" text="Porco cane!" />
  <comment key="Uh, I can't drive this thing" text="Oh mamma, di nuovo!" />
  <comment key="Uh, I can't drive this thing" text="Qualcuno vuole provare?" />
  <comment key="Uh, I can't drive this thing" text="Mi sa che mi servono gli occhiali" />
  <comment key="Uh, I can't drive this thing" text="Mi sa che sto andando dalla parte sbagliata" />
  <comment key="Uh, I can't drive this thing" text="Non ? colpa mia" />
